<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#63606060" />
            <corners android:radius="15.0dip" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <gradient android:startColor="#ffff0000" android:endColor="#ffff0707" android:angle="0.0" android:centerColor="#ffff0000" />
                <corners android:radius="15.0dip" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient android:startColor="#ffff0000" android:endColor="#ffff0707" android:angle="0.0" android:centerColor="#ffff0707" />
                <corners android:radius="15.0dip" />
            </shape>
        </clip>
    </item>
</layer-list>