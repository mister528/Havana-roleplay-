<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/havana_ripple_green"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/havana_radius_md" />
                    <gradient android:startColor="#cc19261f" android:endColor="#cc0d1713" android:angle="270.0" android:type="linear" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/havana_radius_md" />
                    <stroke android:width="1.0dip" android:color="@color/havana_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>