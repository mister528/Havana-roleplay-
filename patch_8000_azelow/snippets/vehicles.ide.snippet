# Add this line at the END of data/vehicles.ide (before the trailing "end")
#
# Format: id, dff, txd, type, handling, gxt_name, anims, class, frq, flags, comprules, wheelmodel, fScale_F, fScale_R, misc
#
# - id        : 8000 (custom slot, requires SA More Vehicles plugin OR custom-ID-aware launcher)
# - dff       : azelow      -> assets/data/img/azelow.dff
# - txd       : azelow      -> assets/data/img/azelow.txd
# - type      : car
# - handling  : AZELOW      -> the entry name in handling.cfg
# - gxt_name  : AZELOW      -> the key inside american.gxt's MAIN block
# - class     : richfamily  -> spawns in rich neighbourhoods
# - frq, flags: 10, 0       -> default
# - comprules : 0
# - wheelmodel: -1
# - scale F/R : 0.80, 0.80
# - misc      : 0

8000, azelow, azelow, car, AZELOW, AZELOW, null, richfamily, 10, 0, 0, -1, 0.80, 0.80, 0
