# Append this line to data/carmods.dat (alphabetically inside its modshop group).
# Format: <handling_name>, comma-separated list of upgrade-component names.
# These are the parts the car can wear at the Transfender / Loco Low Co / Wheel
# Arch Angels modshops. Lift to your taste — these are sane defaults inherited
# from STALLION (4-door style upgrades).

azelow, bnt_b_sc_l, bnt_b_sc_m, nto_b_l, nto_b_s, nto_b_tw, rf_b_sc_r, spl_b_bbr_m, spl_b_mar_m
