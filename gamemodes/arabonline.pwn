	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /setfvehiclemodel [«·„ÊœÌ·]" ) ;
