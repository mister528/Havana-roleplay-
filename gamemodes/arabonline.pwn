cmd:pgun(playerid, param[])
{
    if(GetPVarInt(playerid, "on_dmarena")) return 1;
    if(GetPVarInt(playerid, "on_dmarena1")) return 1;
    if ( TeamPaint[playerid] != 0 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì’Ì— Ê√‰  „‘«—ﬂ ›Ì «·»Ì‰  »Ê·." ) ;
	if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— «·»Ìﬂ √» ›Êﬁ «·√”·Õ… »Ì‰„« „”ÃÊ‰.") ;
	if(p_t_info [ playerid ] [ mp_tp ] == 1) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— «·»Ìﬂ √» ›Êﬁ «·√”·Õ… ·„« √‰  ›Ì  «·ÕœÀ.") ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER || GetPlayerState ( playerid ) == PLAYER_STATE_PASSENGER) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ— «· ﬁ«ÿ «·√”·Õ… ›Ì ”Ì«—…." ) ;
	if ( IsPlayerToSquare ( playerid, 80.8047, 1762.5040, 390.7005, 2093.4778 ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ—  Ã„⁄ «·√”·Õ… ›Ì Â–« «·„ﬂ«‰." ) ;
    PickUpAGun(playerid);
    return 1;
}
PickUpAGun(playerid)
{
    new Float:x, Float:y, Float:z;
    for(new i;i<MAX_DGUNS;i++)
    {
        if(dguns[i]!=-1)
        {
            GetDynamicObjectPos(dguns[i],x,y,z);
            if(IsPlayerInRangeOfPoint(playerid,2,x,y,z))
            {
                new string[89];
                DestroyDynamicObject(dguns[i]);
                DestroyDynamic3DTextLabel(DgunText[i]);
                dguns[i]= -1;
                ApplyAnimation(playerid, "BOMBER","BOM_Plant_Crouch_In", 4.0, 0, 0, 0, 0, 0, 1);
                give_weapon(playerid, dgunn[i],dpatrons[i]);
                format(string,sizeof(string),"{"#cGN"}* {ffffff}√‰  picked ›Êﬁ %s[%d].",GunNames[dgunn[i]],dpatrons[i]);
                SendClientMessage(playerid,-1,string);
                format(string,sizeof(string),"{"#cGN"}* {ffffff}Picked ›Êﬁ '%s' „‰ ground",GunNames[dgunn[i]]);
                SetPlayerChatBubble(playerid, string, 0xDD90FFFF, 10.0, 5000);
                dpatrons[i]=-1;
                dgunn[i]=-1;
                return 1;
            }
        }
    }
    return true;
}

