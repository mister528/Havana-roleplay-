CMD:spcar(playerid, params[])
{
	if ( p_info [ playerid ] [ admin ] < 8 )return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ’·«ÕÌ«  ﬂ«›Ì…." ) ;
	if ( sscanf ( params, "d", params[0] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /spcar [«·‰ÿ«ﬁ]");
	if ( params [ 0 ] < 1 || params [ 0 ] > 5000) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„„‰Ê⁄ √ﬁ· „‰ 1 Ê√ﬂÀ— „‰ 5000.");

	for(new i = 0; i < MAX_VEHICLES; i++)
	{
		if ( ! IsValidVehicle ( i ) ) continue ;
		if ( GetVehicleModel ( i ) == 450 ) continue ;

		new Float:v_pos_x,
			Float:v_pos_y,
			Float:v_pos_z ;
		GetVehiclePos ( i, v_pos_x, v_pos_y, v_pos_z ) ;

		if ( ! IsPlayerInRangeOfPoint ( playerid, params[0], v_pos_x, v_pos_y, v_pos_z ) ) continue ;
		AC_SetVehicleToRespawn ( i );
	}
	new _t_string [ 120 ] ;
	format ( _t_string, sizeof ( _t_string ), "{"#cBL"}*  {"#cGR"}≈œ«—Ì %s ⁄‰œ  „  ÕœÌÀÂ ”Ì«—… within  radius „‰ %d m.", p_info [ playerid ] [ name ], params [ 0 ] ) ;
 	foreach(new i: admin_players)SendClientMessage ( i, col_gray, _t_string ) ;
	return 1;
}
