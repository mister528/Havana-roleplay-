		format ( global_string, 1028, "{"#cGR"}«·«”„:    {"#cWH"}%s\n{"#cGR"} :  {"#cWH"}%d\n{"#cGR"}:   {"#cWH"}%d\n{"#cGR"} :   {"#cWH"}%d  %d\n{"#cGR"} :  {"#cWH"}%d\n{"#cGR"}  :  {"#cWH"}%d\n\n{"#cGR"} :  {"#cWH"}%d\n\n{"#cGR"}:    {"#cWH"}%s\n{"#cGR"}:   {"#cWH"}%s\n{"#cGR"}:   {"#cWH"}%s\n{"#cGR"}:    {"#cWH"}%s\n{"#cGR"}:   {"#cWH"}%s\n{"#cGR"}:   {"#cWH"}%s\n\n",

