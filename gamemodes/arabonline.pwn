// Cityhall: destroys any dynamic pickup / 3D text label that overlaps the
// hotel marker (within 5 units), excluding our own entrance/exit markers.
// Runs once a few seconds after gamemode init so async biz/house loaders
// have already created their pickups.
forward cityhall_clean_overlapping();
public cityhall_clean_overlapping()
{
	new _chmax_p = Streamer_GetUpperBound(STREAMER_TYPE_PICKUP);
	new _chpi = 0;
	while (_chpi <= _chmax_p)
	{
		if (IsValidDynamicPickup(_chpi) && _chpi != g_cityhall_marker_pickup && _chpi != g_cityhall_exit_pickup)
		{
			new Float:px, Float:py, Float:pz;
			Streamer_GetFloatData(STREAMER_TYPE_PICKUP, _chpi, E_STREAMER_X, px);
			Streamer_GetFloatData(STREAMER_TYPE_PICKUP, _chpi, E_STREAMER_Y, py);
			Streamer_GetFloatData(STREAMER_TYPE_PICKUP, _chpi, E_STREAMER_Z, pz);
			new Float:dx = px - 1286.325439;
			new Float:dy = py - (-1329.243041);
			new Float:dz = pz - 13.552773;
			if (dx * dx + dy * dy + dz * dz < 25.0)
			{
				pick_info [ _chpi ] [ pick_type ] = 0;
				DestroyDynamicPickup(_chpi);
			}
		}
		_chpi = _chpi + 1;
	}
	new _chmax_l = Streamer_GetUpperBound(STREAMER_TYPE_3D_TEXT_LABEL);
	new _chli = 0;
	while (_chli <= _chmax_l)
	{
		if (IsValidDynamic3DTextLabel(Text3D:_chli))
		{
			new Float:lx, Float:ly, Float:lz;
			Streamer_GetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, _chli, E_STREAMER_X, lx);
			Streamer_GetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, _chli, E_STREAMER_Y, ly);
			Streamer_GetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, _chli, E_STREAMER_Z, lz);
			new Float:our_dx = lx - 1286.325439;
			new Float:our_dy = ly - (-1329.243041);
			new Float:exit_dx = lx - (-1840.394897);
			new Float:exit_dy = ly - 2670.519531;
			new _is_ours = 0;
			if (our_dx * our_dx + our_dy * our_dy < 0.01) _is_ours = 1;
			if (exit_dx * exit_dx + exit_dy * exit_dy < 0.01) _is_ours = 1;
			if (!_is_ours)
			{
				new Float:ddx = lx - 1286.325439;
				new Float:ddy = ly - (-1329.243041);
				new Float:ddz = lz - 14.552773;
				if (ddx * ddx + ddy * ddy + ddz * ddz < 25.0)
				{
					DestroyDynamic3DTextLabel(Text3D:_chli);
				}
			}
		}
		_chli = _chli + 1;
	}
	return 1;
}

public OnGameModeExit()
{
	for ( new i = 0 ; i < MAX_PLAYERS ; i ++ )
	{
		NpcTest_Destroy(i);
		if ( g_flight_job_vehicle[i] != INVALID_VEHICLE_ID ) AC_DestroyVehicle(g_flight_job_vehicle[i]);
	}
	mysql_close(sql_connection) ;
	return 1;
}

