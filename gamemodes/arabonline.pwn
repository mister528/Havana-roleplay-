		mtime ,
		mreason [ MAX_PLAYER_NAME ];
	if ( sscanf ( params, "s[24]ds[32]", mname, mtime,mreason ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /offmute [«·«”„] [œﬁÌﬁ…] [«·”»»]" ) ;
	if ( ! ( 0 < mtime <= 180 ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}Êﬁ  «·ﬂ „ ·«“„ „« ÌﬂÊ‰ √ﬁ· „‰ 1 Ê·« √ﬂÀ— „‰ 180 œﬁÌﬁ…." ) ;

	new sql_string [ 50 + MAX_PLAYER_NAME ] ;
	format ( sql_string, sizeof sql_string, "SELECT * FROM `users` WHERE `u_name` = '%s' LIMIT 1", mname ) ;
	mysql_tquery ( sql_connection, sql_string, "offmute_check_callback", "isds", playerid, mname, mtime,mreason ) ;
	return 1 ;
}

CMD:mutelist(playerid, params[])
{
	if ( p_info [ playerid ] [ admin ] < 2 )return 1 ;
	new rows_amount ;
	foreach(new i: logged_players)
	{
		if ( p_info [ i ] [ mute ] )
		{
			new scm_string [ 92 ] ;
			format ( scm_string, sizeof ( scm_string  ), "%s[%i] | %d ().", p_info [ i ] [ name ], i, p_info [ i ] [ mute ] ) ;
			SendClientMessage ( playerid, col_white, scm_string ) ;
			rows_amount ++ ;
		}
	}
	new scm_string [ 48 ] ;
	format ( scm_string, sizeof ( scm_string  ), " : %d.", rows_amount ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;
	return 1 ;
}

CMD:skick( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /skick [ID]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» „«  „ «·⁄ÀÊ— ⁄·ÌÂ." ) ;
	
	if(p_info[params[0]][id] == 1) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— ÿ—œ Â–« «·”Ã‰." ) ;

	
	
	new scm_string [ 128 ] ;
	format( scm_string, sizeof ( scm_string  ), "{"#cBL"}*  {"#cGR"}%s[%d]    %s[%d].", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_gray, scm_string ) ;
	
	format(scm_string, 128, "[SKICK] %s  %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ]);
	WriteLog(TYPE_LOG_KICK, scm_string);
	kick_player ( params [ 0 ] ) ;
 	return 1;
}

