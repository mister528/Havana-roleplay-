				    if ( p_info [ playerid ] [ member ] > 0 && is_fraction_duty { playerid } )
					{
						format( _t_string, sizeof ( _t_string ), "- %s {%06x}(%s) [%d]", p_info[playerid][Bind_1], GetPlayerColor(playerid) >>> 8, p_info [ playerid ] [ name ], playerid ) ;
						format( t_string, sizeof ( t_string ), "- %s {%06x}(%s)", p_info[playerid][Bind_1], GetPlayerColor(playerid) >>> 8, p_info [ playerid ] [ name ] ) ;
