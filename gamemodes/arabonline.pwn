// =========================================================
// ================ ARENA SURVIVAL JOB =====================
// =========================================================

public OnPlayerGiveDamageActor(playerid, damaged_actorid, Float:amount, weaponid, bodypart)
{
    #pragma unused weaponid, bodypart
    if (!g_arena_active[playerid]) return 1;
    new slot = -1;
    for (new i = 0; i < ARENA_MAX_SLOTS; i++)
        if (g_arena_enemy[playerid][i] == damaged_actorid) { slot = i; break; }
    if (slot == -1) return 1;
    g_arena_enemy_hp[playerid][slot] -= amount;
    if (g_arena_enemy_hp[playerid][slot] <= 0.0)
    {
        new aid = g_arena_enemy[playerid][slot];
        if (IsValidActor(aid)) DestroyActor(aid);
        if (g_arena_enemy_label[playerid][slot]) { DestroyDynamic3DTextLabel(g_arena_enemy_label[playerid][slot]); g_arena_enemy_label[playerid][slot] = STREAMER_TAG_3D_TEXT_LABEL:0; }
        RemovePlayerMapIcon(playerid, 20 + slot);
        g_arena_enemy[playerid][slot] = INVALID_ACTOR_ID;
        g_arena_enemy_hp[playerid][slot] = 0.0;
        g_arena_kills[playerid]++;
        g_arena_wave_killed[playerid]++;
        new wave_targets[3] = {10, 30, 50};
        new w = g_arena_wave[playerid];
        if (w < 1) w = 1;
        if (w > 3) w = 3;
        new wave_target = wave_targets[w - 1];
        new msg[96];
        format(msg, sizeof(msg), "[«·”«Õ…] „ÊÃ… %d  -  «·ﬁ · %d / %d  («·„Ã„Ê⁄: %d/90)", w, g_arena_wave_killed[playerid], wave_target, g_arena_kills[playerid]);
        SendClientMessage(playerid, 0xFFFF00FF, msg);
        if (g_arena_wave_killed[playerid] >= wave_target)
        {
            if (w >= 3)
            {
                arena_end_win(playerid);
                return 1;
            }
            new old_wave = w;
            g_arena_wave[playerid] = w + 1;
            g_arena_wave_spawned[playerid] = 0;
            g_arena_wave_killed[playerid] = 0;
            if (old_wave == 1)
            {
                SetPlayerHealth(playerid, 100.0);
                set_armour(playerid, 100.0);
                GameTextForPlayer(playerid, "~g~+100 ’Õ…  ~w~+  ~b~+100 œ—⁄~n~~y~„ÊÃ… 1 COMPLETE!", 4000, 3);
                SendClientMessage(playerid, 0x00FF00FF, "[«·”«Õ…] «·„ÊÃ… 1 Œ·’ ! «·’Õ… Ê«·œ—⁄ « ⁄«œ·Ê« »«·ﬂ«„·.");
            }
            else if (old_wave == 2)
            {
                new ammo = 2 + random(2);
                give_weapon(playerid, 35, ammo);
                new rpg_msg[128];
                format(rpg_msg, sizeof(rpg_msg), "~g~„ÊÃ… 2 COMPLETE!~n~~r~+RPG ~w~„⁄ ~y~%d ’Ê«—ÌŒ", ammo);
                GameTextForPlayer(playerid, rpg_msg, 4000, 3);
                new chat_msg[96];
                format(chat_msg, sizeof(chat_msg), "[«·”«Õ…] „ÊÃ… 2 «ﬂ „· ! «” ·„   RPG „⁄ %d ’Ê«—ÌŒ.", ammo);
                SendClientMessage(playerid, 0x00FF00FF, chat_msg);
            }
            new next_msg[96];
            format(next_msg, sizeof(next_msg), "[«·”«Õ…] „ÊÃ… %d ﬁ«œ„…!", g_arena_wave[playerid]);
            SendClientMessage(playerid, 0xFF5555FF, next_msg);
            SetTimerEx("arena_spawn_wave", 2000, false, "i", playerid);
        }
        else
        {
            SetTimerEx("arena_spawn_wave", 500, false, "i", playerid);
        }
    }
    return 1;
}

public arena_spawn_wave(playerid)
{
    if (!g_arena_active[playerid]) return 1;
    if (!IsPlayerConnected(playerid)) return 1;
    new wave_targets[3] = {10, 30, 50};
    new w = g_arena_wave[playerid];
    if (w < 1) { w = 1; g_arena_wave[playerid] = 1; g_arena_wave_spawned[playerid] = 0; g_arena_wave_killed[playerid] = 0; }
    if (w > 3) w = 3;
    new wave_target = wave_targets[w - 1];
    new remaining = wave_target - g_arena_wave_spawned[playerid];
    if (remaining <= 0) return 1;
    new Float:hp, gun_chance;
    if (w == 1) { hp = 70.0;  gun_chance = 0;  }
    else if (w == 2) { hp = 85.0;  gun_chance = 40; }
    else { hp = 100.0; gun_chance = 80; }
    new skins[16] = {46, 47, 73, 107, 111, 120, 127, 167, 173, 179, 181, 230, 247, 249, 259, 294};
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(playerid, px, py, pz);
    new spawned_now = 0;
    for (new i = 0; i < ARENA_MAX_SLOTS; i++)
    {
        if (spawned_now >= remaining) break;
        if (g_arena_enemy[playerid][i] != INVALID_ACTOR_ID) continue;
        new Float:radius = 8.0 + float(random(6));
        new Float:ang = float(random(360));
        new Float:ex = px + floatmul(radius, floatsin(-ang, degrees));
        new Float:ey = py + floatmul(radius, floatcos(-ang, degrees));
        new Float:ez = pz;
        if (ex > ARENA_FIGHT_X + 110.0) ex = ARENA_FIGHT_X + 110.0;
        if (ex < ARENA_FIGHT_X - 110.0) ex = ARENA_FIGHT_X - 110.0;
        if (ey > ARENA_FIGHT_Y + 110.0) ey = ARENA_FIGHT_Y + 110.0;
        if (ey < ARENA_FIGHT_Y - 110.0) ey = ARENA_FIGHT_Y - 110.0;
        new skin = skins[random(sizeof(skins))];
        new aid = CreateActor(skin, ex, ey, ez, 0.0);
        if (aid == INVALID_ACTOR_ID) continue;
        SetActorInvulnerable(aid, 0);
        SetActorHealth(aid, hp);
        g_arena_enemy[playerid][i] = aid;
        g_arena_enemy_hp[playerid][i] = hp;
        g_arena_enemy_state[playerid][i] = 0;
        g_arena_enemy_z[playerid][i] = ez;
        g_arena_atk_cd[playerid][i] = 2 + random(4);
        g_arena_enemy_gun[playerid][i] = (random(100) < gun_chance) ? 1 : 0;
        g_arena_enemy_label[playerid][i] = CreateDynamic3DTextLabel("{FF0000}Âœ›\n{FFFFFF}v", 0xFF0000FF, ex, ey, ez + 1.3, 60.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1, playerid, 50.0);
        SetPlayerMapIcon(playerid, 20 + i, ex, ey, ez, 0, 0xFF0000FF, MAPICON_LOCAL);
        g_arena_wave_spawned[playerid]++;
        spawned_now++;
    }
    if (spawned_now > 0)
    {
        new wmsg[96];
        format(wmsg, sizeof(wmsg), "[«·”«Õ…] „ÊÃ… %d  -  %d √⁄œ«¡ ŸÂ—Ê« (%d / %d)", w, spawned_now, g_arena_wave_spawned[playerid], wave_target);
        SendClientMessage(playerid, 0xFF5555FF, wmsg);
    }
    return 1;
}

public arena_ai_tick(playerid)
{
    if (!g_arena_active[playerid]) return 1;
    if (!IsPlayerConnected(playerid)) { arena_cleanup(playerid, 0); return 1; }
    new Float:ph;
    GetPlayerHealth(playerid, ph);
    if (ph <= 0.0) return 1;
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(playerid, px, py, pz);
    // Grace period: skip the out-of-zone check for the first 3 seconds
    // so the SetPlayerPos teleport into the fight area has time to commit
    // before the first AI tick runs.
    if (GetTickCount() - g_arena_start_tick[playerid] > 3000)
    {
        if (floatabs(pz - ARENA_FIGHT_Z) > 80.0 || floatabs(px - ARENA_FIGHT_X) > 120.0 || floatabs(py - ARENA_FIGHT_Y) > 120.0)
        {
            SendClientMessage(playerid, 0xFF5555FF, "[«·”«Õ…] €«œ—   √Õ„— «·„‰ÿﬁ…. ›‘·  «·„Â„…!");
            arena_cleanup(playerid, 1);
            return 1;
        }
    }
    if (GetTickCount() - g_arena_bonus_tick[playerid] > 60000)
    {
        if (g_arena_bonus_pickup[playerid] > 0)
        {
            DestroyDynamicPickup(g_arena_bonus_pickup[playerid]);
            g_arena_bonus_pickup[playerid] = -1;
            RemovePlayerMapIcon(playerid, 19);
        }
        new Float:bang = float(random(360));
        new Float:brad = 8.0 + float(random(18));
        new Float:bx = px + floatmul(brad, floatsin(-bang, degrees));
        new Float:by = py + floatmul(brad, floatcos(-bang, degrees));
        if (bx > ARENA_FIGHT_X + 100.0) bx = ARENA_FIGHT_X + 100.0;
        if (bx < ARENA_FIGHT_X - 100.0) bx = ARENA_FIGHT_X - 100.0;
        if (by > ARENA_FIGHT_Y + 100.0) by = ARENA_FIGHT_Y + 100.0;
        if (by < ARENA_FIGHT_Y - 100.0) by = ARENA_FIGHT_Y - 100.0;
        g_arena_bonus_pickup[playerid] = CreateDynamicPickup(1239, 1, bx, by, pz, 0, 0, playerid, 300.0);
        g_arena_bonus_tick[playerid] = GetTickCount();
        SetPlayerMapIcon(playerid, 19, bx, by, pz, 23, 0xFFFF00FF, MAPICON_LOCAL);
        SendClientMessage(playerid, 0xFFFF00FF, "[«·”«Õ…] «·„ﬂ«›√…ø «·»Ìﬂ √» ŸÂ— ⁄·Ï Œ—Ìÿ ﬂ! Œ–Â!");
    }
    new w = g_arena_wave[playerid];
    if (w < 1) w = 1; if (w > 3) w = 3;
    new Float:wave_dmg_melee = (w == 1) ? 2.0 : (w == 2) ? 2.5 : 3.5;
    new Float:wave_dmg_gun = (w == 1) ? 0.0 : (w == 2) ? 5.0 : 7.0;
    new cur_tick = GetTickCount();
    for (new i = 0; i < ARENA_MAX_SLOTS; i++)
    {
        new aid = g_arena_enemy[playerid][i];
        if (aid == INVALID_ACTOR_ID) continue;
        if (!IsValidActor(aid)) { g_arena_enemy[playerid][i] = INVALID_ACTOR_ID; continue; }
        new is_gun = g_arena_enemy_gun[playerid][i];
        new Float:ax, Float:ay, Float:az;
        GetActorPos(aid, ax, ay, az);
        new Float:dx = px - ax, Float:dy = py - ay;
        new Float:dist2d = floatsqroot(dx * dx + dy * dy);
        new Float:heading = 180.0 - atan2(ax - px, ay - py);
        while (heading < 0.0) heading += 360.0;
        while (heading >= 360.0) heading -= 360.0;
        if (g_arena_enemy_label[playerid][i])
        {
            Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, _:g_arena_enemy_label[playerid][i], E_STREAMER_X, ax);
            Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, _:g_arena_enemy_label[playerid][i], E_STREAMER_Y, ay);
            Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, _:g_arena_enemy_label[playerid][i], E_STREAMER_Z, az + 1.3);
        }
        SetPlayerMapIcon(playerid, 20 + i, ax, ay, az, 0, 0xFF0000FF, MAPICON_LOCAL);
        new Float:ground_z = g_arena_enemy_z[playerid][i];
        if (ground_z <= 0.0) ground_z = pz;
        if (floatabs(pz - ground_z) < 4.0) ground_z = ground_z + (pz - ground_z) * 0.20;
        g_arena_enemy_z[playerid][i] = ground_z;
        new Float:stop_dist = is_gun ? 10.0 : 1.5;
        if (dist2d > stop_dist)
        {
            new desired_state;
            new Float:step;
            if (is_gun && dist2d < 16.0)      { desired_state = 1; step = 0.09; }
            else if (dist2d > 22.0)            { desired_state = 3; step = 0.42; }
            else if (dist2d > 8.0)             { desired_state = 2; step = 0.28; }
            else                                { desired_state = 1; step = 0.09; }
            if (step > dist2d) step = dist2d;
            new Float:nx = ax + step * (dx / dist2d);
            new Float:ny = ay + step * (dy / dist2d);
            SetActorFacingAngle(aid, heading);
            SetActorPos(aid, nx, ny, ground_z);
            if (g_arena_enemy_state[playerid][i] != desired_state)
            {
                ClearActorAnimations(aid);
                switch (desired_state)
                {
                    case 1:
                    {
                        if (is_gun) ApplyActorAnimation(aid, "PED", "WALK_armed", 4.1, 1, 1, 1, 1, 0);
                        else ApplyActorAnimation(aid, "PED", "WALK_civi", 4.1, 1, 1, 1, 1, 0);
                    }
                    case 2: ApplyActorAnimation(aid, "PED", "run_civi", 4.1, 1, 1, 1, 1, 0);
                    case 3: ApplyActorAnimation(aid, "PED", "sprint_civi", 4.1, 1, 1, 1, 1, 0);
                }
                g_arena_enemy_state[playerid][i] = desired_state;
            }
            g_arena_atk_cd[playerid][i] = cur_tick + 300;
        }
        else
        {
            // In attack range: force-sync facing each tick by re-applying position
            // and facing angle; also re-apply the attack animation when the heading
            // drifts enough so the actor visually rotates to track the player.
            new Float:prev_heading = g_arena_enemy_hdg[playerid][i];
            new Float:hdiff = heading - prev_heading;
            while (hdiff > 180.0) hdiff -= 360.0;
            while (hdiff < -180.0) hdiff += 360.0;
            new bool:need_reapply = (g_arena_enemy_state[playerid][i] != 4) || (floatabs(hdiff) > 12.0);
            SetActorFacingAngle(aid, heading);
            SetActorPos(aid, ax, ay, ground_z);
            if (need_reapply)
            {
                ClearActorAnimations(aid);
                if (is_gun) ApplyActorAnimation(aid, "PED", "Idle_Gang1", 4.1, 1, 0, 0, 0, 0);
                else ApplyActorAnimation(aid, "PED", "IDLE_tired", 4.1, 1, 0, 0, 0, 0);
                g_arena_enemy_state[playerid][i] = 4;
                g_arena_enemy_hdg[playerid][i] = heading;
            }
            if (cur_tick >= g_arena_atk_cd[playerid][i])
            {
                new hit = 1;
                ClearActorAnimations(aid);
                if (is_gun)
                {
                    ApplyActorAnimation(aid, "PYTHON", "PYTHON_fire", 4.1, 0, 1, 1, 1, 0);
                    PlayerPlaySound(playerid, 1159, ax, ay, az);
                    new acc = (w == 2) ? 55 : 70;
                    hit = (random(100) < acc) ? 1 : 0;
                    g_arena_atk_cd[playerid][i] = cur_tick + 1600;
                }
                else
                {
                    ApplyActorAnimation(aid, "KNIFE", "KILL_Knife_Ped_Damage", 4.1, 0, 1, 1, 1, 0);
                    g_arena_atk_cd[playerid][i] = cur_tick + 1200;
                }
                // Mark state so we re-enter the idle branch (and re-sync facing)
                // after the attack windup.
                g_arena_enemy_state[playerid][i] = 4;
                g_arena_enemy_hdg[playerid][i] = heading;
                if (hit)
                {
                    new Float:arm;
                    GetPlayerArmour(playerid, arm);
                    new Float:dmg = is_gun ? wave_dmg_gun : wave_dmg_melee;
                    if (arm > 0.0)
                    {
                        new Float:rem = dmg;
                        new Float:take_arm = (arm >= rem) ? rem : arm;
                        set_armour(playerid, arm - take_arm);
                        rem -= take_arm;
                        if (rem > 0.0)
                        {
                            new Float:nh = ph - rem;
                            if (nh < 0.0) nh = 0.0;
                            SetPlayerHealth(playerid, nh);
                            ph = nh;
                        }
                    }
                    else
                    {
                        new Float:nh = ph - dmg;
                        if (nh < 0.0) nh = 0.0;
                        SetPlayerHealth(playerid, nh);
                        ph = nh;
                    }
                }
            }
        }
    }
    return 1;
}

public arena_end_win(playerid)
{
    give_money(playerid, ARENA_REWARD);
    SetPlayerWantedLevel(playerid, 5);
    g_arena_last_play[playerid] = GetTickCount();
    g_arena_cd_ms[playerid] = ARENA_COOLDOWN_MS;
    SendClientMessage(playerid, 0x00FF00FF, "[«·”«Õ…] ›“ ! ‰ÃÕ  ›Ì ≈‰Â«¡ ﬂ· 3 „ÊÃ«  Êﬂ”»  $500,000!");
    SendClientMessage(playerid, 0xFFFF00FF, "[«·”«Õ…]  ﬁœ— ·⁄» „—… À«‰Ì… ›Ì 3 ”«⁄« .");
    SendClientMessage(playerid, 0xFF5555FF, "[«·”«Õ…] ﬂ”»  „” ÊÏ „ÿ·Ê» 5 ‰ÃÊ„! «·‘—ÿ… Ê—«ﬂ.");
    arena_cleanup(playerid, 1);
    return 1;
}

public arena_cleanup(playerid, const teleport_back)
{
    // Loss cooldown: 30 minutes. arena_end_win sets g_arena_cd_ms to
    // ARENA_COOLDOWN_MS right before calling us, so we only stamp the
    // shorter length when it wasn't a ›Ê“ (the just_won guard keeps
    // the 3-hour cooldown intact).
    if (teleport_back && g_arena_active[playerid])
    {
        new bool:just_won = (g_arena_cd_ms[playerid] == ARENA_COOLDOWN_MS
                             && g_arena_last_play[playerid] > 0
                             && GetTickCount() - g_arena_last_play[playerid] < 2000);
        if (!just_won)
        {
            g_arena_last_play[playerid] = GetTickCount();
            g_arena_cd_ms[playerid] = ARENA_LOSS_COOLDOWN_MS;
            if (IsPlayerConnected(playerid))
                SendClientMessage(playerid, 0xFFAA00FF, "[«·”«Õ…]  ﬁœ— Õ«Ê· „—… À«‰Ì… ›Ì 30 œﬁÌﬁ….");
        }
    }
    if (g_arena_bonus_pickup[playerid] > 0)
    {
        DestroyDynamicPickup(g_arena_bonus_pickup[playerid]);
        g_arena_bonus_pickup[playerid] = -1;
        RemovePlayerMapIcon(playerid, 19);
    }
    g_arena_active[playerid] = 0;
    g_arena_kills[playerid] = 0;
    g_arena_wave[playerid] = 0;
    g_arena_wave_spawned[playerid] = 0;
    g_arena_wave_killed[playerid] = 0;
    if (g_arena_zone != -1 && IsPlayerConnected(playerid)) GangZoneHideForPlayer(playerid, g_arena_zone);
    for (new i = 0; i < ARENA_MAX_SLOTS; i++)
    {
        new aid = g_arena_enemy[playerid][i];
        if (aid != INVALID_ACTOR_ID && IsValidActor(aid)) DestroyActor(aid);
        if (g_arena_enemy_label[playerid][i]) { DestroyDynamic3DTextLabel(g_arena_enemy_label[playerid][i]); g_arena_enemy_label[playerid][i] = STREAMER_TAG_3D_TEXT_LABEL:0; }
        if (IsPlayerConnected(playerid)) RemovePlayerMapIcon(playerid, 20 + i);
        g_arena_enemy[playerid][i] = INVALID_ACTOR_ID;
        g_arena_enemy_hp[playerid][i] = 0.0;
        g_arena_enemy_state[playerid][i] = 0;
        g_arena_enemy_z[playerid][i] = 0.0;
        g_arena_atk_cd[playerid][i] = 0;
        g_arena_enemy_gun[playerid][i] = 0;
    }
    if (g_arena_timer[playerid] > 0)
    {
        KillTimer(g_arena_timer[playerid]);
        g_arena_timer[playerid] = 0;
    }
    if (teleport_back && IsPlayerConnected(playerid))
    {
        reset_player_weapon(playerid);
        // Respawn 10 m in front of the Arena entry NPC (CJ) so the player
        // never clips into the actor. Player faces the NPC.
        new Float:rb_dist = 10.0;
        new Float:rb_x = ARENA_ENTRY_X + floatmul(rb_dist, floatsin(-ARENA_ENTRY_A, degrees));
        new Float:rb_y = ARENA_ENTRY_Y + floatmul(rb_dist, floatcos(-ARENA_ENTRY_A, degrees));
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        SetPlayerPos(playerid, rb_x, rb_y, ARENA_ENTRY_Z);
        SetPlayerFacingAngle(playerid, floatadd(ARENA_ENTRY_A, 180.0));
        SetCameraBehindPlayer(playerid);
        SetPlayerHealth(playerid, 100.0);
        set_armour(playerid, 0.0);
    }
    return 1;
}




// ==================== Car-Rental Office: implementation ====================

stock trent_init()
{
    for (new i = 0; i < TRENT_MAX; i++)
    {
        g_trent_vehid[i]       = INVALID_VEHICLE_ID;
        g_trent_owner[i]       = INVALID_PLAYER_ID;
        g_trent_expire_tick[i] = 0;
        g_trent_model_idx[i]   = -1;
        g_trent_hidden[i]      = false;
        g_trent_pinned[i]      = false;
        g_trent_tag[i]         = Text3D:INVALID_3DTEXT_ID;
    }
    for (new p = 0; p < MAX_PLAYERS; p++)
    {
        g_trent_sel_car[p]  = -1;
        g_trent_sel_dur[p]  = -1;
        g_trent_sel_slot[p] = -1;
        g_trent_prev_vid[p]   = INVALID_VEHICLE_ID;
        g_trent_prev_int[p]   = 0;
        g_trent_prev_vw[p]    = 0;
        g_trent_prev_timer[p] = -1;
        g_trent_prev_rot[p]   = 0;
    }
    g_trent_building_obj = CreateObject(1684, TRENT_BUILDING_X, TRENT_BUILDING_Y, TRENT_BUILDING_Z, 0.0, 0.0, TRENT_BUILDING_A);
    g_trent_actor        = CreateActor(147, TRENT_ACTOR_X, TRENT_ACTOR_Y, TRENT_ACTOR_Z, TRENT_ACTOR_A);
    SetActorInvulnerable(g_trent_actor, true);
    ApplyActorAnimation(g_trent_actor, "DEALER", "shop_pay", 4.1, 1, 0, 0, 1, 0);

    g_trent_pickup    = CreateDynamicPickup(1273, 1, TRENT_PICKUP_X, TRENT_PICKUP_Y, TRENT_PICKUP_Z);
    g_trent_ent_label = CreateDynamic3DTextLabel("{FFC04A}„ﬂ » ≈ÌÃ«— ”Ì«—« ",
        0xFFC04AFF, TRENT_PICKUP_X, TRENT_PICKUP_Y, TRENT_PICKUP_Z + 1.6, 50.0,
        INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
    g_trent_cp        = CreateDynamicCP(TRENT_CP_X, TRENT_CP_Y, TRENT_CP_Z, TRENT_CP_SIZE, 0, 0, -1, 30.0);
    CreateDynamicMapIcon(TRENT_PICKUP_X, TRENT_PICKUP_Y, TRENT_PICKUP_Z, 55, 0, 0, 0, -1, 400.0);
    return 1;
}

stock trent_find_by_vehid(vehid)
{
    if (vehid <= 0 || vehid == INVALID_VEHICLE_ID) return -1;
    for (new i = 0; i < TRENT_MAX; i++)
        if (g_trent_vehid[i] == vehid) return i;
    return -1;
}

stock trent_free_slot()
{
    for (new i = 0; i < TRENT_MAX; i++)
        if (g_trent_vehid[i] == INVALID_VEHICLE_ID) return i;
    return -1;
}

stock trent_count_player(playerid)
{
    new n = 0;
    for (new i = 0; i < TRENT_MAX; i++)
        if (g_trent_vehid[i] != INVALID_VEHICLE_ID && g_trent_owner[i] == playerid) n++;
    return n;
}

stock trent_player_slot_n(playerid, n)
{
    new k = 0;
    for (new i = 0; i < TRENT_MAX; i++)
    {
        if (g_trent_vehid[i] != INVALID_VEHICLE_ID && g_trent_owner[i] == playerid)
        {
            if (k == n) return i;
            k++;
        }
    }
    return -1;
}

stock trent_format_remaining(ms_left, buf[], size)
{
    if (ms_left < 0) ms_left = 0;
    new sec = ms_left / 1000;
    new d   = sec / 86400;
    new h   = (sec % 86400) / 3600;
    new m   = (sec % 3600) / 60;
    new s   = sec % 60;
    if (d > 0)      format(buf, size, "%dd %dh %dm", d, h, m);
    else if (h > 0) format(buf, size, "%dh %dm %ds", h, m, s);
    else            format(buf, size, "%dm %ds", m, s);
    return 1;
}

stock trent_update_label(slot)
{
    if (slot < 0 || slot >= TRENT_MAX) return 0;
    if (g_trent_vehid[slot] == INVALID_VEHICLE_ID) return 0;
    new left_ms = g_trent_expire_tick[slot] - GetTickCount();
    new rem[48];
    trent_format_remaining(left_ms, rem, sizeof(rem));
    new owner_name[MAX_PLAYER_NAME+1];
    if (IsPlayerConnected(g_trent_owner[slot])) GetPlayerName(g_trent_owner[slot], owner_name, sizeof(owner_name));
    else format(owner_name, sizeof(owner_name), "«··«⁄»");
    new txt[160];
    format(txt, sizeof(txt), "{FFAA00}[ «·≈ÌÃ«— ] {FFFFFF}%s\n{AAAAAA}Ì‰ ÂÌ Œ·«· {FFFF00}%s", owner_name, rem);
    if (g_trent_tag[slot] != Text3D:INVALID_3DTEXT_ID)
        UpdateDynamic3DTextLabelText(g_trent_tag[slot], 0xFFAA00FF, txt);
    return 1;
}

stock trent_apply_hidden(slot)
{
    if (slot < 0 || slot >= TRENT_MAX) return 0;
    if (g_trent_vehid[slot] == INVALID_VEHICLE_ID) return 0;
    new vid = g_trent_vehid[slot];
    if (g_trent_hidden[slot])
    {
        // Move it under the map so it's effectively hidden without destroying.
        SetVehicleVirtualWorld(vid, 9000 + slot);
        if (g_trent_tag[slot] != Text3D:INVALID_3DTEXT_ID)
            Streamer_SetIntData(STREAMER_TYPE_3D_TEXT_LABEL, g_trent_tag[slot], E_STREAMER_WORLD_ID, 9000 + slot);
    }
    else
    {
        SetVehicleVirtualWorld(vid, 0);
        if (g_trent_tag[slot] != Text3D:INVALID_3DTEXT_ID)
            Streamer_SetIntData(STREAMER_TYPE_3D_TEXT_LABEL, g_trent_tag[slot], E_STREAMER_WORLD_ID, 0);
    }
    return 1;
}

stock trent_show_list(playerid)
{
    new body[900];
    strcat(body, "{FFFF00}«·”Ì«—…\t{FFFFFF}$ / ”«⁄…\n");
    for (new i = 0; i < TRENT_CAR_COUNT; i++)
    {
        new line[96];
        format(line, sizeof(line), "{FFFFFF}%s\t{00FF66}$%d\n", g_trent_name[i], g_trent_hour_price[i]);
        strcat(body, line);
    }
    show_dialog(playerid, d_trent_list, DIALOG_STYLE_TABLIST_HEADERS,
        "{FFA500} √ÃÌ— «·”Ì«—«  - «Œ — «·”Ì«—…", body, "«Œ Ì«—", "≈€·«ﬁ");
    return 1;
}

stock trent_show_durations(playerid)
{
    new car = g_trent_sel_car[playerid];
    if (car < 0 || car >= TRENT_CAR_COUNT) { trent_show_list(playerid); return 0; }
    new body[700];
    strcat(body, "{FFFF00}«·„œ…\t{FFFFFF}«·”⁄—\n");
    for (new i = 0; i < 7; i++)
    {
        new line[96];
        format(line, sizeof(line), "{FFFFFF}%s\t{00FF66}$%d\n",
            g_trent_dur_name[i], g_trent_hour_price[car] * g_trent_dur_mult[i]);
        strcat(body, line);
    }
    new title[80];
    format(title, sizeof(title), "{FFA500}«·≈ÌÃ«— %s - «Œ — «·„œ…", g_trent_name[car]);
    show_dialog(playerid, d_trent_duration, DIALOG_STYLE_TABLIST_HEADERS,
        title, body, "«Œ Ì«—", "—ÃÊ⁄");
    return 1;
}

stock trent_show_confirm(playerid)
{
    new car = g_trent_sel_car[playerid];
    new dur = g_trent_sel_dur[playerid];
    if (car < 0 || dur < 0) { trent_show_list(playerid); return 0; }
    new price = g_trent_hour_price[car] * g_trent_dur_mult[dur];
    new body[400];
    format(body, sizeof(body),
        "{FFFFFF}«·”Ì«—…:\t{FFFF00}%s\n\
{FFFFFF}«·„œ…:\t{FFFF00}%s\n\
{FFFFFF}«·”⁄—:\t{00FF66}$%d\n\n\
{AAAAAA}—«Õ  ŸÂ— «·”Ì«—… 10„ Œ·› «·„ﬂ ».\n\
{AAAAAA}—«Õ  ‰ ÂÌ  ·ﬁ«∆Ì« ⁄‰œ «‰ Â«¡ «·≈ÌÃ«—.\n\
{AAAAAA}„« Ì’Ì—  »«⁄ √Ê  ⁄œ·. «” Œœ„ {FFFF00}/timecar{AAAAAA} ·≈œ«— Â«.\n\n\
{FFFFFF} √ﬂÌœ «·≈ÌÃ«—ø",
        g_trent_name[car], g_trent_dur_name[dur], price);
    show_dialog(playerid, d_trent_confirm, DIALOG_STYLE_MSGBOX,
        "{FFA500} √ﬂÌœ «·≈ÌÃ«—", body, " √ﬂÌœ", "—ÃÊ⁄");
    return 1;
}

stock trent_do_rent(playerid)
{
    new car = g_trent_sel_car[playerid];
    new dur = g_trent_sel_dur[playerid];
    if (car < 0 || car >= TRENT_CAR_COUNT) return 0;
    if (dur < 0 || dur >= 7) return 0;

    if (trent_count_player(playerid) >= TRENT_MAX_PER_PLAYER)
    {
        show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{FF5555}„ƒÃ—",
            "{FFFFFF}Ê’·  «·Õœ «·√ﬁ’Ï „‰ «·≈ÌÃ«—«  «·‰‘ÿ….\n√—Ã⁄ Ê«Õœ… √Ê· ⁄‰ ÿ—Ìﬁ {FFFF00}/timecar{FFFFFF}.", "OK", "");
        return 0;
    }

    new price = g_trent_hour_price[car] * g_trent_dur_mult[dur];
    if (p_info[playerid][money] < price)
    {
        new m1[180];
        format(m1, sizeof(m1),
            "{FFFFFF}√‰  „Õ «Ã {FFFF00}$%d{FFFFFF} · √ÃÌ— Â–Ì «·”Ì«—….\n{FFAAAA}√‰  ›ﬁÿ ⁄‰œ {FFFF00}$%d{FFAAAA}.",
            price, p_info[playerid][money]);
        show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{FF5555}›·Ê” €Ì— ﬂ«›Ì…", m1, "OK", "");
        return 0;
    }

    new slot = trent_free_slot();
    if (slot < 0)
    {
        show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{FF5555}„ƒÃ—",
            "{FFFFFF}ﬂ· Œ«‰«  «·≈ÌÃ«— „‘€Ê·… Õ«·Ì«. Õ«Ê· »⁄œÌ‰.", "OK", "");
        return 0;
    }

    new vid = AC_CreateVehicle(g_trent_models[car], TRENT_SPAWN_X, TRENT_SPAWN_Y, TRENT_SPAWN_Z, TRENT_SPAWN_A, 1, 1, -1);
    if (vid == INVALID_VEHICLE_ID)
    {
        show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{FF5555}„ƒÃ—",
            "{FFFFFF}›‘· ≈·Ï ≈‰‘«¡  «·≈ÌÃ«— «·”Ì«—…. Õ«Ê· „—… À«‰Ì….", "OK", "");
        return 0;
    }

    veh_info[vid - 1][v_type]  = vehicle_type_job;
    veh_info[vid - 1][v_fuel]  = 100.0;
    veh_info[vid - 1][v_owner] = 0;
    SetVehicleNumberPlate(vid, "RENTAL");
    SetVehicleToRespawn(vid);
    SetVehiclePos(vid, TRENT_SPAWN_X, TRENT_SPAWN_Y, TRENT_SPAWN_Z);
    SetVehicleZAngle(vid, TRENT_SPAWN_A);

    g_trent_vehid[slot]       = vid;
    g_trent_owner[slot]       = playerid;
    g_trent_model_idx[slot]   = car;
    g_trent_expire_tick[slot] = GetTickCount() + g_trent_dur_hours[dur] * 3600 * 1000;
    g_trent_hidden[slot]      = false;
    g_trent_pinned[slot]      = false;
    g_trent_pin_pos[slot][0]  = 0.0;
    g_trent_pin_pos[slot][1]  = 0.0;
    g_trent_pin_pos[slot][2]  = 0.0;
    g_trent_pin_pos[slot][3]  = 0.0;

    new owner_name[MAX_PLAYER_NAME+1];
    GetPlayerName(playerid, owner_name, sizeof(owner_name));
    new rem[48];
    trent_format_remaining(g_trent_expire_tick[slot] - GetTickCount(), rem, sizeof(rem));
    new txt[160];
    format(txt, sizeof(txt), "{FFAA00}[ «·≈ÌÃ«— ] {FFFFFF}%s\n{AAAAAA}Ì‰ ÂÌ Œ·«· {FFFF00}%s", owner_name, rem);
    g_trent_tag[slot] = CreateDynamic3DTextLabel(txt, 0xFFAA00FF,
        0.0, 0.0, 1.6, 25.0, INVALID_PLAYER_ID, vid, 0, 0, 0);

    give_money(playerid, -price);

    new done[160];
    format(done, sizeof(done),
        "{"#cGN"}* {"#cWH"}√‰  „” √Ã—  {"#cGN"}%s{"#cWH"} „ﬁ«»· {"#cGN"}%s{"#cWH"} ({"#cGN"}$%d{"#cWH"}). «” Œœ„ {"#cGN"}/timecar{"#cWH"} ≈·Ï ≈œ«—… ÂÊ.",
        g_trent_name[car], g_trent_dur_name[dur], price);
    SendClientMessage(playerid, col_white, done);
    return 1;
}

stock trent_remove(slot, bool:notify)
{
    if (slot < 0 || slot >= TRENT_MAX) return 0;
    new vid = g_trent_vehid[slot];
    if (vid != INVALID_VEHICLE_ID)
    {
        if (g_trent_tag[slot] != Text3D:INVALID_3DTEXT_ID)
        {
            DestroyDynamic3DTextLabel(g_trent_tag[slot]);
            g_trent_tag[slot] = Text3D:INVALID_3DTEXT_ID;
        }
        DestroyVehicle(vid);
    }
    if (notify && g_trent_owner[slot] != INVALID_PLAYER_ID && IsPlayerConnected(g_trent_owner[slot]))
    {
        new nm[24];
        if (g_trent_model_idx[slot] >= 0 && g_trent_model_idx[slot] < TRENT_CAR_COUNT)
            format(nm, sizeof(nm), "%s", g_trent_name[g_trent_model_idx[slot]]);
        else
            format(nm, sizeof(nm), "vehicle");
        new m[140];
        format(m, sizeof(m), "{"#cRD"}* {"#cWH"}Õﬁﬂ «·≈ÌÃ«— {"#cRD"}%s{"#cWH"} ⁄‰œ expired Ê ﬂ«‰ √⁄«œ.", nm);
        SendClientMessage(g_trent_owner[slot], col_white, m);
    }
    g_trent_vehid[slot]       = INVALID_VEHICLE_ID;
    g_trent_owner[slot]       = INVALID_PLAYER_ID;
    g_trent_expire_tick[slot] = 0;
    g_trent_model_idx[slot]   = -1;
    g_trent_hidden[slot]      = false;
    g_trent_pinned[slot]      = false;
    return 1;
}

stock trent_show_manage(playerid)
{
    new n = trent_count_player(playerid);
    if (n == 0)
    {
        show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX,
            "{FFA500}‰‘ÿ «·≈ÌÃ«—« ",
            "{FFFFFF}„« ⁄‰œﬂ ≈ÌÃ«—«  ‰‘ÿ….\n\n“Ê— {FFA500}„ﬂ »  √ÃÌ— «·”Ì«—« {FFFFFF} ⁄·Ï «·Œ—Ìÿ… · √ÃÌ— Ê«Õœ….",
            "OK", "");
        return 1;
    }
    new body[900];
    strcat(body, "{FFFF00}«·”Ì«—…\t{FFFF00}„ »ﬁÌ\t{FFFF00}«·œÊ·…\n");
    new k = 0;
    for (new i = 0; i < TRENT_MAX; i++)
    {
        if (g_trent_vehid[i] == INVALID_VEHICLE_ID) continue;
        if (g_trent_owner[i] != playerid) continue;
        new left_ms = g_trent_expire_tick[i] - GetTickCount();
        new rem[48];
        trent_format_remaining(left_ms, rem, sizeof(rem));
        new st[48];
        format(st, sizeof(st), "%s%s",
            g_trent_hidden[i] ? "„Œ›Ì" : "„—∆Ì",
            g_trent_pinned[i] ? ", Õ›Ÿ-«·„Êﬁ›" : "");
        new line[140];
        format(line, sizeof(line), "{FFFFFF}%s\t{00FFAA}%s\t{AAAAAA}%s\n",
            g_trent_name[g_trent_model_idx[i]], rem, st);
        strcat(body, line);
        k++;
        if (k >= TRENT_MAX_PER_PLAYER) break;
    }
    show_dialog(playerid, d_trent_manage, DIALOG_STYLE_TABLIST_HEADERS,
        "{FFA500}Õﬁﬂ «·≈ÌÃ«—« ", body, "≈œ«—…", "≈€·«ﬁ");
    return 1;
}

