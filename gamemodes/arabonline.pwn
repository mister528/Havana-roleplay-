		SendClientMessage(playerid, col_green, "* {ffffff}√‰ÂÌ  „Â„ ﬂ »‰Ã«Õ {"#cGN"}«·‘€· ﬂ‹ ⁄«„· „‰Ã„'{ffffff}, —ÊÕ ≈·Ï «·‘Œ’Ì… ›Ì «·ŸÂ— ⁄‘«‰  «Œ– „ﬂ«›¬ ﬂ.");
	}
	if(IsAGreenZone(playerid) && GetPlayerWeapon(playerid) > 0 && !cop_player(playerid) && !fbi_player(playerid) && !gov_player(playerid) && !army_player(playerid)) GreenZone_Warn(playerid);
	if(IsAGreenZone(playerid) && InGZ[playerid] == 0)
