	else veh_info [ veh_id - 1 ] [ v_vehicle ] = AC_CreateVehicle ( veh_info [ veh_id - 1 ] [ v_model ], veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ], veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ], veh_info [ veh_id - 1 ] [ v_color ] [ 0 ], veh_info [ veh_id - 1 ] [ v_color ] [ 1 ], -1 ) ;
	SetVehicleNumberPlate( veh_info [ veh_id - 1 ] [ v_vehicle ], veh_info [ veh_id - 1 ] [ v_plate ] ) ;
	veh_info [ veh_id - 1 ] [ v_fuel ] = 60.0 ;

	new sql_string [ 76 ] ;
	mysql_format ( sql_connection, sql_string, 76, "UPDATE `server_vehicles` SET `sv_model` = '%d' WHERE `sv_id` = '%d'",
	veh_info [ veh_id - 1 ] [ v_model ],
