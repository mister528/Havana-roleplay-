	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /makeleader [ID/«·«”„] [—ﬁ„ «·„‰Ÿ„… (/orglist)]" ) ;
	if ( params [ 1 ] < 1 || params [ 1 ] > fraction_count ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}—ﬁ„ «·„‰Ÿ„… €Ì— ’ÕÌÕ." ) ;
	if ( params [ 1 ] == 11 || params [ 1 ] == 13 || params [ 1 ] == 14 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}—ﬁ„ «·„‰Ÿ„… €Ì— ’ÕÌÕ." );
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
	//if(p_info[params[0]][admin] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}You can not set an administrator as a leader!" ) ;

	new scm_string [ 144 ] ;
	params [ 1 ] -= 1 ;

	format ( scm_string, sizeof scm_string, "{"#cBL"}*  {"#cGR"}%s ⁄„· %s «·ﬁ«∆œ „‰ «·„‰Ÿ„… \"{"#cWH"}%s{"#cGR"}\"", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], f_info [ params [ 1 ] ] [ f_name ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_gray, scm_string ) ;
	format ( scm_string, sizeof scm_string, "* %s ⁄‰œ ⁄„· √‰  ﬁ«∆œ «·„‰Ÿ„… \"%s\"", p_info [ playerid ] [ name ], f_info [ params [ 1 ] ] [ f_name ] ) ;
	SendClientMessage ( params [ 0 ], col_yellow, scm_string ) ;

	p_info [ params [ 0 ] ] [ member ] = params [ 1 ] + 1 ;
	p_info [ params [ 0 ] ] [ leader ] = params [ 1 ] + 1 ;
	p_info [ params [ 0 ] ] [ rank ] = f_info [ params [ 1 ] ] [ f_rank_settings ] [ 0 ] ;
	p_info [ params [ 0 ] ] [ org_skin ] = f_skin [ params [ 1 ] ] [ p_info [ params [ 0 ] ] [ gender ] ] [ 0 ] ;
	update_int_sql ( params [ 0 ], "u_org_skin", p_info [ params [ 0 ] ] [ org_skin ] ) ;

	new query_string [ 200 ] ;

	if ( p_info [ params [ 0 ] ] [ admin ] < 1 )
	{
		format ( f_info [ params [ 1 ] ] [ f_leader_name ], MAX_PLAYER_NAME, "%s", p_info [ params [ 0 ] ] [ name ] ) ;
		format ( query_string, 128, "UPDATE `fractions` SET `f_leader_name` = '%s' WHERE `f_id` = '%d' LIMIT 1",
		p_info [ params [ 0 ] ] [ name ], params [ 1 ]+1 ) ;
		mysql_tquery ( sql_connection, query_string, "", "" ) ;
	}
	p_info [ params [ 0 ] ] [ f_warning ] = 0 ;
	update_int_sql ( params [ 0 ], "u_f_warning", p_info [ params [ 0 ] ] [ f_warning ] ) ;
	p_info [ params [ 0 ] ] [ spawnchange ] = 2 ;
	update_int_sql ( params [ 0 ], "u_spawnchange", p_info [ params [ 0 ] ] [ spawnchange ] ) ;
    pSpawn( params[0]);
    is_fraction_duty {playerid} = 1;

	format ( query_string,sizeof(query_string),"UPDATE `users` SET `u_member` = '%d', `u_leader` = '%d', `u_rank` = '%d', `u_fraction_date` = NOW() WHERE `u_id` = '%d' LIMIT 1",
	p_info [ params [ 0 ] ] [ member ], p_info [ params [ 0 ] ] [ leader ], p_info [ params [ 0 ] ] [ rank ], p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;
	SetPlayerColor ( params [ 0 ], f_info [ p_info [ params [ 0 ] ] [ member ] - 1 ] [ f_radar_color ] ) ;

	format(query_string, 128, "%s ⁄‰œ ⁄Ì¯‰ %s ﬂ‹ «·ﬁ«∆œ „‰ %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], f_info [ p_info [ params [ 0 ] ] [ member ] - 1 ] [ f_name ] );
	WriteLog(TYPE_LOG_MKL, query_string);
	return 1;
}

