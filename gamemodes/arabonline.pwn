			PlayerTextDrawLetterSize(playerid, admin_panel_ptd[playerid][0], 0.1949, 0.9933);
			PlayerTextDrawTextSize(playerid, admin_panel_ptd[playerid][0], 0.0000, -73.0000);
			PlayerTextDrawAlignment(playerid, admin_panel_ptd[playerid][0], 2);
			PlayerTextDrawColor(playerid, admin_panel_ptd[playerid][0], -1);
			PlayerTextDrawBackgroundColor(playerid, admin_panel_ptd[playerid][0], 255);
			PlayerTextDrawFont(playerid, admin_panel_ptd[playerid][0], 2);
			PlayerTextDrawSetProportional(playerid, admin_panel_ptd[playerid][0], 1);
			PlayerTextDrawSetShadow(playerid, admin_panel_ptd[playerid][0], 0);
		}
	 	else if (strfind(buffer, "A89EEC8CCA0900CD9CEC08CCD984DA559D4F4908")) // Mobile
	 	{
			format ( td_str, 48, "%s_(%d)(«·ÃÊ«·)", p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
			admin_panel_ptd[playerid][0] = CreatePlayerTextDraw(playerid, 574.6671, 156.1961, td_str);
			PlayerTextDrawLetterSize(playerid, admin_panel_ptd[playerid][0], 0.1949, 0.9933);
			PlayerTextDrawTextSize(playerid, admin_panel_ptd[playerid][0], 0.0000, -73.0000);
			PlayerTextDrawAlignment(playerid, admin_panel_ptd[playerid][0], 2);
			PlayerTextDrawColor(playerid, admin_panel_ptd[playerid][0], -1);
			PlayerTextDrawBackgroundColor(playerid, admin_panel_ptd[playerid][0], 255);
			PlayerTextDrawFont(playerid, admin_panel_ptd[playerid][0], 2);
			PlayerTextDrawSetProportional(playerid, admin_panel_ptd[playerid][0], 1);
			PlayerTextDrawSetShadow(playerid, admin_panel_ptd[playerid][0], 0);
	 	}

		admin_panel_ptd[playerid][1] = CreatePlayerTextDraw(playerid, 514.1668, 174.9629, "«·„” ÊÏ:~n~«·»Ì‰Ã:~n~«·’Õ…:~n~«·œ—⁄:~n~œﬁ… «·≈ÿ·«ﬁ:~n~«·–ŒÌ—…:~n~«·”—⁄…:~n~¬Ì »Ì:~n~«· Õ–Ì—« :~n~«·ﬂ«‘:");
		PlayerTextDrawLetterSize(playerid, admin_panel_ptd[playerid][1], 0.2119, 0.9103);
		PlayerTextDrawTextSize(playerid, admin_panel_ptd[playerid][1], -89.0000, 0.0000);
		PlayerTextDrawAlignment(playerid, admin_panel_ptd[playerid][1], 1);
		PlayerTextDrawColor(playerid, admin_panel_ptd[playerid][1], -1);
		PlayerTextDrawBackgroundColor(playerid, admin_panel_ptd[playerid][1], 255);
		PlayerTextDrawFont(playerid, admin_panel_ptd[playerid][1], 2);
		PlayerTextDrawSetProportional(playerid, admin_panel_ptd[playerid][1], 1);
		PlayerTextDrawSetShadow(playerid, admin_panel_ptd[playerid][1], 0);

		format ( td_str, sizeof ( td_str ), "%d~n~%d~n~%.2f~n~%.2f~n~%d~n~%d~n~%d~n~%s~n~%d~n~%d$",
		p_info [ params [ 0 ] ] [ level ],
