CMD:acapture ( playerid )
{
	if ( ! terrorist_player ( playerid ) && ! army_player ( playerid )) return 1 ;
	new hor, m, s;
	gettime(hor, m, s);
	if ( capture_az_freezed [ 1 ] > 0 )
	{
		return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„‰Ÿ„ ﬂ „Ã„œ…° „«  ﬁœ—  »œ√ ÕÃ“ «·„‰ÿﬁ…." ) ;
	}
	if ( p_info [ playerid ] [ rank ] < f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 6 ] )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ’·«ÕÌ…." ) ;
	if ( capture_az_cd [ p_info [ playerid ] [ member ] ] > 0 )
	{
		new text_str [ 78 ] ;
		format ( text_str, sizeof ( text_str ), "{"#cRD"}* {"#cGR"}«·”Ìÿ—… ”ÌﬂÊ‰ „ Ê›— via %s", convert_time ( capture_az_cd [ p_info [ playerid ] [ member ] ] ) ) ;
		return SendClientMessage ( playerid, col_gray, text_str ) ;
	}
    for ( new i = 0 ; i < az_count ; i ++ )
	{
		if ( IsPlayerInAzZone ( playerid, i ) )
		{
			if ( az_info [ i ] [ az_owner ] == p_info [ playerid ] [ member ] )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— Œ– ›Êﬁ Õﬁﬂ «·≈ﬁ·Ì„." ) ;

			if ( capture_az_cd [ az_info [ i ] [ az_owner ] ] > 0 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–Ì «·⁄’«»… „« “«·  ›Ì › —… «·—«Õ… »⁄œ ¬Œ— ”Ìÿ—…." ) ;


            new member_counts = 0 ;
			foreach(new j: logged_players)
			{
				if ( p_info [ playerid ] [ member ] == p_info [ j ] [ member ] )member_counts ++ ;
			}
			new text_str1 [ 180 ] ;
			format ( text_str1, sizeof ( text_str1 ), "{"#cRD"}* {"#cGR"}„«  ﬁœ— atack, „« ⁄‰œﬂ ﬂÀÌ— «·⁄÷Ê ›Ì «·⁄’«»…, «·⁄÷Ê ‰‘ÿ ÂÊ %d/2.", member_counts) ;
			if ( member_counts < 2 ) return SendClientMessage ( playerid, col_gray, text_str1 ) ;

			new owner_counts = 0 ;
			foreach(new j: logged_players)
			{
				if ( az_info [ i ] [ az_owner ] == p_info [ j ] [ member ] )owner_counts ++ ;
			}
			new text_str [ 180 ] ;
			format ( text_str, sizeof ( text_str ), "{"#cRD"}* {"#cGR"}«··«⁄»Ì‰ «·„‰Ÿ„… –·ﬂ controls  «·≈ﬁ·Ì„ „Ê ›Ì «··⁄»…, «··«⁄»Ì‰ ‰‘ÿ ÂÊ %d/2.", owner_counts) ;
			if ( owner_counts < 2 ) return SendClientMessage ( playerid, col_gray, text_str ) ;

			az_captured = i ;
			az_info [ i ] [ az_time ] = 900 ;
			az_info [ i ] [ az_attacker ] = p_info [ playerid ] [ member ] ;

			new zone_name [ 32 ] ;
			GetPlayer2DZone ( playerid, zone_name, 32 ) ;

			new _string [ 144 ] ;
			format ( _string, sizeof ( _string ), "%s √‘⁄·  ≈ﬁ·Ì„ „⁄—ﬂ… „⁄ %s ›Ì «·„‰ÿﬁ…: '%s'.",
			f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ],
			f_info [ az_info [ i ] [ az_owner ] - 1 ] [ f_name ], zone_name ) ;

			SendAzMessage ( col_blue, _string ) ;

			format ( _string, sizeof ( _string ), "%s %s[%d] √‘⁄·  Õ—».",
			f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ],
			p_info [ playerid ] [ name ],
			playerid ) ;
			SendAzMessage ( col_blue, _string ) ;

			format ( _string, sizeof ( _string ), "{"#cBL"}* {"#cGR"} %s »œ√ ≈·Ï seize  «·≈ﬁ·Ì„ «·‹ «·⁄’«»… %s",
			f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ],
			f_info [ az_info [ i ] [ az_owner ] - 1 ] [ f_name ] ) ;
			foreach(new j: admin_players) SendClientMessage ( j, col_gray, _string ) ;

			TextDrawSetString(az_capture_td[5], "«·”Ìÿ—…_«·Êﬁ :_15:00");
			TextDrawSetString(az_capture_td[14], f_info[p_info[playerid][member]-1][f_name]);
			TextDrawSetString(az_capture_td[15], f_info[az_info[i][az_owner]-1][f_name]);
			TextDrawSetString(az_capture_td[16], "0");
			TextDrawSetString(az_capture_td[17], "0");

			az_owner_points = 0,
				az_attacker_points	= 0 ;

			//TextDrawColor ( capture_td [17], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;
			//TextDrawColor ( capture_td [18], f_info [ gz_info [ i ] [ gz_owner ] - 1 ] [ f_radar_color ] ) ;

			TextDrawColor(az_capture_td[10], f_info[p_info[playerid][member]-1][f_radar_color]);
			TextDrawColor(az_capture_td[11], f_info[p_info[playerid][member]-1][f_radar_color]);
			TextDrawColor(az_capture_td[12], f_info[az_info[i][az_owner]-1][f_radar_color]);
			TextDrawColor(az_capture_td[13], f_info[az_info[i][az_owner]-1][f_radar_color]);

			capture_az_cd [ 29 ] = 3000 ;
			capture_az_cd [ 8 ] = 3000 ;
			//capture_gang_freezed [ p_info [ playerid ] [ member ] - 18 ] = 1 ;
			//capture_gang_freezed [ gz_info [ i ] [ gz_owner ] - 18 ] = 1 ;
			foreach(new pl_id: logged_players)
			{
				if ( ! terrorist_player ( pl_id ) && ! army_player ( pl_id ))continue ;
				for ( new j = 0 ; j < 18 ; j ++ )
				{
					TextDrawShowForPlayer ( pl_id, az_capture_td [ j ] ) ;
				}
				SetPVarInt ( pl_id, "az_td_status", 1 ) ;
			}

			format ( _string, sizeof ( _string ),"UPDATE `users` SET `u_capture_start` = `u_capture_start`+1 WHERE `u_id` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, _string, "", "" ) ;


   			GangZoneFlashForAll ( az_info [ i ] [ az_created ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;

			az_capture_type = 0 ;

			az_info [ i ] [ az_timer ] = SetTimerEx ( "az_zone_timer", 1000, 1, "iiii", i, p_info [ playerid ] [ member ], az_info [ i ] [ az_owner ], az_capture_type ) ;
			break ;
		}
	}
	return 1 ;
}

