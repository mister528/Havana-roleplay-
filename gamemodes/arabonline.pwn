	if ( p_info [ playerid ] [ number ] == 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ‘—ÌÕ… ÃÊ«· ‰‘ÿ…." ) ;
	if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /sellsim [id/name] [«·”⁄—]") ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» „«  „ «·⁄ÀÊ— ⁄·ÌÂ." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  ÿ»ﬁ Â–« ⁄·Ï ‰›”ﬂ." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;
	if ( p_t_info [ params [ 0 ] ] [ p_dialog ] != -1 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì‰›⁄ «·ÕÌ‰.") ;

	if ( p_info [ params [ 0 ] ] [ exp ] < 3 && p_info [ params [ 0 ] ] [ level ] == 1 ) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"‚Äè}«··«⁄» ·«“„ Ì·⁄» 3 ”«⁄«  ⁄‘«‰ Ìﬁœ— Ì»Ì⁄ «·‘—ÌÕ….");
	if ( params [ 1 ] < 1 || params [ 1 ] > 200000 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"‚Äè}”⁄— «·”Ì„-ﬂ«—  ÌÃ» √‰ ÌﬂÊ‰ „‰ {"#cRD"}1${"#cGR"}  {"#cRD"}200.000${"#cGR"}.");

	if ( GetString ( p_t_info [ params [ 0 ] ] [ p_ip ], p_t_info [ playerid ] [ p_ip ] ) )
	{
		new scm_string [ 128 ] ;
		format ( scm_string, sizeof ( scm_string ), "{"#cRD"}[ Õ–Ì—]: {"#cGR"}%s[%d]   %s[%d] | same ip", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_gray, scm_string ) ;

		//SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}    ." ) ;
		//return 1 ;
	}

	buyer_id [ playerid ] = params [ 0 ] ;
	sell_price [ playerid ] = params [ 1 ] ;
	seller_id [ params [ 0 ] ] = playerid ;
	sell_type [ playerid ] = p_info [ playerid ] [ number ] ;

	new dialog_string [ 90 + MAX_PLAYER_NAME + 32 + 1 + 6 ] ;
	format ( dialog_string, sizeof ( dialog_string ), "   {"#cBL"}%s{FFFFFF}  {"#cBL"}-(.%d){FFFFFF}  {"#cBL"}%d$",
	p_info [ params [ 0 ] ] [ name ], p_info [ playerid ] [ number ], params [ 1 ] ) ;
	SendClientMessage ( playerid, col_white, dialog_string ) ;
	format ( dialog_string, sizeof ( dialog_string  ), "{"#cBL"}%s {FFFFFF}   {"#cBL"}-(.%d){FFFFFF}  {"#cBL"}%d$",
	p_info [ playerid ] [ name ], p_info [ playerid ] [ number ], params [ 1 ] ) ;
	show_dialog ( params [ 0 ], d_sellsim_accept, DIALOG_STYLE_MSGBOX, "{"#cBL"‚Äè}”Ì„-ﬂ«— ", dialog_string, "„Ê«›ﬁ", "≈·€«¡" ) ;
	return 1 ;
}

