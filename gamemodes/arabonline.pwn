CMD:lkr ( playerid )
{
	if ( p_info [ playerid ] [ member ] != 12 ) return true;
	if ( p_info [ playerid ] [ rank ] < 8 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „«  ﬁœ—  ÿ»ﬁ Â–« «·≈Ã—«¡°  Õ «Ã — »… +8." ) ;
    if ( prison_status == 0 ) // opened
	{
	    for ( new t = 0 ; t < 37 ; t ++ )
		{
		    if ( t > 15 ) MoveDynamicObject ( prison_gate [ t ], prison_pos [ t ] [ move_position ] [ 0 ] + 2, prison_pos [ t ] [ move_position ] [ 1 ], prison_pos [ t ] [ move_position ] [ 2 ], 2.00,prison_pos [ t ] [ move_position ] [ 3 ], prison_pos [ t ] [ move_position ] [ 4 ], prison_pos [ t ] [ move_position ] [ 5 ] ) ;
		}
		new sql_string [ 922 ] ;
  		format ( sql_string, sizeof sql_string, "[F] %s %s[%d] {"#cGN"} „ › ÕÂ {"#cGR"}ﬂ· «·»Ê«»… prisons.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ member ] == p_info [ playerid ] [ member ] ) SendClientMessage ( i, col_gray, sql_string ) ;
		prison_status = 1;
	}
	else if ( prison_status == 1 ) // Closed
	{
	    for ( new t = 0 ; t < 37 ; t ++ )
		{
		    if ( t > 15 ) MoveDynamicObject ( prison_gate [ t ], prison_pos [ t ] [ create_position ] [ 0 ] , prison_pos [ t ] [ create_position ] [ 1 ], prison_pos [ t ] [ create_position ] [ 2 ], 2.00,prison_pos [ t ] [ create_position ] [ 3 ], prison_pos [ t ] [ create_position ] [ 4 ], prison_pos [ t ] [ create_position ] [ 5 ] ) ;
		}
		SendClientMessage ( playerid, col_gray, "{"#cBL"}* {"#cGR"}⁄‰œﬂ Õ«·Ì« {"#cRD"}„€·ﬁ {"#cGR"}ﬂ· »Ê«»«  €—› «·”Ã‰." ) ;
		prison_status = 0;
		new sql_string [ 922 ] ;
  		format ( sql_string, sizeof sql_string, "[F] %s %s[%d] {"#cRD"}„€·ﬁ {"#cGR"}ﬂ· «·»Ê«»… prisons.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ member ] == p_info [ playerid ] [ member ] ) SendClientMessage ( i, col_gray, sql_string ) ;
	}
	return 1;
}

