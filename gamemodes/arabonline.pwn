	foreach(new i: admin_players) SendClientMessage ( i, col_gray, scm_string ) ;

	format ( scm_string, sizeof ( scm_string  ), "INSERT INTO `users_bans` (`u_b_admin`,`u_b_name`,`u_b_reason`,`u_b_date`,`u_b_ndate`,`u_b_days`) VALUES ('%s', '%s', '%s', NOW() + INTERVAL 99999 DAY,NOW( ),'99999')", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
