	return DeletePlayer3DTextLabel(issuerid, hitbar);
}

CMD:diplomacy ( playerid )
{
	if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return 1 ;

	static const dip_status [ ] [ ] = {
	"{FFF2C7}Neutrality",
	"{AA3333}War",
	"{33AA33}Union",
	"{"#cGN"}ÿ·» «·‰ﬁ«»…",
	"{"#cGN"}ÿ·» «·‰ﬁ«»…"
	} ;

	new pvar_string [ 11 ],
		step ;

	global_string [ 0 ] = EOS ;

	for ( new i = 0 ; i < 11; i ++ )
	{
		if ( i + 18 == p_info [ playerid ] [ member ] ) continue ;

		format ( pvar_string, 11, "d_%d", step ) ;
		SetPVarInt ( playerid, pvar_string, i + 18 ) ;

		strcat ( global_string, "{") ;
		strcat ( global_string, f_info [ i + 18 ] [ f_chat_color ] ) ;
		strcat ( global_string, "}") ;
		strcat ( global_string, f_info [ i + 18 ] [ f_name ] ) ;
		strcat ( global_string, " ") ;
		strcat ( global_string, dip_status [ f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ i ] ] ) ;
		strcat ( global_string, "\n") ;
		step ++ ;
	}
	show_dialog ( playerid, d_dip_list, DIALOG_STYLE_LIST, "{"#cBL"}«·œ»·Ê„«”Ì…", global_string, "«Œ —", "≈€·«ﬁ" ) ;
	return 1 ;
}
alias:diplomacy("dip")

