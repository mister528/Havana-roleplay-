	if(GetPlayerAnimationIndex(playerid) == 959 && GetPlayerWeapon(playerid) != 46 && GetPlayerSpeedExx(playerid) < 3) anti_cheat(playerid,"Fly hack",021);
	if(GetPVarInt ( playerid, "on_dmarena" ) == 1 && !IsPlayerInRangeOfPoint(playerid, 60, 1557.0854,24.5669,24.1542) && !p_info[playerid][admin])
