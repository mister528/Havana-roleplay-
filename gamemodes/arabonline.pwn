stock PayTicket(playerid, ticketid)
{
	new query[90];

	mysql_format(sql_connection, query, sizeof query, "SELECT * FROM tickets WHERE id=%d LIMIT 1", ticketid);
	mysql_tquery(sql_connection, query, "check_pay_tickets", "d", playerid);
}

callback: check_pay_tickets(playerid)
{
    new rows,
        query[90];

	rows = cache_num_rows();

	if(!rows)
		return send_me(playerid, 0xFF6600FF, "This fine was not found");

	new ticketid = cache_get_field_content_int(0, "id"),
		uid = cache_get_field_content_int(0, "uid"),
		amount = cache_get_field_content_int(0, "amount"),
		status = cache_get_field_content_int(0, "status"),
		desc[64];

	cache_get_field_content(0, "description", desc);

	if(uid != p_info[playerid][id])
		return send_me(playerid, 0xFF6600FF, "This fine was not issued to you.");

	if(status)
		return send_me(playerid, 0xFF6600FF, "This fine has already been paid.");

	if(p_info[playerid][money] < amount)
		return send_me(playerid, 0xFF6600FF, "Insufficient funds to pay the fine");

    new note[38];
	format(note, sizeof note, "%d|%d|%d", p_info[playerid][money], p_info[playerid][money]- amount, -amount);
	//InsertLog(p_info[playerid][name], p_info[playerid][id], "", -1, LOG_OBJECT_MONEY, LOG_TYPE_PLAYER, 95, note);

    give_money(playerid, -amount);

	mysql_format(sql_connection, query, sizeof query, "UPDATE tickets SET status=1 WHERE id=%d", ticketid);
	mysql_tquery(sql_connection, query, "", "");

	new string[128];
	format(string, sizeof(string), "You paid the fine %d (%s)", ticketid, desc);
	SendClientMessage(playerid, 0x99CC00FF, string);

	p_info[playerid][p_ticket_count]--;
	return 1;
}


stock SaveZone(idx)
