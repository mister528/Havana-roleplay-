					    expcapt = 1 ;
	 				}

					CaptureKills[killerid] += expcapt;

					new query_string [ 98 ];
					format ( query_string,sizeof(query_string),"UPDATE `users` SET `u_capture_kills` = `u_capture_kills`+1 WHERE `u_id` = '%d' LIMIT 1", p_info [ killerid ] [ id ] ) ;
					mysql_tquery ( sql_connection, query_string, "", "" ) ;

					format ( query_string,sizeof(query_string),"UPDATE `users` SET `u_capture_top` = `u_capture_top`+1 WHERE `u_id` = '%d' LIMIT 1", p_info [ killerid ] [ id ] ) ;
					mysql_tquery ( sql_connection, query_string, "", "" ) ;

