CMD:paygang ( playerid, params [ ] )
{
	if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) || ! p_info [ playerid ] [ leader ] ) return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«·«” Œœ«„: /paygang [«·„»·€]" ) ;
	if ( params [ 0 ] < 1 || params [ 0 ] > 1000000 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"} «·„»·€ „« Ìﬁœ— ÌﬂÊ‰ √ﬁ· „‰ $1 √Ê «·„“Ìœ 1.000.000$" ) ;

	new num = 0 ;
	foreach(new i : logged_players)
	{
		if ( p_info [ i ] [ member ] != p_info [ playerid ] [ member ] || playerid == i) continue ;
		num++;
	}
	if ( num == 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ›ÌÂ „ÊŸ›Ì‰ ﬂ«›ÌÌ‰ ·œ›⁄ «·—Ê« »." ) ;
	
	global_string [ 0 ] = EOS ;
	format ( global_string, 256, "{"#cWH"}„ √ﬂœ  »Ì √⁄ÿÌ Œ«—Ã %d$ ≈·Ï «··«⁄»Ì‰ ›Ì «·⁄’«»…?\n\n{"#cGR"}-  «·„»·€ Ì„ﬂ‰  €ÌÌ— ·„«  ‰‘ÿ «·„‰Ÿ„… changes.", params [ 0 ] * num ) ;
	show_dialog ( playerid, d_paygang, DIALOG_STYLE_MSGBOX, "{"#cBL"} ’—› «·—Ê« »", global_string, "√ÌÊÂ", "·√" ) ;
	SetPVarInt ( playerid, "gangpay_sum", params [ 0 ] ) ;
	return 1 ;
}

CMD:pay ( playerid, params [ ] )
{
	if ( duel_opponent [ playerid ] != INVALID_PLAYER_ID ) return 1 ;

 	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /œ›⁄ [ID] [«·„»·€]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] )  || params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ." ) ;

	if ( p_info [ params [ 0 ] ] [ level ] < 2 && params [ 1 ] > 500) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  ÕÊ· ›·Ê” ··«⁄» „” ÊÏ 1 √ﬂÀ— „‰ 500$");
	if ( params [ 1 ] < 1 || params [ 1 ] > 10000 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} ﬁœ—  ÕÊÌ· „‰ $1 ≈·Ï 10.000$" ) ;
	if ( params [ 1 ] > p_info [ playerid ] [ money ] )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ›·Ê” ﬂ«›Ì… ≈·Ï  ÕÊÌ·." ) ;

	if ( GetString ( p_t_info [ params [ 0 ] ] [ p_ip ], p_t_info [ playerid ] [ p_ip ] ) )
	{
		new scm_string [ 128 ] ;
		format ( scm_string, sizeof ( scm_string ), "{"#cRD"}<ADM>{"#cGR"} %s[%d] transfers √„Ê«· %s[%d] | same ¬Ì »Ì", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
		foreach(new i: admin_players)SendClientMessage ( i, col_gray, scm_string ) ;

		//SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Unable to transfer funds to this player." ) ;
		//return 1 ;
	}

	give_money ( playerid, - params [ 1 ] ) ;
	give_money ( params [ 0 ], params [ 1 ] ) ;

	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string ), "{"#cGN"}* {"#cWH"}%s √⁄ÿÏ √‰  {"#cGN"}%d${"#cWH"}.", p_info [ playerid ] [ name ], params [ 1 ] ) ;

	SendClientMessage ( params [ 0 ], col_white, scm_string ) ;

	format ( scm_string, sizeof ( scm_string ), "{"#cGN"}* {"#cWH"}√‰  √⁄ÿÏ «··«⁄» %s {"#cGN"}%d${"#cWH"}.", p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;

	format ( scm_string, sizeof ( scm_string ), "√Œ– Œ«—Ã  «·›·Ê” Ê handed ÂÊ ›Êﬁ %s", p_info [ params [ 0 ] ] [ name ] ) ;
	me_action ( playerid, scm_string ) ;

	insert_money_log ( params [ 0 ], playerid, params [ 1 ], "command /pay" ) ;
	return true;
}

