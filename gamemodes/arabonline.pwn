		SendClientMessage(playerid, col_green, "* {ffffff}√‰ÂÌ  „Â„ ﬂ »‰Ã«Õ {"#cGN"}'«·‘€· ﬂ‹ »‰¯«¡'{ffffff}° —ÊÕ ≈·Ï «·„„À· ›Ì «·Œ·› · «Œ– „ﬂ«›¬ ﬂ.");
	}
	if(InBuilder[playerid] == 1 && p_info[playerid][MissionTwelveCount] > 25 && p_info[playerid][MissionTwelve] == 1)
	{
	    p_info[playerid][MissionTwelve] = 2;
	    new query_strinsg [ 600 ];
		mysql_format ( sql_connection, query_strinsg, sizeof query_strinsg, "UPDATE `users` SET `MissionTwelve`='2' WHERE `u_id`='%d'", p_info[playerid][id] ) ;
		mysql_tquery ( sql_connection, query_strinsg ) ;
	    p_info[playerid][MissionTwelveCount] = 0;
	    new query_string [ 600 ];
		mysql_format ( sql_connection, query_string, sizeof query_string, "UPDATE `users` SET `MissionTwelveCount`='0' WHERE `u_id`='%d'", p_info[playerid][id] ) ;
		mysql_tquery ( sql_connection, query_string ) ;
		SendClientMessage(playerid, col_green, "* {ffffff}√‰ÂÌ  „Â„ ﬂ »‰Ã«Õ {"#cGN"}'«·‘€· ﬂ‹ »‰¯«¡'{ffffff}° —ÊÕ ≈·Ï «·„„À· ›Ì «·Œ·› · «Œ– „ﬂ«›¬ ﬂ.");
	}
	if(p_info[playerid][MissionThreeCount] > 2500 && p_info[playerid][MissionThree] == 1)
	{
	    p_info[playerid][MissionThree] = 2;
	    new query_strinsg [ 600 ];
		mysql_format ( sql_connection, query_strinsg, sizeof query_strinsg, "UPDATE `users` SET `MissionThree`='2' WHERE `u_id`='%d'", p_info[playerid][id] ) ;
		mysql_tquery ( sql_connection, query_strinsg ) ;
	    p_info[playerid][MissionThreeCount] = 0;
	    new query_string [ 600 ];
		mysql_format ( sql_connection, query_string, sizeof query_string, "UPDATE `users` SET `MissionThreeCount`='0' WHERE `u_id`='%d'", p_info[playerid][id] ) ;
		mysql_tquery ( sql_connection, query_string ) ;
		SendClientMessage(playerid, col_green, "* {ffffff}√‰ÂÌ  „Â„ ﬂ »‰Ã«Õ {"#cGN"}'‘€· «·„‰‘—…'{ffffff}° —ÊÕ ··„„À· ›Ì «·Œ·› · «Œ– „ﬂ«›√ ﬂ.");
	}
	if(p_info [ playerid ] [ jail ] == 10 && p_info[playerid][jailed] > 1) // Jail ADMIN
	{
	    if ( !IsPlayerInRangeOfPoint ( playerid, 200.0, 5048.9785,-765.0849,13.4594 ) )
	    {
	        if( ! p_t_info [ playerid ][ glitch_logged ] ) return true;
	        set_pos ( playerid, 5048.978515, -765.416931, 12.459382+3.0, 0.0, 0, 15 ) ;
			reset_player_weapon ( playerid ) ;
	    }
	}
	if(p_info [ playerid ] [ jail ] == 20 && p_info[playerid][jailed] > 1 && ! IsPlayerInRangeOfPoint ( playerid, 120.0, 3243.5698,2113.7266,6.9226 ) && ! IsPlayerInRangeOfPoint ( playerid, 50.0, 1363.0466,963.3353,3016.7773 ) && ! IsPlayerInRangeOfPoint ( playerid, 50.0, -1454.9766,1754.1044,3037.3174 )) // Prison Alctraz
	{
        if( ! p_t_info [ playerid ][ glitch_logged ] ) return true;
        if ( p_info [ playerid ] [ jail_force ] >= 0 )
        {
            set_pos ( playerid, prison_spawn [ p_info [ playerid ] [ jail_force ] ] [ 0 ], prison_spawn [ p_info [ playerid ] [ jail_force ] ] [ 1 ], prison_spawn [ p_info [ playerid ] [ jail_force ] ] [ 2 ], prison_spawn [ p_info [ playerid ] [ jail_force ] ] [ 3 ], 27, 27);
        }
        else set_pos ( playerid, 1383.3717,964.0858,3016.7773, 89.6736, 27, 27) ;
		reset_player_weapon ( playerid ) ;
	}
	if(p_info [ playerid ] [ jail_type ] == 1 && p_info[playerid][jailed] > 1) // lspd
	{
	    if ( !IsPlayerInRangeOfPoint ( playerid, 20.0, jail_spawn1 [ 0 ] [ 0 ], jail_spawn1 [ 0 ] [ 1 ], jail_spawn1 [ 0 ] [ 2 ] ))
	    {
	        new random_jail_pos = random(2);
			set_pos ( playerid, jail_spawn1 [ random_jail_pos ] [ 0 ], jail_spawn1 [ random_jail_pos ] [ 1 ], jail_spawn1 [ random_jail_pos ] [ 2 ], jail_spawn1 [ random_jail_pos ] [ 3 ], 6,6 );
            reset_player_weapon ( playerid ) ;
		}
	}
	if(p_info [ playerid ] [ jail_type ] == 2 && p_info[playerid][jailed] > 1) // lvpd
	{
	    if ( !IsPlayerInRangeOfPoint ( playerid, 20.0, 198.2046,161.8974,1003.0300 ))
	    {
	        new random_jail_pos = random(2);
	        reset_player_weapon ( playerid ) ;
	        set_pos ( playerid, jail_spawn3 [ random_jail_pos ] [ 0 ], jail_spawn3 [ random_jail_pos ] [ 1 ], jail_spawn3 [ random_jail_pos ] [ 2 ], jail_spawn3 [ random_jail_pos ] [ 3 ], 3,3 );
	    }
	}
	if(p_info [ playerid ] [ jail_type ] == 3 && p_info[playerid][jailed] > 1) // sfpd
	{
	    if ( !IsPlayerInRangeOfPoint ( playerid, 20.0, 219.4428,114.0134,999.0156 ))
	    {
	        new random_jail_pos = random(2);
	        reset_player_weapon ( playerid ) ;
	        set_pos ( playerid, jail_spawn2 [ random_jail_pos ] [ 0 ], jail_spawn2 [ random_jail_pos ] [ 1 ], jail_spawn2 [ random_jail_pos ] [ 2 ], jail_spawn2 [ random_jail_pos ] [ 3 ], 10,10 );
	    }
	}
	
	new pl_state = GetPlayerState ( playerid ) ;
	
	if ( pl_state == PLAYER_STATE_ONFOOT )
	{

/*		if ( is_adrenaline_effect { playerid } > 0 )
		{
			new Keys, ud, lr, Float:speed = 0.2;
			GetPlayerKeys(playerid, Keys, ud, lr);
			#pragma unused Keys
			#pragma unused lr
			if( ud < 0 )
			{
				new Float:x, Float:y, Float:z;
				GetPlayerCameraFrontVector ( playerid, x, y, z ) ;
				z = atan2 ( y, x ) + 270.0;
				if ( z >= 360.0 ) z -= 360.0 ;
				SetPlayerFacingAngle(playerid, z ) ;
				SetPlayerVelocity(playerid, x * speed, y * speed, 0.0);
			}
		}*/
		if ( gotome_player [ playerid ] != -1 )
		{
			new pl_id = gotome_player [ playerid ] ;
			new Float:pl_x, Float:pl_y, Float:pl_z, Float:pl_r ;

			GetPlayerPos ( pl_id, pl_x, pl_y, pl_z ) ;
			SetPlayerFaceToPoint ( playerid, pl_x, pl_y ) ;

			new Float:g_pos [ 3 ] ;
			new anim = move_animation ( playerid, pl_x, pl_y, pl_z ) ;
			if ( GetPlayerInterior ( pl_id ) != GetPlayerInterior ( playerid ) || GetPlayerVirtualWorld ( pl_id ) != GetPlayerVirtualWorld ( playerid ) || GetPlayerDistanceFromPoint ( playerid, pl_x, pl_y, pl_z ) > 10 )
			{

				SetPlayerPos ( playerid, pl_x, pl_y, pl_z ) ;
				SetPlayerInterior ( playerid, GetPlayerInterior ( pl_id ) ) ;
				SetPlayerVirtualWorld ( playerid, GetPlayerVirtualWorld ( pl_id ) ) ;
			}
			if ( anim != 1 )
			{
				g_pos [ 0 ] = GetPVarFloat ( playerid,"cuff_x" ) ;
				g_pos [ 1 ] = GetPVarFloat ( playerid,"cuff_y" ) ;
				g_pos [ 2 ] = GetPVarFloat ( playerid,"cuff_z" ) ;
				if ( IsPlayerInRangeOfPoint ( playerid, 0.05, g_pos [ 0 ],g_pos [ 1 ],g_pos [ 2 ] ) )
				{
					GetPlayerPos ( playerid, pl_x, pl_y, pl_z ) ;
					GetPlayerFacingAngle ( playerid, pl_r ) ;
					ShiftCords ( pl_x, pl_y, pl_r, 1.5 ) ;
					SetPlayerPos ( playerid, pl_x, pl_y, pl_z ) ;
				}
				GetPlayerPos ( playerid, pl_x, pl_y, pl_z ) ;
				SetPVarFloat ( playerid, "cuff_x", pl_x ) ;
				SetPVarFloat ( playerid, "cuff_y", pl_z ) ;
				SetPVarFloat ( playerid, "cuff_z", pl_z ) ;
			}
		}
	}
	
	
	else if ( pl_state == PLAYER_STATE_DRIVER )
	{
        new veh_id = GetPlayerVehicleID ( playerid ) ;
		
		if ( veh_info [ veh_id - 1 ] [ v_model ] == 530 )
		{
			new Float:vehicle_health_now ;
			GetVehicleHealth ( veh_id, vehicle_health_now ) ;
			if ( vehicle_health_now < 1000 )
			{
				AC_RepairVehicle ( veh_id ) ;
				veh_info [ veh_id - 1 ] [ v_fuel ] = 100.0 ;
			}
		}
		new ac_vehid = GetPlayerVehicleID ( playerid ) ;

		new Float:_coord [ 3 ];
		GetVehicleRotation ( ac_vehid, _coord [ 0 ],_coord[1],_coord[2]);

		new speed = GetVehicleSpeed ( ac_vehid ) ;

		if ( ( _coord [ 0 ] > 2 ) && _coord [ 0 ] - rotation_v_fly_pos [ playerid ] [ 0 ] == 0.00000000 &&
				_coord [ 1 ] - rotation_v_fly_pos [ playerid ] [ 1 ] == 0.00000000 &&
				speed > 60 )
		{
			player_v_fly_warning [ playerid ] ++ ;
		}
		rotation_v_fly_pos [ playerid ] [ 0 ] = _coord [ 0 ] ;
		rotation_v_fly_pos [ playerid ] [ 1 ] = _coord [ 1 ] ;
	}
	// Accessoires Bag
    if ( p_info [ playerid ] [ money ] > 5000000 )
	{
		if ( GetPlayerWeapon ( playerid ) == 0 )
		{
			if ( p_info [ playerid ] [ case_money ] == 0 )
			{
				if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 9 ) ) SetPlayerAttachedObject( playerid, 9, 1210, 5, 0.299999, 0.099999, 0.0, 0.0, -83.00, 0.0, 1.0, 1.0, 1.0);
			}
			else if ( p_info [ playerid ] [ case_money ] == 1 )
			{
			    if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 9 ) ) SetAttachToSkin(playerid, 29, p_info [ playerid ] [ skin ], 19624 ) ;
			}
			else if ( p_info [ playerid ] [ case_money ] == 2 )
			{
				if ( ! IsPlayerAttachedObjectSlotUsed ( playerid, 9 ) ) havana_attach_accessory (playerid, 9, 2919, 5, 0.207999,0.024000,0.049999, 0.000000,-106.799972,3.399999, 0.222999,0.052999,0.302000);
			}
		}
		else
		{
			if ( IsPlayerAttachedObjectSlotUsed ( playerid, 9 ) ) RemovePlayerAttachedObject(playerid, 9 ) ;
		}
	}
	else
	{
		if ( IsPlayerAttachedObjectSlotUsed ( playerid, 9 ) ) RemovePlayerAttachedObject(playerid, 9 ) ;
	}
	p_t_info [ playerid ] [ p_update ] = GetTickCount ( ) ;
	if ( pl_afk_time [ playerid ] > 10 )
	{
		new afk_ret_str [ 96 ] ;
		format ( afk_ret_str, sizeof ( afk_ret_str ), "{"#cGN"}* {"#cWH"}—Ã⁄  „‰ AFK - ﬂ‰  »⁄Ìœ %s œﬁÌﬁ…", convert_time ( pl_afk_time [ playerid ] ) ) ;
		SendClientMessage ( playerid, col_white, afk_ret_str ) ;
	}
	pl_afk_time [ playerid ] = -2 ;
	if(noclipdata[playerid][cameramode] == CAMERA_MODE_FLY)
	{
		new keys,ud,lr;
		GetPlayerKeys(playerid,keys,ud,lr);

		if(noclipdata[playerid][mode] && (GetTickCount() - noclipdata[playerid][lastmove] > 100))
		{
		    // If the last move was > 100ms ago, process moving the object the players camera is attached to
		    MoveCamera(playerid);
		}

        
		// Is the players current key state different than their last keystate?
		if(noclipdata[playerid][udold] != ud || noclipdata[playerid][lrold] != lr)
		{
			if((noclipdata[playerid][udold] != 0 || noclipdata[playerid][lrold] != 0) && ud == 0 && lr == 0)
			{   // All keys have been released, stop the object the camera is attached to and reset the acceleration multiplier
				StopPlayerObject(playerid, noclipdata[playerid][flyobject]);
				noclipdata[playerid][mode]      = 0;
				noclipdata[playerid][accelmul]  = 0.0;
			}
			else
			{   // Indicates a new key has been pressed

			    // Get the direction the player wants to move as indicated by the keys
				noclipdata[playerid][mode] = GetMoveDirectionFromKeys(ud, lr);

				// Process moving the object the players camera is attached to
				MoveCamera(playerid);
			}
		}
		noclipdata[playerid][udold] = ud; noclipdata[playerid][lrold] = lr; // Store current keys pressed for comparison next update
		return 0;
	}
	return 1;
}



public OnPlayerStreamIn ( playerid, forplayerid )
{
	Iter_Add(streamed_players[forplayerid], playerid ) ;
	if ( p_info [ playerid ] [ settings ] [ 1 ] == 0 ) ShowPlayerNameTagForPlayer ( playerid, forplayerid, 0 ) ;
	return 1;
}

public OnPlayerStreamOut ( playerid, forplayerid )
{
	Iter_Remove(streamed_players[forplayerid], playerid ) ;
	return 1;
}
public OnPlayerClickMap ( playerid, Float:fX, Float:fY, Float:fZ )
{
	if ( GetPVarInt ( playerid, "biz_war_map" ) == 1 )
	{
		if ( mw_biz != -1 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·Õ—» ⁄·Ï «·»Ì“‰” Œ·«’ »œ√ ." ), DeletePVar ( playerid, "biz_war_map" ) ;

		if ( ! available_gz_pos ( fX, fY ) )
		{
			SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „Ê „„ﬂ‰  ‰’» ”Â„ ›Ì Â–Ì «·„‰ÿﬁ…." ) ;
			SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–Ì ·«“„  ﬂÊ‰ „‰ÿﬁ… ›Ì ÷Ê«ÕÌ „œÌ‰… Las Venturas." ), DeletePVar ( playerid, "biz_war_map" ) ;
			return 1 ;
		}

		for ( new b = 0; b < b_count ; b ++ )
		{
			DeletePVar ( playerid, "biz_war_map" ) ;
			if ( ! IsPlayerInRangeOfPoint ( playerid , 3.0 , b_info [ b ] [ b_position ] [ 0 ] , b_info [ b ] [ b_position ] [ 1 ], b_info [ b ] [ b_position ] [ 2 ] ) )continue ;

			get_gz_pos ( fX, fY, 80.0, mw_quad [ 0 ], mw_quad [ 1 ], mw_quad [ 2 ], mw_quad [ 3 ] ) ;
			mw_gangzone = GangZoneCreate ( mw_quad [ 0 ], mw_quad [ 1 ], mw_quad [ 2 ], mw_quad [ 3 ] ) ;

			mw_attacker = p_info [ playerid ] [ member ] ;
			mw_owner = b_info [ b ] [ b_mafia ] ;

			GangZoneShowForAll ( mw_gangzone, f_info [ mw_owner - 1 ] [ f_radar_color ] ) ;

			mw_time = 600 ;
			mw_biz = b ;

			GangZoneFlashForAll ( mw_gangzone, f_info [ mw_attacker - 1 ] [ f_radar_color ] ) ;

			mw_owner_points = 0;
			mw_attacker_points = 0;

			mafia_cd = 7200 ;


			new _string [ 144 ] ;
			format ( _string, sizeof ( _string ), "* '%s'    '%s'  '%s'.",
			f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ],
			b_info [ b ] [ b_name ],
			f_info [ mw_owner - 1 ] [ f_name ] ) ;

			SendMafiaMessage ( col_light_red, _string ) ;

			format ( _string, sizeof ( _string ), "* %s %s[%d] () .",
			f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ],
			p_info [ playerid ] [ name ],
			playerid ) ;
			
			SendMafiaMessage ( col_light_red, _string ) ;

			format ( _string, sizeof ( _string ), "{"#cBL"}* {"#cGR"} %s     %s",
			f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ],
			f_info [ mw_owner - 1 ] [ f_name ] ) ;
			foreach(new j: admin_players) SendClientMessage ( j, col_gray, _string ) ;

			TextDrawSetString ( mw_td [ 5 ], "BIZWAR_«·Êﬁ :_10:00" ) ;
			TextDrawSetString ( mw_td [ 14 ], mafia_td_name [ p_info [ playerid ] [ member ] - 23 ] ) ;
			TextDrawSetString ( mw_td [ 15 ], mafia_td_name [ mw_owner - 23 ] ) ;
			TextDrawSetString ( mw_td [ 16 ], "0" ) ;
			TextDrawSetString ( mw_td [ 17 ], "0" ) ;

			mw_owner_points = 0,
			mw_attacker_points	= 0 ;

			TextDrawColor ( mw_td [10], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;
			TextDrawColor ( mw_td [11], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;
			TextDrawColor ( mw_td [12], f_info [ mw_owner - 1 ] [ f_radar_color ] ) ;
			TextDrawColor ( mw_td [13], f_info [ mw_owner - 1 ] [ f_radar_color ] ) ;

			mw_timer = SetTimerEx ( "callback_mw_timer", 1000, 1, "i", b ) ;
			return 1 ;
		}
		return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"√‰  „Ê ⁄‰œ «·»Ì“‰”." ) ;
	}

	if ( GetPVarInt ( playerid, "map_mark" ) )
	{
		new get_taxidriver = GetPVarInt ( playerid, "taxi_driver_id" ) ;
		SetPlayerRaceCheckpoint ( get_taxidriver, 1, fX, fY, fZ, 0.0, 0.0, 0.0, 2.0 ) ;
		is_gps_used { get_taxidriver } = 1 ;
		SendClientMessage ( get_taxidriver, col_white, "{"#cBL"}* {"#cWH"} „ Ê÷⁄ ⁄·«„… ⁄·Ï «·Œ—Ìÿ…° «÷€ÿ Enter ·≈“«· Â« {"#cGR"}/gps'{"#cWH"}." ) ;
		SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}÷»¯ÿ  ‰ﬁÿ… «· «ﬂ”Ì." ) ;
		DeletePVar ( playerid, "map_mark" ) ;
		DeletePVar ( playerid, "taxi_driver_id" ) ;
		return 1 ;
	}

	if ( !p_info [ playerid ] [ admin ] ) return 1 ;
	p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;

	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);

    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
    	new vehicleid = GetPlayerVehicleID(playerid);
        	
    	AC_SetVehiclePos(vehicleid, fX, fY, fZ);
    	LinkVehicleToInterior(vehicleid, 0);
    	SetVehicleVirtualWorld(vehicleid, 0);
    }
	else SetPlayerPos(playerid, fX, fY, fZ);
	return true;
}

