CMD:refill(playerid,params[])
{
    if(p_info[playerid][ job ] != job_mechanic ) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}√‰  „Ê „Ìﬂ«‰ÌﬂÌ.");
	if(p_t_info [ playerid ] [ job_meh ] != 1 ) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"} «»œ√ ÌÊ„ «·‘€· (/mech).");

	if(sscanf(params,"ui",params[0],params[1],params[ 2 ])) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: / ≈⁄«œ…  ⁄»∆… [ID/«·«”„] [«·»‰“Ì‰] [«·”⁄—]");
	if(params[ 2 ] < 80 || params[ 2 ] > 1500) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}«·”⁄— „« Ìﬁœ— ÌﬂÊ‰ √ﬂÀ— „‰ $1500 Ê √ﬁ· „‰ $80" );
	if(GetPVarInt(playerid,"fuel") < params[1] || params[1] < 0) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ –·ﬂ ﬂÀÌ— «·ÊﬁÊœ .");
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;
	if(GetPlayerState(params[0]) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» ·«“„ ÌﬂÊ‰ ›Ì «·”Ì«—….");
	if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ œ«Œ· «·”Ì«—….");
	if(veh_info [ player_rentcar [ playerid ] - 1 ] [ v_type ] != vehicle_type_job || veh_info [ player_rentcar [ playerid ] - 1 ] [ v_owner ] != job_mechanic) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ œ«Œ· ”Ì«—… «·‘€·.");


	if ( veh_info [ GetPlayerVehicleID ( params [ 0 ] ) - 1 ] [ v_fuel ] + params[1] > 100 ) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}ﬂÀÌ— ÊﬁÊœ „« ÌœŒ· ›Ì «· «‰ﬂ.");

	new _scm_string [ 128 ] ;
	format(_scm_string, 128, "√‰  offered %s ≈·Ï fill ›Êﬁ  «·”Ì«—… ·‹ %i · — „ﬁ«»· %i$", p_info[params[0]][name],params [ 1 ],params[ 2 ]);
	SendClientMessage(playerid, col_lblue,_scm_string);

	format(_scm_string, 128, "{ffffff}%s ⁄—Ê÷ ≈·Ï fill ›Êﬁ Õﬁﬂ «·”Ì«—… „⁄ %i · — „ﬁ«»· %i$\n\n«›⁄· √‰  agree?", p_info[playerid][name],params[1], params[ 2 ] ) ;
	show_dialog(params[0],d_refill,DIALOG_STYLE_MSGBOX,"{"#cBL"}≈⁄«œ…  ⁄»∆…",_scm_string,"„Ê«›ﬁ…","—›÷");

	SetPVarInt(playerid,"id_refill",params[0] + 1);
	SetPVarInt(playerid,"price_refill", params[ 2 ]);
	SetPVarInt(playerid,"litres_refill", params[1]);
	SetPVarInt(params[0],"id_refill",playerid + 1);
	return 1;
}

CMD:repair(playerid,params[])
{
    if(p_info[playerid][ job ] != job_mechanic ) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}√‰  „Ê „Ìﬂ«‰ÌﬂÌ.");
	if(p_t_info [ playerid ] [ job_meh ] != 1 ) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"} «»œ√ ÌÊ„ «·‘€· (/mech).");

	if(sscanf(params,"ui",params[0],params[1])) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /’Ì«‰… [ID/«·«”„ ] [«·”⁄—]");
	if(params[1] < 80 || params[1] > 1500) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}«·”⁄— ·‹ ’Ì«‰… „« Ìﬁœ— ÌﬂÊ‰ √ﬂÀ— „‰ $1500 Ê √ﬁ· „‰ 80 $");
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;
	if(GetPlayerState(params[0]) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» ·«“„ ÌﬂÊ‰ ›Ì «·”Ì«—….");
	if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ œ«Œ· «·”Ì«—….");
	if(veh_info [ player_rentcar [ playerid ] - 1 ] [ v_type ] != vehicle_type_job || veh_info [ player_rentcar [ playerid ] - 1 ] [ v_owner ] != job_mechanic) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ œ«Œ· ”Ì«—… «·‘€·.");
	if ( params [ 0 ] == playerid ) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  ’·¯Õ ÃÂ«“ﬂ.");

	new _scm_string [ 128 ] ;
	format(_scm_string, 128, "√‰  offered %s ≈·Ï ≈’·«Õ  «·”Ì«—… ·‹ %i$", p_info[params[0]][name],params[1]);
	SendClientMessage(playerid,col_lblue,_scm_string);

	format(_scm_string, 128, "{ffffff}%s ⁄—Ê÷ ≈·Ï ≈’·«Õ Õﬁﬂ «·”Ì«—… ·‹ %i$\n\n«›⁄· √‰  agree?", p_info[playerid][name],params[1]);
	show_dialog(params[0],d_repair,DIALOG_STYLE_MSGBOX,"{"#cBL"}’Ì«‰…",_scm_string,"„Ê«›ﬁ…","≈·€«¡");

	SetPVarInt(playerid,"id_repair",params[0] + 1);
	SetPVarInt(playerid,"price_repair", params[1]);
	SetPVarInt(params[0],"id_repair",playerid + 1);
	return 1;
}

//ALT:truck:t;
CMD:tr ( playerid, params[])
{
	if ( p_info [ playerid ] [ job ] != job_trucker )return 1 ;
	if ( p_info [ playerid ] [ mute ] )
	{
		new scm_string [ 38 ] ;
		format ( scm_string, sizeof ( scm_string ),"√‰  „„‰Ê⁄ „‰ «·‘«  | %d À«‰Ì…", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
		return true ;
	}
	if ( sscanf ( params, "s[120]", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /tr [«·‰’]" ) ;
 	check_advertise ( playerid, params [ 0 ] ) ;
	new scm_string [ 144 ],
		rank_name [ 16 ] ;

	if ( p_info [ playerid ] [ truck_skill ]>= 0 && p_info [ playerid ] [ truck_skill ] <= 30000 )	rank_name = "Newbie";
	else if ( p_info [ playerid ] [ truck_skill ]>= 30001 && p_info [ playerid ] [ truck_skill ] <= 60000 )rank_name = "Driver" ;
	else if ( p_info [ playerid ] [ truck_skill ]>= 60001 && p_info [ playerid ] [ truck_skill ] <= 90000 )rank_name = "Expert" ;
	else rank_name = "MH carrier" ;

	format ( scm_string, sizeof scm_string, " [«·‘«Õ‰…] %s %s: %s", rank_name, p_info [ playerid ] [ name ], params [ 0 ] ) ;
	foreach(new i: logged_players) if ( p_info [ i ] [ job ] == job_trucker ) SendClientMessage ( i, 0x4682B4AA, scm_string ) ;

//	SetPlayerChatBubble ( playerid, "() -  ", col_light_purple, 13.0, 7000 ) ;
	return 1;
}
CMD:tskill ( playerid, params [ ] )
{
	global_string [ 0 ] = EOS ;

	if ( p_info [ playerid ] [ truck_skill ]>= 0 && p_info [ playerid ] [ truck_skill ] <= 29999 )
	{
		format ( global_string, 186,
		"{ffffff}„” Ê«ﬂ: Beginner (1).\n„ Ê›— ‰ﬁ·: Linerunner.\nÕ„Ê·…  „ ‰ﬁ·Â: %d/30000 ﬂÃ„.", p_info [ playerid ] [ truck_skill ] ) ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX,"{"#cBL"}”«∆ﬁ ‘«Õ‰…", global_string, "≈€·«ﬁ", "" ) ;
	}
	else if ( p_info [ playerid ] [ truck_skill ]>= 30000 && p_info [ playerid ] [ truck_skill ] <= 59999 )
	{
		format ( global_string, 186,
		"{ffffff}„” Ê«ﬂ: ‰«ﬁ· (2).\n„ Ê›— ‰ﬁ·: Linerunner, Tanker.\nÕ„Ê·…  „ ‰ﬁ·Â: %d/60000 ﬂÃ„.", p_info [ playerid ] [ truck_skill ] ) ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX,"{"#cBL"}”«∆ﬁ ‘«Õ‰…", global_string, "≈€·«ﬁ", "" ) ;

	}
	else if ( p_info [ playerid ] [ truck_skill ]>= 60000 && p_info [ playerid ] [ truck_skill ] <= 89999 )
	{
		format ( global_string, 186,
		"{ffffff}„” Ê«ﬂ: Œ»Ì— (3).\n„ Ê›— «·”Ì«—« : Linerunner, Tanker, Roadtrain.\nÕ„Ê·…  „ ‰ﬁ·Â: %d/90000 ﬂÃ„.", p_info [ playerid ] [ truck_skill ] ) ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX,"{"#cBL"}”«∆ﬁ ‘«Õ‰…", global_string, "≈€·«ﬁ", "" ) ;

	}
	else
	{
		format ( global_string, 186,
		"{ffffff}„” Ê«ﬂ: International ‰«ﬁ· (4).\n„ Ê›— ‰ﬁ·: Linerunner, Tanker, Roadtrain.\nÕ„Ê·…  „ ‰ﬁ·Â: %d.", p_info [ playerid ] [ truck_skill ] ) ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX,"{"#cBL"}”«∆ﬁ ‘«Õ‰…", global_string, "≈€·«ﬁ", "" ) ;

	}
	return 1 ;
}

