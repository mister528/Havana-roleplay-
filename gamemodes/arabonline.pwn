callback: repairing_vehicle(playerid)
{
    if (  p_info [ playerid ] [ repairkit ]<=0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ’Ì«‰… «·⁄œ….");
	foreach ( new veh_id:streamed_vehicles[playerid])
	{
		if ( IsVehicleInRangeOfPoint ( veh_id, 5.0, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ] ) ){}
		else continue ;
		if ( veh_info [ veh_id - 1 ] [ v_health ] < 1000.0 )
		{
		    SendClientMessage(playerid, col_white, "{"#cGN"}* {"#cWH"}»‰Ã«Õ √’·Õ  «·”Ì«—… «·ﬁ—Ì»….");
			AC_RepairVehicle ( veh_id ) ;
			ClearAnimations ( playerid, 1 ) ;
			toggle_controlable ( playerid, true, false ) ;
			SetCameraBehindPlayer ( playerid ) ;
			me_action ( playerid, " „ «·≈’·«Õ  «·”Ì«—…." ) ;
			p_info [ playerid ] [ repairkit ] -= 1 ;
			update_int_sql ( playerid, "u_repairkit", p_info [ playerid ] [ repairkit ] ) ;
		}
		else
		{
			SendClientMessage(playerid, col_gray,"* «·”Ì«—… «··Ì ﬁ—Ì»… „‰ﬂ „«  Õ «Ã ’Ì«‰… ›Ì √Ã“«∆Â«.");
		}
	}
	return 1;
}

alias:repairkit("rk")
CMD:repairkit ( playerid )
{
    if ( GetPVarInt ( playerid, "PlayerCuffed" ) )
	{
		SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ—  ” Œœ„  ’Ì«‰… «·⁄œ… »Ì‰„« ﬂ»¯·.");
		return 1;
	}
    if (  p_info [ playerid ] [ repairkit ]<=0 ) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ’Ì«‰… «·⁄œ….");
    if ( IsPlayerInAnyVehicle(playerid) ) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}·«“„ ÌﬂÊ‰ Œ«—Ã  «·”Ì«—….");
	foreach ( new veh_id:streamed_vehicles[playerid])
	{
		if ( IsVehicleInRangeOfPoint ( veh_id, 4.0, p_t_info [ playerid ] [ p_pos ] [ 0 ], p_t_info [ playerid ] [ p_pos ] [ 1 ], p_t_info [ playerid ] [ p_pos ] [ 2 ] ) )
		{
			if ( veh_info [ veh_id - 1 ] [ v_health ] < 1000.0 )
			{
			    new engine,lights,alarm,doors,bonnet,boot,objective;
				GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
			    SetVehicleParamsEx ( veh_id, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective ) ;
			    toggle_controlable ( playerid, false, false ) ;
			    SetTimerEx("repairing_vehicle", 6000, 0, "i", playerid);
				ApplyAnimation(playerid,"BD_FIRE","wash_up",4.1,1,0,0,0,0,0);
				SetCameraBehindPlayer ( playerid ) ;
				return 1;
			}
			else
			{
				SendClientMessage(playerid, col_gray,"* «·”Ì«—… «··Ì ﬁ—Ì»… „‰ﬂ „«  Õ «Ã ’Ì«‰… ›Ì √Ã“«∆Â«.");
			}
		}
	}
	return 1 ;
}

