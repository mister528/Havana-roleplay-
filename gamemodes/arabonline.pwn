CMD:oosami(playerid, params[])
{
	if(
		p_info[playerid][admin] < 5)
			return 1;

	extract params -> new weather; else return SendClientMessage(
													playerid,
													col_gray,
													"«·«” Œœ«„: /oosami [1-21]");
	if ( !(1 <= weather <= 21) || weather == 17 )
	{
		SendClientMessage(
			playerid,
			col_gray,
			"«·ÿﬁ” «·„‰’ÊÕ ›ÌÂ: 1, 2, 3, 10, 11, 18 (ÂÊ Ê«÷Õ)");

		SendClientMessage(
			playerid,
			col_gray,
			"«·ÿﬁ” «·„Ê’Ï »Â: 4, 9, 12, 15, 19, 21 (€«∆„)");

		return 1;
	}

	SetWeather(weather);

	new string[256];

	format(
		string,
		sizeof string,
		"√‰  ÷⁄  «·ÿﬁ” {9ACD32}%d",
		weather);

	SendClientMessage(
		playerid,
		-1,
		string);

	format(
		string,
		sizeof string,
		"≈œ«—Ì {FFCC00}%s[%d] {FFFFFF} „  À»Ì Â {9ACD32}%d {FFFFFF}«·”Ì—›— «·ÿﬁ”",
		p_info[playerid][name],
		playerid,
		weather);

	foreach(new i: logged_players)
		SendClientMessage(
			i,
			-1,
			string);

	return 1;
}

