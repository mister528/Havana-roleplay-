stock ZD_SendMessageToPlayersInRound(const message[], color)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && ZD_PlayerTeam[i] != TEAM_NONE)
        {
            SendClientMessage(i, color, message);
        }
    }
}
stock ZD_SendMessageToLobbyPlayers(const message[], color)
{
    for(new i = 0; i < ZD_LobbyCount; i++)
    {
        new playerid = ZD_LobbyPlayers[i];
        if(IsPlayerConnected(playerid))
        {
            SendClientMessage(playerid, color, message);
        }
    }
}
stock ZD_StartCountdown()
{
    if(ZD_IsCountdownActive) return 0;

    ZD_IsCountdownActive = true;
    ZD_CountdownTimeLeft = 30;

    ZD_CountdownTimer = SetTimer("ZD_CountdownTick", 1000, true);

    ZD_SendMessageToLobbyPlayers("6 players reached! Round will start in 30 seconds.", 0x00FF00FF);

    return 1;
}

stock ZD_KickAllLobbyPlayers()
{
    for(new i = 0; i < ZD_LobbyCount; i++)
    {
        new playerid = ZD_LobbyPlayers[i];
        if(IsPlayerConnected(playerid))
        {
            ZD_PlayerTeam[playerid] = TEAM_NONE;
            ZD_HasTurned[playerid] = false;
            ZD_HumanKills[playerid] = 0;
            ZD_ZombieKills[playerid] = 0;

            SetPlayerPos(playerid, ZD_WAIT_POS_X, ZD_WAIT_POS_Y, ZD_WAIT_POS_Z);
            SendClientMessage(playerid, 0xFF0000FF, " „ ≈Œ—«Ãﬂ „‰ «··Ê»Ì.");
        }
    }
    ZD_LobbyCount = 0;
    return 1;
}

