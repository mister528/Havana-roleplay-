CMD:exitrace ( playerid )
{
	if(!is_player_race_regged[playerid]) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  „Ê ›Ì  «·”»«ﬁ.");
	is_player_race_regged[playerid] = 0;
	PlayerRaceCount--;
	if(StartRace == 2)
 	{
		AC_DestroyVehicle(player_race_vehicle[playerid]);
		DisableRemoteVehicleCollisions(playerid, 0);
		DisablePlayerRaceCheckpoint(playerid);
		set_pos ( playerid, 1298.1658, -1360.8027, 35.8113, 21.7293, 0, 5 ) ;
		player_race_cp[playerid] =
		player_race_vehicle[playerid] = 0;
	}
	SendClientMessage ( playerid, col_white, !"{"#cGN"}* {"#cWH"}‰ÃÕ  ›Ì Ì”«—  «·”»«ﬁ." ) ;
	return 1;
}

CMD:exitpaint(playerid )
{
    if(!TeamPaint[playerid]) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„Ê ⁄÷Ê ›Ì PaintBall.");
	if(StartPaintBall == 2)
	{
 		set_health ( playerid, 100 ) ;
		reset_player_weapon ( playerid ) ;
		SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;

		set_pos ( playerid, 1298.1658, -1360.8027, 35.8113, 21.7293, 0, 5);
		TextDrawHideForPlayer(playerid, PaintTextDraws);
		PlayerTextDrawHide(playerid, PaintStats[playerid] ) ;
		//for ( new j = 0 ; j < 8 ; j ++ ) SendDeathMessageToPlayer ( playerid, 1001, 1001, 200 ) ;
		KillPaint[playerid] =
		DeathPaint[playerid] = 0;
	}
	switch(TeamPaint[playerid])
	{
	    case 1: BluePlayer--;
	    case 2: RedPlayer--;
	}
	TeamPaint[playerid] = 0;
	SendClientMessage ( playerid, col_white, !"{"#cGN"}* {"#cWH"}»‰Ã«Õ ÿ·⁄  „‰ PaintBall." ) ;

	if ( is_fraction_duty { playerid } == 1 ) SetPlayerColor ( playerid, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;
	else SetPlayerColor ( playerid, 0xFFFFFF80 ) ; // col_white
	return 1;
}


CMD:startpaint ( playerid )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	////if(p_info[playerid][id] != 1 ) return true;

	TimerPaintBall = 300 ;
	StartPaintBall = 1 ;
	RedScore = BlueScore = RedPlayer = BluePlayer = 0 ;

	if ( ++ PaintBallMap > 2 ) PaintBallMap = 1 ;
	foreach(new i: logged_players)
	{
		if ( TeamPaint [ i ] )
		{
			TeamPaint [ i ] = KillPaint [ i ] = DeathPaint [ i ] = 0 ;
			set_pos ( i, 1298.1658, -1360.8027, 35.8113, 21.7293, 0, 5 ) ;
		}
	}
	SendClientMessageToAll( col_yellow, "* »⁄œ 5 œﬁ«Ìﬁ ”Ì»œ√ ÕœÀ \"PaintBall\". (/GPS > ¬Œ— > «· ”ÃÌ· ··√Õœ«À)");
	return true;
}

CMD:startrace ( playerid )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	////if(p_info[playerid][id] != 1 ) return true;

	TimerRace = 300;
	StartRace = 1;
	RaceCountWinner =
	PlayerRaceCount = 0;
	RaceVehicle = Race_Car[random(18)];
	if(++RaceMap > 9) RaceMap = 1;
	foreach(new i: logged_players)
	{
		if(is_player_race_regged[i])
		{
			AC_DestroyVehicle ( player_race_vehicle[i] ) ;
			player_race_vehicle[i] =
			is_player_race_regged[i] =
			player_race_cp[i] = 0;
			DisableRemoteVehicleCollisions ( i, 0 ) ;
			set_pos ( i, 1298.1658, -1360.8027, 35.8113, 21.7293, 0, 5 ) ;
		}
	}
	SendClientMessageToAll( col_yellow, "* »⁄œ 5 œﬁ«Ìﬁ ”Ì»œ√ ÕœÀ \"«·”»«ﬁ\". (/GPS > ¬Œ— > «· ”ÃÌ· ··√Õœ«À)");
	return true;
}

CMD:updorms(playerid, params[])
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;

	dorm_count [ DORM_SAWMILL ] = dorm_count [ DORM_MINE ] = dorm_count [ DORM_FACTORY_GUNS ] = dorm_count [ DORM_FACTORY_MINE ]= dorm_count [ DORM_FACTORY_WOOD ] = 1000000 ;
	return 1 ;
}

CMD:setwarehouse(playerid, params[])
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /setwarehouse [«·„‰Ÿ„…] [«·—ﬁ„]" ) ;
	if ( params [ 0 ] < 0 || params [ 0 ] > fraction_count ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}—ﬁ„ «·„‰Ÿ„… €Ì— ’ÕÌÕ." ) ;
	if ( params [ 1 ] < 0 || params [ 1 ] > 300000 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}—ﬁ„ «·„‰Ÿ„… €Ì— ’ÕÌÕ." ) ;
	f_info [ params [ 0 ] - 1 ] [ f_materials ] = params [ 1 ] ;
	f_info [ params [ 0 ] - 1 ] [ f_guns ] = params [ 1 ] ;

	new query_string [ 136 ];
	format ( query_string, 136, "UPDATE `fractions` SET `f_materials` = '%d',`f_guns` = '%d' WHERE `f_id` = '%d' LIMIT 1",
	f_info [ params [ 0 ] - 1 ] [ f_materials ], f_info [ params [ 0 ] - 1 ] [ f_guns ], params [ 0 ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;

	format ( query_string, sizeof ( query_string  ), "{"#cBL"}* {"#cGR"} %s[%i] ⁄‰œ √⁄«œ „·¡  «·„” Êœ⁄ %s „⁄ «·√”·Õ…", p_info [ playerid ] [ name ], playerid, f_info [ params [ 0 ] - 1 ] [ f_name ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_gray, query_string ) ;

	if ( params [ 0 ] >= 18 && params [ 0 ] <= 25 )update_gdorm_text ( params [ 0 ] ) ;
	return 1 ;
}

CMD:setmoneyhouse(playerid, params[])
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /setmoneyhouse [«·„‰Ÿ„…] [«·—ﬁ„]" ) ;
	if ( params [ 0 ] < 0 || params [ 0 ] > fraction_count ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}—ﬁ„ «·„‰Ÿ„… €Ì— ’ÕÌÕ." ) ;
	if ( params [ 1 ] < 0 || params [ 1 ] > 5000000 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}—ﬁ„ «·„‰Ÿ„… €Ì— ’ÕÌÕ." ) ;

	f_info [ params [ 0 ] - 1 ] [ f_money ] = params [ 1 ] ;


	new query_string [ 136 ];
	format ( query_string, 136, "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '%d' LIMIT 1",
	f_info [ params [ 0 ] - 1 ] [ f_money ], params [ 0 ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;

	format ( query_string, sizeof ( query_string  ), "{"#cBL"}* {"#cGR"} %s[%i] funded «·„‰Ÿ„… %s", p_info [ playerid ] [ name ], playerid, f_info [ params [ 0 ] - 1 ] [ f_name ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_gray, query_string ) ;

	if ( params [ 0 ] >= 18 && params [ 0 ] <= 25 )update_gdorm_text ( params [ 0 ] ) ;
	return 1 ;
}

alias:rlk("rlock")
CMD:rlk ( playerid )
{
	// [HOUSE GUARD v12.1] Also let /rlock close the House Guard van
	// when the player is in it or right next to it.
	if ( g_house_guard_vehicle [ playerid ] != INVALID_VEHICLE_ID )
	{
		new Float:_hg_px, Float:_hg_py, Float:_hg_pz;
		GetPlayerPos ( playerid, _hg_px, _hg_py, _hg_pz );
		if ( GetPlayerVehicleID ( playerid ) == g_house_guard_vehicle [ playerid ]
		  || IsVehicleInRangeOfPoint ( g_house_guard_vehicle [ playerid ], 3.0, _hg_px, _hg_py, _hg_pz ) )
		{
			new _hg_eng, _hg_lit, _hg_alm, _hg_dor, _hg_bnt, _hg_bot, _hg_obj;
			GetVehicleParamsEx ( g_house_guard_vehicle [ playerid ], _hg_eng, _hg_lit, _hg_alm, _hg_dor, _hg_bnt, _hg_bot, _hg_obj );
			new _hg_locked = veh_info [ g_house_guard_vehicle [ playerid ] - 1 ] [ v_locked ];
			if ( _hg_locked )
			{
				veh_info [ g_house_guard_vehicle [ playerid ] - 1 ] [ v_locked ] = false;
				SetVehicleParamsEx ( g_house_guard_vehicle [ playerid ], _hg_eng, _hg_lit, _hg_alm, false, _hg_bnt, _hg_bot, _hg_obj );
				GameTextForPlayer ( playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~ › Õ «·›«‰", 3000, 3 );
				me_action ( playerid, "› Õ »«» «·›«‰" );
			}
			else
			{
				veh_info [ g_house_guard_vehicle [ playerid ] - 1 ] [ v_locked ] = true;
				SetVehicleParamsEx ( g_house_guard_vehicle [ playerid ], _hg_eng, _hg_lit, _hg_alm, true, _hg_bnt, _hg_bot, _hg_obj );
				GameTextForPlayer ( playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ ﬁ›· «·›«‰", 3000, 3 );
				me_action ( playerid, "√€·ﬁ »«» «·›«‰" );
			}
			PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 );
			return 1;
		}
	}
	if ( player_rentcar [ playerid ] == INVALID_VEHICLE_ID ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« «·≈ÌÃ«— ”Ì«—…." ) ;

	if ( player_rentcar [ playerid ] == GetPlayerVehicleID ( playerid ) )
	{
		PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;
		if ( veh_info [ player_rentcar [ playerid ] - 1 ] [ v_locked ] )
		{
			new engine, lights, alarm, doors, bonnet, boot, objective ;

			veh_info [ player_rentcar [ playerid ] - 1 ] [ v_locked ] = false ;
			GetVehicleParamsEx ( player_rentcar [ playerid ], engine, lights, alarm, doors, bonnet, boot, objective ) ;
			SetVehicleParamsEx ( player_rentcar [ playerid ], engine, lights, alarm, false, bonnet, boot, objective ) ;
			GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~ › Õ «·”Ì«—…", 3000, 3 ) ;
			me_action ( playerid, " „ › Õ «·‰ﬁ·" ) ;
			return 1 ;
		}
		else
		{
			new engine, lights, alarm, doors, bonnet, boot, objective ;

			veh_info [ player_rentcar [ playerid ] - 1 ] [ v_locked ] = true ;
			GetVehicleParamsEx ( player_rentcar [ playerid ], engine, lights, alarm, doors, bonnet, boot, objective ) ;
			SetVehicleParamsEx ( player_rentcar [ playerid ], engine, lights, alarm, true, bonnet, boot, objective ) ;
			GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ ﬁ›· «·”Ì«—…", 3000, 3 ) ;
			me_action ( playerid, " „ ≈€·«ﬁ «·‰ﬁ·" ) ;
			return 1 ;
		}
	}
	new Float:pl_pos_x,
		Float:pl_pos_y,
		Float:pl_pos_z ;

	GetPlayerPos ( playerid, pl_pos_x, pl_pos_y, pl_pos_z ) ;

	if ( IsVehicleInRangeOfPoint ( player_rentcar [ playerid ], 2.5, pl_pos_x, pl_pos_y, pl_pos_z ) )
	{
		PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;
		if ( veh_info [ player_rentcar [ playerid ] - 1 ] [ v_locked ] )
		{
			new engine, lights, alarm, doors, bonnet, boot, objective ;

			veh_info [ player_rentcar [ playerid ] - 1 ] [ v_locked ] = false ;
			GetVehicleParamsEx ( player_rentcar [ playerid ], engine, lights, alarm, doors, bonnet, boot, objective ) ;
			SetVehicleParamsEx ( player_rentcar [ playerid ], engine, lights, alarm, false, bonnet, boot, objective ) ;
			GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~ › Õ «·”Ì«—…", 3000, 3 ) ;
			me_action ( playerid, " „ › Õ «·‰ﬁ·" ) ;
			return 1 ;
		}
		else
		{
			new engine, lights, alarm, doors, bonnet, boot, objective ;

			veh_info [ player_rentcar [ playerid ] - 1 ] [ v_locked ] = true ;
			GetVehicleParamsEx ( player_rentcar [ playerid ], engine, lights, alarm, doors, bonnet, boot, objective ) ;
			SetVehicleParamsEx ( player_rentcar [ playerid ], engine, lights, alarm, true, bonnet, boot, objective ) ;
			GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ ﬁ›· «·”Ì«—…", 3000, 3 ) ;
			me_action ( playerid, " „ ≈€·«ﬁ «·‰ﬁ·" ) ;
			return 1 ;
		}
	}
	return 1 ;
}

