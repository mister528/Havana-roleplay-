CMD:phone_money ( playerid, params [ ] )
{
	new uid, amount ;
	if ( sscanf ( params, "dd", uid, amount ) ) return 1 ;
	if ( amount <= 0 ) return PhonePush ( playerid, "STATUS|«·„»·€ €Ì— ’ÕÌÕ." ) ;
	new targetid = PhoneFindOnlineByUid ( uid ) ;
	if ( ! PhoneAreFriendsByUid ( playerid, uid ) ) return PhonePush ( playerid, "STATUS|Â–« «··«⁄» ·Ì” ›Ì √’œﬁ«∆ﬂ." ) ;
	new target_name [ MAX_PLAYER_NAME ] ;
	if ( ! PhoneGetAccountNameByUid ( uid, target_name ) ) return PhonePush ( playerid, "STATUS|«·Õ”«» €Ì— „ÊÃÊœ." ) ;
	if ( p_info [ playerid ] [ bank ] < amount ) return PhonePush ( playerid, "STATUS|·« ÌÊÃœ —’Ìœ ﬂ«›Ì ›Ì «·»‰ﬂ." ) ;
	new query [ 360 ] ;
	p_info [ playerid ] [ bank ] -= amount ;
	update_int_sql ( playerid, "u_bank", p_info [ playerid ] [ bank ] ) ;
	if ( targetid != INVALID_PLAYER_ID )
	{
		p_info [ targetid ] [ bank ] += amount ;
		update_int_sql ( targetid, "u_bank", p_info [ targetid ] [ bank ] ) ;
	}
	else
	{
		mysql_format ( sql_connection, query, sizeof ( query ), "UPDATE `users` SET `u_bank`=`u_bank`+'%d' WHERE `u_id`='%d' LIMIT 1", amount, uid ) ;
		mysql_tquery ( sql_connection, query, "", "" ) ;
	}
	format ( query, sizeof ( query ), "INSERT INTO `players_phone_transfers` (`from_uid`,`to_uid`,`amount`) VALUES ('%d','%d','%d')", p_info [ playerid ] [ id ], uid, amount ) ;
	mysql_tquery ( sql_connection, query, "", "" ) ;
	format ( query, sizeof ( query ), "INSERT INTO `players_phone_messages` (`from_uid`,`to_uid`,`message_type`,`message_text`,`amount`) VALUES ('%d','%d','2','MONEY','%d')", p_info [ playerid ] [ id ], uid, amount ) ;
	mysql_tquery ( sql_connection, query, "", "" ) ;
	PhonePushMessage ( playerid, uid, target_name, 1, 2, "MONEY", amount ) ;
	if ( targetid != INVALID_PLAYER_ID ) PhonePushMessage ( targetid, p_info [ playerid ] [ id ], p_info [ playerid ] [ name ], 0, 2, "MONEY", amount ) ;
	new payload [ 64 ] ;
	format ( payload, sizeof ( payload ), "BANK|%d", p_info [ playerid ] [ bank ] ) ;
	PhonePush ( playerid, payload ) ;
	if ( targetid != INVALID_PLAYER_ID )
	{
		format ( payload, sizeof ( payload ), "BANK|%d", p_info [ targetid ] [ bank ] ) ;
		PhonePush ( targetid, payload ) ;
	}
	return 1 ;
}

