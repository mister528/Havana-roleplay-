CMD:givedonate(playerid, params[])
{
	if(p_info [playerid][admin] < 8) return 0;
	new
		targetid,
		donate;
		
	//if(p_info[playerid][id] != 1 ) return true;
	if(sscanf(params, "dd", targetid, donate))
		return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}«·«” Œœ«„: /givedonate [playerid] [ »—⁄]");

	if(!(1 <= donate <= 1000))
		return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}  »—⁄ «·„»·€ „« ·«“„ ÌﬂÊ‰ √ﬁ· „‰ 1 Ê √ﬂÀ— „‰ 1,000  »—⁄ ⁄„·« !");

	if(0 == IsPlayerConnected(targetid))
		return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}«··«⁄» „Ê „ ’·!");

	static const str[] = "Administrator %s[%d] gave you a donation in the amount of %d donate coins. Have a nice time on the project!";
	new fmt_str[sizeof(str) - 6 + MAX_PLAYER_NAME + 1];

	format(fmt_str, sizeof(fmt_str), str, p_info[playerid][name],
										  playerid,
										  donate);

	SendClientMessage(targetid, col_gray, fmt_str);

	static const str1[] = "You gave the player %s[%d] donations in the amount of %d donate coins";
	new fmt_str1[sizeof(str1) - 6 + MAX_PLAYER_NAME + 1 + 11 * 3];
	format(fmt_str1, sizeof(fmt_str1), str1, p_info[targetid][name],
											 targetid,
											 donate);
	SendClientMessage(playerid, -1, fmt_str1);

	static query[] = "UPDATE `users` SET users.u_donate = users.u_donate + %d WHERE users.u_name = '%e'";
	new fmt_query[sizeof(query) + MAX_PLAYER_NAME + 1 - 2];
	mysql_format(sql_connection, fmt_query, sizeof(fmt_query), query,
																	  donate,
																	  p_info[targetid][name]);
	mysql_tquery(sql_connection, fmt_query, "", "");
	
	format(global_string, 128,"%s  »—⁄ %s %d  »—⁄« ", p_info[playerid][name], p_info[targetid][name], donate);
	WriteLog(TYPE_LOG_ADMIN, global_string);
	return 1;
}

CMD:destroyveh( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ admin ] < 8 )return -1 ;
	if ( sscanf ( params, "d", params[0] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /destroyveh [id «·”Ì«—…]");

	new scm_string [ 128 ];
	format ( scm_string, sizeof ( scm_string  ), "{"#cBL"}*  {"#cGR"}%s  . ID: %d", p_info [ playerid ] [ name ], params[0] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_gray, scm_string ) ;

	AC_DestroyVehicle ( params[0] ) ;
	return true;
}

