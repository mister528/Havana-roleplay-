	    SendClientMessage(playerid, col_green,"* {ffffff}‰ÃÕ  ›Ì «·Â—Ê» „‰ „ÿ«—œ… «·‘—ÿ…");
	    SendClientMessage(Chase[playerid], 0xFF0000FF,"* {ffffff}›‘·  ›Ì «·ﬁ»÷ ⁄·Ï «·„Ã—„ »«·„·«Õﬁ…");
	    ChaseTimer[playerid] = 0;
	    Chase[playerid] = -1;
	    OnlyChase[playerid] = 0;
	}
	if ( GetPlayerState(playerid) == PLAYER_STATE_PASSENGER && ( GetPlayerWeapon( playerid ) == 24 || GetPlayerWeapon( playerid ) == 25 || GetPlayerWeapon( playerid ) == 31 ) ) SetPlayerArmedWeapon ( playerid, 0 ) ;

	if ( p_info [ playerid ][ MissionSix ] == 1 && p_info [ playerid ] [ MissionSixCount ] >= 12)
	{
		p_info[playerid][MissionSix] = 2;
		new query_strinsg [ 600 ];
		mysql_format ( sql_connection, query_strinsg, sizeof query_strinsg, "UPDATE `users` SET `MissionSix`='2' WHERE `u_id`='%d'", p_info[playerid][id] ) ;
		mysql_tquery ( sql_connection, query_strinsg ) ;
		p_info[playerid][MissionSixCount] = 0;
		new query_string [ 600 ];
		mysql_format ( sql_connection, query_string, sizeof query_string, "UPDATE `users` SET `MissionSixCount`='0' WHERE `u_id`='%d'", p_info[playerid][id] ) ;
		mysql_tquery ( sql_connection, query_string ) ;
		SendClientMessage(playerid, col_green, "* {ffffff}√‰ÂÌ  „Â„ ﬂ »‰Ã«Õ {"#cGN"}«·‘€· ﬂ‹ ⁄«„· „‰Ã„'{ffffff}, —ÊÕ ≈·Ï «·‘Œ’Ì… ›Ì «·ŸÂ— ⁄‘«‰  «Œ– „ﬂ«›¬ ﬂ.");
	}
	if ( p_info [ playerid ][ MissionSeven ] == 1 && p_info [ playerid ] [ MissionSevenCount ] >= 12)
	{
		p_info[playerid][MissionSeven] = 2;
		new query_strinsg [ 600 ];
		mysql_format ( sql_connection, query_strinsg, sizeof query_strinsg, "UPDATE `users` SET `MissionSeven`='2' WHERE `u_id`='%d'", p_info[playerid][id] ) ;
