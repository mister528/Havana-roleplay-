					action_type { playerid } = ACTION_GRAFFITY ;
					action_step { playerid } = 0 ;
					action_td_status ( playerid, true ) ;

					ApplyAnimation(playerid, "SPRAYCAN", "spraycan_full", 4.0, 1, 1, 1, 0, 0, 1);
				}
			}
		}
	}
	return 1 ;
}
public OnPlayerStateChange ( playerid, newstate, oldstate )
{
    Fisherman_OnPlayerStateChange(playerid, newstate, oldstate);
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerStateChange] playerid:%d | newstate:%d | oldstate:%d", playerid, newstate, oldstate ) ;
	#endif
	ac_test_OnPlayerStateChange ( playerid, newstate, oldstate ) ;
	if (oldstate == PLAYER_STATE_DRIVER && newstate != PLAYER_STATE_DRIVER)
	{
		new _trent_last_vid = GetPVarInt(playerid, "_trent_last_drv");
		if (_trent_last_vid > 0)
		{
			new _trent_slot = trent_find_by_vehid(_trent_last_vid);
			if (_trent_slot >= 0 && g_trent_owner[_trent_slot] == playerid && g_trent_pinned[_trent_slot])
			{
				new Float:_tpx, Float:_tpy, Float:_tpz, Float:_tpa;
				GetVehiclePos(_trent_last_vid, _tpx, _tpy, _tpz);
				GetVehicleZAngle(_trent_last_vid, _tpa);
				g_trent_pin_pos[_trent_slot][0] = _tpx;
				g_trent_pin_pos[_trent_slot][1] = _tpy;
				g_trent_pin_pos[_trent_slot][2] = _tpz;
				g_trent_pin_pos[_trent_slot][3] = _tpa;
			}
		}
		SetPVarInt(playerid, "_trent_last_drv", 0);
	}
	if (newstate == PLAYER_STATE_DRIVER)
	{
		SetPVarInt(playerid, "_trent_last_drv", GetPlayerVehicleID(playerid));
		new _hg_vid = GetPlayerVehicleID(playerid);
		for (new _hg_i = 0; _hg_i < MAX_PLAYERS; _hg_i++)
		{
			if (g_house_guard_vehicle[_hg_i] == _hg_vid && _hg_i != playerid)
			{
				RemovePlayerFromVehicle(playerid);
				SendClientMessage(playerid, col_gray, "{FF5555}* {FFFFFF}”Ì«—… Õ«—” «·„‰“· Â–« „Ê ”Ì«— ﬂ.");
				return 1;
			}
		}
	}
    /*if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING && p_info[playerid][admin] == 0 && p_t_info[playerid][p_logged])
    {
        anti_cheat(playerid,"Invisable hack",014);
    }
    if(newstate == PLAYER_STATE_DRIVER)
    {
        if((GetTickCount()-GetPVarInt(playerid, "cartime")) < 1000)
        {
            SetPVarInt(playerid, "carspam", GetPVarInt(playerid, "carspam")+1);
            if(GetPVarInt(playerid, "carspam") >= 5)
            {
                anti_cheat(playerid, "Vehicle spam",162);
            }
        }
        SetPVarInt(playerid, "cartime", GetTickCount());
    }*/
	if ( oldstate == 2 && p_t_info [ playerid ] [ pveh ] != -1 )
	{
		AC_DestroyVehicle ( p_t_info [ playerid ] [ pveh ] );
		p_t_info [ playerid ] [ pveh ] = -1 ;
	}

	if ( eev_called { playerid } == 0 && newstate == PLAYER_STATE_DRIVER )
	{
		new vehicle_id = GetPlayerVehicleID ( playerid ) ;
		AC_SetVehiclePos ( vehicle_id, veh_info [ vehicle_id - 1 ] [ v_pos ] [ 0 ], veh_info [ vehicle_id - 1 ] [ v_pos ] [ 1 ], veh_info [ vehicle_id - 1 ] [ v_pos ] [ 2 ] ) ;

	}
	if(oldstate == 2 || oldstate == 3)
	{
		new Float:x, Float:y, Float:z;
		GetPlayerPos(playerid, x, y, z);
		new Float:dif = GetDistanceBetweenPoints(x, y, 0.0, p_t_info [playerid][ old_pos ][0], p_t_info [playerid][ old_pos ][1], 0.0);
		if(dif < 100)
		{
			p_t_info [ playerid ] [ old_pos ] [ 0 ] = x ;
			p_t_info [ playerid ] [ old_pos ] [ 1 ] = y ;
			p_t_info [ playerid ] [ old_pos ] [ 2 ] = z ;
		}
	}
	if(newstate == PLAYER_STATE_DRIVER)
	{
		new idveh = GetPlayerVehicleID(playerid);
		if(GetVehicleModel ( idveh ) == 508)
		{
			for(new i = 0; i < totaltrailers; i++) 
			{
				if(idveh == TrailerInfo[i][d_trailer] && strcmp(TrailerInfo[i][d_owner],p_info[playerid][name]))
				{
					new temporary[88];
					format(temporary,sizeof(temporary),"Â–« «·„ﬁÿÊ—… belongs ≈·Ï  resident {00FF7F}%s",TrailerInfo[i][d_owner]);
					SendClientMessage(playerid,COLOR_GREY,temporary);
					RemovePlayerFromVehicle(playerid);
					break;
				}
				if(!strcmp(TrailerInfo[i][d_owner],p_info[playerid][name]))
				{
					if(veh_info[idveh - 1][v_fuel] < 1)
						veh_info[idveh - 1][v_fuel] = 60;
				}
			}
		}
	}

	if ( newstate == PLAYER_STATE_PASSENGER && ( GetPlayerWeapon( playerid ) == 24 || GetPlayerWeapon( playerid ) == 25 ) ) SetPlayerArmedWeapon ( playerid, 0 ) ;
	foreach(new i: admin_players)
	{
		if ( GetPVarInt ( i, "spectate_status" ) - 1 == playerid )
		{
			switch ( GetPlayerState ( playerid ) )
			{
				case 1:
				{
					SetPlayerInterior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					SetPlayerVirtualWorld ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					AC_TogglePlayerSpectating ( i, true ) ;
					PlayerSpectatePlayer ( i, playerid ) ;
				}
				case 2:
				{
					SetPlayerInterior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					SetPlayerVirtualWorld ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					AC_TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle ( i, veh_id ) ;
				}
				case 3:
				{
					SetPlayerInterior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					SetPlayerVirtualWorld ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					AC_TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle (i, veh_id ) ;
				}
			}
		}
	}

	switch ( newstate )
	{
		case PLAYER_STATE_PASSENGER:
		{
			DeletePVar ( playerid,"removetimer" ) ;
			new _v_id = GetPlayerVehicleID(playerid);

			if ( veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_job && veh_info [ _v_id - 1 ] [ v_owner ] == job_taxi && veh_info [ _v_id - 1 ] [ v_driver ] != INVALID_PLAYER_ID )
			{
				new driverid = veh_info [ _v_id - 1 ] [ v_driver ] ;
				if( player_rentcar [ driverid ] != _v_id || ! p_t_info [ driverid ] [ pTaxiPrice ] ) return 1;
				if(p_t_info [ driverid ] [ pTaxiPass ] == INVALID_PLAYER_ID)
				{
					if( p_info [ playerid ] [ money ] < p_t_info [ driverid ] [ pTaxiPrice ] )
					{
						SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ›·Ê” ﬂ«›Ì… ·«Œ– «· «ﬂ”Ì.");
						return RemovePlayerFromVehicle(playerid);
					}
					p_t_info [driverid][pTaxiStart] = veh_info [ _v_id - 1 ] [ v_millage ];
					p_t_info[driverid][pTaxiPass] = playerid;
					p_t_info[driverid][pTaxiGoing] = true;
					SetPVarInt ( playerid, "taxi_driver_id", driverid ) ;
					show_dialog ( playerid, d_taxi_mark, DIALOG_STYLE_LIST, "{"#cBL"}”«∆ﬁ  «ﬂ”Ì «·‰«›ÌÃ« Ê—", "{"#cBL"}1. {"#cWH"}Õÿ ·«› … ⁄·Ï «·Œ—Ìÿ…\n{"#cBL"}2. {" #cWH"}Õÿ «·⁄·«„… „‰ „—‘œ GPS\n{"#cGR"}„ «»⁄… —Õ·… »œÊ‰ «·‰«›ÌÃ« Ê—", "«Œ —", "≈€·«ﬁ" ) ;
				}
				else
				{
					if(p_t_info [driverid][pTaxiTurn][0] == INVALID_PLAYER_ID) p_t_info [driverid][pTaxiTurn][0] = playerid;
					else if(p_t_info [driverid][pTaxiTurn][1] == INVALID_PLAYER_ID) p_t_info [driverid][pTaxiTurn][1] = playerid;
					else
					{
						if(!IsPlayerConnected(p_t_info [driverid][pTaxiTurn][0]) || GetPlayerVehicleID(p_t_info [driverid][pTaxiTurn][0]) != _v_id)
						{
							if(p_t_info [ driverid ] [ pTaxiTurn ] [ 1 ] != INVALID_PLAYER_ID)
							{
								p_t_info [driverid][pTaxiTurn][0] = p_t_info [driverid][pTaxiTurn][1];
								p_t_info [driverid][pTaxiTurn][1] = playerid;
							}
							else p_t_info [driverid][pTaxiTurn][0] = playerid;
						}
						else if(!IsPlayerConnected(p_t_info [driverid][pTaxiTurn][1]) || GetPlayerVehicleID(p_t_info [driverid][pTaxiTurn][1]) != _v_id)
						{
							p_t_info [driverid][pTaxiTurn][1] = playerid;
						}
						else
						{
							SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}«—ﬂ» «· «ﬂ”Ì „—… À«‰Ì…° ’«— Œÿ√.");
							RemovePlayerFromVehicle(playerid);
						}
					}
				}
			}
			if ( veh_info [ _v_id - 1 ] [ v_type ] == vehicle_type_job && veh_info [ _v_id - 1 ] [ v_owner ] == job_bus && veh_info [ _v_id - 1 ] [ v_driver ] != INVALID_PLAYER_ID )
			{
				new driverid = veh_info [ _v_id - 1 ] [ v_driver ] ;
				if ( player_rentcar [ driverid ] != _v_id || ! p_t_info [ driverid ] [ pBusPrice ] ) return 1;
				new price = p_t_info[driverid][pBusPrice];

				if ( p_info [ playerid ] [ money ] < price ) return me_action ( playerid, "⁄—÷  –ﬂ—… ··”«∆ﬁ");
				give_money ( driverid, price ) ;
				give_money ( playerid, -price ) ;
				insert_money_log ( driverid, playerid, price, "bus driver") ;

				new string [ 9 ] ;
				format ( string, sizeof ( string ), "~b~+%i$", price ) ;
				GameTextForPlayer ( driverid, string, 1000, 1 ) ;
				format ( string, sizeof ( string ), "~r~-%i$", price ) ;
				GameTextForPlayer ( playerid,string,1000, 1 ) ;
			}
		}
		case PLAYER_STATE_DRIVER:
		{
			SetPlayerArmedWeapon ( playerid, 0 ) ;
			DeletePVar ( playerid,"removetimer" ) ;
			new veh_id = GetPlayerVehicleID ( playerid ) ;
			player_vehicle[ playerid ] = veh_id ;

            if(InBuilder[playerid] == 1)
			{
				if(IsPlayerAttachedObjectSlotUsed ( playerid, 0 )) RemovePlayerAttachedObject ( playerid, 0 ) ;
			    ClearAnimations ( playerid,  1 ) ;
			   	if ( is_fraction_duty { playerid } == 1 ) SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ), SetPlayerColor ( playerid, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;
				else SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;
				SendClientMessage(playerid, col_green, "* {ffffff}ﬂ„¯·  œÊ«„ ‘€·ﬂ");
			    new string[128];
			    format(string, sizeof(string), "{"#cGN"}* {ffffff}«·√—»«Õ: {"#cGN"}%d$",p_info[playerid][salary]);
				SendClientMessage(playerid, col_green, string);
			    InBuilder[playerid] = 0;
				DisablePlayerRaceCheckpoint(playerid);
				DeletePVar(playerid, "PutBuild");
				DeletePVar(playerid, "TakedBuild");
				hide_payment ( playerid ) ;
				give_money ( playerid, p_info[playerid][salary] ) ;
			    p_info[playerid][salary] = 0;
				update_int_sql(playerid, "u_salary", p_info[playerid][salary]);
				SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}œŒ·  ”Ì«—…/„Ê Ê— ÊŒ·’  ‘€·ﬂ." ) ;
			}

			veh_info [ veh_id - 1 ] [ v_driver ] = playerid ;

			if(veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_family_1)
			{
			    //if ( p_info [ playerid ] [ family_rang ] <  family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_settings ] [ 4 ] )return 1 ;
			    if(p_info[playerid][family]+566 != veh_info[veh_id-1][v_owner])
			    {
				    SendClientMessage ( playerid, 0xACACACFF,"√‰  ·”  ⁄÷Ê« ›Ì Â–Â «·⁄«∆·…!" ) ;
					RemovePlayerFromVehicle ( playerid ) ;
				}
				if ( p_info [ playerid ] [ family_rang ] <  family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_settings ] [ 4 ] )
				{
				    SendClientMessage ( playerid, 0xACACACFF,"— » ﬂ ›Ì «·⁄«∆·… „«  ŒÊ¯·ﬂ  œŒ· ”Ì«—«  «·⁄«∆·…!" ) ;
					RemovePlayerFromVehicle ( playerid ) ;
				}
				return 1;
			}
			
			else if(veh_info [ veh_id - 1 ] [ v_type ] == vehicle_type_family_2)
			{
			    //if ( p_info [ playerid ] [ family_rang ] <  family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_settings ] [ 4 ] )return 1 ;
			    if(p_info[playerid][family]+567 != veh_info[veh_id-1][v_owner])
			    {
				    SendClientMessage ( playerid, 0xACACACFF,"√‰  ·”  ⁄÷Ê« ›Ì Â–Â «·⁄«∆·…!" ) ;
					RemovePlayerFromVehicle ( playerid ) ;
				}
				if ( p_info [ playerid ] [ family_rang ] <  family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_settings ] [ 4 ] )
				{
				    SendClientMessage ( playerid, 0xACACACFF,"— » ﬂ ›Ì «·⁄«∆·… „«  ŒÊ¯·ﬂ  œŒ· ”Ì«—«  «·⁄«∆·…!" ) ;
					RemovePlayerFromVehicle ( playerid ) ;
				}
				return 1;
			}
           
