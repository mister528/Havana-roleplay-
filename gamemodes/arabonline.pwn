CMD:vacancy(playerid)
{
    new vacancies = 0;
    new string [ 6 + 28 + 16 ] ;
	global_string [ 0 ] = EOS ;
	for(new i = 0; i < 10; i++)
	{
	    if(VacancyInfo[i][VacancyStatus])
		{
			format(string, sizeof(string), "{ffffff}%d. {%s}%s\n", vacancies + 1, f_info [VacancyInfo[i][VacancyFraction]-1] [ f_chat_color ], f_info [VacancyInfo[i][VacancyFraction]-1] [ f_name ] ) ;
			strcat(global_string, string);
	        vacancies++;
	    }
	}
	if(vacancies != 10 && p_info [ playerid ] [ leader ] != 0)
	{
	    strcat(global_string, " ");
	  	return show_dialog ( playerid, d_vacancy, DIALOG_STYLE_LIST, "{"#cBL"} ≈œ«—… «·ÊŸ«∆› «·‘«€—…", global_string, "«· «·Ì", "≈€·«ﬁ" ) ;
	}
	if(vacancies == 0)
		return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"} „« ›Ì ÊŸ«∆› „ «Õ… «·ÕÌ‰." ) ;

	return show_dialog ( playerid, d_vacancy, DIALOG_STYLE_LIST, "{"#cBL"} «·ÊŸ«∆› «·„ «Õ…", global_string, "«· «·Ì", "≈€·«ﬁ" ) ;
}

CMD:fstyle(playerid)
{
	global_string [ 0 ] = EOS ;
	
	new StatsLevel[3][50];
	if(p_info[playerid][stats][1] <= 10) StatsLevel[1] = "{FF4500} {FFFFFF}";
	else if(p_info[playerid][stats][1] <= 30) StatsLevel[1] = "{FF8C00}{FFFFFF}";
	else if(p_info[playerid][stats][1] <= 70) StatsLevel[1] = "{FFD00F}{FFFFFF}";
	else if(p_info[playerid][stats][1] <= 90) StatsLevel[1] = "{ADFF2F}{FFFFFF}";
	else StatsLevel[1] = "{008000} {FFFFFF}";
	if(p_info[playerid][stats][2] <= 10) StatsLevel[2] = "{FF4500} {FFFFFF}";
	else if(p_info[playerid][stats][2] <= 30) StatsLevel[2] = "{FF8C00}{FFFFFF}";
	else if(p_info[playerid][stats][2] <= 70) StatsLevel[2] = "{FFD00F}{FFFFFF}";
	else if(p_info[playerid][stats][2] <= 90) StatsLevel[2] = "{ADFF2F}{FFFFFF}";
	else StatsLevel[2] = "{008000} {FFFFFF}";
	
	format ( global_string, 256, "{"#cWH"}:    %d / 1000\n-:   %d / 1000\n\n:    %d [%s]\n:  %d [%s]", p_info[playerid][u_style][0], p_info[playerid][u_style][1], p_info[playerid][stats][2], StatsLevel[2], p_info[playerid][stats][1], StatsLevel[1] ) ;
	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBL"‚Äè}√”·Ê» «·ﬁ «·", global_string, "≈€·«ﬁ", "" ) ;
	return 1;
}

