stock VehicleSpeed ( vehicleid )
{
    new Float:X,
		Float:Y,
		Float:Z ;

    GetVehicleVelocity ( vehicleid, X, Y, Z ) ;
    return floatround ( floatsqroot( X * X + Y * Y ) * 100.0 ) ;
}

stock _PutPlayerInVehicle ( playerid, vehicleid, seatid )
{
	player_vehicle[ playerid ] = vehicleid ;
	eev_called { playerid } = 1 ;
	opev_vehicleid [ playerid ] = vehicleid ;
	used_enter [ playerid ] = true ;

	p_t_info [ playerid ] [ last_alt ] = GetTickCount ( ) ;

	if ( gotome_player [ playerid ] != -1 )
	{
		DeletePVar ( gotome_player [ playerid ], "player_gotome" ) ;
		DeletePVar ( playerid, "cuff_x"), DeletePVar ( playerid, "cuff_y"), DeletePVar ( playerid, "cuff_z") ;
	}

	return PutPlayerInVehicle ( playerid, vehicleid, seatid ), true ;
}
#define AC_PutPlayerInVehicle _PutPlayerInVehicle

stock _SetVehiclePos ( vehicleid, Float:x, Float:y, Float:z )
{
    foreach(new i: logged_players)
	{
		if ( GetPlayerVehicleID ( i ) == vehicleid )
		{
			p_t_info [ i ] [ p_tp_immune_time ] = 3 ;
			p_t_info [ i ] [ real_pos ] [ 0 ] = x ;
			p_t_info [ i ] [ real_pos ] [ 1 ] = y ;
			p_t_info [ i ] [ real_pos ] [ 2 ] = z ;

			p_t_info [ i ] [ last_alt ] = GetTickCount ( ) ;
		}
	}
	veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 0 ] = x ;
 	veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 1 ] = y ;
	veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 2 ] = z ;
    SetVehiclePos ( vehicleid, x, y, z ) ;
    return 1;
}
#define AC_SetVehiclePos _SetVehiclePos
stock SendAdmMessage(color, string[]) {
	foreach(new i: admin_players) SendClientMessage(i, color, string);
	return true;
}
stock anti_cheat ( playerid, reason [ 32 ], code )
{
	if ( p_info [ playerid ] [ admin ] > 0 ) return 1 ;

	ac_info [ playerid ] = reason ;

	foreach(new i: admin_players)
	{
		new line_string [ 128 ] ;
		format ( line_string, sizeof ( line_string ), "‰Ÿ«„ „ﬂ«›Õ… «·€‘: %s[%d] «Õ’· ⁄·Ï  „ ÿ—œÂ ·‹ «” Œœ«„ cheats. «·”»»: %s.", p_info [ playerid ] [ name ], playerid, ac_info [ playerid ] ) ;
		SendClientMessage ( i, col_red, line_string ) ;
	}
	new ip[32], hour, minute, second, day, month, year, string1[3500];
    gettime(hour, minute, second);
    getdate(year, month, day);
    GetPlayerIp(playerid,ip,sizeof(ip));
    format(string1, sizeof(string1), "\n{8c918e}- «·≈œ«—Ì:{FFFFFF} ‰Ÿ«„ «·Õ„«Ì….\n\
                                    {8c918e}- «·”»»:{FFFFFF} %s.\n\
                                    {8c918e}- «·ﬂÊœ:{FFFFFF} %d.\n\
                                    {8c918e}- ⁄‰Ê«‰ IP:{FFFFFF} %s\n\
                                    {8c918e}- Êﬁ  «·ÿ—œ:{FFFFFF} %02d:%02d:%02d » «—ÌŒ %02d/%02d/%d\n\n\
                                    {FFFFFF}Ìı‰’Õ »‘œ… »«·«Õ ›«Ÿ »Â–« «· ﬁ—Ì— ··—ÃÊ⁄ ·Â ·«Õﬁ« («÷€ÿ F8)",ac_info [ playerid ], code, ip, hour, minute, second, day, month, year);
	show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX,"‰Ÿ«„ „ﬂ«›Õ… «·€‘",string1,"≈€·«ﬁ","");
	reset_player_weapon ( playerid );
	AntiStealerMap(playerid);
    //kick_player ( playerid ) ;
	return 1;
}

stock AntiStealerMap(playerid)
{
    new scm_string [ 128 ];
	//new playerip[20];
	SetPVarInt ( playerid, "antistealer", 1 ) ;
	weapon_hack_status[playerid] = 1;
	SetPlayerCameraPos ( playerid, 0, 0, 0 ) ;
	SetPlayerCameraLookAt ( playerid, 0, 0, 0 ) ;
	reset_player_weapon ( playerid );
   // GetPlayerIp(playerid,playerip,sizeof(playerip));
	format ( scm_string, sizeof ( scm_string ),"ÕŸ— IP %s", p_t_info [ playerid ] [ p_ip ]) ;
	SendRconCommand ( scm_string ) ;
	SendRconCommand("reloadbans");
	return true;
}

stock SpawnFamilyVehicle_1(playerid, carid)
{
	new family_id = p_info[playerid][family]-1;
	familyvehicle1 = AC_CreateVehicle(carid, family_info[family_id][fam_house_xgpos], family_info[family_id][fam_house_ygpos], family_info[family_id][fam_house_zgpos], family_info[family_id][fam_house_cgpos], family_info[family_id][fam_car_color], 0, -1);

    AddVehicleComponent(familyvehicle1, 1010); // Nitro

 	veh_info [ familyvehicle1-1 ] [ v_owner ] = p_info[playerid][family]+566;

    veh_info [ familyvehicle1-1 ] [ v_fuel ] = 60 ;
    veh_info [ familyvehicle1-1 ] [ v_type ] = vehicle_type_family_1 ;
