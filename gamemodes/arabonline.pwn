}

cmd:dgun(playerid, param[])
{
    if(GetPVarInt(playerid, "on_dmarena")) return 1;
    if(GetPVarInt(playerid, "on_dmarena1")) return 1;
    if ( TeamPaint[playerid] != 0 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì’Ì— Ê√‰  „‘«—ﬂ ›Ì «·»Ì‰  »Ê·." ) ;
	if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— ≈”ﬁ«ÿ «·√”·Õ… »Ì‰„« „”ÃÊ‰.") ;
	if(p_t_info [ playerid ] [ mp_tp ] == 1) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— ≈”ﬁ«ÿ «·√”·Õ… ·„« √‰  ›Ì  «·ÕœÀ.") ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER || GetPlayerState ( playerid ) == PLAYER_STATE_PASSENGER) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ— ≈”ﬁ«ÿ «·√”·Õ… ›Ì ”Ì«—…." ) ;
	if ( IsPlayerToSquare ( playerid, 80.8047, 1762.5040, 390.7005, 2093.4778 ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ— ≈”ﬁ«ÿ «·√”·Õ… ›Ì Â–« «·„Êﬁ⁄." ) ;
    if(IsPlayerInAnyVehicle(playerid)|| ondmz[playerid] )
        return false;

    new weapon = GetPlayerWeapon(playerid);
    new ammo = GetPlayerAmmo(playerid);

    if(ammo < 1)
        return false;

    if(weapon < 1)
        return SendClientMessage(playerid , col_gray,"* „« ⁄‰œﬂ ”·«Õ ›Ì Ìœﬂ");

    if(p_t_info[playerid][p_gun_slot][GetWeaponSlot ( weapon )] != weapon)
        return false;

    new slot = GetWeaponSlot ( weapon ) ;

    if(p_t_info[playerid][p_gun_ammo][slot] < ammo)
        return false;

    new
        Float:x, Float:y, Float:z,Float:eagle;

    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid,eagle);

    if(NotGoodGun(weapon))
        return SendClientMessage(playerid, col_gray, "* „«  ﬁœ— «—„ˆ »⁄Ìœ« Â–« «·”·«Õ.");

    new idgun = GunObjects[weapon];
    new idobject=-1;

    for(new i;i<MAX_DGUNS;i++)
    {
        if(dguns[i]==-1)
        {
            idobject=i;
            break;
        }
    }

    if(idobject==-1)
    {
        new min1=CurrentTimer;
        for(new i;i<MAX_DGUNS;i++)
        {
            if(dguntime[i]<min1)
            {
                min1=dguntime[i];
                idobject=i;
            }
        }
        DestroyDynamicObject(dguns[idobject]);
        DestroyDynamic3DTextLabel(DgunText[idobject]);
    }


    dguntime[idobject]=CurrentTimer;
    dpatrons[idobject]=ammo;
    dgunn[idobject]=weapon;
    dguns[idobject] = CreateDynamicObject(idgun, x, y, z-0.97, 96, 110, eagle, GetPlayerVirtualWorld(playerid));
    RemovePlayerWeapon(playerid,weapon);
    p_t_info[playerid][p_gun_slot][slot] = 0;
    ApplyAnimation(playerid, "BOMBER","BOM_Plant_Crouch_In", 4.0, 0, 0, 0, 0, 0, 1);

    new buffer[100];

    format(buffer, sizeof(buffer), "{"#cGN"}* {ffffff}√‰  threw away '%s'", GunNames[weapon]);
    SendClientMessage(playerid, -1, buffer);

    format(buffer, sizeof(buffer), "{"#cGN"}* {ffffff}Threw Œ«—Ã '%s'", GunNames[weapon]);
    SendClientMessage(playerid, -1,buffer);

    format(buffer, sizeof(buffer), "{ffffff}≈·Ï «· ﬁ«ÿ %s √œŒ· {007275}/pgun", GunNames[weapon]);
    DgunText[idobject] =CreateDynamic3DTextLabel(buffer, -1, x, y, z-0.971,15.0);

    return 1;
}
