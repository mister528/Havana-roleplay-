	if ( sscanf ( params, "us[42]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /iban [ID/«·«”„] [«·”»»]" ) ;
