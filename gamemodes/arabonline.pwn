}

CMD:ans(playerid, params[])
{
	if ( ! p_info [ playerid ] [ admin ] ) return 1 ;
	new	id_player, text [ 228 ] ;

    if(!sscanf(params, "ds[128]", id_player, text))
	{
		if(! IsPlayerConnected(id_player) ) return SendClientMessage(playerid, col_orange, "«··«⁄» „Ê „⁄ „œ!");
		if(strlen(text) > 228)return true;

		static const
			ftm_str[] = "Administrator %s: {"#cWH"}%s",
			ftm_str2[] = "<ADM>{"#cGR"} Administrator %s[%d] for %s[%d]: %s";
		new str[sizeof(ftm_str2) + 24 + 24 + 228];

		format(str, sizeof(str), ftm_str, p_info [ playerid ] [ name ], text);
		SendClientMessage(id_player, col_yellow, str);

  		foreach(new i:admin_players)
		{
			format(str, sizeof(str), ftm_str2, p_info [ playerid ] [ name ], playerid, p_info [ id_player ] [ name ], id_player, text);
			SendClientMessage(i, col_blue, str);
		}
		return true;
	}

	new bool: temp = false;
    foreach(new i: logged_players)
    {
        if(RepOn[i])
        {
            RepId[playerid] = i;
            RepOn[i] = false;

            static const ftm_str[] = "{"#cBL"}‘ﬂÊÏ/”ƒ«· „‰ %s\n\n{"#cWH"}%s\n";
            new str[sizeof(ftm_str) + 24 + 128];

            format(str, sizeof(str), ftm_str, p_info [ i ] [ name ], RepMessages[i]);
            show_dialog(playerid, d_report_new, DIALOG_STYLE_INPUT, "{"#cRD"}‘ﬂÊÏ{"#cWH"}", str, "≈—”«·", "");

            temp = true;
            break;
        }
    }
    if(!temp) SendClientMessage(playerid, -1, "{"#cRD"}* {"#cGR"}ÌÊÃœ Õ«·Ì« ·« «·‘ﬂ«ÊÌ!");
	return true;
}


