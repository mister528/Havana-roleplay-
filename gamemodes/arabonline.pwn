{
    if ( p_info [ playerid ] [ admin ] < 7 ) return 1 ;
    if ( sscanf ( params, "s[128]",params [ 0 ]) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /capto [«·‰’]" ) ;
    new _t_strccing [ 128 ] ;
