	if ( sscanf ( params, "ddd", params [ 0 ], params [ 1 ], params [ 2 ] ) ) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /yveh [ID «·”Ì«—…] [«··Ê‰ 1] [«··Ê‰ 2]" ) ;
