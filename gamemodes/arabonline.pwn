CMD:ychat(playerid,params[])
{
    if(p_info [ playerid ] [ youtube ] != 1) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}{FF0000}„« ⁄‰œﬂ ÌÊ ÌÊ» «„ Ì«“« ." ) ;
    if(p_info[playerid][mute] > 0) return SendClientMessage(playerid,0xafafafff,"√‰  „„‰Ê⁄ „‰ «·‘« ");
    new text[150];
    if(sscanf(params,"s",text)) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /ychat [«·‰’]." ) ;
    if(p_info[playerid][youtube]>0) format(text,sizeof(text),"[ÌÊ ÌÊ»] {ffffff}%s: %s",p_info[playerid][name],text);
    else if(p_info[playerid][admin] >=2) format(text,sizeof(text),"[„‘—›] {ffffff}%s: %s",p_info[admin][name],text);
    foreach(new i: logged_players)
    {
        if(p_info[playerid][youtube] > 0)
        {
            SendClientMessage(i, 0x1E90FFff, text);
        }
    }
    return 1;
}

