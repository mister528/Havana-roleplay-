			return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „œ… «·«Õ Ã«“ ·«“„  ﬂÊ‰ »Ì‰ 1 Ê240 œﬁÌﬁ…." ) ;
		if(p_info [ params [ 1 ] ] [ jailed ] > 0)
