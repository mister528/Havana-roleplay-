	p_info [ params [ 0 ] ] [ warblock ] = 1 ;
	update_int_sql ( params [ 0 ], "u_warblock", p_info [ params [ 0 ] ] [ warblock ] ) ;
	
	format ( scm_string, sizeof scm_string, "[F] %s %s ()      %s. : %s.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ] ) ;
