	if ( veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_player ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"} ÃÂ«“ GPS Ìﬁœ— Ì À»  »” ⁄·Ï «·”Ì«—«  «·‘Œ’Ì…." ) ;
	if ( veh_info [ veh_id - 1 ] [ v_gps_tracker ] == 1 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}  „  À»Ì  ÃÂ«“ GPS „”»ﬁ«." ) ;

	veh_info [ veh_id - 1 ] [ v_gps_tracker ] = 1 ;
	p_info [ playerid ] [ gps_tracker ] -= 1 ;
	update_int_sql ( playerid, "u_gps_tracker", p_info [ playerid ] [ gps_tracker ] ) ;

	new scm_string [ 98 ] ;
