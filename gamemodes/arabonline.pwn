CMD:time(playerid)
{
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT ) ApplyAnimation ( playerid, "COP_AMBIENT", "Coplook_watch", 4.1, 0, 0, 0, 0, 0 ) ;

	new year,
		month,
		day,
		hour,
		minute,
		second,
		mtext [ 11 ] ;

	getdate ( year, month, day ) ;
	gettime ( hour, minute, second ) ;
	FixHour ( hour ) ;
	hour = global_hour ;


	switch ( month )
	{
		case 1: mtext = "January";
		case 2: mtext = "February";
		case 3: mtext = "Marth";
		case 4: mtext = "April";
		case 5: mtext = "May";
		case 6: mtext = "June";
		case 7: mtext = "July";
		case 8: mtext = "August";
		case 9: mtext = "September";
		case 10: mtext = "October";
		case 11: mtext = "November";
		case 12: mtext = "December";
	}
	
	//jc
    if ( p_info [ playerid ] [ transporttimer ] > 0 )
	{
		new format_string [ 128 ] ;
		SendClientMessage ( playerid, -1, "----------------------------«·Êﬁ ----------------------------");
		format ( format_string, sizeof format_string, "«· «—ÌŒ: {"#cGR"}%d %s 2022", day,mtext ) ;
		SendClientMessage(playerid,-1,format_string);
		format ( format_string, sizeof format_string, "«·Êﬁ  «·Õ«·Ì: {"#cGR"}%s%d:%s%d", (hour < 10) ? ("0") : (""), hour, (minute < 10) ? ("0") : (""), minute) ;
		SendClientMessage(playerid,-1,format_string);
        if ( p_info [ playerid ] [ transporttimer ] <=60 )
		{
			format ( format_string, sizeof format_string, "«·Êﬁ  Ì”«—: {"#cRD"}%d ÀÊ«‰Ì",  p_info [ playerid ] [ transporttimer ] ) ;
			SendClientMessage(playerid,-1,format_string);
			return 1;
		}
		else
		{
            format ( format_string, sizeof format_string, "«·Êﬁ  Ì”«—: {"#cRD"}%d œﬁÌﬁ…",  p_info [ playerid ] [ transporttimer ]/60 ) ;
			SendClientMessage(playerid,-1,format_string);
		}
		return 1;
	}
	if (  p_info [ playerid ] [ stealtimer ] > 0 )
	{
		new format_string [ 128 ] ;
		SendClientMessage ( playerid, -1, "----------------------------«·Êﬁ ----------------------------");
		format ( format_string, sizeof format_string, "«· «—ÌŒ: {"#cGR"}%d %s 2022", day,mtext ) ;
		SendClientMessage(playerid,-1,format_string);
		format ( format_string, sizeof format_string, "«·Êﬁ  «·Õ«·Ì: {"#cGR"}%s%d:%s%d", (hour < 10) ? ("0") : (""), hour, (minute < 10) ? ("0") : (""), minute) ;
		SendClientMessage(playerid,-1,format_string);
		if (  p_info [ playerid ] [ stealtimer ] <=60 )
		{
			format ( format_string, sizeof format_string, "«·Êﬁ  Ì”«—: {"#cRD"}%d ÀÊ«‰Ì", p_info [ playerid ] [ stealtimer ] ) ;
			SendClientMessage(playerid,-1,format_string);
			return 1;
		}
		else
		{
            format ( format_string, sizeof format_string, "«·Êﬁ  Ì”«—: {"#cRD"}%d œﬁÌﬁ…", p_info [ playerid ] [ stealtimer ]/60 ) ;
			SendClientMessage(playerid,-1,format_string);
		}
		return 1;
	}
	if ( p_info [ playerid ] [ jailed ] > 0 )
	{
		new format_string [ 128 ] ;
		SendClientMessage ( playerid, -1, "----------------------------«·Êﬁ ----------------------------");
		format ( format_string, sizeof format_string, "«· «—ÌŒ: {"#cGR"}%d %s 2022", day,mtext ) ;
		SendClientMessage(playerid,-1,format_string);
		format ( format_string, sizeof format_string, "«·Êﬁ  «·Õ«·Ì: {"#cGR"}%s%d:%s%d", (hour < 10) ? ("0") : (""), hour, (minute < 10) ? ("0") : (""), minute) ;
		SendClientMessage(playerid,-1,format_string);
		format ( format_string, sizeof format_string, "«·Êﬁ  „‰ confinement: {"#cGR"}%d ÀÊ«‰Ì", p_info [ playerid ] [ jailed ] ) ;
		SendClientMessage(playerid,-1,format_string);
	}
	else
	{
		new format_string [ 128 ] ;
		SendClientMessage ( playerid, -1, "----------------------------«·Êﬁ ----------------------------");
		format ( format_string, sizeof format_string, "«· «—ÌŒ: {"#cGR"}%d %s 2022 ", day,mtext ) ;
		SendClientMessage(playerid,-1,format_string);
		format ( format_string, sizeof format_string, "«·Êﬁ  «·Õ«·Ì: {"#cGR"}%s%d:%s%d", (hour < 10) ? ("0") : (""), hour, (minute < 10) ? ("0") : (""), minute) ;
		SendClientMessage(playerid,-1,format_string);
