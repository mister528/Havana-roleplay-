		b_info [ b ] [ b_name ], mafia_owner_name [ b_info [ b ] [ b_mafia ] - 1 ], b_info [ b ] [ b_price ] * for_tax [ 1 ], business_status ) ;
		show_dialog ( playerid, d_b_buy, DIALOG_STYLE_MSGBOX, "{"#cBL"‚Äè}„⁄·Ê„«  ⁄‰ ABS", dialog_string, "«‘ —Ì", "≈€·«ﬁ" ) ;
	}
	if ( _gas == false )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"√‰  „Ê ﬁ—Ì» „‰ „Õÿ… «·‘Õ‰ «··Ì  ﬁœ—  ‘ —ÌÂ«." ) ;
	return 1 ;
}

