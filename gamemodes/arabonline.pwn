CMD:kickout(playerid, params[])
{
	if ( ! mayor_player ( playerid ) ) return 1 ;
	if ( GetPlayerVirtualWorld ( playerid ) != 10 && GetPlayerVirtualWorld ( playerid ) != 11 && GetPlayerVirtualWorld ( playerid ) != 12 && GetPlayerVirtualWorld ( playerid ) != 13 ) return 1 ;

	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /kickout [ID/«·«”„]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." );
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— ÿ—œ ‰›”ﬂ." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;
	if ( is_tazered { params [ 0 ] } == 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» ·«“„ ÌﬂÊ‰ „’⁄Êﬁ." ) ;
	new scm_string[82];
	format ( scm_string, 82, "%s[%d] ÿ—œﬂ Œ«—Ã „‰ „»‰Ï «·»·œÌ….",
	p_info [ playerid ] [ name ], playerid ) ;
	SendClientMessage ( params [ 0 ], col_wavy, scm_string ) ;

	format ( scm_string, 82, "ÿ—œ  %s[%d] Œ«—Ã „‰ „»‰Ï «·»·œÌ….",
	p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	SendClientMessage ( playerid, col_wavy, scm_string ) ;

	kickout_cooldown [ params [ 0 ] ] = gettime ( ) + 300 ;

	if ( GetPlayerVirtualWorld ( params [ 0 ] ) == 10 ) set_pos ( params [ 0 ], 1473.2272,-1766.5834,18.7949,326.2043, 0, 0) ;
	if ( GetPlayerVirtualWorld ( params [ 0 ] ) == 11 ) set_pos ( params [ 0 ], 2655.2988,375.7350,4.3343,90.6449, 0, 0) ;
	if ( GetPlayerVirtualWorld ( params [ 0 ] ) == 12 ) set_pos ( params [ 0 ], 2384.2854,2466.0759,10.8203,268.4896, 0, 0) ;
	if ( GetPlayerVirtualWorld ( params [ 0 ] ) == 13 ) set_pos ( params [ 0 ], -2726.2429,-309.8963,7.0391,112.3477, 0, 0) ;
	return true;
}

CMD:newveh( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ admin ] < 8 )return -1 ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  Õ«·Ì« Œ·› «·„ﬁÊœ." ) ;
	if ( sscanf ( params, "ddd", params [ 0  ], params [ 1  ], params [ 2 ] ) ) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /newveh [ID «·”Ì«—…] [·Ê‰ 1] [·Ê‰ 2]" ) ;
	if ( params [ 0 ] < 400 || params [ 0 ] > 611 ) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /newveh [ID «·”Ì«—…] [·Ê‰ 1] [·Ê‰ 2]" ) ;
	if ( params [ 1 ] < 0 || params [ 1 ] > 255 ) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /newveh [ID «·”Ì«—…] [·Ê‰ 1] [·Ê‰ 2]" ) ;
	if ( params [ 2 ] < 0 || params [ 2 ] > 255 ) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /newveh [ID «·”Ì«—…] [·Ê‰ 1] [·Ê‰ 2]" ) ;
	new Float:player_pos [ 3 ];
	GetPlayerPos ( playerid, player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ] ) ;
	new adm_veh = AC_CreateVehicle ( params [ 0 ], player_pos [ 0 ], player_pos [ 1 ], player_pos [ 2 ], 0.0, params [ 1 ], params [ 2 ], -1) ;

	veh_info [ adm_veh - 1 ] [ v_pos ] [ 0 ] = player_pos [ 0 ] ;
	veh_info [ adm_veh - 1 ] [ v_pos ] [ 1 ] = player_pos [ 1 ] ;
	veh_info [ adm_veh - 1 ] [ v_pos ] [ 2 ] = player_pos [ 2 ] ;


	SetPVarInt ( playerid, "admin_vehicle", adm_veh ) ;
	veh_info [ adm_veh - 1 ] [ v_fuel ] = 60.0;
	AC_PutPlayerInVehicle ( playerid, adm_veh, 0) ;
	SetPlayerArmedWeapon(playerid,0) ;
	new scm_string [ 128 ];
	format ( scm_string, sizeof ( scm_string  ), "{"#cBL"}*  {"#cGR"}%s  . ID: %d | Model: %d", p_info [ playerid ] [ name ], adm_veh, params [ 0 ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_gray, scm_string ) ;

	return true;
}

