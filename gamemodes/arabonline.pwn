	if ( GetPlayerState ( params [ 0 ] ) != 1 ) return SendClientMessage ( playerid, -1, "{"#cRD"}*{"#cGR"} «··«⁄» ÂÊ ”»ﬁ Ê ›Ì «·”Ì«—…!" ) ;

	new Float: XYZ [ 4 ] ;
	GetPlayerPos ( params [ 0 ], XYZ [ 0 ], XYZ [ 1 ], XYZ [ 2 ] ) ; GetPlayerFacingAngle ( params [ 0 ], XYZ [ 3 ] ) ;
	if ( p_t_info [ params [ 0 ] ] [ pveh ] != -1 ) AC_DestroyVehicle ( p_t_info [ params [ 0 ] ] [ pveh ] ) ;
	p_t_info [ params [ 0 ] ] [ pveh ] = AC_CreateVehicle ( params [ 1 ], XYZ [ 0 ], XYZ [ 1 ], XYZ [ 2 ], XYZ [ 3 ], -1, -1, -1 ) ;

	veh_info [ p_t_info [ params [ 0 ] ] [ pveh ] ] [ v_health ] = 1000.0 ;

	AC_PutPlayerInVehicle ( params [ 0 ], p_t_info [ params [ 0 ] ] [ pveh ], 0 ) ;

    veh_info [ GetPlayerVehicleID(params[0]) - 1 ] [ v_fuel ] = 30.0 ;

	new string [ 118 ] ;

	format(string,sizeof string, "<≈œ«—Ì>{"#cGR"} ≈œ«—Ì %s[%d]  „ ≈’œ«—  „ƒﬁ  «·”Ì«—… ≈·Ï ·«⁄» %s[%d] [%d]",p_info[playerid][name],playerid,p_info[params[0]][name], params[0], p_t_info [ params [ 0 ] ] [ pveh ] ) ;
	foreach(new i: admin_players) SendClientMessage ( i, col_blue, string ) ;
	return 1 ;
}

