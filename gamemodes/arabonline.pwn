public OnPlayerEnterDynamicCP(playerid, checkpointid)
{
	// dynamic rob247 lockpick
	for (new _rb = 0 ; _rb < b_count ; _rb++)
	{
		if (g_rob247_cp[_rb] == checkpointid && g_rob247_state[_rb] == 1 && g_rob247_robber[_rb] == playerid)
		{
			Rob247_OpenLockpick(playerid, _rb);
			return 1;
		}
	}

    if (Fisherman_OnPlayerEnterDynamicCP(playerid, checkpointid)) return 1;
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerEnterDynamicCP] playerid:%d | checkpointid:%d", playerid, checkpointid ) ;
	#endif

	if (g_house_guard_active[playerid] && checkpointid == g_house_guard_cp[playerid])
	{
		if (g_house_guard_stage[playerid] >= HOUSE_GUARD_TARGETS)
		{
			if (!IsPlayerInAnyVehicle(playerid) || GetPlayerVehicleID(playerid) != g_house_guard_vehicle[playerid])
			{
				SendClientMessage(playerid, col_gray, "{FF5555}* {FFFFFF}—Ã¯⁄ ”Ì«—… Õ«—” «·„‰“· ⁄‘«‰  ‰ÂÌ «·‘Ì› .");
				return 1;
			}
			return house_guard_cleanup(playerid, 1);
		}
		house_guard_open_lock(playerid);
		return 1;
	}


        // === Havana Ballas Tap mini-game ===
        if (checkpointid == g_ballasTap_cp)
        {
                new now2 = gettime();
                new last2 = g_ballasTap_lastPlay[playerid];
                new diff2 = now2 - last2;
                if (last2 != 0 && diff2 < BALLAS_TAP_COOLDOWN_S)
                {
                        new remain2 = BALLAS_TAP_COOLDOWN_S - diff2;
                        new msg2[160];
                        format(msg2, sizeof(msg2), "{FF5555}* {FFFFFF}»«·«“ «‰ﬁ—:  ⁄«· —ÃÊ⁄ ›Ì {FFFF00}%dh %dm{FFFFFF}.", remain2 / 3600, (remain2 % 3600) / 60);
                        SendClientMessage(playerid, -1, msg2);
                        return 1;
                }
                g_ballasTap_active[playerid] = 1;
                g_ballasTap_startTick[playerid] = GetTickCount();
                return 1;
        }


        if (checkpointid == g_trent_cp)
        {
                trent_show_list(playerid);
                return 1;
        }

	if (checkpointid == g_daily_cp_id)
	{
		new now = gettime();
		new diff = now - g_daily_last_claim[playerid];
		if (g_daily_last_claim[playerid] != 0 && diff < 86400)
		{
			new remain = 86400 - diff;
			new msg[192];
			format(msg, sizeof(msg), "{FFFFFF}Hi buddy!\n\n{FFAA00}√‰  ”»ﬁ Ê claimed «·ÌÊ„.\n{FFFFFF} ⁄«· —ÃÊ⁄ ›Ì {FF5555}%d h %d m{FFFFFF}.", remain/3600, (remain%3600)/60);
			show_dialog(playerid, d_daily_reward, DIALOG_STYLE_MSGBOX, "{FFFF00}«·„ﬂ«›√… «·ÌÊ„Ì…", msg, "OK", "");
		}
		else
		{
			show_dialog(playerid, d_daily_reward, DIALOG_STYLE_MSGBOX, "{FFFF00}«·„ﬂ«›√… «·ÌÊ„Ì…", "{FFFFFF}√Â·« Ì« ’«Õ»!\n\n{00FF00}«” ·„ „ﬂ«›√ ﬂ «·ÌÊ„Ì… {FFFF00}$500{00FF00}.\n{FFFFFF}«—Ã⁄ ﬂ· 24 ”«⁄….", "«œ¯⁄«¡", "≈€·«ﬁ");
		}
		return 1;
	}

	return 1 ;
}

callback: check_give_excuse_photographer(const playerid)
{
	new rows = cache_num_rows();
	if(!rows)
	{
        SendClientMessage(playerid, 0xE4EE53FF, "‰Õ‰ ‰⁄Ê¯÷ﬂ ⁄‰ «·Êﬁ  «··Ì ÷«⁄ ›Ì «·—Õ·….  ›÷·° Œ– 2500$");
		static query[] = "INSERT INTO `excuse_for_photographer` (`nick`, `ip`) VALUES ('%e', '%e')";
		new fmt_query[sizeof(query) + MAX_PLAYER_NAME + 1 - 2];
		mysql_format (sql_connection, fmt_query, sizeof fmt_query, query, p_info [ playerid ] [ name ], p_t_info [ playerid ] [ p_ip ] ) ;
		mysql_tquery ( sql_connection, fmt_query, "", "") ;
		insert_money_log (playerid, INVALID_PLAYER_ID, 2500, "    ." ) ;
		give_money(playerid, 2500);
		SetPVarInt(playerid, "excuse_photographer_pvar", GetTickCount());
	}
}


public OnVehicleSpawn(vehicleid)
{
	ac_test_OnVehicleSpawn ( vehicleid ) ;

	new _trent_slot_vs = trent_find_by_vehid(vehicleid);
	if (_trent_slot_vs >= 0 && g_trent_pinned[_trent_slot_vs])
	{
		SetVehiclePos(vehicleid, g_trent_pin_pos[_trent_slot_vs][0], g_trent_pin_pos[_trent_slot_vs][1], g_trent_pin_pos[_trent_slot_vs][2]);
		SetVehicleZAngle(vehicleid, g_trent_pin_pos[_trent_slot_vs][3]);
	}

	for ( new j = 0 ; j < 4 ; j ++ )veh_info [ vehicleid - 1 ] [ v_door_status ] [ j ]  = 0 ;

	veh_info [ vehicleid - 1 ] [ v_health ] = 1000.0 ;
	veh_info [ vehicleid - 1 ] [ v_driver ] = INVALID_PLAYER_ID ;

	veh_info [ vehicleid - 1 ] [ v_cargo ] = 0 ;

	new engine, lights, alarm, doors, bonnet, boot, objective ;

	if ( veh_info [ vehicleid - 1 ] [ v_locked ] )
	{
		GetVehicleParamsEx ( vehicleid, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( vehicleid, engine, lights, alarm, true, bonnet, boot, objective ) ;
	}

	AC_SetVehiclePos ( vehicleid, veh_info [ vehicleid - 1 ] [ v_pos ] [ 0 ],
								veh_info [ vehicleid - 1 ] [ v_pos ] [ 1 ],
								veh_info [ vehicleid - 1 ] [ v_pos ] [ 2 ] ) ;
	SetVehicleZAngle ( vehicleid, veh_info [ vehicleid - 1 ] [ v_pos ] [ 3 ] ) ;
	ChangeVehicleColor ( vehicleid, veh_info [ vehicleid - 1 ] [ v_color ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_color ] [ 1 ] ) ;
	if ( veh_info [ vehicleid - 1 ] [ v_paint ] != 3 )
	{
		ChangeVehiclePaintjob ( vehicleid, veh_info [ vehicleid - 1 ] [ v_paint ] ) ;
	}
	
    if(IsValidDynamicObject(vehicleSiren[vehicleid]))
	{
	    DestroyDynamicObject(vehicleSiren[vehicleid]);
	    vehicleSiren[vehicleid] = INVALID_OBJECT_ID;
	}
	
	if ( veh_info [ vehicleid - 1 ] [ v_int ] != 0 )LinkVehicleToInterior ( vehicleid, veh_info [ vehicleid - 1 ] [ v_int ] ) ;
	if ( veh_info [ vehicleid - 1 ] [ v_vw ] != 0 )SetVehicleVirtualWorld ( vehicleid, veh_info [ vehicleid - 1 ] [ v_vw ] ) ;


	for(new i = 0; i < MAX_TRAILERS;i++)
	{
		if(vehicleid == TrailerInfo[i][d_trailer])
		{
			DestroyVehicle(TrailerInfo[i][d_trailer]);
			TrailerInfo[i][d_trailer] = CreateVehicle(508,TrailerInfo[i][d_posx],TrailerInfo[i][d_posy],TrailerInfo[i][d_posz],TrailerInfo[i][d_posa],1,1,-1);
			SetVehicleNumberPlate(TrailerInfo[i][d_trailer],TrailerInfo[i][d_owner]);
			break;
		}
	}

	if ( veh_info [ vehicleid - 1 ] [ v_cargo_object ] [ 0 ] != 0 )
	{
		for ( new j = 0 ; j < 3 ; j ++ )
		{
			DestroyDynamicObject ( veh_info [ vehicleid - 1 ] [ v_cargo_object ] [ j ] ) ;
			veh_info [ vehicleid - 1 ] [ v_cargo_object ] [ j ] = 0 ;
		}
	}
	if ( veh_info [ vehicleid - 1 ] [ v_type ] == vehicle_type_player && veh_info [ vehicleid - 1 ] [ v_sell_price ] == 0 && ! v_plane ( vehicleid ) )
	{
		for ( new j ; j < MAX_NONPARKING_ZONES ; j ++ )
		{
			if ( IsVehicleInQuad ( veh_info [ vehicleid - 1 ] [ v_pos ] [ 0 ], veh_info [ vehicleid - 1 ] [ v_pos ] [ 1 ],
									non_parking_pos [ j ] [ 0 ], non_parking_pos [ j ] [ 1 ],
									non_parking_pos [ j ] [ 2 ], non_parking_pos [ j ] [ 3 ] ) && veh_info [ vehicleid - 1 ] [ v_fine ] == 0 )
			{

				new query_string [ 156 ] ;

				format ( query_string, sizeof ( query_string ),"UPDATE `users_vehicles` SET `v_fuel` = '%f',`v_millage` = '%f',`v_fine` = '1' WHERE `v_id` = '%d' LIMIT 1",
				veh_info [ vehicleid - 1 ] [ v_fuel ],
				veh_info [ vehicleid - 1 ] [ v_millage ],
				veh_info [ vehicleid - 1 ] [ v_id ] ) ;
				mysql_tquery ( sql_connection, query_string, "", "" ) ;

				new playerid = - 1 ;
				foreach(new i: logged_players)
				{
					if ( veh_info [ vehicleid - 1 ] [ v_owner ] == p_info [ i ] [ id ] )playerid = i ;
				}
				Iter_Remove(player_vehicles[playerid], vehicleid ) ;
				show_dialog ( playerid, d_clearinfo, DIALOG_STYLE_MSGBOX, "{"#cBL"}„Œ«·›… ﬁÊ«⁄œ «·„—Ê—", "{"#cRD"}«‰ »«Â!\n\n{"#cRD"}”Ì«— ﬂ  „ ≈—”«·Â« ··ÕÃ“ »”»» «·—ﬂ‰ ›Ì „ﬂ«‰ €·ÿ\n{"#cBL"}≈·Ï «· ﬁ«ÿ «” Œœ„ {"#cWH"}'/GPS > „ ›—ﬁ«  > ⁄ﬁÊ»…'{"#cBL"}.", "≈€·«ﬁ", "" ) ;

				veh_info [ vehicleid - 1 ] [ v_owner ] = 0 ;
				veh_info [ vehicleid - 1 ] [ v_rank ] = 0 ;
				veh_info [ vehicleid - 1 ] [ v_type ] = 0 ;
				AC_DestroyVehicle ( vehicleid ) ;

			}
		}

		for ( new j = 0; j < 10; j ++ )
		{
			if ( veh_info [ vehicleid - 1 ] [ v_component ] [ j ] == 0 ) continue ;
			AddVehicleComponent ( veh_info [ vehicleid - 1 ] [ v_vehicle ], veh_info [ vehicleid - 1 ] [ v_component ] [ j ] ) ;
		}
	}
	if ( veh_info [ vehicleid - 1 ] [ v_fine ] > 0 )veh_info [ vehicleid - 1 ] [ v_fine ] = 0 ;

	if ( v_velo ( vehicleid ) )toggle_engine ( 0, vehicleid ) ;

	if ( GetVehicleModel ( vehicleid ) == 450 )
	{
		foreach(new i: logged_players)
		{
			if ( player_trailer [ i ] != vehicleid )continue ;
			trailer_count [ vehicleid - 1 ] = 0 ;
			AC_DestroyVehicle ( vehicleid ) ;
			player_tload_time [ i ] = - 1;
			SendClientMessage ( i, col_gray, "{"#cRD"}* {"#cGR"}Õ„Ê· ﬂ —Ã⁄  ··ﬁ«⁄œ…." ) ;
			if ( player_leavearea_time [ i ] > 0 ) player_leavearea_time [ i ] = - 1 ;
			if ( GetPVarInt ( i, "truck_waiting" ) > 0 )
			{
				for ( new j = 0 ; j < 3 ; j ++ )
				{
					if ( loading_playerid [ j ] == i )
					{
						loading_playerid [ j ] = INVALID_PLAYER_ID ;
						DeletePVar ( i, "truck_waiting" ) ;
					}
				}
			}
			for ( new j = 0 ; j < 4 ; j ++ )
			{
				PlayerTextDrawDestroy ( i, td_db [ i ] [ j ] ) ;
				td_db [ i ] [ j ] = PlayerText:-1 ;
			}
			player_trailer [ i ] = INVALID_VEHICLE_ID ;
			break ;
		}
	}
	if ( GetVehicleModel ( vehicleid ) == 450 )
	{
		foreach(new i: logged_players)
		{
			if ( player_trailer [ i ] != vehicleid )continue ;
			give_money ( i, trailer_count [ vehicleid - 1 ] * 9 ) ;
			insert_money_log ( i, INVALID_PLAYER_ID, trailer_count [ vehicleid - 1 ] * 9, "insurance db");

			trailer_count [ vehicleid - 1 ] = 0 ;
			AC_DestroyVehicle ( vehicleid ) ;

			SendClientMessage ( i, col_gray, "{"#cRD"}* {"#cGR"} ‘Õ‰ ﬂ  „  œ„Ì—Â«. ‘—ﬂ… «· √„Ì‰ ⁄Ê÷ ﬂ ⁄‰ «·Ã“¡ «·„ ÷——." ) ;

			if ( GetPVarInt ( i, "truck_waiting" ) > 0 )
			{
				for ( new j = 0 ; j < 3 ; j ++ )
				{
					if ( loading_playerid [ j ] == i )
					{
						loading_playerid [ j ] = INVALID_PLAYER_ID ;
						KillTimer ( loading_timer [ j ] ) ;
						loading_timer [ j ] = - 1 ;
						DestroyDynamic3DTextLabel ( loading_text [ j ] ) ;
						loading_text [ j ] = Text3D:-1 ;
						DeletePVar ( i, "truck_waiting" ) ;
					}
				}
			}
			for ( new j = 0 ; j < 4 ; j ++ )
			{
				PlayerTextDrawDestroy ( i, td_db [ i ] [ j ] ) ;
				td_db [ i ] [ j ] = PlayerText:-1 ;
			}
			player_trailer [ i ] = INVALID_VEHICLE_ID ;
			break ;
		}
	}

	trailer_count [ vehicleid - 1 ] = 0 ;
	trailer_type [ vehicleid - 1 ] = -1 ;

	if ( veh_info [ vehicleid - 1 ] [ v_type ] == vehicle_type_server )
	{
		veh_info [ vehicleid - 1 ] [ v_fuel ] = 60.0 ;
	}
	if ( veh_info [ vehicleid - 1 ] [ v_type ] == vehicle_type_job )
	{
		veh_info [ vehicleid - 1 ] [ v_locked ] = false ;
		GetVehicleParamsEx ( vehicleid, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( vehicleid, engine, lights, alarm, false, bonnet, boot, objective ) ;
		veh_info [ vehicleid - 1 ] [ v_fuel ] = 35.0 ;
		if ( veh_info [ vehicleid - 1 ] [ v_owner ] == job_forklift ) veh_info [ vehicleid - 1 ] [ v_fuel ] = 100.0;
		if ( veh_info [ vehicleid - 1 ] [ v_model ] == 462 )
		{
			AC_DestroyVehicle ( vehicleid ) ;
			foreach(new i: logged_players)
			{
				if(player_rentcar [ i ] == vehicleid)
				{
					player_rentcar [ i ] = INVALID_VEHICLE_ID;
					SendClientMessage(i, col_gray,"{"#cRD"}* {"#cGR"} „ ”Õ» «·„—ﬂ»… «·„” √Ã—….");
					break;
				}
			}
			return 1 ;
		}
		if ( veh_info [ vehicleid - 1 ] [ v_owner ] == job_bus )
		{
			foreach(new i: logged_players)
			{
				if(player_rentcar [ i ] == vehicleid)
				{
					BusSpawn(i);
					player_rentcar [ i ] = INVALID_VEHICLE_ID;
					p_t_info [i][pBusRoute] = 0;
					p_t_info [i][pBusPos] = 0;
					p_t_info [i][pBusPrice] = 0;
					SendClientMessage(i, col_gray,"{"#cRD"}* {"#cGR"} „ ”Õ» «·„—ﬂ»… «·„” √Ã—….");
					break;
				}
			}
		}


		else if ( veh_info [ vehicleid - 1 ] [ v_owner ] == job_delivery )
		{
			foreach(new i: logged_players)
			{
				if(player_rentcar [ i ] == vehicleid)
				{
					new _v_id = player_rentcar [ i ] ;
					player_rentcar [ i ] = INVALID_VEHICLE_ID;

					AC_SetVehicleToRespawn ( _v_id  ) ;

					DisablePlayerRaceCheckpoint ( i ) ;

					SendClientMessage(i, col_gray,"{"#cRD"}* {"#cGR"} „ ”Õ» «·„—ﬂ»… «·„” √Ã—….");
					break;
				}
			}
		}
		else if ( veh_info [ vehicleid - 1 ] [ v_owner ] == job_fuel_delivery )
		{
			foreach(new i: logged_players)
			{
				if(player_rentcar [ i ] == vehicleid)
				{
					new _v_id = player_rentcar [ i ] ;
					player_rentcar [ i ] = INVALID_VEHICLE_ID;

					if ( GetVehicleTrailer( _v_id ) != 0 ) AC_SetVehicleToRespawn ( GetVehicleTrailer( _v_id ) ) ;
					AC_SetVehicleToRespawn ( _v_id  ) ;

					DisablePlayerRaceCheckpoint ( i ) ;

					SendClientMessage(i, col_gray,"{"#cRD"}* {"#cGR"} „ ”Õ» «·„—ﬂ»… «·„” √Ã—….");
					break;
				}
			}
		}
		else if ( veh_info [ vehicleid - 1 ] [ v_owner ] == job_trucker )
		{
			foreach(new i: logged_players)
			{
				if(player_rentcar [ i ] == vehicleid)
				{
					new _v_id = player_rentcar [ i ] ;
					player_rentcar [ i ] = INVALID_VEHICLE_ID;

					if ( player_trailer [ i ] != INVALID_VEHICLE_ID )
					{
						trailer_count [ vehicleid - 1 ] = 0 ;
						AC_DestroyVehicle ( player_trailer [ i ] ) ;

						SendClientMessage ( i, col_gray, "{"#cRD"}* {"#cGR"}„« ﬁœ—   Ê’· «·»÷«⁄…° «· ﬂ«·Ì› „« —«Õ   —œ." ) ;
						player_tload_time [ i ] = - 1;

						if ( GetPVarInt ( i, "truck_waiting" ) > 0 )
						{
							for ( new j = 0 ; j < 3 ; j ++ )
							{
								if ( loading_playerid [ j ] == i )
								{
									loading_playerid [ j ] = INVALID_PLAYER_ID ;
									KillTimer ( loading_timer [ j ] ) ;
									loading_timer [ j ] = - 1 ;
									DestroyDynamic3DTextLabel ( loading_text [ j ] ) ;
									loading_text [ j ] = Text3D:-1 ;
									DeletePVar ( i, "truck_waiting" ) ;
								}
							}
						}
						for ( new j = 0 ; j < 4 ; j ++ )
						{
							PlayerTextDrawDestroy ( i, td_db [ i ] [ j ] ) ;
							td_db [ i ] [ j ] = PlayerText:-1 ;
						}
						player_trailer [ i ] = INVALID_VEHICLE_ID ;
					}
					AC_SetVehicleToRespawn ( _v_id  ) ;

					DisablePlayerRaceCheckpoint ( i ) ;

					SendClientMessage(i, col_gray,"{"#cRD"}* {"#cGR"} „ ”Õ» «·„—ﬂ»… «·„” √Ã—….");
					break;
				}
			}
		}
		else if ( veh_info [ vehicleid - 1 ] [ v_owner ] == job_taxi )
		{
			foreach(new i: logged_players)
			{
				if(player_rentcar [ i ] == vehicleid)
				{
				    new _v_id = player_rentcar [ i ] ;
					if(p_t_info [i][pTaxi3DText] != Text3D:INVALID_3DTEXT_ID) DestroyDynamic3DTextLabel(p_t_info [i][pTaxi3DText]);
					player_rentcar [ i ] = INVALID_VEHICLE_ID ;
					AC_SetVehicleToRespawn ( _v_id  ) ;
					p_t_info [i][pTaxiPrice] = 0;
					taxi_td_status(i, false);
					p_t_info [i][pTaxi3DText] = Text3D:INVALID_3DTEXT_ID;
					p_t_info [i][pTaxiTurn][0] = INVALID_PLAYER_ID;
					p_t_info [i][pTaxiTurn][1] = INVALID_PLAYER_ID;
					SendClientMessage(i, col_gray,"{"#cRD"}* {"#cGR"} „ ”Õ» «·„—ﬂ»… «·„” √Ã—….");
					break;
				}
			}
		}
		else if ( veh_info [ vehicleid - 1 ] [ v_owner ] == job_mechanic )
		{
			foreach(new i: logged_players)
			{
				if(player_rentcar [ i ] == vehicleid)
				{
					new _v_id = player_rentcar [ i ] ;
					player_rentcar [ i ] = INVALID_VEHICLE_ID;
					AC_SetVehicleToRespawn ( _v_id  ) ;
					p_t_info [ i ][pTaxiPrice] = 0 ;
					taxi_td_status(i, false);
     				if(IsValid3DTextLabel(PlayerMehText[ i ])) DestroyDynamic3DTextLabel (PlayerMehText[ i ]);
					PlayerMehText[ i ] = Text3D:INVALID_3DTEXT_ID;
					DeletePVar ( i, "MehName" ) ;
					DeletePVar ( i, "toplivo" ) ;
					SendClientMessage(i, col_gray,"{"#cRD"}* {"#cGR"} „ ”Õ» «·„—ﬂ»… «·„” √Ã—….");
					break;
				}
			}
		}
		else if ( veh_info [ vehicleid - 1 ] [ v_owner ] == job_forklift )
		{
			foreach(new i: logged_players)
			{
				if(player_rentcar [ i ] == vehicleid)
				{
					new _v_id = player_rentcar [ i ] ;
					player_rentcar [ i ] = INVALID_VEHICLE_ID;

					AC_SetVehicleToRespawn ( _v_id  ) ;

					if ( GetPVarInt ( i, "fork_object") )
					{
						DestroyDynamicObject ( GetPVarInt ( i, "fork_object" ) ) ;
						DeletePVar ( i, "fork_object" ) ;
					}

					PlayerTextDrawDestroy ( i, forklift_ptd [ i ] ) ;
					forklift_ptd [ i ] = PlayerText:-1;
					forklift_time [ i ] = 0 ;
					p_info [ i ] [ timejob ] = job_none ;

					SendClientMessage(i, col_gray,"{"#cRD"}* {"#cGR"} „ ”Õ» «·„—ﬂ»… «·„” √Ã—….");
					break;
				}
			}
		}
		else
		{
			foreach(new i: logged_players)
			{
				if(player_rentcar [ i ] == vehicleid)
				{
					SendClientMessage(i, col_gray,"{"#cRD"}* {"#cGR"} „ ”Õ» «·„—ﬂ»… «·„” √Ã—….");
					break;
				}
			}
		}
	}
	return 1;
}

public OnVehicleDeath(vehicleid, killerid)
{
	if ( GetVehicleModel ( vehicleid ) == 450 )
	{
		foreach(new i: logged_players)
		{
			if ( player_trailer [ i ] != vehicleid )continue ;
			give_money ( i, trailer_count [ vehicleid - 1 ] * 9 ) ;
			insert_money_log ( i, INVALID_PLAYER_ID, trailer_count [ vehicleid - 1 ] * 9, "insurance db") ;

			trailer_count [ vehicleid - 1 ] = 0 ;
			AC_DestroyVehicle ( vehicleid ) ;

			SendClientMessage ( i, col_gray, "{"#cRD"}* {"#cGR"} ‘Õ‰ ﬂ  „  œ„Ì—Â«. ‘—ﬂ… «· √„Ì‰ ⁄Ê÷ ﬂ ⁄‰ «·Ã“¡ «·„ ÷——." ) ;

			if ( GetPVarInt ( i, "truck_waiting" ) > 0 )
			{
				for ( new j = 0 ; j < 3 ; j ++ )
				{
					if ( loading_playerid [ j ] == i )
					{
						loading_playerid [ j ] = INVALID_PLAYER_ID ;
						KillTimer ( loading_timer [ j ] ) ;
						loading_timer [ j ] = - 1 ;
						DestroyDynamic3DTextLabel ( loading_text [ j ] ) ;
						loading_text [ j ] = Text3D:-1 ;
						DeletePVar ( i, "truck_waiting" ) ;
					}
				}
			}
			for ( new j = 0 ; j < 4 ; j ++ )
			{
				PlayerTextDrawDestroy ( i, td_db [ i ] [ j ] ) ;
				td_db [ i ] [ j ] = PlayerText:-1 ;
			}
			player_trailer [ i ] = INVALID_VEHICLE_ID ;
			break ;
		}
	}
	return 1;
}

public OnVehicleMod(playerid, vehicleid, componentid)
{
    if (trent_find_by_vehid(vehicleid) >= 0)
    {
        SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}«·≈ÌÃ«— «·”Ì«—«  „« Ìﬁœ— ÌﬂÊ‰  „  ⁄œÌ·Â.");
        return 0;
    }
    if ( GetPVarInt ( playerid, "tuning_opened" ) == 0 ) return anti_cheat ( playerid, "car tunning", 72 ) ;
	ac_test_OnVehicleMod ( playerid, vehicleid, componentid ) ;
	return 1;
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
	Iter_Add(streamed_vehicles[forplayerid], vehicleid ) ;
	return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid)
{
	Iter_Remove(streamed_vehicles[forplayerid], vehicleid ) ;
	return 1;
}

public OnVehicleSirenStateChange(playerid, vehicleid, newstate)
{
	return true;
}

callback:check_player_registered ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	//SetPlayerPos ( playerid, 1658.3394, -1599.5652, 17.1219 ) ;
	Streamer_Update ( playerid ) ;
	set_world ( playerid, playerid ) ;
	SetPlayerCameraPos(playerid,1035.5400,-1775.2500,84.5400);
    SetPlayerCameraLookAt(playerid,851.3914,-1778.8464,13.5290);
	/*PlayerBot[playerid] = CreateActor(18, 2100.2695,262.9875,1110.8562,92.0877); //   
	SetActorInvulnerable(PlayerBot[playerid], true);
	SetActorVirtualWorld(PlayerBot[playerid], playerid);
	ApplyActorAnimation(PlayerBot[playerid], "PED", "SEAT_down", 4.1, 0, 0, 0, 1, 0);*/

	if ( rows )
	{
		new query_string [ 156 ] ;
		format ( query_string, sizeof query_string, "SELECT * FROM `users_bans` WHERE `u_b_name` = '%s' AND `u_b_date` > NOW( ) LIMIT 1", p_info [ playerid ] [ name ] ) ;
		mysql_tquery ( sql_connection, query_string, "check_player_banned", "i", playerid ) ;
	}
	else if ( ! rows )
	{
		show_register ( playerid ) ;
	}
	return 1;
}

callback: check_player_banned ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		global_string [ 0 ] = EOS ;
		new date [ 20 ], reason [ 64 ], old_date [ 20 ], admin_name [ MAX_PLAYER_NAME ], ub_days ;
		cache_get_field_content ( 0, "u_b_date", date, sql_connection, strlen ( date ) ) ;
		cache_get_field_content ( 0, "u_b_admin", admin_name, sql_connection, strlen ( admin_name ) ) ;
		cache_get_field_content ( 0, "u_b_reason", reason, sql_connection, strlen ( reason ) ) ;
		cache_get_field_content ( 0, "u_b_ndate", old_date, sql_connection, strlen ( old_date ) ) ;

		ub_days = cache_get_field_content_int ( 0, "u_b_days", sql_connection ) ;

		format ( global_string, sizeof global_string, "{"#cRD"}Õﬁﬂ «·Õ”«»  „ suspended ·‹ violating «·”Ì—›— ﬁÊ«⁄œ .\n\n{"#cGR"} - Please Œ–  screenshot „‰ Â–« window  {"#cWH"}(F8),\n{"#cGR"}   ≈–« „« agree „⁄ «·⁄ﬁÊ»… Ê Œ—ÊÃ  ‘ﬂÊÏ ⁄·Ï «·”Ì—›— œÌ”ﬂÊ—œ  {"#cWH"} œÌ”ﬂÊ—œ.gg/kmPpxwujF6 \n\n{"#cBL"}- {"#cGR"}Õﬁﬂ «·«”„ : {"#cWH"}%s.\n{"#cBL"}- {"#cGR"}≈œ«—Ì «·«”„ : {"#cWH"}%s.\n{"#cBL"}- {"#cGR"}«ﬁ›· «· «—ÌŒ : {"#cWH"}%s.\n{"#cBL"}- {"#cGR"}«› Õ «· «—ÌŒ : {"#cWH"}%s (%d ÌÊ„)\n{"#cBL"}- {"#cGR"}«·”»» : {"#cWH"}%s\n",
		p_info [ playerid ] [ name ], admin_name, old_date, date, ub_days, reason ) ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX,"{"#cBL"}„⁄·Ê„«  ⁄‰ «·ÕŸ—", global_string, "Œ—ÊÃ", "") ;
		kick_player ( playerid ) ;
	}
	else
	{
	    for ( new i ; i < 12 ; i ++ )
		{
		    SendClientMessage(playerid, -1, " ") ;
		}
		
		new rand_camera = random(2);
		
		SetPlayerCameraPos(playerid, CameraPosJoin[rand_camera][0],CameraPosJoin[rand_camera][1],CameraPosJoin[rand_camera][2]);
		SetPlayerCameraLookAt(playerid, CameraPosJoin[rand_camera][3],CameraPosJoin[rand_camera][4],CameraPosJoin[rand_camera][5]);
		SetPlayerVirtualWorld(playerid, 8);
		show_login ( playerid ) ;
		
		
        login_timer [ playerid ] = SetTimerEx( "TimerLogged", 60000, false, "i", playerid);
	}
	return 1;
}
callback: sell_house_tax ( playerid )
{
	p_info [ playerid ] [ money ] = cache_get_field_content_int ( 0, "u_money", sql_connection ) ;
