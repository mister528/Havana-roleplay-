CMD:buy ( playerid )
{
	new _b_id = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
	if ( _b_id == -1 ) return 1 ;
	if ( b_info [ _b_id - 1 ] [ b_type ] != bizz_type_shop )return 1 ;
