callback: LoadZone()
{
    new time = GetTickCount();
    new r, f;
    cache_get_data(r, f);
    new idx;
    for(idx = 1; idx <= r; idx++)
    {
	    GREENZONE[idx][grid] = cache_get_row_int(idx-1,0, sql_connection);
	    GREENZONE[idx][grX] = cache_get_row_float(idx-1,1, sql_connection);
	    GREENZONE[idx][grY] = cache_get_row_float(idx-1,2, sql_connection);
	    GREENZONE[idx][grZ] = cache_get_row_float(idx-1,3, sql_connection);
	    GREENZONE[idx][grD] = cache_get_row_float(idx-1,4, sql_connection);
	    cache_get_row(idx-1, 5, GREENZONE[idx][grName], sql_connection, 32);
	    GREENZONE[idx][grVirt] = cache_get_row_int(idx-1,6, sql_connection);
    	TOTALZONE++;
	}
	printf("[what is it]: <%i>. : <%i >.",TOTALZONE,GetTickCount()-time);
}

stock CreateRadar(Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, Float:zone_x, Float:zone_y, Float:zone_z, limit, modelid)
{
	new radar_id = g_radars_created;

	SetRadarData(radar_id, R_OBJECT, CreateDynamicObject(modelid, x, y, z, rx, ry, rz));

	SetRadarData(radar_id, R_ZONE, CreateDynamicSphere(zone_x, zone_y, zone_z, 40.0));

	new fmt_text[144];

	format(fmt_text, sizeof fmt_text, "- Radar ﬂ«‰ ⁄„· %d -\n\n{FFFFFF}ÕﬁÌ «·√ÌœÌ: {FF6600}%d /c", radar_id + 1, limit);

	SetRadarData(radar_id, R_LABEL, CreateDynamic3DTextLabel(fmt_text, 0xFFCC00FF, x, y, z + 3.0, 50.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0));

	SetRadarData(radar_id, R_POS_X, x);
	SetRadarData(radar_id, R_POS_Y, y);
	SetRadarData(radar_id, R_POS_Z, z);
	SetRadarData(radar_id, R_POS_RX, rx);
	SetRadarData(radar_id, R_POS_RY, ry);
	SetRadarData(radar_id, R_POS_RZ, rz);
	SetRadarData(radar_id, R_ZONE_X, zone_x);
	SetRadarData(radar_id, R_ZONE_Y, zone_y);
	SetRadarData(radar_id, R_ZONE_Z, zone_z);

	SetRadarData(radar_id, R_LIMIT, limit);

	g_radars_created ++;

	return 1;
}

