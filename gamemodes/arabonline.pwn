CMD:givemoney(playerid, params[])
{
	if ( p_info [ playerid ] [ admin ] < 8 ) return 1 ;
	//if(p_info[playerid][id] != 1 ) return true;
	new target_name [ MAX_PLAYER_NAME ], amount ;
	if ( sscanf ( params, "s[24]d", target_name, amount ) ) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /givemoney [ID/«·«”„] [«·„»·€]");
	if ( amount <= 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·„»·€ €Ì— ’ÕÌÕ." ) ;

	if ( ! isNumeric ( target_name ) )
	{
		new online_id = strval ( target_name ) ;
		if ( 0 <= online_id < MAX_PLAYERS && IsPlayerConnected ( online_id ) )
		{
			SendClientMessage ( playerid, -1, "  „ «·≈›—«Ã ⁄‰ «·›·Ê”." ) ;

			give_money ( online_id, amount ) ;
			insert_money_log ( online_id, playerid, amount, "/givemoney") ;

			format(global_string, 128, "%s √⁄ÿÏ %s %d$", p_info[playerid][name], p_info[online_id][name], amount);
			WriteLog(TYPE_LOG_ADMIN, global_string);
			return 1;
		}
	}
	else
	{
		new online_id = GetPlayerID ( target_name ) ;
		if ( IsPlayerConnected ( online_id ) )
		{
			SendClientMessage ( playerid, -1, "  „ «·≈›—«Ã ⁄‰ «·›·Ê”." ) ;

			give_money ( online_id, amount ) ;
			insert_money_log ( online_id, playerid, amount, "/givemoney") ;

			format(global_string, 128, "%s √⁄ÿÏ %s %d$", p_info[playerid][name], p_info[online_id][name], amount);
			WriteLog(TYPE_LOG_ADMIN, global_string);
			return 1;
		}
	}

	new query_string [ 220 ] ;
	if ( ! isNumeric ( target_name ) )
		mysql_format ( sql_connection, query_string, sizeof ( query_string ), "SELECT `u_id`,`u_name` FROM `users` WHERE `u_id`='%d' LIMIT 1", strval ( target_name ) ) ;
	else
		mysql_format ( sql_connection, query_string, sizeof ( query_string ), "SELECT `u_id`,`u_name` FROM `users` WHERE `u_name`='%e' LIMIT 1", target_name ) ;

	new Cache:result = mysql_query ( sql_connection, query_string ) ;
	if ( ! cache_num_rows ( ) )
	{
		cache_delete ( result ) ;
		return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» „«  „ «·⁄ÀÊ— ⁄·ÌÂ." ) ;
	}

	new account_id, account_name [ MAX_PLAYER_NAME ] ;
	account_id = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
	cache_get_field_content ( 0, "u_name", account_name, sql_connection, MAX_PLAYER_NAME ) ;
	cache_delete ( result ) ;

	mysql_format ( sql_connection, query_string, sizeof ( query_string ), "UPDATE `users` SET `u_money`=`u_money`+'%d' WHERE `u_id`='%d' LIMIT 1", amount, account_id ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;

	mysql_format ( sql_connection, query_string, sizeof ( query_string ), "INSERT INTO `money_logs` (`name`,`from_name`,`money`,`reason`,`date`) VALUES ('%e','%e','%d','/givemoney offline',NOW())", account_name, p_info [ playerid ] [ name ], amount ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;

	format(global_string, 128, " „  ÕÊÌ· %d$ ≈·Ï Õ”«» %s √Ê›·«Ì‰.", amount, account_name);
	SendClientMessage ( playerid, -1, global_string ) ;

	format(global_string, 128, "%s √⁄ÿÏ %s %d$ √Ê›·«Ì‰", p_info[playerid][name], account_name, amount);
	WriteLog(TYPE_LOG_ADMIN, global_string);
	return 1;
}

CMD:ccport ( playerid )
{
	if ( p_info [ playerid ] [ admin ] < 6 ) return 1 ;

	new Float:_distance = 3000.0,
				container_cell ;

	for ( new i = 0 ; i < MAX_CONTAINERS ; i ++ )
	{
		new Float:__distance = GetPlayerDistanceFromPoint ( playerid, porter_pos_take [ i ] [ 0 ], porter_pos_take [ i ] [ 1 ], porter_pos_take [ i ] [ 2 ] ) ;
		if ( _distance > __distance ) _distance = __distance, container_cell = i ;
	}
	if ( _distance < 7 )
	{
		for ( new j = 0 ; j < 2 ; j ++ )
		{
			if ( container_info [ container_cell ] [ con_status ] [ j ] != 0 )
			{
				if ( container_info [ container_cell ] [ con_status ] [ 1 ] == 1 )
				{
					DestroyDynamicObject ( container_info [ container_cell ] [ con_object ] [ 1 ] ) ;
					container_info [ container_cell ] [ con_object ] [ 1 ] = 0 ;
					container_info [ container_cell ] [ con_status ] [ 1 ] = 0 ;
					closed_containers -- ;
				}
				if ( container_info [ container_cell ] [ con_object ] [ 0 ] != 0 )DestroyDynamicObject ( container_info [ container_cell ] [ con_object ] [ 0 ] ) ;
				container_info [ container_cell ] [ con_status ] [ 0 ] = 0 ;
				closed_containers -- ;

				SendClientMessage ( playerid, -1, "«·„Ì‰«¡ «·Œ«‰…  „ „”ÕÂ.") ;
				break ;
			}
		}
	}
	return 1 ;
}

CMD:wlock ( playerid )
{
	if ( ! gang_player ( playerid ) && ! mafia_player ( playerid ) ) return 1 ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–Ì «·„Ì“… „Ê „ «Õ… ·ﬂ." ) ;

	new sql_string [ 92 ] ;
	if ( f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_dorm_status ] )
	{
		f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_dorm_status ] = 0 ;
		format ( sql_string, sizeof ( sql_string ), "UPDATE `fractions` SET `f_dorm_status` = '%d' WHERE `f_id` = '%d' LIMIT 1",
		f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_dorm_status ],
		p_info [ playerid ] [ member ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
		GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~ DORM „› ÊÕ", 3000, 3 ) ;

		format ( sql_string, sizeof sql_string, "[F] %s %s[%d] {"#cGN"} „ › ÕÂ {"#cGR"}«·„” Êœ⁄.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ member ] == p_info [ playerid ] [ member ] ) SendClientMessage ( i, col_gray, sql_string ) ;
	}
	else
	{
		f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_dorm_status ] = 1 ;
		format ( sql_string, sizeof ( sql_string ), "UPDATE `fractions` SET `f_dorm_status` = '%d' WHERE `f_id` = '%d' LIMIT 1",
		f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_dorm_status ],
		p_info [ playerid ] [ member ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
		GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ DORM „ﬁ›·", 3000, 3 ) ;

		format ( sql_string, sizeof sql_string, "[F] %s %s[%d] {"#cRD"}„€·ﬁ {"#cGR"}«·„” Êœ⁄.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ member ] == p_info [ playerid ] [ member ] ) SendClientMessage ( i, col_gray, sql_string ) ;

	}

	return 1 ;
}

CMD:startmp(playerid,params[])
{
	if ( p_info [ playerid ] [ admin ] < 8 ) return 1 ;
    new
           Float:mp_pos_x,
           Float:mp_pos_y,
           Float:mp_pos_z;

	new quantity_player, name_mp[32];
	if ( sscanf ( params, "ds[32]", quantity_player, name_mp ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«·«” Œœ«„: /startmp [⁄œœ «··«⁄»Ì‰] [«”„ «·ÕœÀ]" ) ;

    if(GetSVarInt("AidPlayers"))
       return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}›ÌÂ  Ã„⁄ ··«⁄»Ì‰ ··ÕœÀ.");
    if(quantity_player > 100)
        return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}«·Õœ «·√ﬁ’Ï ·⁄œœ «··«⁄»Ì‰ »«·ÕœÀ: 100.");
    if(!(1 <= strlen(params) <= 32))
		return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"} «”„ «·ÕœÀ ÿÊÌ· Ãœ«.");
    SetSVarInt("AidPlayers",quantity_player);
    GetPlayerPos(playerid, mp_pos_x, mp_pos_y, mp_pos_z);
    SetSVarFloat("mp_pos_x",mp_pos_x);
    SetSVarFloat("mp_pos_y",mp_pos_y);
    SetSVarFloat("mp_pos_z",mp_pos_z);
	SetSVarInt("mp_int",GetPlayerInterior ( playerid ) );
	SetSVarInt("mp_virt",GetPlayerVirtualWorld ( playerid ) );

    new string[ 128 ] ;
    format(string,sizeof(string),"[MP] ≈œ«—Ì %s »œ√ »œ√ Ã„⁄ «··«⁄»Ì‰ ·‹ «·ÕœÀ: '%s'. «·Õœ «·√ﬁ’Ï: %d «·‰«”", p_info [ playerid ] [ name ], name_mp, quantity_player ) ;
    SendClientMessageToAll(col_blue,string);

	foreach(new i : logged_players)
	{
	    p_t_info [ i ] [ mp_tp ] = 0 ;
	}
	foreach(new c:streamed_players[playerid])
	{
		if(GetDistanceBetweenPlayers(playerid,c) < 50 && playerid != c)
		{
		    p_t_info [ c ] [ mp_tp ] = 0 ;
		}
	}

    return SendClientMessageToAll(col_blue, "[MP] √œŒ·: '/gomp' ⁄‘«‰  ‰ ﬁ· ··ÕœÀ");
}

CMD:stopmp(playerid)
{
	if ( p_info [ playerid ] [ admin ] < 8 ) return 1 ;
    if(!GetSVarInt("AidPlayers"))
       return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}  Ã„⁄ «··«⁄»Ì‰ „Ê ‘€¯«·");
    DeleteSVar("AidPlayers");
    DeleteSVar("mp_pos_x"); DeleteSVar("mp_pos_y"); DeleteSVar("mp_pos_z");
	DeleteSVar("mp_int");  DeleteSVar("mp_virt");
	
	foreach(new i : logged_players)
	{
	    p_t_info [ i ] [ mp_tp ] = 0 ;
	}
	
    return SendClientMessageToAll(col_blue, "[MP]  Ã„⁄ «··«⁄»Ì‰ ··ÕœÀ «‰Êﬁ› „‰ ﬁ»· «·≈œ«—Ì");
}

CMD:gomp(playerid)
{
	if(p_info[playerid][jailed] > 1) return SendClientMessage(playerid, col_gray,"„«  ﬁœ— «‰÷„«„  «·ÕœÀ »Ì‰„« √‰  „”ÃÊ‰");
	if ( p_t_info [ playerid ] [ mp_tp ] == 1 ) return SendClientMessage(playerid, -1, "{"#cRD"}* {"#cGR"}”»ﬁ Ê ﬂ«‰  „ ‰ﬁ·Â ≈·Ï «·ÕœÀ!");
	if(!GetSVarInt("AidPlayers"))
        return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}„Ã„Ê⁄… «··«⁄» „« »œ√ ");
    if ( p_info [ playerid ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  ‘«—ﬂ ›Ì «·ÕœÀ Ê√‰  ›Ì «·”Ã‰.") ;
	if ( GetSVarInt("AidPlayers") < 2 )
    {
        SendClientMessage ( playerid, col_blue, "[MP]  Ã„⁄ «··«⁄»Ì‰ ··ÕœÀ Œ·’." ) ;
        DeleteSVar("mp_pos_x");  DeleteSVar("mp_pos_y"); DeleteSVar("mp_pos_z");
		DeleteSVar("AidPlayers");
		DeleteSVar("mp_int");  DeleteSVar("mp_virt");
		
		foreach(new i : logged_players)
		{
			p_t_info [ i ] [ mp_tp ] = 0 ;
		}
		
		return 1 ;
    }
    SetSVarInt("AidPlayers",GetSVarInt("AidPlayers")-1);

    set_pos ( playerid, GetSVarFloat("mp_pos_x") + random(3), GetSVarFloat("mp_pos_y") + random(3), GetSVarFloat("mp_pos_z"), 0.0, GetSVarInt("mp_int"), GetSVarInt("mp_virt") ) ;

    SendClientMessage(playerid, col_blue, "[MP]  „  „ ‰ﬁ·Â ≈·Ï  «·ÕœÀ!");
    p_t_info [ playerid ] [ mp_tp ] = 1 ;
    return 1;
}


