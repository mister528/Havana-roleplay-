	if(sscanf(params,"dd", params[0], params[1]))
		return SendClientMessage(playerid, col_white, !""scm_info"«·«” Œœ«„: /yhp [ID] [’Õ…]");

	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, col_white, !""scm_error"«··«⁄» €Ì— „ÊÃÊœ.");

	if(p_info[playerid][admin] > 7)
	{
		if(params[1] > 1000 || params[1] < 0) return SendClientMessage(playerid, col_white, !""scm_error"’Õ… Ìﬁœ— ÌﬂÊ‰  „ ≈⁄ÿ«ƒÂ „‰ 0 ≈·Ï 1000.");
	}
	else
	{
		if(params[1] > 160 || params[1] < 0) return SendClientMessage(playerid, col_white, !""scm_error"’Õ… Ìﬁœ— ÌﬂÊ‰  „ ≈⁄ÿ«ƒÂ „‰ 0 ≈·Ï 160.");
	}

	set_health(params[0], params[1]);

	new str[128];
	format(str, sizeof(str), ""scm_sucess"‰ÃÕ  ›Ì ÷⁄ Õﬁﬂ ’Õ… «·„” ÊÏ (%d) ≈·Ï «··«⁄» %s[%d]", params[1], p_info[params[0]][name], params[0]);
	SendClientMessage(playerid, col_white, str);
	return 1;
}

