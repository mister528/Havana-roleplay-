	if(b_info[ p_info[playerid][business]-1 ] [b_tax] > 0) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}·«“„  œ›⁄ «·÷—«∆» ﬁ»· „«  »Ì⁄ «·„Õ·") ;
	new sellbiz_id = - 1 ;

