callback: admin_get_callback ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–« ≈œ«—Ì „« ﬂ«‰  „ ≈ÌÃ«œÂ ›Ì ﬁ«⁄œ… «·»Ì«‰« " ) ;
		return 1 ;
	}
	else
	{
		new pl_name [ MAX_PLAYER_NAME ],
		pl_admin,
		pl_jail,
		pl_warn,
		pl_ban,
		pl_kick,
		pl_mute,
		pl_ans,
		pl_date [ 22 ] ;

		cache_get_field_content ( 0, "u_a_name", pl_name, sql_connection, MAX_PLAYER_NAME ) ;
		pl_admin = cache_get_field_content_int ( 0, "u_a_level", sql_connection ) ;
		cache_get_field_content ( 0, "u_a_date", pl_date, sql_connection, 22 ) ;
		
		pl_jail = cache_get_field_content_int ( 0, "u_a_jails", sql_connection ) ;
		pl_warn = cache_get_field_content_int ( 0, "u_a_warns", sql_connection ) ;
		pl_ban = cache_get_field_content_int ( 0, "u_a_bans", sql_connection ) ;
		pl_kick = cache_get_field_content_int ( 0, "u_a_kicks", sql_connection ) ;
		pl_mute = cache_get_field_content_int ( 0, "u_a_mute", sql_connection ) ;
		pl_ans = cache_get_field_content_int ( 0, "u_a_reports", sql_connection ) ;

		global_string [ 0 ] = EOS ;

		format ( global_string, sizeof ( global_string  ),
		"{"#cBL"}≈œ«—Ì „⁄·Ê„« :\n\n\
		{"#cGR"}≈œ«—Ì «·«”„: {"#cBL"}%s\n\
		{"#cGR"}≈œ«—Ì «·„” ÊÏ: {"#cBL"}%d «·„” ÊÏ\n\
		{"#cGR"}«·√ŒÌ— entrance: {"#cBL"}%s\n\n\
		{"#cBL"}Issuance „‰ punishments:\n\n\
		{"#cGR"}/jail   {"#cBL"}%d\n\
		{"#cGR"}/warn   {"#cBL"}%d\n\
		{"#cGR"}/ban   {"#cBL"}%d\n\
		{"#cGR"}/kick   {"#cBL"}%d\n\
		{"#cGR"}/mute   {"#cBL"}%d\n\
		{"#cGR"}/ans   {"#cBL"}%d\n\n\
		{"#cGR"}«·„Ã„Ê⁄ «·—ﬁ„ „‰ punishments: {"#cBL"}%d",
		pl_name, pl_admin, pl_date, pl_jail, pl_warn, pl_ban, pl_kick, pl_mute, pl_ans, pl_jail + pl_warn + pl_ban + pl_kick + pl_mute ) ;

		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBL"}|{"#cWH"} ≈œ«—Ì ≈Õ’«∆Ì« ", global_string, "≈€·«ﬁ", "" ) ;
	}
	return 1;
}

