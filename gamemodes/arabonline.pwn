callback: mc_callback ( playerid, to_id )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ »ÿ«ﬁ… ÿ»Ì…." ) ;
	new cmd_mc_date [ 18 ],
		cmd_mc_result ;



	cmd_mc_result = cache_get_field_content_int ( 0, "mc_result", sql_connection ) ;
	cache_get_field_content ( 0, "mc_date", cmd_mc_date, sql_connection, 18 ) ;

	static const mc_status [ ] [ ] = {
		" /",
		" ",
		" ()" } ;

	if ( to_id == playerid )format ( global_string, 72, "(-)  ." ) ;
	else format ( global_string, 72, "(-) . %s", p_info [ to_id ] [ name ] ) ;

	me_action ( playerid, global_string ) ;

	new dialog_string [ 186 ] ;

	format ( dialog_string, sizeof ( dialog_string ), "{ffffff}: %s\n : %s\n\n\n{cccc99}%s",
	p_info [ playerid ] [ name ], cmd_mc_date, mc_status [ cmd_mc_result ] ) ;

	show_dialog ( to_id, d_none, DIALOG_STYLE_MSGBOX, "{"#cBL"}«·»ÿ«ﬁ… «·ÿ»Ì…", dialog_string, "≈€·«ﬁ", "" ) ;
	return 1;
}


