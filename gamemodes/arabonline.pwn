	if ( p_info [ params [ 0 ] ] [ warblock ] == 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ›Ì ÕŸ— ⁄·Ï «··«⁄» ··„‘«—ﬂ… ›Ì «·Õ—Ê»." ) ;

