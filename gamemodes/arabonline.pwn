CMD:endarea(playerid, params[])
{
	if ( p_info [ playerid ] [ admin ] < 8 )return SendClientMessage ( playerid, col_gray,"«·√„— œÂ „‘ „ÊÃÊœ." ) ;
	////if(p_info[playerid][id] != 1 ) return true;
	if ( area_amount >= sizeof ( area_info ) ) return SendClientMessage ( playerid, col_white, "Œÿ√ ›Ì ≈‰‘«¡ «·‰ﬁ·. –«Â» Œ«—Ã „‰ÿﬁ…_«·„⁄·Ê„« ." ) ;
	if ( sscanf(params, "dddds[32]", params [ 0 ], params [ 1 ], params [ 2 ], params [ 3 ], params [ 4 ] ) ) return SendClientMessage(playerid, col_gray,"«·«” Œœ«„: /endarea [vw] [int] [to_vw] [to_int] [«”„]" ) ;
	GetPlayerFacingAngle ( playerid, p_t_info [ playerid ][ p_pos ] [ 3 ] ) ;
	area_amount ++;
	area_info [ area_amount - 1 ] [ a_id ] = area_amount + 1 ;
	for ( new i = 0; i < 4; i ++ )
	{
		new pvar_string [ 28 ];
		format ( pvar_string, sizeof ( pvar_string  ), "area_pos_%d", i ) ;
		area_info [ area_amount - 1 ] [ a_pos ] [ i ] = GetPVarFloat ( playerid, pvar_string ) ;
		DeletePVar ( playerid, pvar_string ) ;
		area_info [ area_amount - 1 ] [ a_to_pos ] [ i ] = p_t_info [ playerid ][ p_pos ] [ i ];
	}

	area_info [ area_amount - 1 ] [ a_pick ] = 1318 ;
	area_info [ area_amount - 1 ] [ a_virt_world ] [ 0 ] = params [ 0 ];
	area_info [ area_amount - 1 ] [ a_virt_world ] [ 1 ] = params [ 2 ];

	area_info [ area_amount - 1 ] [ a_interior ] [ 0 ] = params [ 1 ];
	area_info [ area_amount - 1 ] [ a_interior ] [ 1 ] = params [ 3 ];

	area_info [ area_amount - 1 ] [ a_area ] [ 0 ] = CreateDynamicPickup ( 1318, 23, area_info [ area_amount - 1 ] [ a_pos ] [ 0  ], area_info [ area_amount - 1 ] [ a_pos ] [ 1  ], area_info [ area_amount - 1 ] [ a_pos ] [ 2  ], area_info [ area_amount - 1 ] [ a_virt_world ] [ 0 ] ) ;
	area_info [ area_amount - 1 ] [ a_area ] [ 1 ] = CreateDynamicPickup ( 1318, 23, area_info [ area_amount - 1 ] [ a_to_pos ] [ 0  ], area_info [ area_amount - 1 ] [ a_to_pos ] [ 1  ], area_info [ area_amount - 1 ] [ a_to_pos ] [ 2  ], area_info [ area_amount - 1 ] [ a_virt_world ] [ 1 ] ) ;

	pick_info [ area_info [ area_amount - 1 ] [ a_area ] [ 0 ] ] [ pick_type ] = pick_type_teleportation ;
	pick_info [ area_info [ area_amount - 1 ] [ a_area ] [ 1 ] ] [ pick_type ] = pick_type_teleportation ;

	new insert_string [ 512 ];
	format ( insert_string, sizeof insert_string, "INSERT INTO `teleport_areas` ( `area_x`, `area_y`, `area_z`, `area_c`, `area_to_x`, `area_to_y`, `area_to_z`, `area_to_c`, `area_virtual_world`, `area_to_virtual_world`, `area_interior`, `area_to_interior`, `area_name` ) VALUES ( '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%d', '%d', '%d', '%d', '%s')",
	area_info [ area_amount - 1 ] [ a_pos ] [ 0  ], area_info [ area_amount - 1 ] [ a_pos ] [ 1  ], area_info [ area_amount - 1 ] [ a_pos ] [ 2  ], area_info [ area_amount - 1 ] [ a_pos ] [ 3  ],
	area_info [ area_amount - 1 ] [ a_to_pos ] [ 0  ], area_info [ area_amount - 1 ] [ a_to_pos ] [ 1  ], area_info [ area_amount - 1 ] [ a_to_pos ] [ 2  ], area_info [ area_amount - 1 ] [ a_to_pos ] [ 3  ],
	params [ 0  ], params [ 2  ], params [ 1  ], params [ 3 ], params [ 4 ] ) ;
	mysql_tquery ( sql_connection, insert_string, "", "" ) ;

	SendClientMessage ( playerid, col_lblue, " „ ≈‰‘«¡ «·„œŒ· «·œÌ‰«„ÌﬂÌ »‰Ã«Õ." ) ;
	return true;
}

CMD:gotohint ( playerid, params[ ] )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	//////if(p_info[playerid][id] != 1 ) return true;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /gotohint [int]" ) ;
	new hint = params [ 0 ] - 1 ;
	set_pos ( playerid, house_int [ hint ] [ hint_position ] [ 0 ], house_int [ hint ] [ hint_position ] [ 1 ], house_int [ hint ] [ hint_position ] [ 2 ], house_int [ hint ] [ hint_position ] [ 3 ], house_int [ hint ] [ hint_int ], 3223 ) ;
	return 1 ;
}

CMD:sethouseclass( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ admin ] < 8 ) return 1;
	////if(p_info[playerid][id] != 1 ) return true;
	extract params -> new id_house, classes; else return SendClientMessage(playerid,-1,"{"#cRD"}*{"#cGR"} ÿ—Ìﬁ… «·«” Œœ«„: /sethouseclass [ ID «·»Ì  ] [ class (1-»œÊ‰ „√ÊÏ, 2-„ Ê”ÿ, 3-⁄«·Ì) ]");
	if(params[1] == 1)h_info [ id_house - 1 ] [ h_int ] = 1 ;
	else if(params[1] == 2)h_info [ id_house - 1 ] [ h_int ] = 10 ;
	else if(params[1] == 3)h_info [ id_house - 1 ] [ h_int ] = 27 ;
	h_info [ id_house - 1 ] [ h_class_int ] = params [ 1 ] ;
	
	new query_string [ 60 ] ;

	format ( query_string, 27, "    %d", id_house ) ;
	SendClientMessage ( playerid, col_blue, query_string ) ;

	format ( query_string, 59, "UPDATE `houses` SET `h_class_int` = '%d' WHERE `h_id` = '%d'",
	classes, id_house ) ;
	mysql_tquery ( sql_connection, query_string ) ;
	
	return 1;
}

CMD:createfarm ( playerid, params[ ] )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	////if(p_info[playerid][id] != 1 ) return true;
	if ( sscanf ( params, "s[60]d", params [ 0 ], params[1] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /createhouse [«·«”„] [«·”⁄—]" ) ;
	if ( params [ 1 ] < 1 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}”⁄— «·»Ì  „« Ìﬁœ— ÌﬂÊ‰ √ﬁ· 1$." ) ;
	GetPlayerPos ( playerid, farm_info [ farm_count ] [ f_pos ] [ 0 ], farm_info [ farm_count ] [ f_pos ] [ 1 ], farm_info [ farm_count ] [ f_pos ] [ 2 ] ) ;
	GetPlayerFacingAngle ( playerid, farm_info [ farm_count ] [ f_pos ] [ 3 ] ) ;

	farm_info [ farm_count ] [ f_id ] = farm_count + 1 ;
	format ( farm_info [ farm_count ] [ f_name ], 35, "%s", params[0]) ;
	format ( farm_info [ farm_count ] [ f_owner_name ], 25, "«·œÊ·…" ) ;
	farm_info [ farm_count ] [ f_owner ] = -1 ;
	farm_info [ farm_count ] [ f_price ] = params [ 1 ] ;

    new stringer[180];
	format(stringer, sizeof(stringer), "{"#cGN"}%s\n{ffffff}Â–« «·„“—⁄… ··»Ì⁄\n\n«·”⁄—: %d$",farm_info[farm_count][f_name],farm_info[farm_count][f_price]);
	farm_info[farm_count][f_label] = CreateDynamic3DTextLabel(stringer,-1,
										farm_info[farm_count][f_pos][0], farm_info[farm_count][f_pos][1], farm_info[farm_count][f_pos][2] + 0.5,
										4.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1 ) ;

	farm_info [ farm_count ] [ f_pickup ] = CreateDynamicPickup ( 19130, 23, farm_info [ farm_count ] [ f_pos ] [ 0 ], farm_info [ farm_count ] [ f_pos ] [ 1 ], farm_info [ farm_count ] [ f_pos ] [ 2 ], -1, -1 ) ;

	farm_info [ farm_count ] [ f_icon_id ] = CreateDynamicMapIcon ( farm_info [ farm_count ] [ f_pos ] [ 0 ], farm_info [ farm_count ] [ f_pos ] [ 1 ], farm_info [ farm_count ] [ f_pos ] [ 2 ], 35, 0, 0, 0, -1, 30.0 ) ;

	farm_info [ farm_count ] [ f_exit_pickup ] = CreateDynamicPickup ( 19130, 23, -901.9227,-1199.9701,1019.4020, farm_info [ farm_count ] [ f_id ], -1 ) ;

	pick_info [ farm_info [ farm_count ] [ f_pickup ] ] [ pick_type ] = pick_type_fentrance ;
	pick_info [ farm_info [ farm_count ] [ f_exit_pickup ] ] [ pick_type ] = pick_type_fexit ;

	new query_stringx[1000];
	mysql_format ( sql_connection, query_stringx, sizeof ( query_stringx  ),"INSERT INTO `farms` (`f_name`,`f_pos_x`,`f_pos_y`,`f_pos_z`,`f_pos_c`,`f_price`) VALUES ('%s','%f','%f','%f','%f','%d','%d','%d','%d','%d')",
	params[0],farm_info [ farm_count ] [ f_pos ] [ 0 ], farm_info [ farm_count ] [ f_pos ] [ 1 ], farm_info [ farm_count ] [ f_pos ] [ 2 ], farm_info [ farm_count ] [ f_pos ] [ 3 ],params [ 1 ]) ;
	mysql_tquery ( sql_connection, query_stringx, "", "" ) ;

	farm_count ++ ;
	
	new query_string [ 128 ] ;

	format ( query_string, 68, "‰ÃÕ  ›Ì  „ ≈‰‘«ƒÂ  «·„“—⁄… | «·„“—⁄… #%d.", farm_info [ farm_count ] [ f_id ]+1 ) ;
	SendClientMessage ( playerid, col_white, query_string ) ;
	return 1 ;
}

CMD:createhouse ( playerid, params[ ] )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	////if(p_info[playerid][id] != 1 ) return true;
	if ( sscanf ( params, "ddd", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /createhouse [«·›∆…] [«·”⁄—] [«·Ã—«Ã]" ) ;
	if ( params [ 1 ] < 1 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}”⁄— «·»Ì  „« Ìﬁœ— ÌﬂÊ‰ √ﬁ· 1$." ) ;
	if(params[0] == 1)h_info [ house_count ] [ h_int ] = 1 ;
	else if(params[0] == 2)h_info [ house_count ] [ h_int ] = 10 ;
	else if(params[0] == 3)h_info [ house_count ] [ h_int ] = 27 ;
	GetPlayerPos ( playerid, h_info [ house_count ] [ h_pos ] [ 0 ], h_info [ house_count ] [ h_pos ] [ 1 ], h_info [ house_count ] [ h_pos ] [ 2 ] ) ;
	GetPlayerFacingAngle ( playerid, h_info [ house_count ] [ h_pos ] [ 3 ] ) ;

	h_info [ house_count ] [ h_id ] = house_count + 1 ;
	strcat ( h_info [ house_count ] [ h_owner_name ], "«·œÊ·…" ) ;
