{
	return 1;
}

public OnRconLoginAttempt(ip[], password[], success)
{
	return 1;
}

public OnQueryError(errorid, error[], callback[], query[], connectionHandle)
{
	print ("[OnQueryError] SQL ERROR. QUERY:") ;
	printf("0) OnQueryError | error: %s", error);
	printf("1) OnQueryError | callback: %s", callback);
	printf("2) OnQueryError | query: %s", query);
	printf("3) OnQueryError | errorid: %d", errorid);
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if (Fisherman_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
	#if defined debug_mode
		printf ( "[DEBUG] [OnDialogResponse] playerid:%d | dialogid:%d | listitem:%d | p_t_info:%d", playerid, dialogid, listitem, p_t_info [ playerid ] [ p_dialog ] ) ;
	#endif
	for(new i=0;i<strlen(inputtext);i++)if(inputtext[i]=='%')inputtext[i]='#';
	while(strfind(inputtext,"%s",true)!=-1) strdel(inputtext,strfind(inputtext,"%s",true),strfind(inputtext,"%s",true)+2);
	while(strfind(inputtext,"%",true)!=-1) strdel(inputtext,strfind(inputtext,"%",true),strfind(inputtext,"%",true)+2);

	if ( google_checking { playerid } == 1 && dialogid != d_googleauth_entrance ) return 1 ;

	if ( p_t_info [ playerid ] [ p_dialog ] != dialogid )
	{
		p_t_info [ playerid ] [ p_dialog ] = -1 ;
		return 1 ;
	}
	p_t_info [ playerid ] [ p_dialog ] = -1 ;

	switch ( dialogid )
	{
		case d_object_list:
		{
			if ( ! response ) return 1 ;
			if ( listitem < 0 || listitem >= g_objedit_count [ playerid ] ) return 1 ;
			g_objedit_current [ playerid ] = listitem ;
			objedit_reapply ( playerid, listitem ) ;
			Streamer_Update ( playerid ) ;
			objedit_push_overlay ( playerid ) ;
			SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „ «Œ Ì«— «·√Ê»Ãﬂ . «” Œœ„ ﬁ«∆„… «· Õﬂ„ · ÕœÌÀ „ﬂ«‰Â." ) ;
			return 1 ;
		}
		case d_object_project_list:
		{
			if ( ! response )
			{
				new midx2 = listitem - 1 ;
				if ( midx2 < 0 || midx2 >= 50 ) return 1 ;
				new idx2 = g_objedit_menu_index [ playerid ] [ midx2 ] ;
				if ( idx2 < 0 ) return 1 ;
				g_objedit_delete_idx [ playerid ] = idx2 ;
				new dpath2 [ 96 ], dpname [ 64 ], dtxt [ 256 ] ;
				objedit_project_index_path ( idx2, dpath2, sizeof dpath2 ) ;
				if ( fexist ( dpath2 ) ) { new File:dr = fopen ( dpath2, io_read ) ; if ( dr ) { fread ( dr, dpname, sizeof dpname ) ; fclose ( dr ) ; objedit_chomp ( dpname ) ; } }
				format ( dtxt, sizeof dtxt, "Project: %s\n\nDelete this object project permanently?", dpname ) ;
				show_dialog ( playerid, d_object_delete_confirm, DIALOG_STYLE_MSGBOX, "Delete Object Project", dtxt, "Delete", "Cancel" ) ;
				return 1 ;
			}
			if ( listitem == 0 ) return show_dialog ( playerid, d_object_project, DIALOG_STYLE_INPUT, "{"#cBL"}„Õ—— «·√Ê»Ãﬂ « ", "{"#cWH"}÷⁄ «”„ «·„‘—Ê⁄ «·–Ì  —Ìœ ≈‰‘«¡Â:\n\n{"#cYW"}„À«·: œÌﬂÊ— „ÿ⁄„", "≈‰‘«¡", "≈·€«¡" ) ;
			new midx = listitem - 1 ;
			if ( midx < 0 || midx >= 50 ) return 1 ;
			new idx = g_objedit_menu_index [ playerid ] [ midx ], path [ 96 ], pname [ 64 ] ;
			if ( idx < 0 ) return objedit_show_project_menu ( playerid ) ;
			objedit_project_index_path ( idx, path, sizeof path ) ;
			if ( ! fexist ( path ) ) return objedit_show_project_menu ( playerid ) ;
			new File:r = fopen ( path, io_read ) ;
			if ( ! r ) return 1 ;
			fread ( r, pname, sizeof pname ) ;
			fclose ( r ) ;
			objedit_chomp ( pname ) ;
			objedit_open_project ( playerid, pname ) ;
			if ( g_objedit_count [ playerid ] > 0 ) objedit_push_overlay ( playerid ) ;
			SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „ › Õ «·„‘—Ê⁄. «” Œœ„ /Add [«·„ÊœÌ·] ··≈÷«›… √Ê /Eddtadd · ⁄œÌ· «·„ÊÃÊœ." ) ;
			return 1 ;
		}
		case d_object_delete_confirm:
		{
			if ( ! response ) return objedit_show_project_menu ( playerid ) ;
			new didx = g_objedit_delete_idx [ playerid ] ;
			g_objedit_delete_idx [ playerid ] = -1 ;
			if ( didx < 0 ) return objedit_show_project_menu ( playerid ) ;
			if ( objedit_delete_project ( playerid, didx ) ) SendClientMessage ( playerid, col_white, "{33FF33}* {FFFFFF}Object project deleted from menu and files." ) ;
			else SendClientMessage ( playerid, col_gray, "{FF3333}* {AAAAAA}Could not delete object project." ) ;
			return objedit_show_project_menu ( playerid ) ;
		}

		case d_object_project:
		{
			if ( ! response ) return 1 ;
			if ( strlen ( inputtext ) < 2 ) return show_dialog ( playerid, d_object_project, DIALOG_STYLE_INPUT, "{"#cBL"}„Õ—— «·√Ê»Ãﬂ « ", "{"#cRD"}÷⁄ «”„ „‘—Ê⁄ ’ÕÌÕ.\n\n{"#cWH"}«ﬂ » «”„ «·„‘—Ê⁄:", "≈‰‘«¡", "≈·€«¡" ) ;
			objedit_open_project ( playerid, inputtext ) ;
			objedit_register_project ( g_objedit_project [ playerid ] ) ;
			SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „ ≈‰‘«¡ „‘—Ê⁄ «·√Ê»Ãﬂ . «” Œœ„ /Add [«·„ÊœÌ·] ·≈÷«›… √Ê»Ãﬂ ." ) ;
			return 1 ;
		}

		case d_army_carextract:
		{
			if ( ! response ) return 1;
			if ( ! army_player ( playerid ) && p_info [ playerid ] [ admin ] < 4 )
				return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}›ﬁÿ √⁄÷«¡ «·ÃÌ‘ ·«” Œ—«Ã «·”Ì«—« ." );
			new car_model;
			switch ( listitem )
			{
				case 0: car_model = 470;
				case 1: car_model = 433;
				default: return 1;
			}
			if ( army_extract_vehicle [ playerid ] != 0 && IsValidVehicle ( army_extract_vehicle [ playerid ] ) )
			{
				AC_DestroyVehicle ( army_extract_vehicle [ playerid ] );
				army_extract_vehicle [ playerid ] = 0;
			}
			new veh = AC_CreateVehicle ( car_model, 675.245971, -2617.874023, 11.866999, 305.40, 43, 0, -1 );
			army_extract_vehicle [ playerid ] = veh;
			veh_info [ veh - 1 ] [ v_fuel ] = 100;
			veh_info [ veh - 1 ] [ v_locked ] = false;
			AC_PutPlayerInVehicle ( playerid, veh, 0 );
			SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „ «” Œ—«Ã ”Ì«—… «·ÃÌ‘ »‰Ã«Õ." );
