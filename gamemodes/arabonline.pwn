	if(p_t_info [ playerid ] [ mp_tp ] == 1) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— «⁄„· «·√”·Õ… ·„« √‰  ›Ì  «·ÕœÀ.") ;
