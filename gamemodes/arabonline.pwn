}

CMD:hleave ( playerid )
{
	if ( p_info [ playerid ] [ rent_house ] <= 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}√‰  „Ê ≈ÌÃ«—.") ;

	p_info [ playerid ] [ rent_house ] = -1 ;
	update_int_sql ( playerid, "u_renthouse", p_info [ playerid ] [ rent_house ] ) ;

	SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}‰ÃÕ  ›Ì  „ ‰ﬁ·Â Œ«—Ã." ) ;
	return 1;
}

CMD:renthome(playerid)
{
	for ( new h = 0 ; h < house_count ; h ++ )
	{
		if ( IsPlayerInRangeOfPoint ( playerid, 4.00, h_info [ h ] [ h_pos ] [ 0 ], h_info [ h ] [ h_pos ] [ 1 ], h_info [ h ] [ h_pos ] [ 2 ] ) )
		{
			if( ! h_info [ h ] [ h_rent_price ] || ! h_info [ h ] [ h_rent_status ] ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«·»Ì  «·≈ÌÃ«— „Ê „ Ê›—.");

			if(p_info [ playerid ] [ house ] != -1 || p_info [ playerid ] [ rent_house ] != -1) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}√‰  ≈ÌÃ«— «·”ﬂ‰ √Ê √‰  ”»ﬁ Ê ⁄‰œ  «·»Ì .") ;
			if ( p_info [ playerid ] [ money ] < h_info [ h ] [ h_rent_price ] ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ „« Ìﬂ›Ì „‰ «·›·Ê” · √ÃÌ— »Ì .") ;

			p_info [ playerid ] [ rent_house ] = h ;
			update_int_sql ( playerid, "u_renthouse", p_info [ playerid ] [ rent_house ] ) ;

			SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}»‰Ã«Õ «” ﬁ—Ì  ›Ì «·»Ì ." ) ;
			new text_size [ 128 ] ;
			format ( text_size, sizeof text_size, "{"#cGN"}* {"#cWH"}‰ÃÕ  ›Ì  „ ‰ﬁ·Â ≈·Ï œ«Œ· «·»Ì . «·»Ì  «·≈ÌÃ«— per ”«⁄…: %d.", h_info [ h ] [ h_rent_price ] ) ;
			return 1;
		}
	}
	return 1;
}

CMD:fmute( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 5 ] )return 1 ;
	if ( sscanf ( params, "uds[42]", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /fmute [ID] [œﬁÌﬁ…] [«·”»»]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» „Ê ›Ì „‰Ÿ„ ﬂ. ");
	if ( p_info [ params [ 0 ] ] [ rank ] >= p_info [ playerid ] [ rank ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „«  ﬁœ—  ﬂ „ œ·Ì·ﬂ.");
	if ( params [1] < 1 || params [1] > 120 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} «·ﬂ „ „« Ìﬁœ— ÌﬂÊ‰ √ﬁ· „‰ œﬁÌﬁ… ÊÕœ… √Ê √ﬂÀ— „‰ 120 œﬁÌﬁ….");

	new scm_string [ 144 ] ;

	format ( scm_string, sizeof scm_string, "[F] %s %s ÿ—œ %s ·‹ %i «·Õœ «·√œ‰Ï. «·”»»: %s.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ] ) ;
	foreach(new i: logged_players) if ( ( p_info [ i ] [ member ] == p_info [ playerid ] [ member ] || is_control_chat { i } == p_info [ playerid ] [ member ] ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, 0x8D8DFFFF, scm_string ) ;

	p_info [ params [ 0 ] ] [ f_mute ] = params [1]*60;
	return 1;
}

