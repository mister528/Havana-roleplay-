	if ( p_info [ playerid ] [ jail ] == 20 ) return SendClientMessage(playerid, col_red, "* {"#cGR"}„«  ﬁœ—  ” Œœ„ Â–Ì «·Õ—ﬂ… ›Ì ”Ã‰ «·ﬂ —«“!");
