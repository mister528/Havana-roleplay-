CMD:healme(playerid, params[])
{
    if ( TeamPaint[playerid] != 0 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì’Ì— Ê√‰  „‘«—ﬂ ›Ì «·»Ì‰  »Ê·." ) ;
    if(GetPVarInt(playerid, "on_dmarena") || GetPVarInt(playerid, "on_dmarena1")) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–« „Ê „„ﬂ‰ ›Ì „‰ÿﬁ… «·‹ DM." ) ;

    if ( heal_cooldown [ playerid ] > gettime ( ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}«·⁄œ… «·ÿ»Ì…  ‰” Œœ„ »” „—… ﬂ· {"#cRD"}15{"#cGR"} ÀÊ«‰Ì.");
	if ( GetPVarInt ( playerid, "PlayerCuffed" ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  „ﬂ»¯·." ) ;
	if ( GetPVarInt ( playerid, "PlayerTied" )) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „ « ’«·ﬂ." ) ;

	if ( p_info [ playerid ] [ aidkit ] < 1 ) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ⁄œ… ≈”⁄«›.");
	
	p_info [ playerid ] [ aidkit ] -= 1 ;
	update_int_sql ( playerid, "u_aidkit", p_info [ playerid ] [ aidkit ] ) ;

	new Float:pl_health ;
	GetPlayerHealth ( playerid, pl_health ) ;
	if ( pl_health + 65 > 100 ) set_health ( playerid, 100 ) ;
	else set_health ( playerid, pl_health + 65 ) ;
	
	GameTextForPlayer ( playerid, "~g~+65’Õ…", 2000, 1 ) ;
	heal_cooldown [ playerid ] = gettime ( ) + 12 ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT && ! GetPVarInt ( playerid, "PlayerCuffed" )&& ! GetPVarInt ( playerid, "PlayerTied" ) ) ApplyAnimation(playerid, "ped", "gum_eat", 4.0, 0, 0, 0, 0, 0, 1);
	return 1;
}

alias:stealcar("carjack")
CMD:stealcar(playerid, params[])
{
	if ( GetPVarInt ( playerid, "PlayerCuffed" ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ—  ” Œœ„ „› «Õ «·”—ﬁ… Ê«‰  „ﬂ»·." ) ;
	if ( GetPVarInt ( playerid, "PlayerTied" ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ—  ” Œœ„ „› «Õ «·”—ﬁ… Ê«‰  „—»Êÿ." ) ;
	if ( p_info [ playerid ] [ u_theft_key ] <= 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ „› «Õ ”—ﬁ…." ) ;
	if ( IsPlayerInAnyVehicle ( playerid ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ Œ«—Ã «·”Ì«—… Êﬁ—Ì» „‰ «·»«»." ) ;
	new veh_id = CarJack_GetNearestVehicle ( playerid ) ;
	if ( veh_id == INVALID_VEHICLE_ID ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}ﬁ—» √ﬂÀ— „‰ »«» «·”Ì«—…." ) ;
	if ( ! CarJack_IsVehicleAllowed ( veh_id ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ—  ”—ﬁ ”Ì«—«  «·⁄„· √Ê «·ÕﬂÊ„… √Ê «·⁄’«»«  √Ê «·„‰Ÿ„« ." ) ;
	if ( is_vehicle_occupied ( veh_id ) != -1 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«·”Ì«—… ›ÌÂ« ‘Œ’° „«  ﬁœ—  ”—ﬁÂ« «·¬‰." ) ;
	g_carjack_vehicle [ playerid ] = veh_id ;
	g_carjack_dialog [ playerid ] = d_carjack_minigame ;
	p_t_info [ playerid ] [ p_dialog ] = d_carjack_minigame ;
	toggle_controlable ( playerid, false, false ) ;
	ApplyAnimation(playerid,"BD_FIRE","wash_up",4.1,1,0,0,0,0,0);
	ShowPlayerDialog(playerid, d_carjack_minigame, DIALOG_STYLE_INPUT, "[!CARJACK_OPEN]", "4", "OK", "");
