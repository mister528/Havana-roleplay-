PlayerTimer(playerid) 
{
    new hor, m, s;
    new year, month, day;
    getdate(year, month, day);
	gettime(hor, m, s);
	if(m+1 == 60) m = 0, hor++;
    if(hor == 24) hor = 0;

    new timersami[128];

    format(timersami, sizeof(timersami), "%02d.%02d.%02d / %02d:%02d", day, month, year, hor, m);
    TextDrawSetString(TD_DataTime[1], timersami);
    
    
    for(new i;i<MAX_PLAYERS;i++)
    {
		if(SWAT_TIMER[0][i] > 0)
		{
			SWAT_TIMER[0][i]--;
			if(SWAT_TIMER[0][i] == 1) MoveObject(swat_mskr,777.630859, -1384.746826, 14.545700, 2.0);
		}
		if(ARHAB_TIMER[0][i] > 0)
		{
			ARHAB_TIMER[0][i]--;
			if(ARHAB_TIMER[0][i] == 1) MoveObject(arhab_door,-1617.058105, 2666.118896, 56.049236, 2.0);
		}
	}
	if(p_info[playerid][jailed] > 0)
    {
        if(p_info[playerid][jailed] == 1) InJAIL[playerid] = 1;
        new string[228];
        p_info[playerid][jailed] --;
        format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~«·Êﬁ  Ì”«—: %s",fix_seconde(p_info[playerid][jailed]));
        GameTextForPlayer(playerid, string, 1000, 3);
	}
	
    p_info[playerid][second_played]++;
    
    /*if(p_info[playerid][hunger] >= 0)
	{
	    if(p_info[playerid][hunger] == 0)
	    {
	        new Float:heal;
	        GetPlayerHealth(playerid, heal);
	        if(heal > 2) set_health(playerid, heal-2);
	        else if(heal <= 2) set_health(playerid, 0.0), SendClientMessage(playerid, col_red, "* {ffffff}„  ·√‰ﬂ ÃÊ⁄«‰.");
	    }
	    else if(p_info[playerid][hunger] > 0)
		{
			p_info[playerid][hunger] -= 0.5;
		}
	}*/
	
    if(tazered[playerid] > 0)
    {
        tazered [playerid] -- ;

		if ( tazered [playerid] <= 0 )
		{
			tazered [playerid] = 0;
		}
    }
    if(is_tazered { playerid } == 1 )
    {
        new strings[228];
        format(strings, sizeof(strings), "{ffffff} „  Êﬁ› {"#cYW"}(slinced „”œ”) {ffffff}»Ê«”ÿ…  cop/federal agent\n{ffffff}«·Êﬁ : {"#cGN"}%d {ffffff}ÀÊ«‰Ì",tazered[playerid]);
        show_dialog(playerid, d_tazered, DIALOG_STYLE_MSGBOX, "≈‘⁄«—", strings, "≈€·«ﬁ","");
    }
    if(ChaseTimer[playerid] > 0)
    {
        new string[228];
        format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~„ƒﬁ  «·„ÿ«—œ…: %s",fix_seconde(ChaseTimer[playerid]));
        GameTextForPlayer(playerid, string, 1000, 3);
    }
    if(CopChaseTimer[playerid] > 0)
    {
        new string[228];
        format(string, sizeof(string), "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~„ƒﬁ  «·„ÿ«—œ…: %s",fix_seconde(CopChaseTimer[playerid]));
        GameTextForPlayer(playerid, string, 1000, 3);
    }
    if ( p_info[playerid][pizza_exit_timer]  > 0 )
	{
	    if(p_info[playerid][pizza_exit_timer] == 1)
	    {
	        DisablePlayerRaceCheckpoint ( playerid ) ;
			DeliveryPizza[playerid] = 0;
	        havePizza[playerid] = 0;
			DeletePVar ( playerid, "PizzaCheckpoint" ) ;
			SetPlayerRaceCheckpoint(playerid,1,954.2245,-1362.7594,13.3438,954.2245,-1362.7594,13.3438,1.5);
			p_info[playerid][pizzatimer]=900;
			p_info[playerid][pizza_exit_timer] = 0;
			SendClientMessage(playerid, col_white,"{"#cRD"}* {"#cGR"} «‰ ÂÏ Êﬁ   Ê’Ì· «·»Ì “«° «—Ã⁄ · «Œ– ﬁÿ⁄… »Ì “« „‰ ÃœÌœ.");
            GameTextForPlayer ( playerid, "~r~«·Êﬁ  ÂÊ ›Êﬁ!", 3000, 3 ) ;
	        return 1;
		}
		p_info[playerid][pizza_exit_timer] -- ;

		if ( p_info[playerid][pizza_exit_timer]<=0 )
		{
			p_info[playerid][pizza_exit_timer] = 0;

