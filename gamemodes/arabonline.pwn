CMD:destroylag(playerid, params[])
{
    if ( p_info [ playerid ] [ admin ] < 8 )return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}√‰  „Ê ≈œ«—Ì." ) ;
