		PlayerTextDrawSetShadow(playerid, cm_ptd [ playerid ] [ 54 ], 1 ) ;
		PlayerTextDrawSetSelectable(playerid, cm_ptd [ playerid ] [ 54 ], 0 ) ;

		cm_ptd [ playerid ] [ 55 ] = CreatePlayerTextDraw(playerid, 349.000000, 84.000000, "LD_SPAC:white" ) ;
