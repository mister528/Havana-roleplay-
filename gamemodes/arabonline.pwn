//fish system 
// Forward declarations to avoid warnings
forward FinishFishing(playerid);
forward ResetCooldown(playerid);

public FinishFishing(playerid)
{
    if (!isFishing[playerid]) return;

    isFishing[playerid] = false;
    cooldownzbi[playerid] = true;

    new fishIndex = random(MAX_FISH);
    new moneyEarned = fishList[fishIndex][Pricefish];

    GivePlayerMoney(playerid, moneyEarned);

    new msg[128];
    format(msg, sizeof(msg), "[«·’Ìœ] √‰  √„”ﬂ  %s («·Ê“‰: %d ﬂÃ„) Ê —»Õ $%d!", 
           fishList[fishIndex][Namefish], fishList[fishIndex][Weight], moneyEarned);
    SendClientMessage(playerid, 0x00FF00FF, msg);

	//RemovePlayerAttachedObject ( playerid ) ;

    // Play sound effect for catching a fish
    //PlayerPlaySound(playerid, 1130, 0.0, 0.0, 0.0);
    TogglePlayerControllable(playerid, true);
    ClearAnimations(playerid);

    SetTimerEx("ResetCooldown", COOLDOWN_TIME, false, "d", playerid);
}

public ResetCooldown(playerid)
{
    cooldownzbi[playerid] = false;
    SendClientMessage(playerid, 0xFFFF00FF, "[«·’Ìœ]  ﬁœ—  ’Ìœ „—… À«‰Ì…!");
}

