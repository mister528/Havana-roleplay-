{
	if ( Iter_Count(player_vehicles[playerid]) == 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ‰ﬁ· √Ê ÂÊ ›Ì ÕÃ“ «·”Ì«—« ." ) ;
