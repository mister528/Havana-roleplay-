	        new veh_id = GetPlayerVehicleID ( params [ 0 ] ) ;
	        TogglePlayerSpectating ( playerid, true ) ;
			PlayerSpectateVehicle (playerid, veh_id ) ;
		}
	}
	
	SetPVarInt ( playerid, "spectate_status", params [ 0 ] + 1 ) ;
	return 1;
}

