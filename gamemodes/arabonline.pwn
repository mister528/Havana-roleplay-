stock house_guard_is_member(playerid)
{
	if (gover_player(playerid) || gov_player(playerid) || cop_player(playerid) || fbi_player(playerid) || army_player(playerid) || medic_player(playerid) || mayor_player(playerid)) return 1;
	return 0;
}

stock house_guard_select_houses(playerid)
{
	new count = 0;
	for (new tries = 0; tries < 250 && count < HOUSE_GUARD_TARGETS; tries++)
	{
		if (house_count <= 0) break;
		new h = random(house_count);
		if (h_info[h][h_id] <= 0) continue;
		if (h_info[h][h_vw] != 0) continue;
		if (h_info[h][h_pos][0] < 1200.0 || h_info[h][h_pos][0] > 2800.0) continue;
		if (h_info[h][h_pos][1] < -2800.0 || h_info[h][h_pos][1] > -800.0) continue;
		new exists = 0;
		for (new j = 0; j < count; j++) if (g_house_guard_house[playerid][j] == h) exists = 1;
		if (exists) continue;
		g_house_guard_house[playerid][count++] = h;
	}
	if (count == HOUSE_GUARD_TARGETS) return 1;
	for (new i = 0; i < HOUSE_GUARD_TARGETS; i++) g_house_guard_house[playerid][i] = -1 - i;
	return 1;
}

stock house_guard_target_pos(playerid, idx, &Float:x, &Float:y, &Float:z)
{
	new h = g_house_guard_house[playerid][idx];
	if (h >= 0)
	{
		x = h_info[h][h_pos][0];
		y = h_info[h][h_pos][1];
		z = h_info[h][h_pos][2];
		return 1;
	}
	switch (-1 - h)
	{
		case 0: x = 2066.6814, y = -1731.0592, z = 13.8762;
		case 1: x = 2148.9863, y = -1484.8107, z = 26.6234;
		case 2: x = 2397.2480, y = -1723.1818, z = 13.5469;
		case 3: x = 2523.9021, y = -1679.2977, z = 15.4970;
		default: x = 2282.2571, y = -1641.0193, z = 15.8892;
	}
	return 1;
}

stock house_guard_create_cp(playerid, idx)
{
	if (g_house_guard_cp[playerid] != -1) DestroyDynamicCP(g_house_guard_cp[playerid]);
	new Float:x, Float:y, Float:z;
	house_guard_target_pos(playerid, idx, x, y, z);
	g_house_guard_cp[playerid] = CreateDynamicCP(x, y, z, 2.5, 0, 0, playerid, 120.0);
	SetPlayerRaceCheckpoint(playerid, 1, x, y, z, x, y, z, 3.0);
	new msg[128];
	format(msg, sizeof(msg), "{00BFFF}[Õ«—” «·„‰“·] {FFFFFF} „  ÕœÌœ «·„‰“· %d/%d »«··Ê‰ «·√Õ„—. «–Â» ≈·ÌÂ Êﬁ› ⁄·Ï ‰ﬁÿ… «·›Õ’.", idx + 1, HOUSE_GUARD_TARGETS);
	SendClientMessage(playerid, col_white, msg);
	return 1;
}

public house_guard_start(playerid)
{
	if (!IsPlayerConnected(playerid)) return 1;
	if (g_house_guard_vehicle[playerid] == INVALID_VEHICLE_ID) return 1;
	house_guard_select_houses(playerid);
	g_house_guard_active[playerid] = 1;
	g_house_guard_stage[playerid] = 0;
	g_house_guard_pay[playerid] = 0;
	house_guard_create_cp(playerid, 0);
	return 1;
}

// [HOUSE GUARD v12] The launcher detects this magic title and replaces
// the stock dialog with a circular skill-minigame overlay. The body is
// "<houseIdx>|<totalHouses>|<rewardPerHouse>". The overlay handles the
// rotating arrow / target arc / 5-hit counter / mistakes locally and
// replies via SendDialogResponse:
//   button=1 -> house  „  √„Ì‰Â (success, advance + reward)
//   button=0 -> player gave up
// On unmodified clients the SAMP MSGBOX still works as a fallback:
//   Yes (button=1) = mark  „  √„Ì‰Â, No (button=0) = give up.
stock house_guard_open_lock(playerid)
{
	if (!g_house_guard_active[playerid]) return 1;
	new s[64];
	g_house_guard_key_dir[playerid]  = 0;
	g_house_guard_key_step[playerid] = 0;
	// [HOUSE GUARD v12.5] The player is now standing on the door, so the
	// red race-checkpoint and the dynamic CP have done their job. Hide
	// them so the screen is clean while the minigame is up. The next
	// house's checkpoint will be created by house_guard_show_next.
	DisablePlayerRaceCheckpoint(playerid);
	if (g_house_guard_cp[playerid] != -1)
	{
		DestroyDynamicCP(g_house_guard_cp[playerid]);
		g_house_guard_cp[playerid] = -1;
	}
	// [HOUSE GUARD v12.3] Lockpicking pose for the duration of the
	// minigame. BOMBER/BOM_Plant_Loop is already preloaded by
	// PreloadAnimLibs and ‘«› like the player is fiddling with the
	// door at chest height.
	ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.1, 1, 0, 0, 0, 0, 1);
	format(s, sizeof(s), "%d|%d|%d",
		g_house_guard_stage[playerid] + 1,
		HOUSE_GUARD_TARGETS,
		HOUSE_GUARD_REWARD);
	show_dialog(playerid, d_house_guard_lock, DIALOG_STYLE_MSGBOX,
		"~HOUSEGUARD_UI~", s, " √„Ì‰", "≈·€«¡");
	return 1;
}

// [HOUSE GUARD v12.3] Called 5s after the player completes the 5-hit
// minigame. Finishes the lockpick, pays the reward, advances the
// route, and clears the burglary animation.
public house_guard_finish_open(playerid)
{
	if (!IsPlayerConnected(playerid)) return 1;
	if (!g_house_guard_active[playerid])
	{
		ClearAnimations(playerid, 1);
		return 1;
	}
	ClearAnimations(playerid, 1);
	// [HOUSE GUARD v12.4] Drop the drug-bag (model 1577) on the door step
	// for THIS house. Visible only to the player who completed it; it gets
	// cleaned up smoothly when the shift ends.
	new _hg_idx = g_house_guard_stage[playerid];
	if (_hg_idx >= 0 && _hg_idx < HOUSE_GUARD_TARGETS)
	{
	    new Float:_hg_x, Float:_hg_y, Float:_hg_z;
	    house_guard_target_pos(playerid, _hg_idx, _hg_x, _hg_y, _hg_z);
	    if (g_house_guard_drug_obj[playerid][_hg_idx])
	        DestroyDynamicObject(g_house_guard_drug_obj[playerid][_hg_idx]);
	    g_house_guard_drug_obj[playerid][_hg_idx] = CreateDynamicObject(
	        1577, _hg_x, _hg_y, _hg_z - 0.5,
	        0.0, 0.0, 0.0,
	        -1, -1, playerid, 250.0);
	}
	g_house_guard_pay[playerid] += HOUSE_GUARD_REWARD;
	g_house_guard_stage[playerid]++;
	g_house_guard_key_step[playerid] = 0;
	new okmsg[180];
	format(okmsg, sizeof(okmsg), "{00BFFF}[Õ«—” «·„‰“·] {FFFFFF} „  √„Ì‰ «·„‰“·. «·„ﬂ«›√…: {00FF00}$%d", HOUSE_GUARD_REWARD);
	SendClientMessage(playerid, col_white, okmsg);
	SendClientMessageToAll(col_white, "{00BFFF}[Õ«—” «·„‰“·] {FFFFFF} „  √„Ì‰ √Õœ «·„‰«“· ÊÕ„«Ì Â „‰ «·„Ã—„Ì‰.");
	house_guard_show_next(playerid);
	return 1;
}

public house_guard_show_next(playerid)
{
	if (!IsPlayerConnected(playerid)) return 1;
	if (!g_house_guard_active[playerid]) return 1;
	if (g_house_guard_stage[playerid] >= HOUSE_GUARD_TARGETS)
	{
		if (g_house_guard_cp[playerid] != -1) DestroyDynamicCP(g_house_guard_cp[playerid]);
		g_house_guard_cp[playerid] = CreateDynamicCP(HOUSE_GUARD_CAR_X, HOUSE_GUARD_CAR_Y, HOUSE_GUARD_CAR_Z, 3.5, 0, 0, playerid, 120.0);
		SetPlayerRaceCheckpoint(playerid, 1, HOUSE_GUARD_CAR_X, HOUSE_GUARD_CAR_Y, HOUSE_GUARD_CAR_Z, HOUSE_GUARD_CAR_X, HOUSE_GUARD_CAR_Y, HOUSE_GUARD_CAR_Z, 4.0);
		SendClientMessage(playerid, col_white, "{00BFFF}[Õ«—” «·„‰“·] {FFFFFF} „  √„Ì‰ ﬂ· «·„‰«“·. √⁄œ «·›«‰ ≈·Ï ‰ﬁÿ… «· ”·Ì„ «·Õ„—«¡.");
		return 1;
	}
	return house_guard_create_cp(playerid, g_house_guard_stage[playerid]);
}

public house_guard_cleanup(playerid, const reward)
{
	if (!IsPlayerConnected(playerid)) return 1;
	if (g_house_guard_cp[playerid] != -1) DestroyDynamicCP(g_house_guard_cp[playerid]);
	g_house_guard_cp[playerid] = -1;
	DisablePlayerRaceCheckpoint(playerid);
	// [HOUSE GUARD v12.4] Sink each drug-bag 3m into the ground over
	// 1.5s; an associated timer destroys them once they have vanished.
	{
	    new _hg_any = 0;
	    for (new _hg_i = 0; _hg_i < HOUSE_GUARD_TARGETS; _hg_i++)
	    {
	        if (!g_house_guard_drug_obj[playerid][_hg_i]) continue;
	        new Float:_hg_ox, Float:_hg_oy, Float:_hg_oz;
	        GetDynamicObjectPos(g_house_guard_drug_obj[playerid][_hg_i], _hg_ox, _hg_oy, _hg_oz);
	        MoveDynamicObject(g_house_guard_drug_obj[playerid][_hg_i], _hg_ox, _hg_oy, _hg_oz - 3.0, 2.0);
	        _hg_any = 1;
	    }
	    if (_hg_any) SetTimerEx("house_guard_destroy_drugs", 1700, false, "d", playerid);
	}
	if (g_house_guard_vehicle[playerid] != INVALID_VEHICLE_ID)
	{
		if (GetPlayerVehicleID(playerid) == g_house_guard_vehicle[playerid]) RemovePlayerFromVehicle(playerid);
		AC_DestroyVehicle(g_house_guard_vehicle[playerid]);
	}
	g_house_guard_vehicle[playerid] = INVALID_VEHICLE_ID;
	g_house_guard_active[playerid] = 0;
	g_house_guard_stage[playerid] = 0;
	if (reward && g_house_guard_pay[playerid] > 0)
	{
		give_money(playerid, g_house_guard_pay[playerid]);
		insert_money_log(playerid, INVALID_PLAYER_ID, g_house_guard_pay[playerid], "house guard job");
		new msg[96];
		format(msg, sizeof(msg), "{00BFFF}[Õ«—” «·„‰“·] {FFFFFF}«‰ ÂÏ «·⁄„·. „Ã„Ê⁄ «·√—»«Õ: {00FF00}$%d", g_house_guard_pay[playerid]);
		SendClientMessage(playerid, col_white, msg);
	}
	g_house_guard_pay[playerid] = 0;
	return 1;
}

// [HOUSE GUARD v12.4] Final cleanup of the drug-bag props once their
// sink animation completes. Safe to call even after disconnect.
public house_guard_destroy_drugs(playerid)
{
	for (new i = 0; i < HOUSE_GUARD_TARGETS; i++)
	{
		if (!g_house_guard_drug_obj[playerid][i]) continue;
		DestroyDynamicObject(g_house_guard_drug_obj[playerid][i]);
		g_house_guard_drug_obj[playerid][i] = 0;
	}
	return 1;
}


public OnGameModeInit()
{
	Custom_RegisterDefaultCatalog();
	PC_Init();
    Fisherman_OnGameModeInit();
	SetTimer("Rob247_TimeoutTick", 1000, true);
	for (new _ri = 0; _ri < MAX_PLAYERS; _ri++) g_rob247_dialog[_ri] = -1;
	for (new _ci = 0; _ci < MAX_PLAYERS; _ci++) g_carjack_dialog[_ci] = -1;
	SetTimer("PoliceHUD_Tick", 1500, true);
	for (new _ph = 0; _ph < MAX_PLAYERS; _ph++) g_police_hud_state{_ph} = 0;
    for (new _wh = 0; _wh < MAX_PLAYERS; _wh++)
    {
        g_wanted_hud_x [_wh] = 0.92;
        g_wanted_hud_y [_wh] = 0.62;
        g_wanted_hud_sz[_wh] = 1.0;
    }

    CarShopInterior_Spawn();
    LSPDExterior_Spawn();
	LSPDNewInterior_Spawn();
    LSPDGarage_CreateLabels();

    objedit_load_all_perm_projects ( ) ;
    HavanaIsland_Create ( ) ;
    HavanaIsland_RespawnTools ( ) ;
    HavanaIsland_StartToolTimer ( ) ;

	global_weather = 1, RepOt = 0;
	
	
	sql_connection = mysql_connect("51.210.223.180", "gs108396", "gs108396", "2ymgifcr");
	
	switch(mysql_errno())
	{
		case 0:
		{
			print("{40de14}Database Connection Successfully") ;
			// Havana RP: ensure `have_music` column exists (idempotent).
			mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `have_music` INT NOT NULL DEFAULT 0" ) ;
			mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_theft_key` INT NOT NULL DEFAULT 0" ) ;
			mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_rob247_cd` INT NOT NULL DEFAULT 0" ) ;
			mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_flight_boxes` INT NOT NULL DEFAULT 0" ) ;
			PhoneEnsureTables ( ) ;
			mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_flight_level` INT NOT NULL DEFAULT 1" ) ;
			mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_acc_offsets` VARCHAR(600) NOT NULL DEFAULT ''" ) ;
			mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_whud_x`    FLOAT NOT NULL DEFAULT 0.92" ) ;
			mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_whud_y`    FLOAT NOT NULL DEFAULT 0.62" ) ;
			mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_whud_size` FLOAT NOT NULL DEFAULT 1.00" ) ;
			HavanaIsland_EnsureToolColumns ( ) ;
		}
		case 1044: print("Database connection failed [Unknown username specified]") ;
		case 1045: print("{dd0000}Database connection failed [Unknown password specified]") ;
		case 1049: print("{dd0000}Database connection failed [Unknown database specified]") ;
