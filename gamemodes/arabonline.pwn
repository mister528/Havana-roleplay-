		format ( line_string, sizeof ( line_string ), "%s - {"#cBL"}%s (%d){"#cWH"} - %s\n", pl_ofm_name, f_rank [ p_info [ playerid ] [ member ] - 1 ] [ pl_ofm_rank - 1 ], pl_ofm_rank, pl_ofm_online ) ;
		strcat ( dialog_string, line_string ) ;
	}
	show_dialog ( playerid, d_offmembers_list, DIALOG_STYLE_LIST, "{"#cBL"}√⁄÷«¡ «·„‰Ÿ„… €Ì— ‰‘ÿ", dialog_string, "«Œ —", "—ÃÊ⁄" ) ;
