    show_dialog(playerid, d_trent_manage_item, DIALOG_STYLE_LIST, title, body, " ÿ»Ìﬁ", "—ÃÊ⁄");
    return 1;
}

public trent_tick()
{
    new tick = GetTickCount();
    for (new i = 0; i < TRENT_MAX; i++)
    {
        if (g_trent_vehid[i] == INVALID_VEHICLE_ID) continue;
        if (tick >= g_trent_expire_tick[i])
        {
            trent_remove(i, true);
            continue;
        }
        // Refresh the 3D label every 30s so the remaining time stays in sync.
        if ((tick / 1000) % 30 == 0) trent_update_label(i);
    }
    return 1;
}

stock trent_show_preview(playerid)
{
    new car = g_trent_sel_car[playerid];
    if (car < 0 || car >= TRENT_CAR_COUNT) { trent_show_list(playerid); return 0; }
    new body[400];
    format(body, sizeof(body),
        "{FFFFFF}«Œ — : {FFFF00}%s\n\
{FFFFFF}«·”⁄— «·√”«”Ì: {00FF66}$%d{FFFFFF} ›Ì «·”«⁄…\n\n\
{AAAAAA}«÷€ÿ {FFFF00}„ «»⁄…{AAAAAA} ·«Œ Ì«— «·„œ….\n\
{AAAAAA}«÷€ÿ {FFFF00}⁄—÷ «·”Ì«—…{AAAAAA} ·„⁄«Ì‰ Â« ›Ì «·„⁄—÷ √Ê·«.\n\
{AAAAAA}√À‰«¡ «·⁄—÷° «ﬂ » {FFFF00}/back{AAAAAA} ··—ÃÊ⁄.",
        g_trent_name[car], g_trent_hour_price[car]);
    show_dialog(playerid, d_trent_preview, DIALOG_STYLE_MSGBOX,
        "{FFA500}„⁄«Ì‰… «·≈ÌÃ«—", body, "„ «»⁄…", "‘Ê› «·”Ì«—…");
    return 1;
}

// Compute & apply orbit camera around the showroom car for the current rotation index.
stock trent_apply_camera(playerid)
{
    new rot = g_trent_prev_rot[playerid];
    if (rot < 0 || rot > 3) { rot = 0; g_trent_prev_rot[playerid] = 0; }
    // Camera orbits the car at fixed distance/height. Slight elevation so
    // the bonnet, roof and tires are all visible at a 3/4 angle.
    new Float:dist   = 7.0;
    new Float:height = 4.0;
    new Float:angle  = float(rot) * 90.0 + TRENT_SHOW_CAR_A;
    new Float:rad    = angle * 3.14159265 / 180.0;
    new Float:cx     = TRENT_SHOW_CAR_X + dist * floatcos(rad, radian);
    new Float:cy     = TRENT_SHOW_CAR_Y + dist * floatsin(rad, radian);
    new Float:cz     = TRENT_SHOW_CAR_Z + height;
    SetPlayerCameraPos   (playerid, cx, cy, cz);
    SetPlayerCameraLookAt(playerid, TRENT_SHOW_CAR_X, TRENT_SHOW_CAR_Y, TRENT_SHOW_CAR_Z + 0.5);
    return 1;
}

stock trent_show_car(playerid)
{
    new car = g_trent_sel_car[playerid];
    if (car < 0 || car >= TRENT_CAR_COUNT) { trent_show_preview(playerid); return 0; }
    if (g_trent_prev_vid[playerid] != INVALID_VEHICLE_ID)
    {
        DestroyVehicle(g_trent_prev_vid[playerid]);
        g_trent_prev_vid[playerid] = INVALID_VEHICLE_ID;
    }
    GetPlayerPos(playerid, g_trent_prev_bx[playerid], g_trent_prev_by[playerid], g_trent_prev_bz[playerid]);
    GetPlayerFacingAngle(playerid, g_trent_prev_ba[playerid]);
    g_trent_prev_int[playerid] = GetPlayerInterior(playerid);
    g_trent_prev_vw[playerid]  = GetPlayerVirtualWorld(playerid);
    g_trent_prev_rot[playerid] = 0;

    new vw = 7000 + playerid;
    new prev_vid = CreateVehicle(g_trent_models[car],
        TRENT_SHOW_CAR_X, TRENT_SHOW_CAR_Y, TRENT_SHOW_CAR_Z, TRENT_SHOW_CAR_A,
        1, 1, -1);
    if (prev_vid == INVALID_VEHICLE_ID)
    {
        SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ﬁœ—  √› Õ «·„⁄«Ì‰…. Õ«Ê· „—… À«‰Ì….");
        trent_show_preview(playerid);
        return 0;
    }
    SetVehicleVirtualWorld(prev_vid, vw);
    LinkVehicleToInterior(prev_vid, 0);
    g_trent_prev_vid[playerid] = prev_vid;

    // Camera-only preview: keep player body in same VW as vehicle so the
    // model streams in, but freeze them and override their camera. The
    // launcher overlay renders left/right/exit buttons that send chat
    // commands handled by CMD:tprev_left / tprev_right / tprev_exit.
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, vw);
    SetPlayerPos(playerid, TRENT_SHOW_CAR_X, TRENT_SHOW_CAR_Y, TRENT_SHOW_CAR_Z - 5.0);
    TogglePlayerControllable(playerid, 0);
    trent_apply_camera(playerid);

    // Trigger sentinel dialog the launcher overlay listens for.
    show_dialog(playerid, d_trent_preview_active, DIALOG_STYLE_MSGBOX,
        "[!TRENT_PREVIEW_OPEN]", " ", "", "");

    new msg[160];
    format(msg, sizeof(msg),
        "{"#cGN"}* {"#cWH"} „ › Õ „⁄«Ì‰… {"#cGN"}%s",
        g_trent_name[car]);
    SendClientMessage(playerid, col_white, msg);

    if (g_trent_prev_timer[playerid] != -1) KillTimer(g_trent_prev_timer[playerid]);
    g_trent_prev_timer[playerid] = SetTimerEx("trent_preview_expire", TRENT_SHOW_DURATION_MS, false, "i", playerid);
    return 1;
}

public trent_preview_expire(playerid)
{
    g_trent_prev_timer[playerid] = -1;
    if (g_trent_prev_vid[playerid] == INVALID_VEHICLE_ID) return 0;
    if (GetPlayerVehicleID(playerid) == g_trent_prev_vid[playerid])
        RemovePlayerFromVehicle(playerid);
    SendClientMessage(playerid, col_white, "{"#cGN"}* {"#cWH"}«‰ Â  „œ… «·„⁄«Ì‰… (œﬁÌﬁ… Ê«Õœ… ﬂÕœ √ﬁ’Ï). «·—ÃÊ⁄ ·„ﬂ » «·≈ÌÃ«—.");
    trent_return_from_preview(playerid);
    return 1;
}

stock trent_return_from_preview(playerid)
{
    if (g_trent_prev_vid[playerid] == INVALID_VEHICLE_ID) return 0;
    if (g_trent_prev_timer[playerid] != -1)
    {
        KillTimer(g_trent_prev_timer[playerid]);
        g_trent_prev_timer[playerid] = -1;
    }
    if (GetPlayerVehicleID(playerid) == g_trent_prev_vid[playerid])
        RemovePlayerFromVehicle(playerid);
    DestroyVehicle(g_trent_prev_vid[playerid]);
    g_trent_prev_vid[playerid] = INVALID_VEHICLE_ID;

    // Restore camera + control before teleporting back.
    SetCameraBehindPlayer(playerid);
    TogglePlayerControllable(playerid, 1);

    SetPlayerVirtualWorld(playerid, g_trent_prev_vw[playerid]);
    SetPlayerInterior(playerid, g_trent_prev_int[playerid]);
    SetPlayerPos(playerid,
        g_trent_prev_bx[playerid], g_trent_prev_by[playerid], g_trent_prev_bz[playerid]);
    SetPlayerFacingAngle(playerid, g_trent_prev_ba[playerid]);
    SetCameraBehindPlayer(playerid);
    g_trent_prev_rot[playerid] = 0;

    // Re-open the preview dialog so the user can continue to duration.
    trent_show_preview(playerid);
    return 1;
}

CMD:tprev_left(playerid)
{
    if (g_trent_prev_vid[playerid] == INVALID_VEHICLE_ID) return 1;
    g_trent_prev_rot[playerid] = (g_trent_prev_rot[playerid] + 3) % 4;
    trent_apply_camera(playerid);
    return 1;
}

CMD:tprev_right(playerid)
{
    if (g_trent_prev_vid[playerid] == INVALID_VEHICLE_ID) return 1;
    g_trent_prev_rot[playerid] = (g_trent_prev_rot[playerid] + 1) % 4;
    trent_apply_camera(playerid);
    return 1;
}

CMD:tprev_exit(playerid)
{
    if (g_trent_prev_vid[playerid] == INVALID_VEHICLE_ID) return 1;
    trent_return_from_preview(playerid);
    return 1;
}

CMD:back(playerid)
{
    if (g_trent_prev_vid[playerid] == INVALID_VEHICLE_ID)
    {
        SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ‘«Âœ «·„⁄«Ì‰… «·„ƒÃ—….");
        return 1;
    }
    trent_return_from_preview(playerid);
    return 1;
}

CMD:timecar(playerid)
{
    trent_show_manage(playerid);
    return 1;
}


