    global_string [ 0 ] = EOS ;
    for ( new i = 0; i < f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 0 ] ; i ++ )
    {
        new line_string [ 72 ] ;
