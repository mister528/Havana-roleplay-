		else SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;
	    InBuilder[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
		DeletePVar(playerid, "PutBuild");
		DeletePVar(playerid, "TakedBuild");
		hide_payment ( playerid ) ;
		SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}€«œ—   »‰¯«¡ «·„‰ÿﬁ… Ê „ﬂ „· ‘€·ﬂ." ) ;
	}
	if ( p_info [ playerid ] [ timejob ] == job_factory && ! IsPlayerInRangeOfPoint( playerid, 70.0, -1110.5922,-783.9410,1001.1705 ) )
	{
		SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;
		give_money ( playerid, p_info [ playerid ] [ salary ] ) ;
        insert_money_log ( playerid, INVALID_PLAYER_ID, p_info [ playerid ] [ salary ], "—« » «·„’‰⁄") ;

		SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}€«œ—   «·„’‰⁄ «·„‰ÿﬁ… Ê √ﬂ„·  œÊ«„ ‘€·ﬂ." ) ;
		new __t_string [ 128 ] ;
		format ( __t_string, sizeof ( __t_string ), "{"#cGN"}* {"#cWH"}«·√—»«Õ: {"#cGN"}%d$", p_info [ playerid ] [ salary ] ) ;
		SendClientMessage ( playerid, col_white, __t_string ) ;
		p_info [ playerid ] [ salary ] = 0 ;

		if ( is_fraction_duty { playerid } == 1 ) SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ) ;
		else SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;

		hide_payment ( playerid ) ;


		p_info [ playerid ] [ timejob ] = job_none ;
		DeletePVar ( playerid, "have_factory_box" ) ;

		RemovePlayerAttachedObject ( playerid, 0 ) ;
		DisablePlayerRaceCheckpoint ( playerid ) ;
	}
	else if ( ( p_info [ playerid ] [ timejob ] == job_porter || p_info [ playerid ] [ timejob ] == job_forklift ) && p_t_info [ playerid ] [ p_tp_immune_time ] == 0 && ! IsPlayerInQuad ( playerid, 2610.3188,-2563.9526, 2863.4382, -2327.9478 ) && GetPlayerVirtualWorld ( playerid ) == 0 )
	{
		give_money ( playerid, p_info [ playerid ] [ salary ] ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, p_info [ playerid ] [ salary ], "—« » «·„Ì‰«¡" ) ;

		SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}€«œ—   «·„Ì‰«¡ «·„‰ÿﬁ… Ê √ﬂ„·  œÊ«„ ‘€·ﬂ." ) ;
		new __t_string [ 128 ] ;
		format ( __t_string, sizeof ( __t_string ), "{"#cGN"}* {"#cWH"}«·√—»«Õ: {"#cGN"}%i$", p_info [ playerid ] [ salary ] ) ;
		SendClientMessage ( playerid, col_white, __t_string ) ;

		new pljob = p_info [ playerid ] [ timejob ];

		p_info [ playerid ] [ timejob ] = 0 ;
		p_info [ playerid ] [ salary ] = 0 ;

		if ( is_fraction_duty { playerid } == 1 ) SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ) ;
		else SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;

		hide_payment ( playerid ) ;
		DisablePlayerRaceCheckpoint ( playerid ) ;

		if ( pljob == job_forklift )
		{
			if ( forklift_ptd [ playerid ] != PlayerText:-1 )
			{
				PlayerTextDrawDestroy ( playerid, forklift_ptd [ playerid ] ) ;
				TextDrawHideForPlayer ( playerid, forklift_td ) ;

				forklift_ptd [ playerid ] = PlayerText:-1;
				forklift_time [ playerid ] = -600 ;
			}
			new _v_id = player_rentcar [ playerid ] ;
			player_rentcar [ playerid ] = INVALID_VEHICLE_ID;

			AC_SetVehicleToRespawn ( _v_id  ) ;
			if ( GetPVarInt ( playerid, "fork_object") )
			{
				DestroyDynamicObject ( GetPVarInt ( playerid, "fork_object" ) ) ;
				DeletePVar ( playerid, "fork_object" ) ;
			}
		}
		else if ( pljob == job_porter )
		{
			if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ) ;
			ClearAnimations ( playerid ) ;
			DeletePVar ( playerid, "have_factory_box" ) ;
		}

	}
	else if ( p_info [ playerid ] [ timejob ] == job_miner && ! IsPlayerInRangeOfPoint( playerid, 250.0, -1892.0273,-1672.3884,-5.2182 ) )
	{
		give_money ( playerid, p_info [ playerid ] [ salary ] ) ;
        insert_money_log ( playerid, INVALID_PLAYER_ID, p_info [ playerid ] [ salary ], "—« » «·„‰Ã„") ;
        
		SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}€«œ—   «·„‰Ã„ «·„‰ÿﬁ… Ê √ﬂ„·  œÊ«„ ‘€·ﬂ." ) ;
		new __t_string [ 72 ] ;
		format ( __t_string, sizeof ( __t_string ), "{"#cGN"}* {"#cWH"}«·√—»«Õ: {"#cGN"}%d$", p_info [ playerid ] [ salary ] ) ;
		SendClientMessage ( playerid, col_white, __t_string ) ;
		p_info [ playerid ] [ salary ] = 0 ;

		if ( is_fraction_duty { playerid } == 1 ) SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ) ;
		else SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;

		hide_payment ( playerid ) ;

		p_info [ playerid ] [ timejob ] = job_none ;

		DeletePVar ( playerid, "mining_ex" ) ;
		DeletePVar ( playerid, "miner_cp" ) ;

		DisablePlayerRaceCheckpoint ( playerid ) ;

		if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ) ;
		if ( IsPlayerAttachedObjectSlotUsed ( playerid, 2 ) ) RemovePlayerAttachedObject ( playerid, 2 ) ;
		if ( IsPlayerAttachedObjectSlotUsed ( playerid, 3 ) ) RemovePlayerAttachedObject ( playerid, 3 ) ;
	}
	else if ( p_info [ playerid ] [ timejob ] == job_sawmil && ! IsPlayerInRangeOfPoint( playerid, 150.0, -1092.1349, -1643.6737, 76.3739 ) )
	{
		give_money ( playerid, p_info [ playerid ] [ salary ] ) ;
        insert_money_log ( playerid, INVALID_PLAYER_ID, p_info [ playerid ] [ salary ], "—« » „‰‘«— «·Œ‘»" ) ;

		SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}€«œ—   „‰‘«— «·Œ‘» «·„‰ÿﬁ… Ê √ﬂ„·  œÊ«„ ‘€·ﬂ." ) ;
		new __t_string [ 72 ] ;
		format ( __t_string, sizeof ( __t_string ), "{"#cGN"}* {"#cWH"}«·√—»«Õ: {"#cGN"}%d$", p_info [ playerid ] [ salary ] ) ;
		SendClientMessage ( playerid, col_white, __t_string ) ;
		p_info [ playerid ] [ salary ] = 0 ;

		if ( is_fraction_duty { playerid } == 1 ) SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ) ;
		else SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;


		hide_payment ( playerid ) ;

		p_info [ playerid ] [ timejob ] = job_none ;

		DisablePlayerRaceCheckpoint ( playerid ) ;
		
		if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3 ) ;
		if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4 ) ;
	}
	
	if(GetPVarInt(playerid, "GYM_Bike") == 1)
	{
		if(GetPVarInt(playerid, "GYM_Simulator_Time") <= gettime())
		{
			SetPVarInt(playerid, "GYM_Bike", 0);
			ApplyAnimation(playerid, "GYMNASIUM", "gym_bike_getoff", 4, 0, 0, 0, 0, 0);
			SimulatorUse[0] = false;
		}
	}
	if(GetPVarInt(playerid, "GYM_Thread") == 1)
	{
		if(GetPVarInt(playerid, "GYM_Simulator_Time") <= gettime())
		{
			SetPVarInt(playerid, "GYM_Thread", 0);
			ApplyAnimation(playerid, "GYMNASIUM", "gym_jog_falloff", 4, 0, 0, 0, 0, 0);
			SimulatorUse[1] = false;
		}
	}
	if(GetPVarInt(playerid, "GYM_Bar") == 1)
	{
		if(GetPVarInt(playerid, "GYM_Simulator_Time") <= gettime())
		{
			SetPVarInt(playerid, "GYM_Bar", 0);
			ApplyAnimation(playerid, "benchpress", "gym_bp_getoff", 4, 0, 0, 0, 0, 0);
			RemovePlayerAttachedObject(playerid, 4);
			SimulatorUse[2] = false;
		}
	}
	if(GetPVarInt(playerid, "GYM_Dumbbells") == 1)
	{
		if(GetPVarInt(playerid, "GYM_Simulator_Time") <= gettime())
		{
			SetPVarInt(playerid, "GYM_Dumbbells", 0);
			ApplyAnimation(playerid, "Freeweights", "gym_free_putdown", 4, 0, 0, 0, 0, 0);
			RemovePlayerAttachedObject(playerid, 4);
			SimulatorUse[3] = false;
		}
	}
	
	PoppyCollection ( playerid ) ;
	return 1 ;
}

callback: UpdateTruckerTrailerMinute ( playerid )
{
	for ( new j = 0 ; j < 3 ; j ++ )
	{
		if ( dorm_queue [ j ] [ 0 ] == playerid )
		{
			dorm_queue [ j ] [ 0 ] = INVALID_PLAYER_ID ;
		}
	}
}

callback: m_timer ( )
{
	new hor, m, s;
	gettime(hor, m, s);

	if ( hor == 0 && m == 0 )
	{
		mysql_tquery ( sql_connection, "UPDATE `users_bans` SET `u_b_days`=`u_b_days` - 1 WHERE 1", "", "" ) ;
	}
	if ( m == 0 || 15 || 30 || 45)
	{
		for(new i = 0; i < MAX_VEHICLES; i++)
		{
		    if ( ! IsValidVehicle ( i ) ) continue ;
			if ( GetVehicleModel ( i ) == 450 ) continue ;
			if ( GetVehicleDistanceFromPoint ( i, 0, 0, 0 ) < 40 )
			{
			    AC_DestroyVehicle ( i ) ;
	        	foreach(new g: admin_players) SendClientMessage ( g, col_gray,"{"#cBL"}*  {"#cGR"} «·»Ê  »ÊŸ «·⁄—»Ì«  »”»» «··«Ã ›Ì «·”Ì—›—" ) ;
			}
		}
	}
	
	if ( m == 0 )
	{
	    FixHour ( hor ) ;
   	    SetWorldTime(hor);
   	    pay_day_time();
	}
	
	for(new r = 0; r < 60; r++)
    {
        if ( m == r )
        {
			foreach(new i: logged_players)
			{
				if ( p_info [ i ] [ vip ] == 0)
				{
			        if ( p_info [ i ] [ hunger ] <= 0 )
			        {
				        set_health ( i , p_t_info [ i ] [ p_health ] - 0.5 ) ;
				    }
				    /*
					if ( p_info [ i ] [ sleepp ] <= 0 )
			        {
				        set_health ( i , p_t_info [ i ] [ p_health ] - 1.0 ) ;
				    }
					*/
					if ( p_info [ i ] [ hunger ] > 0)
					{
						p_info [ i ] [ hunger ] -= 1 ;
						new str[50];
						format(str, sizeof(str), "%d/100",p_info[i][hunger]);
					    // PlayerTextDrawSetString(i, Hunger[i][4], str);
						// PlayerTextDrawHide(i, Hunger[i][2]);
						// PlayerTextDrawTextSize(i, Hunger[i][2], p_info[i][hunger]  / 2.0 + 5, 8.000);
						// PlayerTextDrawShow(i, Hunger[i][2]);
					}
					/*
					if ( is_sleep_effect { i } == 0 && p_info [ i ] [ sleepp ] > 0 )
					{
						p_info [ i ] [ sleepp ] -= 1 ;
						new td_stringg [ 64 ] ;
						format ( td_stringg, sizeof ( td_stringg ), "%d%", p_info [ i ] [ sleepp ] ) ;
						PlayerTextDrawSetString ( i, SleepTD[i][1], td_stringg ) ;
					}*/
				}
			}
		}
	}
	
	if ( hor == 4 && m == 0 )
	{
		SendClientMessageToAll ( col_yellow, "* ›ÌÂ ≈⁄«œ…  ‘€Ì·  ﬁ‰Ì… ··”Ì—›—. «·⁄„·Ì… Â «Œœ ‘ÊÌ… ÀÊ«‰Ì." ) ;
		for ( new i = 0 ; i < MAX_PLAYERS ; i ++ )
		{
			kick_player ( i ) ;
		}

		new _sql_string [ 156 ] ;
		for ( new t = 0 ; t < b_count ; t ++ )
		{
			format ( _sql_string, 115, "INSERT INTO `businesses_history` (`bh_date`,`bh_business`,`bh_count`) VALUES (NOW()-INTERVAL 1 DAY,'%d','%d')",
			b_info [ t ] [ b_id ], b_info [ t ] [ b_cash_today ] ) ;
			mysql_query ( sql_connection, _sql_string ) ;

			if ( b_info [ t ] [ b_mafia ] != 0)
			{
				f_info [ b_info [ t ] [ b_mafia ] - 1 ] [ f_money ] += b_info [ t ] [ b_cash_today ] ;
				update_gdorm_text ( b_info [ t ] [ b_mafia ] ) ;
			}

			//new business_tax = floatround ( b_info [ t ][ b_price ] / 250) * for_tax [ 4 ] ;
			//if ( b_info [ t ] [ b_improve ] [ 0 ] ) business_tax = floatround ( b_info [ t ][ b_price ] / 350 ) * for_tax [ 4 ] ;

			//format ( _sql_string, 156, "UPDATE `users` SET `u_tax` = `u_tax`+'%d' WHERE `u_id` = '%d' LIMIT 1", business_tax,
																												//b_info [ t ] [ b_owner_inc ] ) ;
		//	mysql_query ( sql_connection, _sql_string ) ;

			b_info [ t ] [ b_cash_today ] = 0 ;
			format ( _sql_string, 156, "UPDATE `businesses` SET `b_product` = '%d',`b_cost` = '%d',`b_money` = '%d' WHERE `b_id` = '%d' LIMIT 1",
			b_info [ t ][ b_product ], b_info [ t ][ b_cost ], b_info [ t ] [ b_money ], b_info [ t ] [ b_id ] ) ;
			mysql_query ( sql_connection, _sql_string ) ;
		}

		format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '1' LIMIT 1", dorm_count [ DORM_SAWMILL ] ) ;
		mysql_query ( sql_connection, _sql_string ) ;

		format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '2' LIMIT 1", dorm_count [ DORM_MINE ] ) ;
		mysql_query ( sql_connection, _sql_string ) ;

		format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '3' LIMIT 1", dorm_count [ DORM_FACTORY_GUNS ] ) ;
		mysql_query ( sql_connection, _sql_string ) ;

		format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '4' LIMIT 1", mine_count [ MINE_MELTED ] ) ;
		mysql_query ( sql_connection, _sql_string ) ;

		format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '5' LIMIT 1", mine_count [ MINE_UNMELTED ] ) ;
		mysql_query ( sql_connection, _sql_string ) ;

		format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '6' LIMIT 1", dorm_count [ DORM_FACTORY_MINE ] ) ;
		mysql_query ( sql_connection, _sql_string ) ;

		format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '7' LIMIT 1", dorm_count [ DORM_FACTORY_WOOD ] ) ;
		mysql_query ( sql_connection, _sql_string ) ;

		format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '8' LIMIT 1", election_status ) ;
		mysql_query ( sql_connection, _sql_string ) ;

		format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '18' LIMIT 1", AmbarDrugs ) ;
		mysql_query ( sql_connection, _sql_string ) ;

		format ( _sql_string, 112, "UPDATE `server_variables` SET `var_count` = '%d' WHERE `var_id` = '35' LIMIT 1", PritonDrugs ) ;
		mysql_query ( sql_connection, _sql_string ) ;

		for ( new h = 0 ; h < house_count ; h ++ )
		{
			format ( _sql_string, 112, "UPDATE `houses` SET `h_seed` = '%d',`h_seed_result` = '%d' WHERE `h_id` = '%d' LIMIT 1", h_info [ h ][ h_seed ], h_info [ h ][ h_seed_result ], h_info [ h ] [ h_id ] ) ;
			mysql_query ( sql_connection, _sql_string ) ;

			//format ( _sql_string, 156, "UPDATE `users` SET `u_tax` = `u_tax`+'%d' WHERE `u_id` = '%d' LIMIT 1",
			//floatround ( h_info [ h ] [ h_price ] / 350 ) * for_tax [ 3 ], h_info [ h ] [ h_owner ] ) ;
			//mysql_query ( sql_connection, _sql_string ) ;
		}

		for ( new j = 0 ; j < fraction_count ; j ++ )
		{
			format ( _sql_string, 146, "UPDATE `fractions` SET `f_money` = '%d',`f_materials`='%d',`f_guns` = '%d' WHERE `f_id` = '%d' LIMIT 1",
			f_info [ j ] [ f_money ], f_info [ j ] [ f_materials ], f_info [ j ] [ f_guns ], j + 1 ) ;
			mysql_tquery ( sql_connection, _sql_string, "", "" ) ;
		}
		SendRconCommand("gmx" ) ;
	}
	
	if ( mine_count [ MINE_UNMELTED ] >= 30 )
	{
		mine_count [ MINE_UNMELTED ] -= 30 ;
		mine_count [ MINE_MELTED ] += 30 ;

		dorm_count [ DORM_MINE ] = mine_count [ MINE_MELTED ] ;

		new dorm_string [ 134 ] ;
		format ( dorm_string, 76, "{"#cBL"}„⁄œ‰\n{"#cGR"}«·ﬂ„Ì… «·„ Ê›—…:{"#cWH"} %i ﬂÃ„.", dorm_count [ DORM_MINE ] ) ;
		UpdateDynamic3DTextLabelText ( dorm_text [ DORM_MINE ], 0xFFCD00FF, dorm_string ) ;

		format ( dorm_string, 134, "{"#cBL"}’Â—\n{"#cGR"}«·Œ«„: {"#cWH"}%d ﬂÃ„.\n{"#cGR"}«·„⁄œ‰: {"#cWH"} %d ﬂÃ„.", mine_count [ MINE_UNMELTED ], mine_count [ MINE_MELTED ] ) ;
		UpdateDynamic3DTextLabelText ( mine_text, -1, dorm_string ) ;

	}

	for ( new h = 0 ; h < house_count ; h ++ )
	{
		if ( h_info [ h ] [ h_seed ] <= 0 ) continue ;
		h_info [ h ] [ h_seed ] -= RandomEx ( 3, 9 ) ;
		if ( h_info [ h ] [ h_seed ] < 0 ) h_info [ h ] [ h_seed ] = 0 ;
		h_info [ h ] [ h_seed_result ] += RandomEx ( 1, 4 ) ;
	}
	
	for ( new h = 0 ; h < cellar_count ; h ++ )
	{
		if ( cellar_info [ h ] [ cl_seed ] <= 0 ) continue ;
		cellar_info [ h ] [ cl_seed ] -= RandomEx ( 3, 9 ) ;
		if ( cellar_info [ h ] [ cl_seed ] < 0 ) cellar_info [ h ] [ cl_seed ] = 0 ;
		cellar_info [ h ] [ cl_seed_result ] += RandomEx ( 1, 4 ) ;
	}
	
	foreach(new i: logged_players)
	{
	    new horr, minn, ssss;
		gettime(horr, minn, ssss);
		if(horr == 0)

		if ( GetPVarInt ( i, "p_masked" ) > 0 )
		{
			SetPVarInt ( i, "p_masked", GetPVarInt ( i, "p_masked" ) - 60 ) ;
		}
		else if ( GetPVarInt ( i, "p_masked" ) == 0 ) DeletePVar ( i, "p_masked" ) ;
		
		if ( p_info [ i ] [ wanted ] > 0 )
		{
		    if ( GetPVarInt ( i, "wanted_time" ) == 15 ) SetPVarInt ( i, "wanted_time", 0 ) ;
			SetPVarInt ( i, "wanted_time", GetPVarInt ( i, "wanted_time" ) + 1 ) ;
			if ( GetPVarInt ( i, "wanted_time" ) == 15 )
			{
				if ( p_info [ i ] [ enhancement ] [ 1 ] && p_info [ i ] [ wanted ] >= 2 ) p_info [ i ] [ wanted ] -= 2 ;
				else p_info [ i ] [ wanted ] -- ;
				update_int_sql ( i, "u_wanted", p_info [ i ] [ wanted ] ) ;
				
				new text_wanted [ 64 ] ;
				format(text_wanted, 128, "*  „  ﬁ·Ì· „” ÊÏ «·„ÿ«—œ…° »«ﬁÌ ‰ÃÊ„: %d.", p_info [ i ] [ wanted ] ) ;
				SendClientMessage(i, col_yellow, text_wanted);
			}
		}

		/*if ( p_info [ i ] [ hunger ] >= 1 && pl_afk_time [ i ] < 1)
		{
			p_info [ i ] [ hunger ] -= 0.5 ;
			
			new query_string [ 128 ];
			mysql_format ( sql_connection, query_string, sizeof query_string, "UPDATE `users` SET `u_hunger`='%d' WHERE `u_id`='%d'", p_info[i][hunger], p_info[i][id]);
			mysql_tquery ( sql_connection, query_string ) ;
			
			//if ( GetPVarInt ( i, "hunger_time" ) == 3 ) SetPVarInt ( i, "hunger_time", 0 ) ;
			//SetPVarInt ( i, "hunger_time", GetPVarInt ( i, "hunger_time" ) + 1 ) ;
			new td_string [ 64 ] ;
			format ( td_string, sizeof ( td_string ), "%d%", p_info [ i ] [ hunger ] ) ;
			// PlayerTextDrawSetString ( i, Hunger[i][1], td_string ) ;
   		}
		else if ( p_info [ i ] [ hunger ] < 1 && pl_afk_time [ i ] < 1)
		{
		    SendClientMessage(i, col_yellow, "* √‰  ÃÊ⁄«‰! —ÊÕ ··„ÿ⁄„.");
			set_health ( i, p_t_info [ i ] [ p_health ] - 0.5 ) ;
			p_info [ i ] [ hunger ] = 0 ;
			new query_string [ 128 ];
			mysql_format ( sql_connection, query_string, sizeof query_string, "UPDATE `users` SET `u_hunger`='%d' WHERE `u_id`='%d'", p_info[i][hunger], p_info[i][id]);
			mysql_tquery ( sql_connection, query_string ) ;
			new td_string [ 64 ] ;
			format ( td_string, sizeof ( td_string ), "%d%", p_info [ i ] [ hunger ] ) ;
			// PlayerTextDrawSetString ( i, Hunger[i][1], td_string ) ;
		}*/

		if ( p_t_info [ i ] [ phone_id ] != INVALID_PLAYER_ID && p_t_info [ i ] [ phone_caller ] == 0 )
		{
			p_info [ i ] [ phone_balance ] -- ;
			if ( p_info [ i ] [ phone_balance ] < 1 )
			{
				SetPlayerSpecialAction ( i, SPECIAL_ACTION_STOPUSECELLPHONE ) ;
				SetPlayerSpecialAction ( p_t_info [ i ] [ phone_id ], SPECIAL_ACTION_STOPUSECELLPHONE ) ;
				RemovePlayerAttachedObject ( i, 2 ) ;
				RemovePlayerAttachedObject ( p_t_info [ i ] [ phone_id ], 2 ) ;

				SendClientMessage ( p_t_info [ i ] [ phone_id ], 0x940000FF, "«‰ﬁÿ⁄ «·« ’«·..." ) ;
				SendClientMessage ( i, 0x940000FF, " «·„ﬂ«·„… «‰ﬁÿ⁄ . —’Ìœﬂ Œ·’ „‰ «·›·Ê”!" ) ;

				p_t_info [ p_t_info [ i ] [ phone_id ] ] [ phone_id ] = INVALID_PLAYER_ID ;
				p_t_info [ p_t_info [ i ] [ phone_id ] ] [ phone_caller ] = 0 ;

				p_t_info [ i ] [ phone_id ] = INVALID_PLAYER_ID ;
				p_t_info [ i ] [ phone_caller ] = 0 ;

			}
		}
	}
	return 1 ;
}

stock convert_time ( seconds )
{
	new time_string [ 12 ],
		minutes = floatround ( seconds / 60 ) ;

	seconds -= minutes * 60 ;

	format ( time_string, sizeof( time_string ), "%02d:%02d", minutes, seconds ) ;
	return time_string;
}

stock pay_day_time ( )
{
	for ( new j = 0 ; j < gz_count ; j ++ )
	{
		if ( gz_info [ j ] [ gz_owner ] == 0 ) continue ;
		f_info [ gz_info [ j ] [ gz_owner ] - 1 ] [ f_money ] += 500 ;
		update_gdorm_text ( gz_info [ j ] [ gz_owner ] ) ;
	}
	new total_graf [ 6 ] ;
	for(new i; i < CountGraffity; i++)
	{
	    if ( graf_info [ i ] [ g_member ] == 0 ) continue ;
	    f_info [ graf_info [ i ] [ g_member ] - 1 ] [ f_money ] += 250 ;
	    update_gdorm_text ( graf_info [ i ] [ g_member ] ) ;
	    total_graf [ graf_info [ i ] [ g_member ] - 18 ] ++ ;
	}
	for ( new j = 18 ; j <= 22 ; j ++ )
	{
		new query_string [ 88 ];
		format ( query_string, 88, "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '%d' LIMIT 1",
		f_info [ j - 1 ] [ f_money ], j ) ;
		mysql_tquery ( sql_connection, query_string, "", "" ) ;
	}

    new horr, minn, ssss;
	gettime(horr, minn, ssss);
	if(horr == 0)
	{
		for(new h = 0; h < house_count; h++)
		{
			if ( h_info [ h ] [ h_owner ] != -1)
			{
				if ( h_info [ h ] [ h_class_int ] == 1)
				{
					if ( h_info [ h ] [ h_tax ] > 17472 )
					{
						new ifconnected = GetPlayerID(h_info[h][h_owner_name]);
						if(IsPlayerConnected(ifconnected))
						{
							give_money ( ifconnected, h_info[h_info[h][h_id]] [ h_price ] - 17472 ) ;
							p_info[ifconnected][house] = -1;
							p_info[ifconnected][spawnchange] = 0;
							if(p_info[ifconnected][family_rang] == 7)
							{
							    new family_id = p_info [ ifconnected ] [ family ] - 1;
							    SendClientMessage(ifconnected, 0x40bd06FF, "* {FFFFFF}»Ì  «·⁄«∆·… «‰Õ–›  ·ﬁ«∆Ì«.");
							    family_info[family_id][fam_house] = -1;
							    family_info[family_id][fam_house_xgpos] = 0;
							    family_info[family_id][fam_house_ygpos] = 0;
							    family_info[family_id][fam_house_zgpos] = 0;
							    family_info[family_id][fam_house_cgpos] = 0;
							    new query_string [ 600 ];
								mysql_format ( sql_connection, query_string, sizeof query_string, "UPDATE `family` SET `fam_house`='%d', `fam_house_xgpos`='%.2f', `fam_house_ygpos`='%.2f', `fam_house_zgpos`='%.2f', `fam_house_cgpos`='%.2f' WHERE `fam_id`='%d'", family_info [ p_info [ ifconnected ] [ family ] - 1 ] [ fam_house ], family_info[family_id][fam_house_xgpos], family_info[family_id][fam_house_ygpos], family_info[family_id][fam_house_zgpos], family_info[family_id][fam_house_cgpos], p_info [ ifconnected ] [ family ] ) ;
								mysql_tquery ( sql_connection, query_string ) ;
							}
							update_int_sql(ifconnected, "u_spawnchange", p_info[ifconnected][spawnchange]);
							update_int_sql(ifconnected, "u_house", p_info[ifconnected][house]);
