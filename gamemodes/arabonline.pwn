		if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«·«” Œœ«„: /givevkey [ID]" ) ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;
		if ( p_t_info [ params [ 0 ] ] [ v_key ] > 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«··«⁄» ”»ﬁ Ê ⁄‰œ „›« ÌÕ ≈·Ï  «·”Ì«—…." ) ;
		p_t_info [ params [ 0 ] ] [ v_key ] = veh_id;
		new string [ 95 + ( -2 + MAX_PLAYER_NAME ) ] ;
