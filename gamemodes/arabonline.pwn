        strcat ( global_string, line_string ) ;
    }
    show_dialog ( playerid, d_rank, DIALOG_STYLE_LIST, "{"#cBL"} €ÌÌ— „‰ — »…", global_string, "«Œ —", "≈€·«ﬁ" ) ;
    SetPVarInt ( playerid, "pl_setrank_id", params [ 0 ] ) ;
    return 1 ;
}
