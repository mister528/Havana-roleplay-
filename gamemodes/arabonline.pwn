stock get_passenger_count ( playerid )
{
	new passenger_count = 0,
		vehicleid = GetPlayerVehicleID ( playerid ) ;

	foreach ( new i:streamed_players[playerid])
	{
		if ( GetPlayerState ( i ) == PLAYER_STATE_PASSENGER && GetPlayerVehicleID ( i ) == vehicleid )passenger_count ++ ;
	}
	return passenger_count ;
}

stock IsARPName(Name[])
{
	new simb_, RP_Name[2][24];
	new playerid;
	for(new i = 0;i < strlen(Name);i ++)
	{
	    if(Name[i] == '_') simb_ ++;
	}
	if(simb_ != 1) return false;
	sscanf(Name,"p<_>s[24]s[24]",RP_Name[0],RP_Name[1]);
	if( !IsAGoodName(RP_Name[0]) || !IsAGoodName(RP_Name[1]) ) return false;
	if( IsPlayerNPC(playerid)) return true;
	return true;
}

stock IsAGoodName(Name[])
{
	new playerid;
	new NameChars;
	if(IsPlayerNPC(playerid))return 1;
	if(strlen(Name) < 2) return false;
	if(Name[0] < 'A' || Name[0] > 'Z') return false;
	for(new i = 1;i < strlen(Name);i ++)
	{
	    if(Name[i] < 'a' || Name[i] > 'z')
		{
		    if(Name[i] >= 'A' && Name[i] <= 'Z') NameChars ++;
		    else return false;
		}
	    if(NameChars > 1) return false;
	}
	return true;
}

stock check_advertise ( playerid, string [ ] )
{
	if ( is_ip_found ( string ) || IsMessageReklama ( string ) )
	{
		new text_string [ 144 ] ;
		format ( text_string, 144, "{"#cRD"}<ADM> REPORT  %s [%d]:{"#cWH"} %s", p_info [ playerid ] [ name ], playerid, string ) ;
		foreach(new i: admin_players) SendClientMessage ( i, col_white, text_string ) ;
		return 1 ;
	}
	return false ;
}

stock is_ip_found(string[])
{
    new len = strlen(string), blocks, digits;
    for(new pos, bool: LastCharWasDigit; pos < len; pos++)
    {
        switch(string[pos])
        {
            case '0'..'9':
            {
                digits ++;
                if(!LastCharWasDigit) blocks ++, LastCharWasDigit = true;
            }
            default: if(LastCharWasDigit) LastCharWasDigit = false;
        }
    }
    return (digits >= 8 && blocks >= 4) ? (true) : (false);
}

stock IsMessageReklama( string[])
{
	if(strfind(string, "http",true) != -1||strfind(string, ".com",true) != -1||strfind(string, ".ru",true) != -1||strfind(string, "www.",true) != -1||strfind(string, "/q",true) != -1||strfind(string, "/quit",true) != -1||strfind(string, "mq",true) != -1
	||strfind(string, ".net",true) != -1||strfind(string, ". com",true) != -1||strfind(string, ". net",true) != -1||strfind(string, ". ru",true) != -1||strfind(string, ".ua",true) != -1||strfind(string, "",true) != -1||strfind(string, "",true) != -1
	||strfind(string, ". ua",true) != -1||strfind(string, "",true) != -1||strfind(string, "",true) != -1
	||strfind(string, "",true) != -1||strfind(string, "",true) != -1
	||strfind(string, "",true) != -1||strfind(string, "",true) != -1
	||strfind(string, "qm",true) != -1
	||strfind(string, "mamawa",true) != -1
	||strfind(string, "mamsha",true) != -1
	||strfind(string, "",true) != -1
	||strfind(string, "mama",true) != -1
	||strfind(string, "mamka",true) != -1
	||strfind(string, "address",true) != -1||strfind(string, "",true) != -1||strfind(string, "",true) != -1||strfind(string, "",true) != -1||strfind(string, "",true) != -1||strfind(string, "mamke",true) != -1||strfind(string, "mamku",true) != -1
	||strfind(string, "mamawu",true) != -1||strfind(string, "mamawe",true) != -1||strfind(string, "mamashu",true) != -1||strfind(string, "mamashe",true) != -1||strfind(string, "mat'",true) != -1||strfind(string, "matb",true) != -1||strfind(string, ". su",true) != -1
	||strfind(string, "q m",true) != -1||strfind(string, "q m",true) != -1||strfind(string, "rcon",true) != -1)
	{
		return 1;
	}
	return 0;
}

stock IsPlayerAiming(playerid)
{
	new anim = GetPlayerAnimationIndex(playerid);
	if(((anim >= 1160) && (anim <= 1163)) || (anim == 1167) || (anim == 1365) || (anim == 1643) || (anim == 1453) || (anim == 220)) return 1;
	return 0;
}

callback: death_sync ( playerid )
{
	if ( is_player_fake_spawn { playerid } == 0 ) return 1 ;
	set_health ( playerid, 10 ) ;
	return 1 ;
}

callback: OnPlayerSyncDeath(playerid, killerid, reason)
{
	SetTimerEx ( "death_sync", 3000, false, "i", playerid ) ;
	foreach(new i: admin_players)
	{
		if ( KillList == true )
		{
			SendDeathMessageToPlayer ( i, killerid, playerid, reason ) ;
		}
	}
    if(GetPVarInt(killerid, "on_dmarena"))
	{
		set_health(killerid, 100.0);
		p_info[killerid][pDmzKills] += 1;
		p_info[playerid][pDmzDeaths] += 1;

		new query_string [ 128 ];
		mysql_format ( sql_connection, query_string, sizeof query_string, "UPDATE `users` SET `dmzkills`='%d' WHERE `u_id`='%d'", p_info[killerid][pDmzKills], p_info[killerid][id] ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		new query_stringr [ 128 ];
		mysql_format ( sql_connection, query_stringr, sizeof query_stringr, "UPDATE `users` SET `dmzdeaths`='%d' WHERE `u_id`='%d'", p_info[playerid][pDmzDeaths], p_info[playerid][id] ) ;
		mysql_tquery ( sql_connection, query_stringr ) ;

		GameTextForPlayer(killerid, "++ﬁ ·", 2000, 4);
		GameTextForPlayer(playerid, "++«·„Ê ", 2000, 4);
		
		return 1;
	}
	if(GetPVarInt(killerid, "on_dmarena1"))
	{
		set_health(killerid, 100.0);
		p_info[killerid][pDmzKills] += 1;
		p_info[playerid][pDmzDeaths] -= 1;

		new query_string [ 128 ];
		mysql_format ( sql_connection, query_string, sizeof query_string, "UPDATE `users` SET `dmzkills`='%d' WHERE `u_id`='%d'", p_info[killerid][pDmzKills], p_info[killerid][id] ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		new query_stringr [ 128 ];
		mysql_format ( sql_connection, query_stringr, sizeof query_stringr, "UPDATE `users` SET `dmzdeaths`='%d' WHERE `u_id`='%d'", p_info[playerid][pDmzDeaths], p_info[playerid][id] ) ;
		mysql_tquery ( sql_connection, query_stringr ) ;

		GameTextForPlayer(killerid, "++ﬁ ·", 2000, 4);
		GameTextForPlayer(playerid, "++«·„Ê ", 2000, 4);
		
		return 1;
	}
	if ( TeamPaint [ playerid ] != 0 )
	{
		switch ( StartPaintBall )
		{
			case 1:
			{
				switch ( TeamPaint [ playerid ] )
				{
					case 1: BluePlayer -- ;
					case 2: RedPlayer -- ;
				}
				TeamPaint[ playerid ] =
				KillPaint[ playerid ] =
				DeathPaint[ playerid ] = 0;
				SendClientMessage ( playerid, col_yellow, "*  „ «” »⁄«œﬂ." ) ;
			}
			case 2:
			{
				if(TeamPaint[killerid] != 0 && TeamPaint [ killerid ] != TeamPaint[ playerid ] )
				{
					DeathPaint [ playerid ] ++ ;
					KillPaint [ killerid ] ++ ;
					set_health ( killerid, 100.0 ) ;
					if ( TeamPaint [ killerid ] == 1 ) BlueScore++ ;
					else RedScore++ ;
					new string [ 40 ] ;
					format ( string, sizeof ( string ), "ﬁ ·: ~b~~h~%i~n~«·„Ê : ~b~~h~%i", KillPaint[ playerid ], DeathPaint[ playerid ] ) ;
					PlayerTextDrawSetString ( playerid, PaintStats[ playerid ], string ) ;
					format ( string, sizeof ( string ), "ﬁ ·: ~b~~h~%i~n~«·„Ê : ~b~~h~%i", KillPaint [ killerid ], DeathPaint [ killerid ] ) ;
					PlayerTextDrawSetString ( killerid, PaintStats [ killerid ], string ) ;


					format( string, sizeof ( string ),"~r~~h~ „ ﬁ ·Â »Ê«”ÿ… %s", p_info [ killerid ] [ name ] ) ;
					GameTextForPlayer ( playerid, string, 4000, 3 ) ;
					GameTextForPlayer ( killerid, "~g~+1 ﬁ ·", 2000, 1 ) ;

					//foreach(new i: logged_players)
					//{
						//if ( TeamPaint [ i ] != 0) SendDeathMessageToPlayer ( i, killerid, playerid, reason ) ;
					//}
				}
			}
		}
	}


	if ( player_killed [ playerid ] ) return 1 ;

	if ( mw_gangzone != - 1 )
	{
	    if ( IsPlayerInQuad ( playerid, mw_quad [ 0 ], mw_quad [ 1 ], mw_quad [ 2 ], mw_quad [ 3 ] ) )
	    {
			if ( mafia_player ( playerid ) && mafia_player ( killerid ) && p_info [ killerid ] [ member ] != p_info [ playerid ] [ member ] )
			{
				if ( p_info [ killerid ] [ member ] == mw_attacker && p_info [ playerid ] [ member ] == mw_owner ||
				p_info [ killerid ] [ member ] == mw_attacker && f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [  mw_owner - 18 ] == dip_status_alliance ||
				f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ mw_attacker - 18 ] == dip_status_alliance && p_info [ playerid ] [ member ] == mw_owner && f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ mw_owner - 18 ] == dip_status_war ||
				f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ mw_attacker - 18 ] == dip_status_alliance && f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ mw_owner - 18 ] == dip_status_alliance && f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ mw_owner - 18 ] == dip_status_war )
				{
					foreach(new i: logged_players)
					{
						if ( ! mafia_player ( i ) ) continue ;
						SendDeathMessageToPlayer ( i, killerid, playerid, reason ) ;
					}
					mw_attacker_points ++ ;
					
					new query_string [ 98 ];
					format ( query_string,sizeof(query_string),"UPDATE `users` SET `u_m_capture_kills` = `u_m_capture_kills`+1 WHERE `u_id` = '%d' LIMIT 1", p_info [ killerid ] [ id ] ) ;
					mysql_tquery ( sql_connection, query_string, "", "" ) ;

					format ( query_string,sizeof(query_string),"UPDATE `users` SET `u_capture_top` = `u_capture_top`+1 WHERE `u_id` = '%d' LIMIT 1", p_info [ killerid ] [ id ] ) ;
					mysql_tquery ( sql_connection, query_string, "", "" ) ;

					format ( query_string, 8, "%d", mw_attacker_points ) ;
					TextDrawSetString ( mw_td [ 17 ], query_string ) ;
				}
				if ( p_info [ killerid ] [ member ] == mw_owner && p_info [ playerid ] [ member ] == mw_attacker ||
					p_info [ killerid ] [ member ] == mw_owner && f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [  mw_attacker - 18 ] == dip_status_alliance ||
					f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ mw_owner - 18 ] == dip_status_alliance && p_info [ playerid ] [ member ] == mw_attacker && f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ mw_attacker - 18 ] == dip_status_war ||
					f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ mw_owner - 18 ] == dip_status_alliance && f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ mw_attacker - 18 ] == dip_status_alliance && f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ mw_attacker - 18 ] == dip_status_war )
				{
					foreach(new i: logged_players)
					{
						if ( ! mafia_player ( i ) ) continue ;
						SendDeathMessageToPlayer ( i, killerid, playerid, reason ) ;
					}
					mw_owner_points ++ ;
					
					new query_string [ 98 ];
					format ( query_string,sizeof(query_string),"UPDATE `users` SET `u_m_capture_kills` = `u_m_capture_kills`+1 WHERE `u_id` = '%d' LIMIT 1", p_info [ killerid ] [ id ] ) ;
					mysql_tquery ( sql_connection, query_string, "", "" ) ;

					format ( query_string,sizeof(query_string),"UPDATE `users` SET `u_capture_top` = `u_capture_top`+1 WHERE `u_id` = '%d' LIMIT 1", p_info [ killerid ] [ id ] ) ;
					mysql_tquery ( sql_connection, query_string, "", "" ) ;

					format ( query_string, 8, "%d", mw_owner_points ) ;
					TextDrawSetString ( mw_td [ 16 ], query_string ) ;
				}
				update_activity ( killerid ) ;
			}
		}
	}
	if ( az_captured != - 1 )
	{
	    new a_expcapt = 0 ;
		if ( ( IsPlayerInAzZone ( playerid, az_captured ) || ( IsPlayerInRangeOfQuad ( playerid, az_info [ az_captured ] [ az_pos ] [ 2 ], az_info [ az_captured ] [ az_pos ] [ 3 ] ) < 200 || IsPlayerInRangeOfQuad ( playerid, az_info [ az_captured ] [ az_pos ] [ 0 ], az_info [ az_captured ] [ az_pos ] [ 1 ] ) < 200 ) ) && p_info [ killerid ] [ member ] != p_info [ playerid ] [ member ] )
		{
			if ( p_info [ killerid ] [ member ] == az_info [ az_captured ] [ az_attacker ] && p_info [ playerid ] [ member ] == az_info [ az_captured ] [ az_owner ] )
			{
				foreach(new i: logged_players)
				{
					if ( ! terrorist_player ( i ) && ! army_player ( i )) continue ;
				    SendDeathMessageToPlayer ( i, killerid, playerid, reason ) ;
				}
				if ( az_capture_type == az_type_kills )
				{
				    if ( GetPlayerWeapon ( killerid ) == 5 || GetPlayerWeapon ( killerid ) == 0 )
				    {
						az_attacker_points += 3 ;
						a_expcapt = 3 ;
					}
					else
					{
					    az_attacker_points ++ ;
					    a_expcapt = 1 ;
	 				}

					CaptureKills[killerid] += a_expcapt;

					new query_string [ 98 ];

					format ( query_string, 11, "%d", az_attacker_points ) ;
					TextDrawSetString ( az_capture_td [ 17 ], query_string ) ;

					new f_string [ 61 + MAX_PLAYER_NAME * 2 + 28 + 8 + 22 ] ;
					format(f_string, sizeof f_string, "[U] %s[%s] ›‘·() %s[%s](+%d «·‰ﬁ«ÿ). ›Õ’: %s[%d] : [%d]%s", p_info [ killerid ] [ name ], f_info [ p_info [ killerid ] [ member ] - 1 ] [ f_name ], p_info [ playerid ] [ name ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ], a_expcapt, f_info [ p_info [ killerid ] [ member ] - 1 ] [ f_name ], az_attacker_points, az_owner_points, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ] ) ;
					SendAzMessage ( f_info [ p_info [ killerid ] [ member ] - 1 ] [ f_radar_color ], f_string ) ;

				}
