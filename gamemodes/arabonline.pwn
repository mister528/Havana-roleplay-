stock havana_attach_accessory(playerid, index, modelid, bone,
    Float:offx, Float:offy, Float:offz,
    Float:rotx, Float:roty, Float:rotz,
    Float:scalex, Float:scaley, Float:scalez,
    materialcolor1 = 0, materialcolor2 = 0)
{
    SetPlayerAttachedObject(playerid, index, modelid, bone,
        offx, offy, offz, rotx, roty, rotz, scalex, scaley, scalez, materialcolor1, materialcolor2);

    new slot = -1;
    for (new i = 0; i < 8; i++)
    {
        if (p_info[playerid][accessories][i] != modelid) continue;
        if (p_info[playerid][accessories_used][i] != 1) continue;
        new cur_idx = havana_get_acidx(playerid, i);
        if (cur_idx < 0 || cur_idx == index)
        {
            slot = i;
            break;
        }
    }
    if (slot < 0) return 1;

    havana_set_acidx(playerid, slot, index);
    if (!havana_has_saved_acc_offsets(playerid, slot))
    {
        new b[28];
        format(b, sizeof(b), "HAV_ACBONE_%d", slot); SetPVarInt(playerid, b, bone);
        format(b, sizeof(b), "HAV_ACBX_%d", slot); SetPVarFloat(playerid, b, offx);
        format(b, sizeof(b), "HAV_ACBY_%d", slot); SetPVarFloat(playerid, b, offy);
        format(b, sizeof(b), "HAV_ACBZ_%d", slot); SetPVarFloat(playerid, b, offz);
        format(b, sizeof(b), "HAV_ACBRX_%d", slot); SetPVarFloat(playerid, b, rotx);
        format(b, sizeof(b), "HAV_ACBRY_%d", slot); SetPVarFloat(playerid, b, roty);
        format(b, sizeof(b), "HAV_ACBRZ_%d", slot); SetPVarFloat(playerid, b, rotz);
        format(b, sizeof(b), "HAV_ACBSX_%d", slot); SetPVarFloat(playerid, b, scalex);
        format(b, sizeof(b), "HAV_ACBSY_%d", slot); SetPVarFloat(playerid, b, scaley);
        format(b, sizeof(b), "HAV_ACBSZ_%d", slot); SetPVarFloat(playerid, b, scalez);
    }
    return 1;
}

