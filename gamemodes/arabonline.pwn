{
    if (slot < 0 || slot >= TRENT_MAX) return 0;
    new body[512];
    format(body, sizeof(body),
        "{FFFFFF} »œÌ· {FFFF00}«·≈ŸÂ«—/«·≈Œ›«¡\n\
{FFFFFF} »œÌ· {FFFF00}Õ›Ÿ-«·„Êﬁ› {AAAAAA}(«” ⁄«œ… »⁄œ «· Õÿ„)\n\
{FFFFFF}÷⁄ {FFFF00}⁄·«„… Checkpoint\n\
{FF5555}≈—Ã«⁄ «·”Ì«—… «·¬‰ {AAAAAA}(»œÊ‰ «” —œ«œ)");
