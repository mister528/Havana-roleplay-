	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  ÿ»ﬁ Â–« ⁄·Ï ‰›”ﬂ." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;
	if ( params [ 1 ] > 21 || params [ 1 ] < 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}»” [Room 0 - 21]" ) ;
	if ( p_info [ params [ 0 ] ] [ jail ] != 20 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  ÿ»Ìﬁ Â–« ≈·Ï «··«⁄»." ) ;
	p_info [ params [ 0 ] ] [ jail_force ] = params [ 1 ];
	update_int_sql ( params [ 0 ], "u_jail_force", p_info [ params [ 0 ] ] [ jail_force ] ) ;
	set_pos ( params [ 0 ], prison_spawn [ p_info [ params [ 0 ] ] [ jail_force ] ] [ 0 ], prison_spawn [ p_info [ params [ 0 ] ] [ jail_force ] ] [ 1 ], prison_spawn [ p_info [ params [ 0 ] ] [ jail_force ] ] [ 2 ], prison_spawn [ p_info [ params [ 0 ] ] [ jail_force ] ] [ 3 ], 27, 27);
	new scm_string [ 250 ] ;
	format ( scm_string, sizeof ( scm_string ), "{"#cRD"}* {"#cWH"}%s[%d] ‰ﬁ·ﬂ ·€—›… N#%d", p_info [ playerid ] [ name ],playerid, params [ 1 ]) ;
    SendClientMessage ( params [ 0 ], col_gray,scm_string ) ;
    new sql_string [ 280 ] ;
	format ( sql_string, sizeof sql_string, "[F] %s {"#cYW"}%s[%d] {"#cGR"}œ›⁄ {"#cRD"}%s[%d] {"#cGR"}to room NÔøΩ%d.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ],params [ 1 ] ) ;
	foreach(new i: logged_players) if ( p_info [ i ] [ member ] == p_info [ playerid ] [ member ] ) SendClientMessage ( i, col_gray, sql_string ) ;
	return 1;
}

