CMD:offcas ( playerid )
{
	if ( p_info [ playerid ] [ member ] != 27 )return 1 ;
	if ( is_ether { playerid } == 0 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ ›Ì «·√ÀÌ—!" ) ;
	if ( cas_price [ p_info [ playerid ] [ member ] - 26 ] == 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«” ﬁ»«· «·„ﬂ«·„«  Ê«·—”«∆· ·”« „« «‘ €·!" ) ;
	cas_price [ p_info [ playerid ] [ member ] - 26 ] = 0 ;
	new scm_string [ 98 ] ;

	format ( scm_string, sizeof scm_string, "%s %s   . : %d$.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], cas_bank [ p_info [ playerid ] [ member ] - 26 ] ) ;
	foreach(new i: logged_players)
	{
		if ( p_info [ i ] [ member ] == p_info [ playerid ] [ member ] ) SendClientMessage ( i, 0x7DA1FFFF, scm_string ) ;
		if ( is_ether { i } == 0 || is_ether { i } != p_info [ playerid ] [ member ] || i == playerid)continue ;
		is_ether { i } = 0 ;
		SetPlayerSpecialAction ( i, SPECIAL_ACTION_STOPUSECELLPHONE ) ;
		RemovePlayerAttachedObject ( i, 2 ) ;
	}
	return 1 ;
}

