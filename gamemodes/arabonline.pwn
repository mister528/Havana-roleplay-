}

CMD:pass(playerid, params[])
{
	if ( GetPVarInt ( playerid, "PlayerCuffed" ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  „ﬂ»¯· »«·√’›«œ." ) ;
	if ( GetPVarInt ( playerid, "PlayerTied" ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  „—»Êÿ." ) ;
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /pass [ID/«·«”„]");
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» „«  „ «·⁄ÀÊ— ⁄·ÌÂ." ) ;

    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;
	if ( p_t_info [ params [ 0 ] ] [ p_dialog ] != -1 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì‰›⁄ «·ÕÌ‰.") ;


	show_pass ( playerid, params [ 0 ] ) ;

	if ( params [ 0 ] == playerid )format ( global_string, 72, "(-)  " ) ;
	else format ( global_string, 72, "(-)  %s", p_info [ params [ 0 ] ] [ name ] ) ;

