    {
        give_money ( i, params [ 0 ] ) ;
        new _t_string [ 220 ] ;
		format ( _t_string, sizeof ( _t_string ), "{"#cYW"}*  {"#cWH"}%s Atta ≈·Ï ﬂ· streamed «·√⁄÷«¡ «·‹ {"#cGN"}$%d", p_info [ playerid ] [ name ], params [ 0 ] ) ;
