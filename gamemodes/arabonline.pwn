CMD:createbusiness ( playerid, params[ ] )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( sscanf ( params, "ddds[32]", params [ 0 ], params [ 1 ], params [ 2 ], params [ 3 ] ) )
	{
		SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /createbusiness [«·‰Ê⁄] [«·”⁄—] [int] [«·«”„]" );
		SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·„Õ· - «·‰Ê⁄ 0° „Õÿ… «·ÊﬁÊœ - «·‰Ê⁄ 1° „Õ· «·”·«Õ - «·‰Ê⁄ 2° «· ÌÊ‰Ì‰ﬁ - «·‰Ê⁄ 3° „Õ· «·„·«»” - «·‰Ê⁄ 4.");
		SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·”Ì«—… «·”Êﬁ - «ﬂ » 5, „ÿ⁄„ - «ﬂ » 6, «·‰«œÌ - «ﬂ » 7, «·»«— - «ﬂ » 8, ’Ìœ·Ì… - «ﬂ » 9, «·ﬂ«“Ì‰Ê - «ﬂ » 10" ) ;
        SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·ÃÌ„ - «·‰Ê⁄ 11 | /intlist" ) ;
		return 1;
	}
	GetPlayerPos ( playerid, b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ] ) ;
	GetPlayerFacingAngle ( playerid, b_info [ b_count ] [ b_position ] [ 3 ] ) ;

	b_info [ b_count ] [ b_id ] = b_count + 1 ;
	strcat ( b_info [ b_count ] [ b_owner_name ], "«·œÊ·…" ) ;
	b_info [ b_count ] [ b_owner_inc ] = -1 ;
	b_info [ b_count ] [ b_price ] = params [ 1 ] ;
	b_info [ b_count ] [ b_type ] = params [ 0 ] ;
	b_info [ b_count ] [ b_maxproduct ] = 15000 ;
	b_info [ b_count ] [ b_mafia ] = 25 ;
	format ( b_info [ b_count ] [ b_name ], 32, "%s", params [ 3 ] ) ;

	new bis_int = params [ 2 ] - 1 ;

	if ( b_info [ b_count ] [ b_type ] == bizz_type_shop || b_info [ b_count ] [ b_type ] == bizz_type_pharm || b_info [ b_count ] [ b_type ] == bizz_type_clothes || b_info [ b_count ] [ b_type ] == bizz_type_carshop || b_info [ b_count ] [ b_type ] == bizz_type_cafe || b_info [ b_count ] [ b_type ] == bizz_type_club || b_info [ b_count ] [ b_type ] == bizz_type_bar || b_info [ b_count ] [ b_type ] == bizz_type_casino || b_info [ b_count ] [ b_type ] == bizz_type_gum )
	{
		b_info [ b_count ] [ b_pickup ] = CreateDynamicPickup ( 1318, 23, b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ], 0, 0 ) ;
		pick_info [ b_info [ b_count ] [ b_pickup ] ] [ pick_type ] = pick_type_bentrance ;


		new pickup_biz = CreateDynamicPickup ( 1318, 23, b_interior [ bis_int ] [ i_position ] [ 0 ], b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ], b_info [ b_count ] [ b_id ] + 1000, b_interior [ bis_int ] [ i_interior ] ) ;
		pick_info [ pickup_biz ] [ pick_type ] = pick_type_bexit ;

		if ( b_info [ b_count ] [ b_type ] == bizz_type_shop )
		{
			new pickup_b247_buy = CreateDynamicPickup ( 1274, 1, 663.917419, -568.787658, 16.343263, b_info [ b_count ] [ b_id ] + 1000, b_interior [ bis_int ] [ i_interior ] ) ;
			pick_info [ pickup_b247_buy ] [ pick_type ] = pick_type_b247_buy ;
		}

		// [CLOTHES SHOP - new buy-skin pickup + Arabic 3D label]
		if ( b_info [ b_count ] [ b_type ] == bizz_type_clothes )
		{
			new pickup_clbuy = CreateDynamicPickup ( 1274, 1, 1502.572631, 1318.530151, 1010.820312, b_info [ b_count ] [ b_id ] + 1000, b_interior [ bis_int ] [ i_interior ] ) ;
			pick_info [ pickup_clbuy ] [ pick_type ] = pick_type_clothes_buy ;
			CreateDynamic3DTextLabel ( "[ ‘—«¡ „·«»” ]\n«„‘ Â‰« ··‘—«¡", 0xFFD75AFF, 1502.572631, 1318.530151, 1010.820312 + 0.7, 8.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, b_info [ b_count ] [ b_id ] + 1000, b_interior [ bis_int ] [ i_interior ] ) ;
		}

		new label_string [ 228 ] ;
		format ( label_string, sizeof ( label_string  ), "{"#cBL"}%s\n{"#cGR"}: {"#cWH"}%d$\n{"#cGR"}: {"#cWH"}%s\n{"#cGR"} ", b_types [ b_info [ b_count ] [ b_type ] ], b_info [ b_count ] [ b_price ] * for_tax [ 1 ], mafia_owner_name [ b_info [ b_count ] [ b_mafia ] - 1 ] ) ;
		b_info [ b_count ] [ b_label ] = CreateDynamic3DTextLabel ( label_string, -1,  b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ] + 0.7, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0 ) ;
	}
	else if ( b_info [ b_count ] [ b_type ] == bizz_type_ammo )
	{
		b_info [ b_count ] [ b_pickup ] = CreateDynamicPickup ( 1318, 23, b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ], 0, 0 ) ;
		pick_info [ b_info [ b_count ] [ b_pickup ] ] [ pick_type ] = pick_type_bentrance ;

		new pickup_biz = CreateDynamicPickup ( 1318, 23, b_interior [ bis_int ] [ i_position ] [ 0 ], b_interior [ bis_int ] [ i_position ] [ 1 ], b_interior [ bis_int ] [ i_position ] [ 2 ], b_info [ b_count ] [ b_id ] + 1000, b_interior [ bis_int ] [ i_interior ] ) ;
		pick_info [ pickup_biz ] [ pick_type ] = pick_type_bexit ;

		new actorid = CreateActor( 179, 296.4053, -40.2153, 1001.5156, 1.6147 ) ;
		SetActorVirtualWorld ( actorid, b_info [ b_count ] [ b_id ] + 1000 ) ;

		new label_string [ 228 ] ;
		format ( label_string, sizeof ( label_string  ), "{"#cBL"}%s\n{"#cGR"}: {"#cWH"}%d$\n{"#cGR"}: {"#cWH"}%s\n{"#cGR"} ", b_types [ b_info [ b_count ] [ b_type ] ], b_info [ b_count ] [ b_price ] * for_tax [ 1 ], mafia_owner_name [ b_info [ b_count ] [ b_mafia ] - 1 ] ) ;
		b_info [ b_count ] [ b_label ] = CreateDynamic3DTextLabel ( label_string, -1,  b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ] + 0.7, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0 ) ;

	}
	else if ( b_info [ b_count ] [ b_type ] == bizz_type_gas )
	{
		new label_string [ 228 ] ;
		format ( label_string, sizeof ( label_string  ), "{"#cBL"}%s\n{"#cGR"}: {"#cWH"}%d$\n{"#cGR"}: {"#cWH"}%s\n{"#cGR"}  (/buygas)", b_types [ b_info [ b_count ] [ b_type ] ], b_info [ b_count ] [ b_price ] * for_tax [ 1 ], mafia_owner_name [ b_info [ b_count ] [ b_mafia ] - 1 ] ) ;
		b_info [ b_count ] [ b_label ] = CreateDynamic3DTextLabel ( label_string, -1,  b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ] + 0.7, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0 ) ;
	}
	else if ( b_info [ b_count ] [ b_type ] == bizz_type_tune )
	{
		new label_string [ 228 ] ;
		format ( label_string, sizeof ( label_string  ), "{"#cBL"}%s\n{"#cGR"}: {"#cWH"}%d$\n{"#cGR"}: {"#cWH"}%s\n{"#cGR"}  (/buytune)", b_types [ b_info [ b_count ] [ b_type ] ], b_info [ b_count ] [ b_price ] * for_tax [ 1 ], mafia_owner_name [ b_info [ b_count ] [ b_mafia ] - 1 ] ) ;
		b_info [ b_count ] [ b_label ] = CreateDynamic3DTextLabel ( label_string, -1,  b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ] + 0.7, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0 ) ;
	}

	if ( bis_int >= 0 )
	{
 		CreateDynamicMapIcon ( b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ], b_interior [ bis_int ] [ i_map_icon ], 0, 0, 0, -1, 200.0 ) ;
	}
	else
	{
		switch ( b_info [ b_count ] [ b_type ] )
		{
			case bizz_type_tune:CreateDynamicMapIcon ( b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ], 27, 0, 0, 0, -1, 50.0 ) ;
			case bizz_type_gas:CreateDynamicMapIcon ( b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ], 56, 0, 0, 0, -1, 50.0 ) ;
		}
	}

	new query_string [ 236 ] ;
	mysql_format ( sql_connection, query_string, sizeof ( query_string  ),"INSERT INTO `businesses` (`b_pos_x`,`b_pos_y`,`b_pos_z`,`b_pos_c`,`b_price`,`b_type`,`b_int`,`b_name`,`b_mafia`) VALUES ('%f','%f','%f','%f','%d','%d','%d','%e','%d')",
	b_info [ b_count ] [ b_position ] [ 0 ], b_info [ b_count ] [ b_position ] [ 1 ], b_info [ b_count ] [ b_position ] [ 2 ], b_info [ b_count ] [ b_position ] [ 3 ],
	params [ 1 ], b_info [ b_count ] [ b_type ], bis_int + 1, b_info [ b_count ] [ b_name ], b_info [ b_count ] [ b_mafia ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;

	// If the loaded business sits on top of the Cityhall hotel marker, hide its
	// pickup and label so the hotel pickup is the only one visible at that spot.
	new Float:_dx_ch = b_info [ b_count ] [ b_position ] [ 0 ] - 1285.059814;
	new Float:_dy_ch = b_info [ b_count ] [ b_position ] [ 1 ] - (-1330.639770);
	new Float:_dz_ch = b_info [ b_count ] [ b_position ] [ 2 ] - 13.547210;
	if (_dx_ch * _dx_ch + _dy_ch * _dy_ch + _dz_ch * _dz_ch < 9.0)
	{
		if (IsValidDynamicPickup(b_info [ b_count ] [ b_pickup ]))
		{
			pick_info [ b_info [ b_count ] [ b_pickup ] ] [ pick_type ] = 0;
			DestroyDynamicPickup(b_info [ b_count ] [ b_pickup ]);
			b_info [ b_count ] [ b_pickup ] = -1;
		}
		if (IsValidDynamic3DTextLabel(b_info [ b_count ] [ b_label ]))
		{
			DestroyDynamic3DTextLabel(b_info [ b_count ] [ b_label ]);
			b_info [ b_count ] [ b_label ] = Text3D:INVALID_3DTEXT_ID;
		}
	}

	b_count ++ ;
	return 1 ;
}

CMD:buygas ( playerid, params[ ] )
