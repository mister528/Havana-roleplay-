//================================


stock speedometr_status(playerid, bool:status)
{
	if(status == true)
	{
		// [Devin] vehicle speedometer HUD removed
		if(!speed_one[playerid]) createspeed(playerid);
		for(new j = 0; j < 31; j++) PlayerTextDrawHide(playerid, Speedometer[playerid][j]);
	}
	else
	{
		for(new j = 0; j < 31; j++)
		{
			if(speed_one[playerid]) destroyspeed(playerid);
			if(j < 31) PlayerTextDrawHide(playerid, Speedometer[playerid][j]);
		}
	}
	return 1;
}

stock destroyspeed(playerid)
{
	for(new i = 0; i < 31; i++) PlayerTextDrawHide(playerid, Speedometer[playerid][i]);
	speed_one[playerid] = 0;
}


