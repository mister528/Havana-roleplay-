	else if(p_t_info [ playerid ] [ job_meh ] != 1 ) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"} «»œ√ ÌÊ„ «·‘€· (/mech).");
	else if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ œ«Œ· «·”Ì«—….");
	else if(veh_info [ player_rentcar [ playerid ] - 1 ] [ v_type ] != vehicle_type_job || veh_info [ player_rentcar [ playerid ] - 1 ] [ v_owner ] != job_mechanic) return SendClientMessage(playerid,col_gray,"{"#cRD"} * {"#cGR"}·«“„  ﬂÊ‰ œ«Œ· ”Ì«—… «·‘€·.");

