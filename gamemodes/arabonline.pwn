	PlayerTextDrawFont(playerid, g_shop247_td[playerid][idx], 2);
	PlayerTextDrawLetterSize(playerid, g_shop247_td[playerid][idx], 0.36, 1.8);
	PlayerTextDrawTextSize(playerid, g_shop247_td[playerid][idx], xto, 22.0);
	PlayerTextDrawColor(playerid, g_shop247_td[playerid][idx], 0xFFFFFFFF);
	PlayerTextDrawSetOutline(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawSetProportional(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawSetShadow(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawUseBox(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawBoxColor(playerid, g_shop247_td[playerid][idx], boxcol);
	PlayerTextDrawSetSelectable(playerid, g_shop247_td[playerid][idx], 1);
