callback:load_debtor_messages ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		global_string [ 0 ] = EOS ;

		for ( new i = 0 ; i < rows ; i ++ )
		{
			new dm_text [ 172 ] ;
			cache_get_field_content ( i, "dm_text", dm_text, sql_connection, 168 ) ;
			strcat ( dm_text, "\n") ;
			strcat ( global_string, dm_text ) ;

			format ( dm_text, 128, "DELETE FROM `debtor_message` WHERE `dm_dest` = '%d'", p_info [ playerid ] [ id ] ) ;
			mysql_tquery ( sql_connection, dm_text ) ;
		}

		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBL"}≈‘⁄«—« ", global_string, "≈€·«ﬁ", "" ) ;
	}
	return 1 ;
}

callback:referal_bonus_callback ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )return 1 ;

	new referal_name [ MAX_PLAYER_NAME ] ;
	cache_get_field_content ( 0, "u_name", referal_name, sql_connection, MAX_PLAYER_NAME ) ;
	new referal_inc = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;


	new _pl_id ;
	sscanf ( referal_name, "u", _pl_id ) ;
	if ( IsPlayerConnected ( _pl_id ) )
	{
		if ( ! p_t_info [ _pl_id ] [ p_logged ] )
		{
			new query_string [ 232 ] ;
			format ( query_string, 128, "* «··«⁄» %s  „ «” ·«„Â {"#cBL"}$75.000{"#cGR"} ·‹ inviting √‰  ≈·Ï «·”Ì—›—.", referal_name ) ;
			SendClientMessage ( playerid, col_gray, query_string ) ;

			format ( query_string, sizeof query_string, "INSERT INTO `debtor_message`(`dm_text`, `dm_dest`) VALUES ('{"#cWH"}«” ·„  {"#cBL"}75.000${"#cWH"} ·‹ inviting ·«⁄» {"#cBL"}%s','%d')",
			p_info [ playerid ] [ name ], referal_inc ) ;
			mysql_tquery ( sql_connection, query_string ) ;

			format ( query_string, 144, "UPDATE `users` SET u_money=u_money+'75000' WHERE `u_id` = '%d'",
			referal_inc ) ;
			mysql_tquery ( sql_connection, query_string ) ;
		}
		else
		{
			new query_string [ 128 ] ;
			format ( query_string, 128, "* «··«⁄» %s  „ «” ·«„Â {"#cBL"}75.000${"#cGR"} ·‹ inviting √‰  ≈·Ï «·”Ì—›—.", referal_name ) ;
			SendClientMessage ( playerid, col_gray, query_string ) ;

			format ( query_string, 128, "* «” ·„  {"#cBL"}75.000${"#cGR"} ·‹ invite {"#cBL"}%s{"#cGR"}.", p_info [ playerid ] [ name ] ) ;
			SendClientMessage ( _pl_id, col_gray, query_string ) ;

			give_money ( _pl_id, 75000 ) ;
			insert_money_log ( _pl_id, playerid, 75000, "referral money" ) ;
		}
	}
	else
	{
		new query_string [ 232 ] ;
		format ( query_string, 128, "* «··«⁄» %s  „ «” ·«„Â {"#cBL"}75.000${"#cGR"} ·‹ inviting √‰  ≈·Ï «·”Ì—›—.", referal_name ) ;
		SendClientMessage ( playerid, col_gray, query_string ) ;

		format ( query_string, sizeof query_string, "INSERT INTO `debtor_message`(`dm_text`, `dm_dest`) VALUES ('{"#cWH"}«” ·„  {"#cBL"}75.000${"#cWH"} ·‹ inviting ·«⁄» {"#cBL"}%s','%d')",
		p_info [ playerid ] [ name ], referal_inc ) ;
		mysql_tquery ( sql_connection, query_string ) ;

		format ( query_string, 144, "UPDATE `users` SET u_money=u_money+'75000' WHERE `u_id` = '%d'",
		referal_inc ) ;
		mysql_tquery ( sql_connection, query_string ) ;
	}
	return 1 ;
}

callback: change_donate_name ( playerid, donate_name [ ] )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		show_dialog ( playerid, d_donate_rename, DIALOG_STYLE_INPUT, "{"#cBL"}Œœ„«  «·œÊ‰Ì ","{"#cRD"}- Â–« «·«”„ ÂÊ ”»ﬁ Ê √ıŒ–.\n\n{"#cGR"}- {"#cWH"}«·«”„  €ÌÌ—:\n\n{"#cGR"}- «·”⁄—: {"#cGN"}20  »—⁄ ⁄„·« {"#cGR"}.\n{"#cGR"}- «›⁄· ›⁄·«  »Ì · €ÌÌ— Õﬁﬂ \"{"#cWH"}«·≈”„{"#cGR"}\".","≈·Ï „Ê«›ﬁ…", "—ÃÊ⁄");
		return 1 ;
	}
	if ( SetPlayerName ( playerid, donate_name ) == -1 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» „⁄ Â–« «·«”„ ÂÊ  „ «·« ’«· »«·”Ì—›—." )  ;

	new sql_string [ 198 ] ;
	format ( sql_string, sizeof ( sql_string ), "UPDATE `users` SET `u_donate` = `u_donate`-'20',`u_name` = '%s' WHERE `u_id` = '%d' LIMIT 1", donate_name, p_info [ playerid ] [ id ] ) ;
	mysql_query ( sql_connection, sql_string ) ;
	
	format(sql_string, sizeof ( sql_string ), "SELECT `u_referal` FROM `users` WHERE `u_name`= '%s'", p_info [ playerid ] [ name ] ) ;
	mysql_tquery(sql_connection, sql_string, "FriendPay", "dd", playerid, 5 );

	if ( p_info [ playerid ] [ admin ] != 0)
	{
		format ( sql_string, sizeof ( sql_string ), "UPDATE `users_admins` SET `u_a_name` = '%s' WHERE `u_a_name` = '%s' LIMIT 1", donate_name, p_info [ playerid ] [ name ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	format ( sql_string, sizeof ( sql_string ), "UPDATE `fractions_blacklist` SET `bl_name` = '%s' WHERE `bl_name` = '%s'", donate_name, p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	if ( p_info [ playerid ] [ house ] != -1 )
    {
   		strmid( h_info [ p_info [ playerid ] [ house ] - 1 ] [ h_owner_name ], donate_name, 0, strlen ( donate_name ), 31 ) ;
		format ( sql_string, 138, "UPDATE `houses` SET `h_ownername` = '%s' WHERE `h_id` = '%d' LIMIT 1", donate_name, p_info [ playerid ] [ house ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	if ( p_info [ playerid ] [ business ] != -1 )
    {
   		strmid( b_info [ p_info [ playerid ] [ business ] - 1 ] [ b_owner_name ], donate_name, 0, strlen ( donate_name ), 31 ) ;
		format ( sql_string, 138, "UPDATE `businesses` SET `b_owner_name` = '%s' WHERE `b_id` = '%d' LIMIT 1", donate_name, p_info [ playerid ] [ business ] ) ;
		mysql_tquery ( sql_connection, sql_string ) ;
	}
	for(new i = 0; i < MAX_TRAILERS; i++)
	{
		if(!strcmp(p_info[playerid][name],TrailerInfo[i][d_owner]))
		{
			format ( sql_string, sizeof ( sql_string ), "UPDATE `DNK` SET `d_owner` = '%s' WHERE `d_owner` = '%s'",donate_name,p_info[playerid][name]);
			format(TrailerInfo[i][d_owner],MAX_PLAYER_NAME,donate_name);
			mysql_tquery ( sql_connection, sql_string ) ;
			break;
		}
	}
	
	format ( sql_string, 98,"*     : {"#cBL"}%s", donate_name ) ;
	SendClientMessage ( playerid, col_green, sql_string ) ;
	SendClientMessage ( playerid, col_green, "* ‰Õ‰ ‰Ê’Ì ≈‰ﬂ  ⁄Ìœ  ‘€Ì· «··⁄»… »«”„ ÃœÌœ." ) ;
	format ( sql_string, 132, "{"#cBL"}*  {"#cGR"}%s  „  €ÌÌ—Â ÕﬁÂ «·«”„ ≈·Ï %s", p_info [ playerid ] [ name ], donate_name ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_gray, sql_string ) ;

	format( sql_string, 132, "%s  „  €ÌÌ—Â «·«”„ ≈·Ï %s", p_info [ playerid ] [ name ], donate_name ) ;
	foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, sql_string ) ;

	format ( sql_string, sizeof ( sql_string ), "INSERT INTO `nickname_history` (`nh_owner`,`nh_oldname`,`nh_newname`,`nh_date`,`nh_admin`) VALUES ('%d','%s','%s',NOW(),'donate')",
	p_info [ playerid ] [ id ], p_info [ playerid ] [ name ], donate_name ) ;
	mysql_tquery ( sql_connection, sql_string ) ;

	strmid ( p_info [ playerid ] [ name ], donate_name, 0, strlen ( donate_name ), 31 ) ;

	show_donate ( playerid ) ;
	return 1 ;
}

