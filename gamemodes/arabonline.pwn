CMD:settime(playerid, params[])
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	//////if(p_info[playerid][id] != 1 ) return true;
	if ( sscanf ( params, "ddd", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /settime [”«⁄« ] [œﬁ«∆ﬁ] [ÀÊ«‰Ì]" ) ;
	if ( params [ 0 ] > 23 || params [ 0 ] < 0 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /settime [”«⁄« ] [œﬁ«∆ﬁ] [ÀÊ«‰Ì]" ) ;
	if ( params [ 1 ] > 59 || params [ 1 ] < 0 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /settime [”«⁄« ] [œﬁ«∆ﬁ] [ÀÊ«‰Ì]" ) ;
	if ( params [ 2 ] > 59 || params [ 2 ] < 0 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /settime [”«⁄« ] [œﬁ«∆ﬁ] [ÀÊ«‰Ì]" ) ;
	global_hour = params [ 0 ] ;
	SetWorldTime ( params [ 0 ] ) ;

	new scm_string [ 98 ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBL"}*  {"#cGR"}%s[%d]      %d:%d:%d.", p_info [ playerid ] [ name ], playerid, params [ 0 ], params [ 1 ], params [ 2 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_gray, scm_string ) ;
	return 1 ;
}

CMD:ipaccounts( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ admin ] < 4 )return 1 ;
	new ban_ip [ 16 ] ;
	if ( sscanf ( params, "s[16]", ban_ip ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /ipaccounts [¬Ì »Ì]" ) ;


	new sql_string [ 178 ] ;
	mysql_format ( sql_connection, sql_string, 178, "SELECT `u_name`,`u_last_date`,`u_online`,`u_level` FROM `users` WHERE `u_last_ip` = '%s' OR `u_ip_registration` = '%s' LIMIT 25",
	ban_ip, ban_ip ) ;
	mysql_tquery ( sql_connection, sql_string, "cmd_ipaccounts_callback", "i", playerid ) ;

	return true;
}

callback:cmd_ipaccounts_callback ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}·«  ÊÃœ »Ì«‰«   „ ≈ÌÃ«œÂ ·‹ Â–« ⁄‰Ê«‰ ¬Ì »Ì." ) ;
	global_string [ 0 ] = EOS ;
	for ( new j = 0 ; j < rows ; j ++ )
	{
		new pl_name [ 24 ], pl_date [ 28 ], u_online, line_string [ 98 ], pl_level ;
		u_online = cache_get_field_content_int ( j, "u_online", sql_connection ) ;
		pl_level = cache_get_field_content_int ( j, "u_level", sql_connection ) ;

		cache_get_field_content ( j, "u_name", pl_name, sql_connection, 24 ) ;
		cache_get_field_content ( j, "u_last_date", pl_date, sql_connection, 28 ) ;

		if ( u_online )format ( line_string, sizeof ( line_string ), "{"#cWH"}%s („” ÊÏ:%d) - {"#cGN"}‰‘ÿ {"#cWH"}%s\n", pl_name, pl_level, pl_date ) ;
		else format ( line_string, sizeof ( line_string ), "{"#cWH"}%s („” ÊÏ:%d) - {"#cRD"}€Ì— ‰‘ÿ {"#cWH"}%s\n", pl_name, pl_level, pl_date ) ;
		strcat ( global_string, line_string ) ;
	}
	show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBL"}ﬁ«∆„… «·Õ”«»« ", global_string, "≈€·«ﬁ", "" ) ;
	return 1 ;
}

CMD:banip ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	////if(p_info[playerid][id] != 1 ) return true;
	new ban_ip [ 16 ], ban_reason_ip [ 32 ] ;
	if ( sscanf ( params,"s[16]s[32]", ban_ip, ban_reason_ip ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /ÕŸ— IP [¬Ì »Ì] [«·”»»]" ) ;
	if ( strfind ( ban_ip, "*.*", true ) != -1 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}€Ì— ’«·Õ ⁄‰Ê«‰ ¬Ì »Ì." ) ;
	new scm_string [ 128 ];
	format ( scm_string, sizeof ( scm_string ),"ÕŸ— IP %s", ban_ip ) ;
	SendRconCommand ( scm_string ) ;
	SendRconCommand("reloadbans");

	format ( scm_string, sizeof ( scm_string ),"{"#cBL"}* {"#cGR"}%s[%d] blocked ¬Ì »Ì %s. «·”»»: %s", p_info [ playerid ] [ name ], playerid, ban_ip, ban_reason_ip ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_gray, scm_string ) ;
	return true;
}

CMD:unbanip ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	////if(p_info[playerid][id] != 1 && p_info[playerid][id] != 23 && p_info[playerid][id] != 94) return true;
	if ( sscanf ( params,"s[16]",params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /›ﬂ ÕŸ— IP [¬Ì »Ì]" ) ;
	if ( strfind ( params [ 0 ], "*.*", true ) != -1 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}€·ÿ ⁄‰Ê«‰ ¬Ì »Ì." ) ;

	new scm_string [ 128 ];
	format ( scm_string, sizeof ( scm_string ),"›ﬂ ÕŸ— IP %s", params [ 0 ] ) ;
	SendRconCommand ( scm_string ) ;
	SendRconCommand("reloadbans");

	format ( scm_string, sizeof ( scm_string ),"{"#cBL"}* {"#cGR"}%s[%d] unblocked ¬Ì »Ì %s.", p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_gray, scm_string ) ;
	return true;
}


CMD:createfvehicle( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	////if(p_info[playerid][id] != 1 ) return true;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ ›Ì „—ﬂ»…." ) ;
	if ( sscanf ( params, "dds[12]", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /createfvehicle [«·„ÊœÌ·][«·„‰Ÿ„…][«·—ﬁ„]" ) ;
	if ( params [ 0 ] < 400 || params [ 0 ] > 611 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /createfvehicle [«·„ÊœÌ·][«·„‰Ÿ„…][«·—ﬁ„]" ) ;
	new veh_id = GetPlayerVehicleID ( playerid ) ;
	for ( new i = 1 ; i < MAX_VEHICLES; i ++ )
	{
		if ( IsValidVehicle ( i ) ) continue;
		veh_info [ i - 1 ] [ v_owner ] = params [ 1 ] ;
		veh_info [ i - 1 ] [ v_model ] = params [ 0 ] ;
		format ( veh_info [ i - 1 ] [ v_plate ], 12, "%s", params [ 2 ] ) ;

		GetVehiclePos ( veh_id, veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ] ) ;
		GetVehicleZAngle ( veh_id, veh_info [ i - 1 ] [ v_pos ] [ 3 ] ) ;

		veh_info [ i - 1 ] [ v_rank ] = 1 ;

		veh_info[ veh_id - 1 ] [ v_type ] = vehicle_type_server ;


        if ( veh_info [ i - 1 ] [ v_owner ] == 1 ) veh_info [ i - 1 ] [ v_vehicle ] = AC_CreateVehicle ( veh_info [ i - 1 ] [ v_model ], veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ], veh_info [ i - 1 ] [ v_pos ] [ 3 ], veh_info [ i - 1 ] [ v_color ] [ 0 ], veh_info [ i - 1 ] [ v_color ] [ 1 ], -1, 1 ) ;
		else veh_info [ i - 1 ] [ v_vehicle ] = AC_CreateVehicle ( veh_info [ i - 1 ] [ v_model ], veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ], veh_info [ i - 1 ] [ v_pos ] [ 3 ], veh_info [ i - 1 ] [ v_color ] [ 0 ], veh_info [ i - 1 ] [ v_color ] [ 1 ], -1 ) ;
		SetVehicleNumberPlate ( veh_info [ i ] [ v_vehicle ], veh_info [ i - 1 ] [ v_plate ] ) ;
		veh_info [ i - 1 ] [ v_fuel ] = 60.0 ;

		new sql_string [ 228 ] ;
		mysql_format ( sql_connection, sql_string, 228, "INSERT INTO `server_vehicles` (`sv_model`,`sv_owner`,`sv_plate`,`sv_pos_x`,`sv_pos_y`,`sv_pos_z`,`sv_pos_a`,`sv_owner`) VALUES ('%d','%d','%e','%f','%f','%f','%f','1')",
		params [ 0 ], params [ 1 ], params [ 2 ],
		veh_info [ i - 1 ] [ v_pos ] [ 0 ], veh_info [ i - 1 ] [ v_pos ] [ 1 ], veh_info [ i - 1 ] [ v_pos ] [ 2 ], veh_info [ i - 1 ] [ v_pos ] [ 3 ] ) ;
		mysql_tquery ( sql_connection, sql_string, "create_vehicle_callback", "d", i ) ;
		break ;
	}
	SendClientMessage ( playerid, col_white, " „ ≈‰‘«¡ „—ﬂ»… «·„‰Ÿ„… »‰Ã«Õ." ) ;
	return 1 ;
}

