CMD:p( playerid )
{
	if ( GetPVarInt ( playerid, "PlayerCuffed" ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  „ﬂ·»‘." );
	if ( GetPVarInt ( playerid, "PlayerTied" )) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „ « ’«·ﬂ." ) ;
	if ( ! p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ÃÊ«·." ) ;
	if ( ! p_t_info [ playerid ] [ phone_toggled ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}ÃÊ«·ﬂ „€·ﬁ." ) ;
	if ( p_t_info [ playerid ] [ phone_id ] == INVALID_PLAYER_ID || p_t_info [ playerid ] [ phone_caller ] == 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}·« Ê«Õœ ÂÊ Ì ’· √‰  .");
	if ( ! p_t_info [ playerid ] [ p_logged ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}·« Ê«Õœ ÂÊ Ì ’· √‰ ." ) ;
	if ( is_ether { playerid } != 0 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  ﬂ·„ ⁄·Ï «·ÃÊ«· Ê√‰  ›Ì «·ÃÊ." ) ;

	new scm_string [ 30 + MAX_PLAYER_NAME ] ;
	format ( scm_string, sizeof ( scm_string ), "%s answered  «·Â« ›.", p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( p_t_info [ playerid ] [ phone_id ], col_yellow, scm_string ) ;

	p_t_info [ playerid ] [ phone_caller ] = 0 ;
	p_t_info [ p_t_info [ playerid ] [ phone_id ] ] [ phone_caller ] = 0 ;
	p_t_info [ p_t_info [ playerid ] [ phone_id ] ] [ phone_id ] = playerid ;

