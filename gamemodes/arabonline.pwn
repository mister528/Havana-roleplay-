callback: GetLogs(playerid, Types)
{
    global_string [ 0 ] = EOS ;
	new rows, fields;
	cache_get_data(rows, fields);
	new sqlcmd[256];
	new t_level[128], awarn1, t_id;
	new Adminlevel, Helperlevel;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ›ÌÂ ”Ã·«  ‰‘ÿ…." ) ;
	if(rows)
	{
  		for ( new i ; i < rows ; i ++ )
		{
			cache_get_field_content(i, "type", sqlcmd), t_id = strval(sqlcmd);
			cache_get_field_content(i, "Text", sqlcmd), strmid(t_level, sqlcmd, 0, strlen(sqlcmd), 128);
			cache_get_field_content(i, "day", sqlcmd), Adminlevel = strval(sqlcmd);
			cache_get_field_content(i, "month", sqlcmd), Helperlevel = strval(sqlcmd);
			cache_get_field_content(i, "year", sqlcmd), awarn1 = strval(sqlcmd);

			if(Types == t_id)
			{
				format(global_string, sizeof(global_string), "%s%s, %d.%d.%d\n", global_string, t_level, Adminlevel, Helperlevel, awarn1);
			}
		}
	}
	show_dialog(playerid, d_none, DIALOG_STYLE_LIST, "{"#cBL"}”Ã· œŒÊ· œ«Œ· «··⁄»…", global_string, "≈€·«ﬁ", "");
	return 1;
}

callback: GetLogsRang(playerid, p_member)
{
    global_string [ 0 ] = EOS ;
	new rows, fields;
	cache_get_data(rows, fields);
	new sqlcmd[256], stringer1[128];
	new t_level[128], awarn1, org, Adminlevel, Helperlevel;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ›ÌÂ ”Ã·«  ‰‘ÿ…." ) ;
	if(rows)
	{
  		for ( new i ; i < rows ; i ++ )
		{
			cache_get_field_content(i, "member", sqlcmd), org = strval(sqlcmd);
			cache_get_field_content(i, "Text", sqlcmd), strmid(t_level, sqlcmd, 0, strlen(sqlcmd), 128);
			cache_get_field_content(i, "day", sqlcmd), Adminlevel = strval(sqlcmd);
			cache_get_field_content(i, "month", sqlcmd), Helperlevel = strval(sqlcmd);
			cache_get_field_content(i, "year", sqlcmd), awarn1 = strval(sqlcmd);

			if(p_member == org)
			{
				format(global_string, sizeof global_string, "%s%s, %d.%d.%d\n",
				global_string, t_level, Adminlevel, Helperlevel, awarn1);
			}
		}
	}
	format(stringer1, sizeof stringer1, "{"#cBL"} ”ÃÌ· «·œŒÊ· œ«Œ· «··⁄»…: {"#cWH"}%s", f_info [ p_member - 1] [ f_name ] );
	show_dialog(playerid, d_none, DIALOG_STYLE_LIST, stringer1, global_string, "≈€·«ﬁ", "");
	return 1;
}

callback: GetLogsUval(playerid, p_member)
{
