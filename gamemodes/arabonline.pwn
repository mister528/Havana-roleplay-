	format ( scm_string, 106, "SELECT * FROM `users_bans` WHERE `u_b_name` = '%s' AND `u_b_date` > NOW( ) LIMIT 1", p_info [ params [ 0 ] ] [ name ] ) ;
	mysql_function_query ( sql_connection, scm_string, true, "check_player_banned", "i", params [ 0 ] ) ;
	
