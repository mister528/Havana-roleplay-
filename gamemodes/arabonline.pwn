        InGZ[playerid] = 1;
        for(new i;i<6;i++) TextDrawShowForPlayer(playerid,fstd[i]);
    }
    if(!IsAGreenZone(playerid) && InGZ[playerid] == 1)
    {
        InGZ[playerid] = 0;
        for(new i;i<6;i++) TextDrawHideForPlayer(playerid,fstd[i]);
        GreenZone_ResetViolations(playerid);
    }
	if(InBuilder[playerid] == 1 && p_info[playerid][MissionOneCount] > 25 && p_info[playerid][MissionOne] == 1)
	{
	    p_info[playerid][MissionOne] = 2;
	    new query_strinsg [ 600 ];
