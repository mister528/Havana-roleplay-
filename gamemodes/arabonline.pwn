public OnPlayerEnterVehicle ( playerid, vehicleid, ispassenger)
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerEnterVehicle] playerid:%d | vehicleid:%d | ispassenger:%d", playerid, vehicleid, ispassenger ) ;
	#endif
	ac_test_OnPlayerEnterVehicle ( playerid, vehicleid, ispassenger) ;

	new _trent_slot = trent_find_by_vehid(vehicleid);
	if (_trent_slot >= 0 && g_trent_owner[_trent_slot] != playerid && !ispassenger)
	{
		RemovePlayerFromVehicle(playerid);
		SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}Â–Ì «·”Ì«—… «·„ƒÃ¯—…  «»⁄… ··«⁄» À«‰Ì.");
		return 1;
	}
	for (new _hg_i = 0; _hg_i < MAX_PLAYERS; _hg_i++)
	{
		if (g_house_guard_vehicle[_hg_i] == vehicleid && _hg_i != playerid && !ispassenger)
		{
			RemovePlayerFromVehicle(playerid);
			SendClientMessage(playerid, col_gray, "{FF5555}* {FFFFFF}”Ì«—… Õ«—” «·„‰“· Â–« „Ê ”Ì«— ﬂ.");
			return 1;
		}
	}
	eev_called { playerid } = 1 ;
	new veh_id = GetPlayerVehicleID(playerid);
	if(InPizza[playerid] == 1 && veh_id == 448)
	{
	    p_info[playerid][pizza_exit_timer] = 0;
	}
	if ( GetPVarInt ( playerid, "exam_bank" ) > 0 )
	{
		SetPVarInt ( playerid, "leaved_bank_vehicle", GetPVarInt ( playerid, "exam_bank" )  ) ;
		p_info[playerid][banktimer]=0;
	}
	if ( GetPVarInt ( playerid, "have_box" ) == 1 )
	{
		if ( job_timer [ playerid ] != -1 )KillTimer ( job_timer [ playerid ] ) ;
		SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}”ﬁÿ „‰ﬂ «·’‰œÊﬁ° Õ«Ê· „—… À«‰Ì…." ) ;

		RemovePlayerAttachedObject ( playerid, 0 ) ;
		DisablePlayerRaceCheckpoint ( playerid ) ;

		ClearAnimations ( playerid ) ;
		ApplyAnimation ( playerid, "PED","IDLE_tired", 4.1, 0, 1, 1, 0, 1 ) ;
		DeletePVar ( playerid, "have_box" ) ;
		return 1 ;
	}
	if ( GetPVarInt ( playerid, "PutBuild" ) == 1 && IsPlayerAttachedObjectSlotUsed ( playerid, 0))
	{
		SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}”ﬁÿ „‰ﬂ «·’‰œÊﬁ° Õ«Ê· „—… À«‰Ì…." ) ;

		RemovePlayerAttachedObject ( playerid, 0 ) ;
		DisablePlayerRaceCheckpoint ( playerid ) ;

        DeletePVar ( playerid, "PutBuild" ) ;

		ClearAnimations ( playerid ) ;
		ApplyAnimation ( playerid, "PED","IDLE_tired", 4.1, 0, 1, 1, 0, 1 ) ;
		
		RemovePlayerFromVehicle(playerid);
		
		SetPlayerRaceCheckpoint(playerid, 1,1251.3547,-1264.2043,13.3296,1251.3547,-1264.2043,13.3296, 3.0);
		SetPVarInt(playerid, "TakedBuild", 1);
		return 1 ;
	}
	new tempvehmodel = GetVehicleModel(vehicleid);
	if(tempvehmodel == vehiclerc[playerid] && DeliveryPizza[playerid] == 0 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        SetPlayerRaceCheckpoint(playerid,1,954.2245,-1362.7594,13.3438,954.2245,-1362.7594,13.3438,3.0);
        SendClientMessage(playerid, COLOR_SERVER, "Êﬁ› ⁄‰œ √ÌﬁÊ‰… «·»Ì “« (”Ì— ⁄·Ï —Ã·ﬂ) ⁄‘«‰  «Œ– «·»Ì “« Ê »œ√ ‘€· «· Ê’Ì·!");
    }
	if ( p_info [ playerid ] [ timejob ] == job_porter && IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) && job_timer [ playerid ] == -1)
	{
		SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}”ﬁÿ «·’‰œÊﬁ. Õ«Ê· „—… À«‰Ì…." ) ;

		RemovePlayerAttachedObject ( playerid, 1 ) ;
		DisablePlayerRaceCheckpoint ( playerid ) ;

		SetPlayerRaceCheckpoint ( playerid, 1,porter_pos_take [ opened_containers - 1 ] [ 0 ], porter_pos_take [ opened_containers - 1 ] [ 1 ], porter_pos_take [ opened_containers - 1 ] [ 2 ],porter_pos_take [ opened_containers - 1 ] [ 0 ], porter_pos_take [ opened_containers - 1 ] [ 1 ], porter_pos_take [ opened_containers - 1 ] [ 2 ], 2.5 ) ;
		job_ac_tick [ playerid ] = 0 ;

		DeletePVar ( playerid, "have_factory_box" ) ;
		return 1 ;
	}
	opev_opsc_time_differ [ playerid ] = GetTickCount ( ) ;

	opev_vehicleid [ playerid ] = vehicleid ;
	exv_called { playerid } = 0 ;
	new Float:veh_x, Float:veh_y, Float:veh_z ;
	GetVehiclePos ( vehicleid, veh_x, veh_y, veh_z ) ;
	//auto engine
    new engine,lights,alarm,doors,bonnet,boot,objective;
	new Float:vehicle_health ;
	GetVehicleParamsEx ( vehicleid, engine, lights, alarm, doors, bonnet, boot, objective ) ;
	GetVehicleHealth ( vehicleid, vehicle_health ) ;

	if ( v_velo ( vehicleid ) ) return 1;
	if ( vehicle_health <= 360 )
	{
    	SetVehicleParamsEx ( vehicleid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective ) ;
		return 0;
	}
	if ( engine == VEHICLE_PARAMS_UNSET )
	{
		if ( veh_info [ vehicleid - 1 ] [ v_fuel ] < 1 )
		{
			SendClientMessage ( playerid, col_white, "{"#cRD"}* {"#cGR"}⁄‰œﬂ —ﬂ÷ Œ«—Ã „‰ «·ÊﬁÊœ ›Ì «·”Ì«—…. «” Œœ„ {"#cWH"}/service' {"#cGR"}≈·Ï « ’·  „Ìﬂ«‰ÌﬂÌ!" ) ;
			return SetVehicleParamsEx ( vehicleid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective ) ;
		}
		//else SetVehicleParamsEx ( vehicleid, VEHICLE_PARAMS_ON, lights, alarm, doors, bonnet, boot, objective ) ;
	}
    
	opev_vehicleid [ playerid ] = vehicleid ;
	used_enter [ playerid ] = true ;

 	return 1;
}

public OnPlayerExitVehicle ( playerid, vehicleid)
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerExitVehicle] playerid:%d | vehicleid:%d ", playerid, vehicleid ) ;
	#endif
	exv_called { playerid } = 1 ;
	opev_opsc_time_differ [ playerid ] = 0 ;
	
    new veh_id = GetPlayerVehicleID(playerid);
	if(InPizza[playerid] == 1 && veh_id == 448)
	{
	    p_info[playerid][pizza_exit_timer] = 10;
	    SendClientMessage(playerid, col_green,"* {ffffff}⁄‰œﬂ 10 ÀÊ«‰Ì  —Ã⁄ ·œ—«Ã… «·»Ì “« Ê≈·« —«Õ   œ„—  ·ﬁ«∆Ì«.");
	}
	if ( GetPVarInt ( playerid, "exam_bank" ) > 0 )
	{
		SetPVarInt ( playerid, "leaved_bank_vehicle", GetPVarInt ( playerid, "exam_bank" )  ) ;
		p_info[playerid][banktimer]=30;
		SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}⁄‰œﬂ {"#cRD"}30 ÀÊ«‰Ì{"#cGR"} ··—ÃÊ⁄ œ«Œ· «·„—ﬂ»…° Ê≈·« ”Ê› Ì›‘· «·«Œ »«—." ) ;
	}
	if(GetPlayerVehicleSeat(playerid) == 0)
	{
	    new engine,lights,alarm,doors,bonnet,boot,objective;
	    GetVehicleParamsEx ( vehicleid, engine, lights, alarm, doors, bonnet, boot, objective ) ;
		SetVehicleParamsEx ( vehicleid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective ) ;
	}
	if ( GetPVarInt ( playerid, "exam_vehicle" ) > 0 )
	{
		SetPVarInt ( playerid, "leaved_ex_vehicle", GetPVarInt ( playerid, "exam_vehicle" )  ) ;
		is_leave_exam_vehicle { playerid } = 15 ;
		SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}⁄‰œﬂ {"#cRD"}15 ÀÊ«‰Ì{"#cGR"} ··—ÃÊ⁄ œ«Œ· «·„—ﬂ»…° Ê≈·« ”Ê› Ì›‘· «·«Œ »«—." ) ;
		GameTextForPlayer ( playerid, "~r~15", 5000, 6 ) ;
	}
	//hhh
	if((GetPVarInt ( playerid, "PlayerTied")) ||(GetPVarInt ( playerid, "PlayerCuffed")))
	{
	    new seatid = GetVehicleFreeSeat ( veh_id ) ;
		if ( seatid != - 1 )
		{
			AC_PutPlayerInVehicle ( playerid, veh_id, seatid ) ;
			SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"„«  ﬁœ— «›⁄· ÂÊ ⁄‰œ ·ÕŸ…!." ) ;
		}
		else SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ›Ì „ﬁ«⁄œ ›«÷Ì… ›Ì √ﬁ—» „—ﬂ»… ‰ﬁ·." ) ;
	}
	
	if ( p_info [ playerid ] [ job ] == job_taxi && player_rentcar [ playerid ] != INVALID_VEHICLE_ID && (veh_info [ player_rentcar [ playerid ] - 1 ] [ v_type ] == vehicle_type_job || veh_info [ player_rentcar [ playerid ] - 1 ] [ v_owner ] == job_taxi) )
	{
	    taxi_td_status(playerid, false);
	}
	else if ( p_info [ playerid ] [ job ] == job_mechanic && player_rentcar [ playerid ] != INVALID_VEHICLE_ID && (veh_info [ player_rentcar [ playerid ] - 1 ] [ v_type ] == vehicle_type_job || veh_info [ player_rentcar [ playerid ] - 1 ] [ v_owner ] == job_mechanic) )
	{
	    taxi_td_status(playerid, false);
	}
	player_vehicle[ playerid ] = INVALID_VEHICLE_ID;
	speedometr_status ( playerid, false ) ;
	KillTimer ( speed_timer [ playerid ] ) ;
	speed_timer [ playerid ] = - 1 ;
	veh_info [ vehicleid] [ v_driver ] = INVALID_PLAYER_ID ;
	return 1;
}

public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
	// Havana RP: quest pickup handled first so it is not blocked by teleport cooldown or open dialogs.
	for ( new qj = 0 ; qj < MAX_QUEST_ACTORS ; qj ++ )
	{
		if ( pickupid == g_quest_pickup [ qj ] )
		{
			if ( GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT ) return 1 ;
			if ( ! IsPlayerInRangeOfPoint ( playerid, 3.0, quest_actor [ qj ] [ actor_pos ] [ 0 ], quest_actor [ qj ] [ actor_pos ] [ 1 ], quest_actor [ qj ] [ actor_pos ] [ 2 ] ) ) return 1 ;
			if ( g_quest_menu_lock [ playerid ] ) return 1 ;
			g_quest_menu_lock [ playerid ] = true ;
			SetTimerEx("Quest_OpenMenuDeferred", 60, false, "d", playerid);
			return 1 ;
		}
	}
	// 24/7 buy pickup: handle before global teleport cooldown so the dialog
	// can be re-opened without the 5s lockout, and without consuming
	// tp_area_used (it is not a teleport).
	if ( pick_info [ pickupid ] [ pick_type ] == pick_type_b247_buy )
	{
		if ( p_t_info [ playerid ] [ p_dialog ] != -1 ) return 1 ;
		new _bb247 = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
		if ( _bb247 < 0 ) return 1 ;
		if ( b_info [ _bb247 ] [ b_type ] != bizz_type_shop ) return 1 ;
		ShowShopDialog ( playerid ) ;
		return 1 ;
	}
	// [CLOTHES SHOP] Buy-skin pickup: open shop menu (SAMP list dialog).
	if ( pick_info [ pickupid ] [ pick_type ] == pick_type_clothes_buy )
	{
		if ( p_t_info [ playerid ] [ p_dialog ] != -1 ) return 1 ;
		if ( GetPVarInt ( playerid, "cl_active" ) ) return 1 ;
		new _bcl = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
		if ( _bcl < 0 ) return 1 ;
		if ( b_info [ _bcl ] [ b_type ] != bizz_type_clothes ) return 1 ;
		show_dialog ( playerid, d_clothes_buy_menu, DIALOG_STYLE_LIST, "{"#cBL"}„ Ã— «·„·«»”", "{"#cWH"}‘—«¡ „·«»”\n{"#cWH"}‘—«¡ «ﬂ””Ê«—« ", "«Œ —", "≈€·«ﬁ" ) ;
		return 1 ;
	}
	if ( pick_info [ pickupid ] [ pick_type ] == pick_type_craft_table )
	{
		// Type-23 dynamic pickups fire repeatedly while standing on them; we
		// gate the menu open behind a per-player lock so the overlay only
		// opens once. The lock is auto-released when the player walks away
		// (see CraftTable_SessionTick) or closes the menu.
		if ( GetPVarInt ( playerid, "craft_in_session" ) ) return 1 ;
		if ( GetPVarInt ( playerid, "craft_pending" ) )    return 1 ;
		new __ch = -1 ;
		for ( new __ci = 0 ; __ci < house_count ; __ci ++ )
		{
			if ( h_info [ __ci ] [ h_craft_pickup ] == pickupid )
			{
				__ch = __ci ;
				break ;
			}
		}
		SetPVarInt ( playerid, "craft_in_session", 1 ) ;
		SetPVarInt ( playerid, "craft_session_pickup", pickupid ) ;
		SetPVarInt ( playerid, "craft_session_house",  __ch + 1 ) ;
