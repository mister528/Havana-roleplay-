CMD:setvip(playerid,params[])
{
	if ( p_info [ playerid ] [ admin ] < 8 ) return 1;
	//if(p_info[playerid][id] != 1 ) return true;
	if ( sscanf ( params, "udd", params [ 0 ], params [ 1 ], params [ 2 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /setvip [ID] [„” ÊÏ] [«·Êﬁ ]" ) ;
	if ( !IsPlayerConnected ( params [ 0 ] )  ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
	if ( params[1] > 1 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}— »… VIP ·«“„  ﬂÊ‰ 0 √Ê 1." ) ;
	if ( params[1] < 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}— »… VIP ·«“„  ﬂÊ‰ 0 √Ê 1." ) ;
	p_info [ params [ 0 ] ] [ vip ] = params[1] ;
	p_info [ params [ 0 ] ] [ vip_time ] = params[2] ;
	update_int_sql ( params [ 0 ], "u_vip", p_info [ params [ 0 ] ] [ vip ] ) ;
	update_int_sql ( params [ 0 ], "u_vip_time", p_info [ params [ 0 ] ] [ vip_time ] ) ;
	new formatcc[228];
	format(formatcc, sizeof(formatcc), "* ≈œ«—Ì %s[%d] √⁄ÿÏ «··«⁄» %s[%d]  VIP — »… «·„” ÊÏ %d ·‹ %d ÌÊ„",p_info[playerid][name],playerid, p_info[params[0]][name], params[0], params[1], params[2]);
	SendAdmMessage(col_gray,formatcc);
	new format1[228];
	format(format1, sizeof(format1), "* ≈œ«—Ì %s[%d] √⁄ÿÏ √‰   VIP — »… «·„” ÊÏ %d ·‹ %d ÌÊ„",p_info[playerid][name],playerid, params[1], params[2]);
	SendClientMessage(params[0], col_gray,format1);
	return 1;
}
