					format ( _query, 72, "~n~~n~~n~~n~~g~+1 ~w~«·„Â«—«  »‰œﬁÌ… ~n~ﬂ·: ~g~ %i/100", p_info [ playerid ] [ gun_skills ] [ 6 ] ) ;
					GameTextForPlayer ( playerid, _query, 2000, 5 ) ;

					format ( _query, sizeof ( _query ), "UPDATE `users` SET `u_skills`='%d|%d|%d|%d|%d|%d|%d' WHERE `u_name` = '%s'",
					p_info [ playerid ] [ gun_skills ] [ 0 ], p_info [ playerid ] [ gun_skills ] [ 1 ], p_info [ playerid ] [ gun_skills ] [ 2 ],
					p_info [ playerid ] [ gun_skills ] [ 3 ], p_info [ playerid ] [ gun_skills ] [ 4 ], p_info [ playerid ] [ gun_skills ] [ 5 ],
					p_info [ playerid ] [ gun_skills ] [ 6 ], p_info [ playerid ] [ name ] ) ;
					mysql_tquery ( sql_connection, _query ) ;
					SetPlayerSkills ( playerid ) ;
				}
			}
		}
	}

	// === [HAVANA] 24/7 SHOP ROBBERY TRIGGER ===
	{
		new _ribx = Rob247_FindShopByVW(GetPlayerVirtualWorld(playerid));
		if (_ribx != -1 && weaponid >= 22 && weaponid <= 38)
		{
			if (Rob247_PreCheck(playerid))
			{
				if (g_rob247_state[_ribx] == 0) Rob247_Start(playerid, _ribx);
				else SendClientMessage(playerid, 0xFFAA55FF, "{FFAA55}* {FFFFFF}Â–« «·„ Ã—  „ ”—ﬁ Â „ƒŒ—«.");
			}
		}
	}

	return 1 ;
}

public OnUnoccupiedVehicleUpdate ( vehicleid, playerid, passenger_seat, Float:new_x, Float:new_y, Float:new_z, Float:vel_x, Float:vel_y, Float:vel_z )
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnUnoccupiedVehicleUpdate] vehicleid:%d | playerid:%d | passenger_seat:%d", vehicleid, playerid, passenger_seat ) ;
	#endif
	ac_OOnUnoccupiedVehicleUpdate ( vehicleid, playerid, passenger_seat, new_x, new_y, new_z, vel_x, vel_y, vel_z) ;


	if(passenger_seat)
	{
		p_t_info [ playerid ] [ last_unoccup_tick ] = GetTickCount ( ) ;
		return 0;
	}

	static Float: __z ;
	GetVehiclePos ( vehicleid, __z, __z, __z ) ;
	
	veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 0 ] = new_x;
    veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 1 ] = new_y;
    veh_info [ vehicleid - 1 ] [ v_now_pos ] [ 2 ] = new_z;


    veh_info [ vehicleid - 1 ] [ v_velocity ] [ 0 ] = vel_x;
    veh_info [ vehicleid - 1 ] [ v_velocity ] [ 1 ] = vel_y;

	if(GetVehicleDistanceFromPoint(vehicleid,new_x, new_y, new_z) < 0.0) return 0;
	GetVehiclePos(vehicleid, new_x, new_y, new_z);
	if(!IsPlayerInRangeOfPoint(playerid, 10, new_x, new_y, new_z)) return 0;

	if ( GetVehicleDistanceFromPoint ( vehicleid, new_x, new_y, new_z ) > 15.0 )
	{
		new Float:pos_x, Float:pos_y, Float:pos_z;
		GetVehiclePos(vehicleid, pos_x, pos_y, pos_z);
		if(pos_z > -70.0) AC_SetVehiclePos(vehicleid, pos_x, pos_y, pos_z ) ;
		return 0;
 	}
	return 1 ;
}
public OnPlayerClickPlayerTextDraw ( playerid, PlayerText:playertextid )
{
	if ( p_t_info [ playerid ] [ p_dialog ] != -1 ) return 1 ;
	if ( playertextid == dice_ptd [ playerid ] [ 18 ] ) return show_dialog ( playerid, d_dice_exit,DIALOG_STYLE_MSGBOX,"{"#cBL"}  Õ–Ì—","{ffffff}≈–« ÕÿÌ  —Â«‰ Ê«··⁄»… »œ√  »«·›⁄·° ›·Ê”ﬂ „« —«Õ  —Ã⁄ ·ﬂ\n\n{"#cGR"}* „ √ﬂœ  »Ì Œ—ÊÃ  «·ÿ«Ê·…?", "Œ—ÊÃ", "≈·€«¡" ) ;
	else if(playertextid == dice_ptd [ playerid ] [ 14 ])
	{
		if(GetPVarInt(playerid,"Krupje"))
		{
			new null = 0;
			for(new i; i < 5; i++) if ( GetPVarInt ( dice_info [ GetPVarInt ( playerid,"Stol" ) - 1 ] [ b_player ] [ i ],"InGame" ) ) null++ ;
			if(null > 0) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  €Ì¯— «·—Â«‰ «·ÕÌ‰." ) ;
			return show_dialog(playerid,d_dice_bet,1,"{"#cBL"}Õÿ —Â«‰ ··⁄»…","{ffffff}√œŒ· «·„»·€ ··—Â«‰\n\n{"#cGR"}* «·—Â«‰ ·«“„ ÌﬂÊ‰ ⁄·Ï «·√ﬁ· $1000 Ê„« Ì Ã«Ê“ $30.000.000","«· «·Ì","≈·€«¡");
		}
		if(!dice_info[GetPVarInt(playerid,"Stol")-1][b_bet]) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}«·—Â«‰ „Ê „ÕÿÊÿ." ) ;
		if(GetPVarInt(playerid,"InGame")) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}—«Â‰  ﬁ»·." ) ;
		if(p_info [ playerid ] [ money ] < dice_info[GetPVarInt(playerid,"Stol")-1][b_bet]) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}›·Ê” €Ì— ﬂ«›Ì… .");
		if(dice_info[GetPVarInt(playerid,"Stol")-1][b_started] > 0) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}·⁄»… ”»ﬁ Ê »œ√." ) ;
		give_money(playerid,-dice_info[GetPVarInt(playerid,"Stol")-1][b_bet]);
		insert_money_log ( playerid, INVALID_PLAYER_ID, -dice_info[GetPVarInt(playerid,"Stol")-1][b_bet], "Bones bet" ) ;

		dice_info[GetPVarInt(playerid,"Stol")-1][b_bank] += dice_info[GetPVarInt(playerid,"Stol")-1][b_bet];
		SetPVarInt(playerid,"InGame",1);
		UpdateBone(GetPVarInt(playerid,"Stol")-1);
		
	/*	new b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
		b_info [ b ] [ b_product ] -= 5 ;
		b_info [ b ] [ b_money ] += floatround(dice_info[GetPVarInt(playerid,"Stol")-1][b_bet]/50) ;
		b_info [ b ] [ b_cash_today ] += floatround(dice_info[GetPVarInt(playerid,"Stol")-1][b_bet]/50) ;*/
	}
	else if(playertextid == Passport_PTD[playerid][25])
	{
		for(new i = 0; i < 39; i++)
		{
		    PlayerTextDrawDestroy(playerid, Passport_PTD[playerid][i]);
		    Passport_PTD [ playerid ] [ i ] = PlayerText:-1 ;

			if(i < 6) TextDrawHideForPlayer(playerid, Passport_TD[i]);
		}
		CancelSelectTextDraw(playerid);

		DeletePVar(playerid, "show_pass");
	}
	else if(playertextid == dice_ptd [ playerid ] [ 15 ])
	{
		if(GetPVarInt(playerid,"Krupje"))
		{
			new null = 0;
			for(new i; i < 5; i++) if(GetPVarInt(dice_info[GetPVarInt(playerid,"Stol")-1][ b_player ][i],"InGame")) null++;
			if(null < 2) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}„« ›Ì ·«⁄»Ì‰ ﬂ«›ÌÌ‰ ··»œ«Ì…." ) ;
			if(dice_info[GetPVarInt(playerid,"Stol")-1][b_started] > 0) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"} «··⁄»… ‘€¯«·… »«·›⁄·." ) ;
			return dice_info[GetPVarInt(playerid,"Stol")-1][b_started] = 30;
		}
		else
		{
			if(!GetPVarInt(playerid,"InGame")) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"„« ÕÿÌ  —Â«‰." ) ;
			if(dice_info[GetPVarInt(playerid,"Stol")-1][b_started] <= 0) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  Œ—Ã „‰ Bonest «·ÕÌ‰.");
			if(GetPVarInt(playerid,"InGame") > 1) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}ﬂ‰  ÕÿÌ  „ﬂ⁄»«  ›Ì Â–« «·ÃÊ·…." ) ;
			new null = 0;
			SetPVarInt(playerid,"InGame",random(11) + 2);
			UpdateBone(GetPVarInt(playerid,"Stol")-1);
			foreach ( new i:logged_players)
			{
				if(GetPVarInt(i,"Stol") == GetPVarInt(playerid,"Stol") && GetPVarInt(i,"InGame") == 1) null++;
			}
			if(!null) dice_info[GetPVarInt(playerid,"Stol")-1][b_started] = 4;
		}
	}
	
	if ( playertextid == ptd_policecam [ playerid ] [ 25 ] ) // Camera selection in PD (State Tracking) (Back)
	{
		new camid = GetPVarInt ( playerid, "police_camid" ) ;
		if ( camid == 0 ) camid = 11 ;
		else camid-- ;
		return show_cams ( playerid, camid ) ;
	}
	else if ( playertextid == ptd_policecam [ playerid ] [ 26 ] ) // (Forward)
	{
		new camid = GetPVarInt ( playerid, "police_camid" ) ;
		if ( camid == 11 ) camid = 0 ;
		else camid++ ;
		return show_cams ( playerid, camid ) ;
	}
	else if ( playertextid == ptd_policecam [ playerid ] [ 20 ] )
	{
		pdcam_status ( playerid, false ) ;
		CancelSelectTextDraw ( playerid ) ;
		return 1 ;
 	}

	
	for(new i = 0; i < 9; i++)
	{
		if(playertextid == SecurityCode[playerid][i])
		{
			PlayerPlaySound(playerid, 17803, 0.0, 0.0, 0.0);
			if(GetPVarInt(playerid, "NumberDigits") == 0) return p_info[playerid][input_code] += 1000 * (mass_pass[playerid][i]), SetPVarInt(playerid, "NumberDigits", GetPVarInt(playerid, "NumberDigits") + 1);
			else if(GetPVarInt(playerid, "NumberDigits") == 1) return p_info[playerid][input_code] += 100 * (mass_pass[playerid][i]), SetPVarInt(playerid, "NumberDigits", GetPVarInt(playerid, "NumberDigits") + 1);
			else if(GetPVarInt(playerid, "NumberDigits") == 2) return p_info[playerid][input_code] += 10 * (mass_pass[playerid][i]), SetPVarInt(playerid, "NumberDigits", GetPVarInt(playerid, "NumberDigits") + 1);
			else if(GetPVarInt(playerid, "NumberDigits") == 3)
			{
				p_info[playerid][input_code] += 1 * (mass_pass[playerid][i]), SetPVarInt(playerid, "NumberDigits", 0);
				if(p_info[playerid][input_code] == p_info [ playerid ] [ graph_code ] [ 1 ] )
				{
					if ( p_info [ playerid ] [ google_auth_status ] == 1 )
					{
						google_checking { playerid } = 1 ;
						show_dialog ( playerid, d_googleauth_entrance, DIALOG_STYLE_INPUT, "{"#cBL"} „’«œﬁ… ﬁÊﬁ·", "{"#cWH"}√œŒ· «·ﬂÊœ „‰ «· ÿ»Ìﬁ:", "œŒÊ·", "Œ—ÊÃ" );
					}
					else
					{
                        SendClientMessage ( playerid, col_blue, " „  ”ÃÌ· œŒÊ·ﬂ »‰Ã«Õ!" ) ;
                        AC_TogglePlayerSpectating ( playerid, false ) ;
                        
                        new sql_string [ 158 ] ;
						format ( sql_string, sizeof sql_string, "SELECT * FROM `debtor_message` WHERE `dm_dest` = '%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
						mysql_tquery ( sql_connection, sql_string, "load_debtor_messages", "i", playerid ) ;
						DestroyActor(PlayerBot[playerid]);
						
						if(p_info[playerid][load_textures] == 1) ShowPlayerLoadScreen ( playerid, 4 ) ;
						else
						{
							TogglePlayerControllable(playerid,0);
							SetTimerEx("Load_Texture_Off", 2500, false, "d", playerid);
						}
					}
				}
				else kick_player ( playerid ) ;
				for(new f = 0; f < 10; f++) PlayerTextDrawHide(playerid, SecurityCode[playerid][f]);
				for(new f = 0; f < 10; f++) PlayerTextDrawDestroy(playerid, SecurityCode[playerid][f]);
				p_info[playerid][input_code] = -1;
				CancelSelectTextDraw(playerid);
			}
		}
	}
	return 1 ;
}

public OnPlayerClickTextDraw ( playerid, Text:clickedid )
{

	if ( reg_info [ playerid ] [ reg_national ] != 0 )
	{
		if ( ! ( _:clickedid ^ 0xFFFF ) )return SelectTextDraw ( playerid, 0xB0C4DEFF ) ;
	}
	if(GetPVarInt ( playerid, "Autorization" ) == 1)
	{
 	    SelectTextDraw( playerid, 0xB0C4DEFF ) ;
 	}

	/*- */
	
	if ( clickedid == admin_panel [ 10 ] )
	{
	    new string [ 4 ] ;
	    format ( string, sizeof string, "%d", p_t_info [ playerid ] [ sp_admin ] ) ;
		pc_cmd_sp(playerid, string);
		return 1;
 	}
 	
	if ( clickedid == admin_panel [ 19 ] )
	{
	    pc_cmd_spoff ( playerid ) ;
	}
	
	if ( clickedid == admin_panel [ 16 ] )
	{
	    new string [ 4 ] ;
	    
	    p_t_info [ playerid ] [ sp_admin ] += 1;
	    
	    format ( string, sizeof string, "%d", p_t_info [ playerid ] [ sp_admin ] ) ;
