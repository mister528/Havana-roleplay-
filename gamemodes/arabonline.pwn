CMD:getdrugs(playerid,params[])
{
	if ( b_info [ 141 ] [ b_mafia ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ’·«ÕÌ… ≈·Ï «·„“—⁄…." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 8.0, -1059.7736, -1169.2307, 129.2188 ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}√‰  „Ê ﬁ—Ì»  ÕŸÌ—…." ) ;
	if(sscanf(params, "d",params[0])) return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}«·«” Œœ«„: /getdrugs [«·⁄œœ („‰ 1 ≈·Ï 500)]");
 	if(params[0] > 500 || params[0] == 0 || AmbarDrugs < params[0] ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}Õ—Ê› €Ì— ’«·Õ… „œŒ·….");
	if(p_info [ playerid ] [ drugs ] + params[0] > 500) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ—  ﬂÊ‰ ⁄‰œﬂ √ﬂÀ— „‰ 500 Ã—«„.");

	p_info [ playerid ] [ drugs ] += params[0] ;
	update_int_sql ( playerid, "u_drugs", p_info [ playerid ] [ drugs ] ) ;

	global_string [ 0 ] = EOS ;

	AmbarDrugs -= params[0];
	format(global_string, 78, "{"#cGN"}* {"#cWH"}√‰  √Œ– {"#cGN"}%d{"#cWH"} grams „‰ «·„Œœ—« .", params[0]);
	SendClientMessage(playerid, col_white, global_string);
	format(global_string, 96, "ÕŸÌ—…\n{"#cGR"}«·„»·€ „‰ «·„Œœ—« : {"#cWH"}%d gr.\n{"#cGN"}/getdrugs - Œ– «·„Œœ—« ", AmbarDrugs);
	UpdateDynamic3DTextLabelText(TextWarehouseAmbar, col_blue, global_string);
	return 1;
}

