	if ( p_info [ playerid ] [ admin ] < 3 ) return 1;
	if ( sscanf ( params, "dd", params [ 0 ], params [ 1 ] ) ) return SendClientMessage(playerid,-1,"{"#cRD"}*{"#cGR"} ÿ—Ìﬁ… «·«” Œœ«„: /pveh [ID «··«⁄»] [ID «·”Ì«—…]");

