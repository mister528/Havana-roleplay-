// Havana RP: 24/7 Shop TextDraw UI
#define SHOP247_TD_COUNT 23
new PlayerText:g_shop247_td[MAX_PLAYERS][SHOP247_TD_COUNT];
new Text:g_shop247_hit[17] = {Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW,Text:INVALID_TEXT_DRAW};
stock ShopTD_InitGlobalHitboxes()
{
	// 15 item row hitboxes (y=131+i*17, x=180..460, height ~16)
	for (new i = 0; i < 15; i++) {
		new Float:hy = 131.0 + float(i) * 17.0;
		g_shop247_hit[i] = TextDrawCreate(180.0, hy, "_");
		TextDrawFont(g_shop247_hit[i], 1);
		TextDrawLetterSize(g_shop247_hit[i], 0.0, 1.3);
		TextDrawTextSize(g_shop247_hit[i], 460.0, 0.0);
		TextDrawUseBox(g_shop247_hit[i], 1);
		TextDrawBoxColor(g_shop247_hit[i], 0x00000001);
		TextDrawColor(g_shop247_hit[i], 0x00000000);
		TextDrawBackgroundColor(g_shop247_hit[i], 0x00000000);
		TextDrawSetSelectable(g_shop247_hit[i], 1);
	}
	// [15] BUY hitbox
	g_shop247_hit[15] = TextDrawCreate(188.0, 372.0, "_");
	TextDrawFont(g_shop247_hit[15], 1);
	TextDrawLetterSize(g_shop247_hit[15], 0.0, 2.2);
	TextDrawTextSize(g_shop247_hit[15], 318.0, 0.0);
	TextDrawUseBox(g_shop247_hit[15], 1);
	TextDrawBoxColor(g_shop247_hit[15], 0x00000001);
	TextDrawColor(g_shop247_hit[15], 0x00000000);
	TextDrawBackgroundColor(g_shop247_hit[15], 0x00000000);
	TextDrawSetSelectable(g_shop247_hit[15], 1);
	// [16] CLOSE hitbox
	g_shop247_hit[16] = TextDrawCreate(328.0, 372.0, "_");
	TextDrawFont(g_shop247_hit[16], 1);
	TextDrawLetterSize(g_shop247_hit[16], 0.0, 2.2);
	TextDrawTextSize(g_shop247_hit[16], 458.0, 0.0);
	TextDrawUseBox(g_shop247_hit[16], 1);
	TextDrawBoxColor(g_shop247_hit[16], 0x00000001);
	TextDrawColor(g_shop247_hit[16], 0x00000000);
	TextDrawBackgroundColor(g_shop247_hit[16], 0x00000000);
	TextDrawSetSelectable(g_shop247_hit[16], 1);
	printf("[SHOP_DBG] InitGlobalHitboxes done");
	return 1;
}
new g_shop247_sel[MAX_PLAYERS];
new bool:g_shop247_open[MAX_PLAYERS];
new const shop247_td_names[15][24] = {
	{"Mobile phone"},{"Number change"},{"Directory"},{"Health kit"},
	{"Repair kit"},{"GPS"},{"Mask"},{"Rope"},{"Flowers"},{"Home aid kit"},
	{"Camera"},{"Spray paint"},{"Radio"},{"Turning tools"},{"„› «Õ ”—ﬁ…"}
};
forward ShopTD_DoBuy(playerid, sel);
forward ShopTD_EnableCursor(playerid);
stock HideShopTD(playerid)
{
	if (!g_shop247_open[playerid]) return 0;
	g_shop247_open[playerid] = false;
	g_shop247_sel[playerid] = -1;
	for (new gi = 0; gi < 17; gi++) TextDrawHideForPlayer(playerid, g_shop247_hit[gi]);
	CancelSelectTextDraw(playerid);
	for (new i = 0; i < SHOP247_TD_COUNT; i++) {
		PlayerTextDrawHide(playerid, g_shop247_td[playerid][i]);
		PlayerTextDrawDestroy(playerid, g_shop247_td[playerid][i]);
	}
	return 1;
}
public ShopTD_EnableCursor(playerid)
{
	if (g_shop247_open[playerid]) {
		SelectTextDraw(playerid, 0xFFFF00FF);
		printf("[SHOP_DBG] cursor enabled for pid=%d", playerid);
	}
	return 1;
}
stock Shop247_MakeRow(playerid, idx, Float:y, text[], boxcol, selectable)
{
	g_shop247_td[playerid][idx] = CreatePlayerTextDraw(playerid, 180.0, y, text);
	PlayerTextDrawAlignment(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawFont(playerid, g_shop247_td[playerid][idx], 2);
	PlayerTextDrawLetterSize(playerid, g_shop247_td[playerid][idx], 0.26, 1.25);
	PlayerTextDrawTextSize(playerid, g_shop247_td[playerid][idx], 460.0, 15.5);
	PlayerTextDrawColor(playerid, g_shop247_td[playerid][idx], 0xFFFFFFFF);
	PlayerTextDrawSetOutline(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawSetProportional(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawSetShadow(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawUseBox(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawBoxColor(playerid, g_shop247_td[playerid][idx], boxcol);
	PlayerTextDrawSetSelectable(playerid, g_shop247_td[playerid][idx], selectable);
	PlayerTextDrawShow(playerid, g_shop247_td[playerid][idx]);
	return 1;
}
stock Shop247_MakeButton(playerid, idx, Float:x, Float:y, Float:xto, text[], boxcol)
{
	g_shop247_td[playerid][idx] = CreatePlayerTextDraw(playerid, x, y, text);
