CMD:ffixcar ( playerid )
{
    if ( ! p_info [ playerid ] [ leader ] ) return 1 ;
	if ( f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_money ] < 100 )
	{
		SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ›ÌÂ —’Ìœ ﬂ«›Ì ›Ì »‰ﬂ «·„‰Ÿ„…." ) ;

		format ( global_string, sizeof ( global_string ), "{"#cWH"}”Õ» ﬂ· «·”Ì«—«  {"#cGN"}100$\n" ) ;
		new veh_point = 0 ;
		for ( new vehicleid = 0 ; vehicleid < vehicle_count ; vehicleid ++ )
		{
			if ( ! IsValidVehicle ( vehicleid + 1 ) ) continue ;
			if ( veh_info [ vehicleid ] [ v_type ] != vehicle_type_server || veh_info [ vehicleid ] [ v_owner ] != p_info [ playerid ] [ member ] ) continue ;

			veh_point ++ ;
			new line_string [ 62 ] ;
			format ( line_string, sizeof ( line_string ), "{"#cWH"}%d. %s {"#cGN"}300$\n", veh_point, vehicle_name [ veh_info [ vehicleid ] [ v_model ] - 400 ] ) ;
			strcat ( global_string, line_string ) ;
			show_dialog ( playerid, d_lmenu_fixcar, DIALOG_STYLE_LIST, "{"#cBL"}≈œ«—… «·√”ÿÊ·", global_string, "«Œ —", "—ÃÊ⁄" ) ;
		}
	}
	for ( new vehicleid = 0 ; vehicleid < vehicle_count ; vehicleid ++ )
	{
		if ( ! IsValidVehicle ( vehicleid + 1 ) ) continue ;
		if ( veh_info [ vehicleid ] [ v_type ] != vehicle_type_server || veh_info [ vehicleid ] [ v_owner ] != p_info [ playerid ] [ member ] ) continue ;
		if ( is_vehicle_occupied ( vehicleid + 1 ) != -1) continue ;

		AC_SetVehicleToRespawn ( vehicleid + 1 ) ;
	}
	return 1;
}

