			mysql_tquery ( sql_connection, query_string, "ticket_list_callback", "i", playerid ) ;
			return 1 ;
		}
		give_money ( playerid, - ticket_count ) ;
		new pvar_string [ 8 ],
			ticket_id,
			query_string [ 82 ] ;


		format ( pvar_string, sizeof ( pvar_string ), "tlc_%d", GetPVarInt ( playerid, "ticket_listitem" ) ) ;
