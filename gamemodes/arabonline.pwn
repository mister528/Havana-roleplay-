    if(p_info[params[0]][id] == 1) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— Õ–›  «·ﬁ«∆œ „‰ «·”Ã‰." ) ;


	new scm_string [ 144 ] ;
	format ( scm_string, sizeof scm_string, "{"#cBL"}* {"#cGR"} %s  %s     \"{"#cWH"}%s{"#cGR"}\"", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], f_info [ p_info [ params [ 0 ] ] [ member ] - 1 ] [ f_name ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_gray, scm_string ) ;
	format ( scm_string, sizeof scm_string, " %s       \"%s\"", p_info [ playerid ] [ name ], f_info [ p_info [ params [ 0 ] ] [ member ] - 1 ] [ f_name ] ) ;
	SendClientMessage ( params [ 0 ], col_yellow, scm_string ) ;

	new query_string [ 268 ];

	if ( p_info [ params [ 0 ] ] [ admin ] < 1 )
	{
		format ( f_info [ p_info [ params [ 0 ] ] [ member ] - 1 ] [ f_leader_name ], MAX_PLAYER_NAME, "·« ÌÊÃœ" ) ;
		format ( query_string, 100, "UPDATE `fractions` SET `f_leader_name` = '%s' WHERE `f_id` = '%d' LIMIT 1",
		f_info [ p_info [ params [ 0 ] ] [ member ]  - 1 ] [ f_leader_name ], p_info [ params [ 0 ] ] [ member ] ) ;
		mysql_tquery ( sql_connection, query_string, "", "" ) ;
	}
	mysql_format ( sql_connection, query_string,sizeof(query_string),
	"INSERT INTO `users_jobinfo` (`ji_uid`,`ji_date_invite`,`ji_date_uninvite`,`ji_reason`,`ji_fraction`,`ji_fwarnings` ) SELECT `u_id`, `u_fraction_date`, NOW(), '/','%d','0' FROM `users` WHERE `u_id` = '%d'",
	p_info [ params [ 0 ] ] [ member ], p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;

    format ( scm_string, sizeof ( scm_string  ), "DELETE FROM `f_warns` WHERE `f_name`='%s' LIMIT 3", p_info [ params [ 0 ] ] [ name ] ) ;
	mysql_query ( sql_connection, scm_string ) ;

	p_info [ params [ 0 ] ] [ member ] = 0 ;
	p_info [ params [ 0 ] ] [ leader ] = 0 ;
	p_info [ params [ 0 ] ] [ rank ] = 0 ;
	p_info [ params [ 0 ] ] [ spawnchange ] = 0 ;
	update_int_sql ( params [ 0 ], "u_spawnchange", p_info [ params [ 0 ] ] [ spawnchange ] ) ;
	
	if ( is_fraction_duty { params [ 0 ] } == 1 ) is_fraction_duty { params [ 0 ] } = 0 ;

	format ( query_string, 138, "UPDATE `users` SET `u_member` = '0', `u_leader` = '0',\
	`u_rank` = '0'	WHERE `u_id` = '%d' LIMIT 1",
	p_info [ params [ 0 ] ] [ id ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;


	SetPlayerSkin ( params [ 0 ], p_info [ params [ 0 ] ] [ skin ] ) ;
	SetPlayerColor ( params [ 0 ], 0xFFFFFF80 ) ; // col_white
	return 1;
}

CMD:asellhouse(playerid, params[])
{
	if(p_info[playerid][admin] < 8) return true;

	new house_id, isMsg;
	if(sscanf(params, "dD(1)", house_id, isMsg)) return SendClientMessage(playerid, col_white, !"«·«” Œœ«„: /asellhouse [ID «·»Ì ]");

	if(!(0 < house_id < house_count))
		return SendClientMessage(playerid, col_gray, !"—ﬁ„ «·»Ì  €Ì— ’ÕÌÕ");

	new s_house_id = house_id - 1;

	if(h_info[s_house_id][h_owner] == -1)
		return SendClientMessage(playerid, col_gray, !"Â–« «·»Ì  „Ê ·√Õœ");

	new h_owner_id = GetPlayerID(h_info[s_house_id][h_owner_name]);

	if(IsPlayerConnected(h_owner_id))
	{
		p_info[h_owner_id][house] = -1;
		update_int_sql(h_owner_id, "u_house", p_info[h_owner_id][house]);

		p_info[h_owner_id][spawnchange] = 0;
		update_int_sql(h_owner_id, "u_spawnchange", p_info[h_owner_id][spawnchange]);

		SendClientMessage(h_owner_id, col_light_red, !" ≈œ«—Ì ·„« »«⁄ Õﬁﬂ «·Œ«’ ›Ì «·»Ì ");
	}
	else
	{
		new query_string[91];
		format(query_string,sizeof(query_string),"UPDATE `users` SET `u_house` = '-1', `u_spawnchange` = '-1' WHERE `u_id` = '%d' LIMIT 1", h_info[s_house_id][h_owner]);
		mysql_tquery(sql_connection, query_string, "", "");
	}

	format(h_info[s_house_id][h_owner_name], 36, "«·œÊ·…");
	h_info[s_house_id][h_owner] = -1;
	h_info[s_house_id][h_closed] = 0;
	DestroyDynamicPickup(h_info[s_house_id][h_pickup]);
	if(! h_info[s_house_id][h_vw])DestroyDynamicMapIcon(h_info[s_house_id][h_icon_id]);
	h_info[s_house_id][h_pickup] = CreateDynamicPickup(1273, 23, h_info[s_house_id][h_pos][0], h_info[s_house_id][h_pos][1], h_info[s_house_id][h_pos][2], h_info[s_house_id][h_vw], -1);
	if(! h_info[s_house_id][h_vw])h_info[s_house_id][h_icon_id] = CreateDynamicMapIcon(h_info[s_house_id][h_pos][0], h_info[s_house_id][h_pos][1], h_info[s_house_id][h_pos][2], 31, 0, 0, 0, -1, 30.0);

	save_house(s_house_id);

	new data[48], query[128];
	for(new i;i<8;i++)
	{
		h_info[s_house_id][h_improve][i] = 0;
		if(!i)format(data, sizeof(data),"%d", h_info[s_house_id][h_improve][i]);
		else format(data, sizeof(data),"%s|%d", data, h_info[s_house_id][h_improve][i]);
	}
	format(query,sizeof(query),"UPDATE `houses` SET `h_improve` = '%s' WHERE `h_id` = '%d'", data, house_id);
	mysql_tquery(sql_connection, query);

    h_info[s_house_id][h_safe_code] = 0;
 	format(query, sizeof query, "UPDATE `houses` SET `h_safe_code` = '0000' WHERE `h_id` = '%d' LIMIT 1",h_info[s_house_id][h_id]);
	mysql_tquery(sql_connection, query);

	if(isMsg == 1) SendClientMessage(playerid, col_white, " «·⁄ﬁ«—  „ »Ì⁄Â »‰Ã«Õ ··œÊ·….");
	return 1;
}

CMD:asellbiz(playerid, params[])
{
	if(p_info[playerid][admin] < 8) return true;

	new b, isMsg;
	if(sscanf(params, "dD(1)", b, isMsg)) return SendClientMessage(playerid, col_white, !"«·«” Œœ«„: /asellbiz [ID «·„Õ·]");

	if(!(0 < b < b_count))
	{
		printf("%d", b);
		return SendClientMessage(playerid, col_gray, !"—ﬁ„ «·„Õ· €Ì— ’ÕÌÕ");
	}

	new b_owner = GetPlayerID(b_info[b-1][b_owner_name]);

	if(b_info[b-1][b_owner_inc] == -1)
		return SendClientMessage(playerid, col_gray, !"Â–« «·„Õ· „« ÂÊ „„·Êﬂ „‰ √Õœ");

	if(IsPlayerConnected(b_owner))
	{
		update_int_sql(b_owner, "u_business", -1);
		p_info[b_owner][business] = -1;
		SendClientMessage(b_owner, col_light_red, " ≈œ«—Ì ·„« »«⁄ Õﬁﬂ «·Œ«’ ›Ì «·„Õ·");
	}
	else
	{
		new query_string[87];
		format(query_string,sizeof(query_string),"UPDATE `users` SET `u_business` = '-1' WHERE `u_id` = '%d' LIMIT 1", b_info[b-1][b_owner_inc]);
		mysql_tquery(sql_connection, query_string, "", "");
	}

	b_info[b-1][b_owner_inc] = -1;
	format(b_info[b-1][b_owner_name], 36, "«·œÊ·…");

	if(isMsg == 1) SendClientMessage(playerid, col_white, "«·„Õ·  »«⁄");

	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	new query_string[200 + MAX_PLAYER_NAME + 1];
	format(query_string, 136,"UPDATE `businesses` SET `b_owner_inc` = '-1', `b_owner_name` = 'The State' WHERE `b_id` = '%d' LIMIT 1", b_info[b-1][b_id]);
	mysql_tquery(sql_connection, query_string);

	if(b_info[b-1][b_type] == bizz_type_bar || b_info[b-1][b_type] == bizz_type_club || b_info[b-1][b_type] == bizz_type_cafe || b_info[b-1][b_type] == bizz_type_pharm || b_info[b-1][b_type] == bizz_type_shop || b_info[b-1][b_type] == bizz_type_clothes || b_info[b-1][b_type] == bizz_type_carshop)
	{
		format(query_string, sizeof(query_string), ""c_server"%s\n"c_grey"«·”⁄—: "c_white"%d$\n"c_grey"«· Õﬂ„: "c_white"%s\n"c_grey"«·„Õ· ··»Ì⁄", b_types[b_info[b-1][b_type]], b_info[b-1][b_price], f_info[b_info[b-1][b_mafia] - 1][f_name]);
		UpdateDynamic3DTextLabelText(b_info[b-1][b_label], -1, query_string);
	}

	else if(b_info[b-1][b_type] == bizz_type_gas)
	{
		format(query_string, sizeof(query_string), ""c_server"%s\n"c_grey"«·”⁄—: "c_white"%d$\n"c_grey"«· Õﬂ„: "c_white"%s\n"c_grey"«·„Õ· ··»Ì⁄ (/buygas)", b_types[b_info[b-1][b_type]], b_info[b-1][b_price], f_info[b_info[b-1][b_mafia] - 1][f_name]);
		UpdateDynamic3DTextLabelText(b_info[b-1][b_label], -1, query_string);
	}
	else if(b_info[b-1][b_type] == bizz_type_ammo)
	{
		format(query_string, sizeof(query_string), ""c_server"%s\n"c_grey"«·”⁄—: "c_white"%d$\n"c_grey"«· Õﬂ„: "c_white"%s\n"c_grey"«·„Õ· ··»Ì⁄", b_types[b_info[b-1][b_type]], b_info[b-1][b_price], f_info[b_info[b-1][b_mafia] - 1][f_name]);
		UpdateDynamic3DTextLabelText(b_info[b][b_label], -1, query_string);
	}
	else if(b_info[b-1][b_type] == bizz_type_tune)
	{
		format(query_string, sizeof(query_string), ""c_server"%s\n"c_grey"«·”⁄—: "c_white"%d$\n"c_grey"«· Õﬂ„: "c_white"%s\n"c_grey"Workshop ··»Ì⁄ (/buytune)", b_types[b_info[b-1][b_type]], b_info[b-1][b_price], f_info[b_info[b-1][b_mafia] - 1][f_name]);
		UpdateDynamic3DTextLabelText(b_info[b-1][b_label], -1, query_string);
	}

	return 1;
}

