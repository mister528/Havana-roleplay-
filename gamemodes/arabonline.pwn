		new _scm_string [ 128 ] ;
		format(_scm_string, 128, "{ffffff} ﬂ·›… 1 liter: %d$\n\n«” Œœ„  «·„»·€ „‰ «·»‰“Ì‰  »Ì ‘—«¡\n( «·—ﬁ„ ·«“„ ÌﬂÊ‰  multiple „‰ 2)", b_info [ t ] [ b_cost ]);
		show_dialog ( playerid, d_mech_contract,DIALOG_STYLE_INPUT,"{"#cBL"}«·‘—«¡ „‰ «·ÊﬁÊœ",_scm_string,"‘—«¡","≈·€«¡");

