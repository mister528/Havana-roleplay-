CMD:dsvip(playerid,params[])
{
    if ( p_info [ playerid ] [ admin ] < 8 ) return 1;
    ////if(p_info[playerid][id] != 1   && p_info[playerid][id] != 1887) return true;
    foreach(new i: logged_players)
    {
        if(p_info[i][vip] != 0 && p_info[i][vip_time] <= 0)
        {
            new ifconnected = GetPlayerID(p_info[i][name]);
            if(IsPlayerConnected(ifconnected))
            {
                p_info[ifconnected][vip] = 0;
                p_info[ifconnected][vip_time] = 0;
                update_int_sql(ifconnected, "u_vip", p_info[ifconnected][vip]);
                update_int_sql(ifconnected, "u_vip_time", p_info[ifconnected][vip_time]);
                SendClientMessage(ifconnected, col_blue, "* „” ÊÏ VIP Õﬁ ﬂ « Õ–› ·√‰ „œ… «·‹VIP Œ·’ .");
            }
            else if(!IsPlayerConnected(ifconnected))
            {
                new query_string[228];
                format(query_string,sizeof(query_string),"UPDATE `users` SET `u_vip`='0',`u_vip_time` = '0' WHERE `u_name` = '%s' ",p_info[ifconnected][name] );
                mysql_tquery(sql_connection, query_string, "", "");
            }
        }
    }

    return 1;
}
