			show_dialog ( playerid, d_rd_end, DIALOG_STYLE_MSGBOX, "{"#cBL"}«·›«∆“", "{"#cBL"}„»—Êﬂ!\n\n{"#cWH"}«‰ Â  ·⁄»… «·—Ê·Ì ° „ﬂ”»ﬂ:\n{"#cBL"}-{"#cWH"}  ⁄»∆… «·ÃÊ⁄ Ê«·ÃÊ⁄ «··«‰Â«∆Ì.", "≈€·«ﬁ", "" ) ;

