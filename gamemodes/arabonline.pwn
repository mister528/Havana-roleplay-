stock HavanaIsland_ShowZone ( playerid )
{
    if ( g_havana_island_zone != -1 )
    {
        GangZoneShowForPlayer ( playerid, g_havana_island_zone, 0xFF000080 ) ;
    }
    return 1 ;
}

stock HavanaIsland_ToolName(type, out_name[])
{
    out_name[0] = EOS ;
    switch ( type )
    {
        case 0: strcat ( out_name, "»«—Êœ", 32 ) ;
        case 1: strcat ( out_name, "ÕœÌœ", 32 ) ;
        case 2: strcat ( out_name, "Œ—œ…", 32 ) ;
        case 3: strcat ( out_name, "Œ‘»", 32 ) ;
        case 4: strcat ( out_name, "“‰»—ﬂ", 32 ) ;
        default: strcat ( out_name, "√œ«…", 32 ) ;
    }
    return 1 ;
}

stock HavanaIsland_DestroyTool ( slot )
{
    if ( slot < 0 || slot >= HAVANA_ISLAND_TOOL_MAX ) return 0 ;
    if ( g_havana_island_tool_pickup [ slot ] != -1 )
    {
        DestroyDynamicPickup ( g_havana_island_tool_pickup [ slot ] ) ;
    }
    g_havana_island_tool_pickup [ slot ] = -1 ;
    return 1 ;
}

stock HavanaIsland_CreateTool ( slot )
{
    if ( slot < 0 || slot >= HAVANA_ISLAND_TOOL_MAX ) return 0 ;
    HavanaIsland_DestroyTool ( slot ) ;
    g_havana_island_tool_type [ slot ] = random ( HAVANA_ISLAND_TOOL_TYPES ) ;
    g_havana_island_tool_amount [ slot ] = random ( 8 ) + 1 ;
    g_havana_island_tool_taken [ slot ] = false ;
    new modelid = ( g_havana_island_tool_type [ slot ] == 0 ) ? HAVANA_ISLAND_TOOL_PICKUP_AMMO : HAVANA_ISLAND_TOOL_PICKUP_MARK ;
    g_havana_island_tool_pickup [ slot ] = CreateDynamicPickup ( modelid, 1,
        g_havana_island_tool_pos [ slot ] [ 0 ],
        g_havana_island_tool_pos [ slot ] [ 1 ],
        g_havana_island_tool_pos [ slot ] [ 2 ], 0, 0, -1, 120.0 ) ;
    return 1 ;
}

stock HavanaIsland_RespawnTools ( )
{
    for ( new i = 0 ; i < HAVANA_ISLAND_TOOL_MAX ; i ++ )
    {
        HavanaIsland_CreateTool ( i ) ;
    }
    return 1 ;
}

callback: HavanaIsland_RespawnToolsTimer ( )
{
    HavanaIsland_RespawnTools ( ) ;
    SendClientMessageToAll ( col_white, "{33FF33}* {FFFFFF} „ ≈⁄«œ…  Ê“Ì⁄ √œÊ«  «·Ã“Ì—…." ) ;
    return 1 ;
}


stock HavanaIsland_EnsureToolColumns ( )
{
    mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_island_gunpowder` INT NOT NULL DEFAULT 0", "", "" ) ;
    mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_island_iron` INT NOT NULL DEFAULT 0", "", "" ) ;
    mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_island_scrap` INT NOT NULL DEFAULT 0", "", "" ) ;
    mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_island_wood` INT NOT NULL DEFAULT 0", "", "" ) ;
    mysql_tquery ( sql_connection, "ALTER TABLE `users` ADD COLUMN IF NOT EXISTS `u_island_spring` INT NOT NULL DEFAULT 0", "", "" ) ;
    mysql_tquery ( sql_connection, "ALTER TABLE `houses` ADD COLUMN IF NOT EXISTS `h_craft_table` TINYINT(1) NOT NULL DEFAULT 0", "", "" ) ;
    return 1 ;
}

stock HavanaIsland_StartToolTimer ( )
{
    if ( g_havana_island_tool_timer != -1 ) KillTimer ( g_havana_island_tool_timer ) ;
    g_havana_island_tool_timer = SetTimer ( "HavanaIsland_RespawnToolsTimer", HAVANA_ISLAND_TOOL_RESPAWN_MS, true ) ;
    return 1 ;
}

stock HavanaIsland_StopExtract ( playerid, bool:clear_anim = true )
{
    if ( playerid < 0 || playerid >= MAX_PLAYERS ) return 0 ;
    if ( g_havana_island_tool_progress_timer [ playerid ] != -1 )
    {
        KillTimer ( g_havana_island_tool_progress_timer [ playerid ] ) ;
        g_havana_island_tool_progress_timer [ playerid ] = -1 ;
    }
    g_havana_island_tool_active [ playerid ] = HAVANA_ISLAND_TOOL_NONE ;
    g_havana_island_tool_progress [ playerid ] = 0 ;
    if ( clear_anim ) ClearAnimations ( playerid ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, "~ISLANDTOOL~hide" ) ;
    return 1 ;
}

stock HavanaIsland_UpdateToolSql ( playerid, type )
{
    if ( p_info [ playerid ] [ id ] <= 0 ) return 0 ;
    new query [ 256 ] ;
    switch ( type )
    {
        case 0: mysql_format ( sql_connection, query, sizeof query, "UPDATE `users` SET `u_island_gunpowder`='%d' WHERE `u_id`='%d' LIMIT 1", p_island_gunpowder [ playerid ], p_info [ playerid ] [ id ] ) ;
        case 1: mysql_format ( sql_connection, query, sizeof query, "UPDATE `users` SET `u_island_iron`='%d' WHERE `u_id`='%d' LIMIT 1", p_island_iron [ playerid ], p_info [ playerid ] [ id ] ) ;
        case 2: mysql_format ( sql_connection, query, sizeof query, "UPDATE `users` SET `u_island_scrap`='%d' WHERE `u_id`='%d' LIMIT 1", p_island_scrap [ playerid ], p_info [ playerid ] [ id ] ) ;
        case 3: mysql_format ( sql_connection, query, sizeof query, "UPDATE `users` SET `u_island_wood`='%d' WHERE `u_id`='%d' LIMIT 1", p_island_wood [ playerid ], p_info [ playerid ] [ id ] ) ;
        case 4: mysql_format ( sql_connection, query, sizeof query, "UPDATE `users` SET `u_island_spring`='%d' WHERE `u_id`='%d' LIMIT 1", p_island_spring [ playerid ], p_info [ playerid ] [ id ] ) ;
        default: return 0 ;
    }
    mysql_tquery ( sql_connection, query, "", "" ) ;
    return 1 ;
}

stock HavanaIsland_GiveTool ( playerid, type, amount )
{
    switch ( type )
    {
        case 0: p_island_gunpowder [ playerid ] += amount ;
        case 1: p_island_iron [ playerid ] += amount ;
        case 2: p_island_scrap [ playerid ] += amount ;
        case 3: p_island_wood [ playerid ] += amount ;
        case 4: p_island_spring [ playerid ] += amount ;
    }
    HavanaIsland_UpdateToolSql ( playerid, type ) ;
    return 1 ;
}


stock HavanaIsland_LoadToolInventory ( playerid )
{
    if ( p_info [ playerid ] [ id ] <= 0 ) return 0 ;
    p_island_gunpowder [ playerid ] = 0 ;
    p_island_iron [ playerid ] = 0 ;
    p_island_scrap [ playerid ] = 0 ;
    p_island_wood [ playerid ] = 0 ;
    p_island_spring [ playerid ] = 0 ;
    new query [ 164 ] ;
    format ( query, sizeof query, "SELECT `u_island_gunpowder`,`u_island_iron`,`u_island_scrap`,`u_island_wood`,`u_island_spring` FROM `users` WHERE `u_id`='%d' LIMIT 1", p_info [ playerid ] [ id ] ) ;
    new Cache:result = mysql_query ( sql_connection, query ) ;
    if ( cache_num_rows ( ) )
    {
        p_island_gunpowder [ playerid ] = cache_get_field_content_int ( 0, "u_island_gunpowder", sql_connection ) ;
        p_island_iron [ playerid ] = cache_get_field_content_int ( 0, "u_island_iron", sql_connection ) ;
        p_island_scrap [ playerid ] = cache_get_field_content_int ( 0, "u_island_scrap", sql_connection ) ;
        p_island_wood [ playerid ] = cache_get_field_content_int ( 0, "u_island_wood", sql_connection ) ;
        p_island_spring [ playerid ] = cache_get_field_content_int ( 0, "u_island_spring", sql_connection ) ;
    }
    cache_delete ( result ) ;
    return 1 ;
}

stock HavanaIsland_PushToolInventory ( playerid )
{
    if ( ! IsPlayerConnected ( playerid ) ) return 0 ;
    new payload [ 192 ] ;
    format ( payload, sizeof payload, "~INV_DATA~gunpowder=%d;iron=%d;scrap=%d;wood=%d;spring=%d",
        p_island_gunpowder [ playerid ], p_island_iron [ playerid ], p_island_scrap [ playerid ],
        p_island_wood [ playerid ], p_island_spring [ playerid ] ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, payload ) ;
    return 1 ;
}

stock HavanaIsland_OnToolFinished ( playerid )
{
    new slot = g_havana_island_tool_active [ playerid ] ;
    if ( slot < 0 || slot >= HAVANA_ISLAND_TOOL_MAX ) return HavanaIsland_StopExtract ( playerid ) ;
    if ( g_havana_island_tool_taken [ slot ] ) return HavanaIsland_StopExtract ( playerid ) ;

    new type = g_havana_island_tool_type [ slot ] ;
    new amount = g_havana_island_tool_amount [ slot ] ;
    new item_name [ 32 ] ;
    new msg [ 128 ] ;
    HavanaIsland_ToolName ( type, item_name ) ;
    HavanaIsland_DestroyTool ( slot ) ;
    g_havana_island_tool_taken [ slot ] = true ;
    HavanaIsland_GiveTool ( playerid, type, amount ) ;
    HavanaIsland_PushToolInventory ( playerid ) ;
    format ( msg, sizeof msg, "{33FF33}* {FFFFFF} „ «·⁄ÀÊ— ⁄·Ï %s ◊%d", item_name, amount ) ;
    SendClientMessage ( playerid, col_white, msg ) ;
    return HavanaIsland_StopExtract ( playerid ) ;
}

callback: HavanaIsland_ExtractStep ( playerid )
{
    if ( ! IsPlayerConnected ( playerid ) ) return 0 ;
    new slot = g_havana_island_tool_active [ playerid ] ;
    if ( slot < 0 || slot >= HAVANA_ISLAND_TOOL_MAX ) return HavanaIsland_StopExtract ( playerid ) ;
    if ( g_havana_island_tool_taken [ slot ] ) return HavanaIsland_StopExtract ( playerid ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 2.3,
        g_havana_island_tool_pos [ slot ] [ 0 ],
        g_havana_island_tool_pos [ slot ] [ 1 ],
        g_havana_island_tool_pos [ slot ] [ 2 ] ) )
    {
        SendClientMessage ( playerid, col_gray, "{FF3333}* {FFFFFF}Island extraction cancelled." ) ;
        return HavanaIsland_StopExtract ( playerid ) ;
    }

    g_havana_island_tool_progress [ playerid ] += 10 ;
    if ( g_havana_island_tool_progress [ playerid ] > 100 ) g_havana_island_tool_progress [ playerid ] = 100 ;
    new item_name [ 32 ] ;
    new payload [ 128 ] ;
    HavanaIsland_ToolName ( g_havana_island_tool_type [ slot ], item_name, sizeof item_name ) ;
    format ( payload, sizeof payload, "~ISLANDTOOL~progress=%d;name=%s", g_havana_island_tool_progress [ playerid ], item_name ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, payload ) ;

    ApplyAnimation ( playerid, "BOMBER", "BOM_Plant_Loop", 4.1, 1, 0, 0, 0, 0, 1 ) ;
    if ( g_havana_island_tool_progress [ playerid ] >= 100 ) return HavanaIsland_OnToolFinished ( playerid ) ;
    return 1 ;
}

stock HavanaIsland_StartExtract ( playerid, slot )
{
    if ( slot < 0 || slot >= HAVANA_ISLAND_TOOL_MAX ) return 0 ;
    if ( g_havana_island_tool_taken [ slot ] ) return 0 ;
    if ( g_havana_island_tool_active [ playerid ] != HAVANA_ISLAND_TOOL_NONE ) return 1 ;
    g_havana_island_tool_active [ playerid ] = slot ;
    g_havana_island_tool_progress [ playerid ] = 0 ;
    new item_name [ 32 ] ;
    new payload [ 128 ] ;
    HavanaIsland_ToolName ( g_havana_island_tool_type [ slot ], item_name, sizeof item_name ) ;
    format ( payload, sizeof payload, "~ISLANDTOOL~progress=0;name=%s", item_name ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, payload ) ;
    ApplyAnimation ( playerid, "BOMBER", "BOM_Plant_Loop", 4.1, 1, 0, 0, 0, 0, 1 ) ;
    g_havana_island_tool_progress_timer [ playerid ] = SetTimerEx ( "HavanaIsland_ExtractStep", 500, true, "i", playerid ) ;
    return 1 ;
}

stock HavanaIsland_CheckTools ( playerid )
{
    if ( ! IsPlayerConnected ( playerid ) ) return 0 ;
    if ( GetPlayerVirtualWorld ( playerid ) != 0 || GetPlayerInterior ( playerid ) != 0 ) return HavanaIsland_StopExtract ( playerid ) ;
    new near_slot = HAVANA_ISLAND_TOOL_NONE ;
    for ( new i = 0 ; i < HAVANA_ISLAND_TOOL_MAX ; i ++ )
    {
        if ( g_havana_island_tool_taken [ i ] ) continue ;
        if ( IsPlayerInRangeOfPoint ( playerid, 1.8,
            g_havana_island_tool_pos [ i ] [ 0 ],
            g_havana_island_tool_pos [ i ] [ 1 ],
            g_havana_island_tool_pos [ i ] [ 2 ] ) )
        {
            near_slot = i ;
            break ;
        }
    }
    g_havana_island_tool_last_slot [ playerid ] = near_slot ;
    if ( near_slot == HAVANA_ISLAND_TOOL_NONE )
    {
        if ( g_havana_island_tool_active [ playerid ] != HAVANA_ISLAND_TOOL_NONE ) HavanaIsland_StopExtract ( playerid ) ;
        return 1 ;
    }
    if ( g_havana_island_tool_active [ playerid ] == HAVANA_ISLAND_TOOL_NONE ) HavanaIsland_StartExtract ( playerid, near_slot ) ;
    return 1 ;
}

CMD:islandmap ( playerid, params [ ] )
{
    #pragma unused params
    if ( p_info [ playerid ] [ admin ] < 8 ) return 1 ;

    new Float:island_x = 987.9480 ;
    new Float:island_y = -3173.6389 ;
    new Float:island_z = 21.0000 ;
    set_pos ( playerid, island_x, island_y, island_z, 180.0, 0, 0 ) ;
    Streamer_UpdateEx ( playerid, island_x, island_y, island_z, 0, 0, -1, -1, 1 ) ;
    SendClientMessage ( playerid, col_white, "{33FF33}* {FFFFFF}Island map teleport done." ) ;
    return 1 ;
}
alias:islandmap ( "Islandmap", "island", "islandtp" )

/* ------------------------------------------------------------------
   [HavanaRP v13] Weapon Crafting Table
   Added by Devin: a 9th house improvement that unlocks an in-house
   crafting workbench. Uses ~CRAFT_UI~ messages to drive the client
   overlay (see jni/gui/weaponcraftoverlay.cpp).
------------------------------------------------------------------ */

#define CRAFT_TABLE_OBJ_MODEL          2964
#define CRAFT_TABLE_PICKUP_MODEL       1239
#define CRAFT_RPG_WEAPONID             35
#define CRAFT_RPG_AMMO                 1

#define CRAFT_REQ_SPRING               5
#define CRAFT_REQ_IRON                 7
#define CRAFT_REQ_SCRAP                3
#define CRAFT_REQ_GUNPOWDER            6
#define CRAFT_REQ_WOOD                10

// Bullet (single-round) recipe.
#define CRAFT_BULLET_REQ_GUNPOWDER    10
#define CRAFT_BULLET_REQ_IRON          5

// Animated craft progress timing in milliseconds.
#define CRAFT_PROGRESS_TOTAL_MS     3000

// Distance (in world units) used to detect the player walking away from
// the craft pickup so the next approach can re-open the menu.
#define CRAFT_SESSION_RADIUS         4.0

forward CraftTable_OpenForPlayer ( playerid ) ;
forward CraftTable_HasMaterials  ( playerid ) ;
forward CraftTable_HasBulletMats ( playerid ) ;
forward CraftTable_Spawn         ( h ) ;
forward CraftTable_Despawn       ( h ) ;
forward CraftTable_SessionTick   ( playerid ) ;
forward CraftTable_TickProgress  ( playerid, pct ) ;
forward CraftTable_FinishCraft   ( playerid ) ;
forward CraftTable_VerifyGrant   ( playerid, weaponid, ammo ) ;

stock CraftTable_HasMaterials ( playerid )
{
    if ( p_island_spring    [ playerid ] < CRAFT_REQ_SPRING    ) return 0 ;
    if ( p_island_iron      [ playerid ] < CRAFT_REQ_IRON      ) return 0 ;
    if ( p_island_scrap     [ playerid ] < CRAFT_REQ_SCRAP     ) return 0 ;
    if ( p_island_gunpowder [ playerid ] < CRAFT_REQ_GUNPOWDER ) return 0 ;
    if ( p_island_wood      [ playerid ] < CRAFT_REQ_WOOD      ) return 0 ;
    return 1 ;
}

stock CraftTable_HasBulletMats ( playerid )
{
    if ( p_island_gunpowder [ playerid ] < CRAFT_BULLET_REQ_GUNPOWDER ) return 0 ;
    if ( p_island_iron      [ playerid ] < CRAFT_BULLET_REQ_IRON      ) return 0 ;
    return 1 ;
}

stock CraftTable_Spawn ( h )
{
    if ( h < 0 || h >= house_count ) return 0 ;
    if ( ! h_info [ h ] [ h_craft_table ] ) return 0 ;

    new hint = h_info [ h ] [ h_int ] - 1 ;
    if ( hint < 0 || hint >= HINTS_COUNT ) return 0 ;

    new Float:fx = house_int [ hint ] [ hspawn_position ] [ 0 ] ;
    new Float:fy = house_int [ hint ] [ hspawn_position ] [ 1 ] ;
    new Float:fz = house_int [ hint ] [ hspawn_position ] [ 2 ] - 1.0 ;
    new Float:fa = house_int [ hint ] [ hspawn_position ] [ 3 ] ;

    fx += 2.0 * floatsin ( -fa, degrees ) ;
    fy += 2.0 * floatcos ( -fa, degrees ) ;

    new Float:obj_a = fa + 180.0 ;
    if ( obj_a >= 360.0 ) obj_a -= 360.0 ;

    if ( h_info [ h ] [ h_craft_obj ] != INVALID_OBJECT_ID )
    {
        DestroyDynamicObject ( h_info [ h ] [ h_craft_obj ] ) ;
    }
    if ( h_info [ h ] [ h_craft_pickup ] != -1 )
    {
        DestroyDynamicPickup ( h_info [ h ] [ h_craft_pickup ] ) ;
    }

    h_info [ h ] [ h_craft_obj ]    = CreateDynamicObject ( CRAFT_TABLE_OBJ_MODEL, fx, fy, fz, 0.0, 0.0, obj_a, h_info [ h ] [ h_id ], house_int [ hint ] [ hint_int ] ) ;
    h_info [ h ] [ h_craft_pickup ] = CreateDynamicPickup ( CRAFT_TABLE_PICKUP_MODEL, 23, fx, fy, fz + 1.0, h_info [ h ] [ h_id ], house_int [ hint ] [ hint_int ] ) ;
    pick_info [ h_info [ h ] [ h_craft_pickup ] ] [ pick_type ] = pick_type_craft_table ;

    new lbl[160];
    format(lbl, sizeof lbl, "{FFC436} ’‰Ì⁄ «·√”·Õ…\n{FFFFFF}«œŒ· ·› Õ «·ﬁ«∆„…");
    CreateDynamic3DTextLabel ( lbl, 0xFFC436FF, fx, fy, fz + 1.7, 6.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info [ h ] [ h_id ], house_int [ hint ] [ hint_int ] ) ;
    return 1 ;
}

stock CraftTable_Despawn ( h )
{
    if ( h < 0 || h >= house_count ) return 0 ;
    if ( h_info [ h ] [ h_craft_obj ] != INVALID_OBJECT_ID )
    {
        DestroyDynamicObject ( h_info [ h ] [ h_craft_obj ] ) ;
        h_info [ h ] [ h_craft_obj ] = INVALID_OBJECT_ID ;
    }
    if ( h_info [ h ] [ h_craft_pickup ] != -1 )
    {
        DestroyDynamicPickup ( h_info [ h ] [ h_craft_pickup ] ) ;
        h_info [ h ] [ h_craft_pickup ] = -1 ;
    }
    return 1 ;
}

stock CraftTable_OpenForPlayer ( playerid )
{
    new mat_string [ 220 ] ;
    format ( mat_string, sizeof mat_string,
        "~CRAFT_UI~OPEN|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
        p_island_spring [ playerid ],
        p_island_iron [ playerid ],
        p_island_scrap [ playerid ],
        p_island_gunpowder [ playerid ],
        p_island_wood [ playerid ],
        CRAFT_REQ_SPRING, CRAFT_REQ_IRON, CRAFT_REQ_SCRAP, CRAFT_REQ_GUNPOWDER, CRAFT_REQ_WOOD,
        CRAFT_BULLET_REQ_GUNPOWDER, CRAFT_BULLET_REQ_IRON ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, mat_string ) ;
    return 1 ;
}

// Periodic check that clears the craft session lock once the player has
// physically walked away from the craft-table pickup. As long as the lock
// is set, OnPlayerPickUpDynamicPickup will not re-open the menu (this fixes
// the repeat-open / soft-kick bug when standing on a type-23 pickup).
public CraftTable_SessionTick ( playerid )
{
    if ( ! IsPlayerConnected ( playerid ) )
    {
        DeletePVar ( playerid, "craft_in_session" ) ;
        DeletePVar ( playerid, "craft_session_pickup" ) ;
        DeletePVar ( playerid, "craft_session_house" ) ;
        return 1 ;
    }
    if ( ! GetPVarInt ( playerid, "craft_in_session" ) ) return 1 ;

    new hidx = GetPVarInt ( playerid, "craft_session_house" ) - 1 ;
    if ( hidx < 0 || hidx >= house_count )
    {
        DeletePVar ( playerid, "craft_in_session" ) ;
        DeletePVar ( playerid, "craft_session_pickup" ) ;
        DeletePVar ( playerid, "craft_session_house" ) ;
        return 1 ;
    }

    new pickupid = h_info [ hidx ] [ h_craft_pickup ] ;
    new Float:px, Float:py, Float:pz, Float:dist ;
    if ( pickupid == -1 || ! Streamer_GetItemPos ( STREAMER_TYPE_PICKUP, pickupid, px, py, pz ) )
    {
        DeletePVar ( playerid, "craft_in_session" ) ;
        DeletePVar ( playerid, "craft_session_pickup" ) ;
        DeletePVar ( playerid, "craft_session_house" ) ;
        return 1 ;
    }
    new Float:plx, Float:ply, Float:plz ;
    GetPlayerPos ( playerid, plx, ply, plz ) ;
    dist = floatsqroot ( ( plx - px ) * ( plx - px ) + ( ply - py ) * ( ply - py ) + ( plz - pz ) * ( plz - pz ) ) ;

    if ( dist > CRAFT_SESSION_RADIUS )
    {
        // Player walked away -> release the lock and tell the client to hide.
        DeletePVar ( playerid, "craft_in_session" ) ;
        DeletePVar ( playerid, "craft_session_pickup" ) ;
        DeletePVar ( playerid, "craft_session_house" ) ;
        SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~HIDE" ) ;
        return 1 ;
    }
    // Re-arm next tick.
    SetTimerEx ( "CraftTable_SessionTick", 800, 0, "i", playerid ) ;
    return 1 ;
}

// Pushes a single PROG|<pct> message to the client (used by SetTimerEx).
public CraftTable_TickProgress ( playerid, pct )
{
    if ( ! IsPlayerConnected ( playerid ) ) return 1 ;
    if ( ! GetPVarInt ( playerid, "craft_pending" ) ) return 1 ;
    new buf [ 32 ] ;
    format ( buf, sizeof buf, "~CRAFT_UI~PROG|%d", pct ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, buf ) ;
    return 1 ;
}

// Defensive re-grant: if for any reason the player did not actually receive
// weapon ID 35 with ammo (RPC packet loss, anti-cheat sweep race, modified
// client filtering), this verification timer re-issues GivePlayerWeapon and
// re-bumps the immune window. Called at 1500ms and 3500ms after /craft_done.
public CraftTable_VerifyGrant ( playerid, weaponid, ammo )
{
    if ( ! IsPlayerConnected ( playerid ) ) return 1 ;
    if ( weaponid != CRAFT_RPG_WEAPONID ) return 1 ;
    new w_id = 0, w_ammo = 0 ;
    GetPlayerWeaponData ( playerid, 7, w_id, w_ammo ) ;
    // Only re-issue the weapon if it is *missing entirely* (slot empty or
    // anti-cheat stripped it). DO NOT re-grant on low ammo - that causes
    // false-positive Nex-AC ammo-hack detections (#016) when the player
    // legitimately fires their RPG between craft and verify ticks.
    if ( w_id != weaponid )
    {
        p_t_info [ playerid ] [ p_gun_immune_time ] = 24 ;
        p_t_info [ playerid ] [ p_gun_slot ] [ 7 ] = weaponid ;
        if ( p_t_info [ playerid ] [ p_gun_ammo ] [ 7 ] < ammo )
            p_t_info [ playerid ] [ p_gun_ammo ] [ 7 ] = ammo ;
        Craft_DisableACAmmo ( playerid ) ;
        GivePlayerWeapon ( playerid, weaponid, ammo ) ;
    }
    return 1 ;
}

// Disables Nex-AC ammo-related checks (#15 weapon hack, #16 ammo add,
// #17 infinite ammo) for ~12 seconds while RPG ammo is being granted via
// the crafting table. Without this, Nex-AC triggers code 016 right after
// GivePlayerWeapon because the underlying ammo-tracker is racy on slot 7.
stock Craft_DisableACAmmo ( playerid )
{
    EnableAntiCheatForPlayer ( playerid, 15, 0 ) ;
    EnableAntiCheatForPlayer ( playerid, 16, 0 ) ;
    EnableAntiCheatForPlayer ( playerid, 17, 0 ) ;
    SetTimerEx ( "CraftTable_ReenableAC", 12000, 0, "i", playerid ) ;
    return 1 ;
}

forward CraftTable_ReenableAC ( playerid ) ;
public  CraftTable_ReenableAC ( playerid )
{
    if ( ! IsPlayerConnected ( playerid ) ) return 1 ;
    // While disabled, Nex-AC's own OnPlayerUpdate sweep silently absorbs
    // the actual ammo into its internal tracker (see nex-ac.inc:4276 -
    // resync runs even when acACAllow[16] is false). So by the time we
    // re-enable, the tracker is already in sync with the real value.
    EnableAntiCheatForPlayer ( playerid, 15, 1 ) ;
    EnableAntiCheatForPlayer ( playerid, 16, 1 ) ;
    EnableAntiCheatForPlayer ( playerid, 17, 1 ) ;
    return 1 ;
}

// Final step of the animated craft: deducts materials, gives RPG with 1
// round, persists everything to MySQL, then sends DONE to the client.
public CraftTable_FinishCraft ( playerid )
{
    if ( ! IsPlayerConnected ( playerid ) )
    {
        DeletePVar ( playerid, "craft_pending" ) ;
        DeletePVar ( playerid, "craft_already_granted" ) ;
        return 1 ;
    }
    DeletePVar ( playerid, "craft_pending" ) ;
    // If /craft_done already granted the weapon synchronously, only
    // emit the closing DONE pulse + re-bump the immunity window, then
    // exit before the legacy duplicate-grant block runs.
    if ( GetPVarInt ( playerid, "craft_already_granted" ) )
    {
        DeletePVar ( playerid, "craft_already_granted" ) ;
        p_t_info [ playerid ] [ p_gun_immune_time ] = 12 ;
        SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~DONE" ) ;
        return 1 ;
    }
    if ( ! CraftTable_HasMaterials ( playerid ) )
    {
        SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~ERR_MAT" ) ;
        return 1 ;
    }
    p_island_spring    [ playerid ] -= CRAFT_REQ_SPRING ;
    p_island_iron      [ playerid ] -= CRAFT_REQ_IRON ;
    p_island_scrap     [ playerid ] -= CRAFT_REQ_SCRAP ;
    p_island_gunpowder [ playerid ] -= CRAFT_REQ_GUNPOWDER ;
    p_island_wood      [ playerid ] -= CRAFT_REQ_WOOD ;
    HavanaIsland_UpdateToolSql ( playerid, 0 ) ;
    HavanaIsland_UpdateToolSql ( playerid, 1 ) ;
    HavanaIsland_UpdateToolSql ( playerid, 2 ) ;
    HavanaIsland_UpdateToolSql ( playerid, 3 ) ;
    HavanaIsland_UpdateToolSql ( playerid, 4 ) ;

    // Persist FIRST so a disconnect mid-give still keeps the weapon.
    p_info [ playerid ] [ rpg_save ] += CRAFT_RPG_AMMO ;
    update_int_sql ( playerid, "rpg_save", p_info [ playerid ] [ rpg_save ] ) ;
    // give_weapon registers the slot in p_t_info and bumps p_gun_immune_time
    // so the anti-cheat sweep (line ~10186) does NOT strip the freshly
    // crafted RPG.  Raw GivePlayerWeapon would be reset by anti-cheat.
    give_weapon ( playerid, CRAFT_RPG_WEAPONID, CRAFT_RPG_AMMO ) ;
    p_t_info [ playerid ] [ p_gun_immune_time ] = 6 ;

    new __dn [ 160 ] ;
    format ( __dn, sizeof __dn, "{33FF33}* {FFFFFF} „  ’‰Ì⁄ ”·«Õ (RPG) »—’«’… Ê«Õœ…" ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, __dn ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~DONE" ) ;
    return 1 ;
}

// /craft_pick is the cheap pre-flight check: validates the requested weapon
// id + materials so the client can immediately start the trace minigame
// without waiting for a server roundtrip. Materials are NOT deducted here.
CMD:craft_pick ( playerid, params [ ] )
{
    new wid ;
    if ( sscanf ( params, "d", wid ) ) return 0 ;
    if ( wid != CRAFT_RPG_WEAPONID && wid != 1 )
    {
        SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~ERR_WEAPON" ) ;
        return 1 ;
    }
    if ( ! CraftTable_HasMaterials ( playerid ) )
    {
        new __m1 [ 200 ] ;
        format ( __m1, sizeof __m1, "{"#cRD"}* {"#cGR"}·Ì” ·œÌﬂ „Ê«—œ ﬂ«›Ì… · ’‰Ì⁄ «·”·«Õ" ) ;
        SendClientMessage ( playerid, col_gray, __m1 ) ;
        SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~ERR_MAT" ) ;
        return 1 ;
    }
    SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~OK_PICK" ) ;
    return 1 ;
}

// /craft_done starts the animated 3-second crafting on the server side.
// It schedules PROG|N pulses so the client progress bar advances visibly,
// then deducts materials and grants the RPG (1 round) at the end.
CMD:craft_done ( playerid, params [ ] )
{
    new wid ;
    if ( sscanf ( params, "d", wid ) ) return 0 ;
    if ( wid != CRAFT_RPG_WEAPONID && wid != 1 )
    {
        SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~ERR_WEAPON" ) ;
        return 1 ;
    }
    if ( ! CraftTable_HasMaterials ( playerid ) )
    {
        SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~ERR_MAT" ) ;
        return 1 ;
    }
    if ( GetPVarInt ( playerid, "craft_pending" ) )
    {
        // Already crafting; ignore duplicate request.
        return 1 ;
    }
    SetPVarInt ( playerid, "craft_pending", 1 ) ;

    // ====================================================================
    //  SYNCHRONOUS weapon grant.  Older AMX versions / heavily-loaded
    //  servers have been observed to drop pending public-function timers,
    //  leaving the player with the success animation but no weapon.  We
    //  therefore deduct + grant + persist RIGHT NOW and use a PVar guard
    //  so CraftTable_FinishCraft (the legacy 3s timer) cannot re-run the
    //  same logic at the end.
    // ====================================================================
    p_island_spring    [ playerid ] -= CRAFT_REQ_SPRING ;
    p_island_iron      [ playerid ] -= CRAFT_REQ_IRON ;
    p_island_scrap     [ playerid ] -= CRAFT_REQ_SCRAP ;
    p_island_gunpowder [ playerid ] -= CRAFT_REQ_GUNPOWDER ;
    p_island_wood      [ playerid ] -= CRAFT_REQ_WOOD ;
    HavanaIsland_UpdateToolSql ( playerid, 0 ) ;
    HavanaIsland_UpdateToolSql ( playerid, 1 ) ;
    HavanaIsland_UpdateToolSql ( playerid, 2 ) ;
    HavanaIsland_UpdateToolSql ( playerid, 3 ) ;
    HavanaIsland_UpdateToolSql ( playerid, 4 ) ;
    p_info [ playerid ] [ rpg_save ] += CRAFT_RPG_AMMO ;
    update_int_sql ( playerid, "rpg_save", p_info [ playerid ] [ rpg_save ] ) ;
    Craft_DisableACAmmo ( playerid ) ;
    give_weapon ( playerid, CRAFT_RPG_WEAPONID, CRAFT_RPG_AMMO ) ;
    p_t_info [ playerid ] [ p_gun_immune_time ] = 12 ;
    SetPVarInt ( playerid, "craft_already_granted", 1 ) ;

    SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~PROG|0" ) ;
    SetTimerEx ( "CraftTable_TickProgress", 250,                                0, "ii", playerid, 12 ) ;
    SetTimerEx ( "CraftTable_TickProgress", 700,                                0, "ii", playerid, 35 ) ;
    SetTimerEx ( "CraftTable_TickProgress", 1300,                               0, "ii", playerid, 60 ) ;
    SetTimerEx ( "CraftTable_TickProgress", 1900,                               0, "ii", playerid, 82 ) ;
    SetTimerEx ( "CraftTable_TickProgress", 2500,                               0, "ii", playerid, 100 ) ;
    SetTimerEx ( "CraftTable_FinishCraft",  CRAFT_PROGRESS_TOTAL_MS,            0, "i",  playerid ) ;
    // Defensive re-grant timers: if first GivePlayerWeapon got dropped or
    // wiped by anti-cheat, re-deliver the RocketLauncher (id 35) at 1.5s and 3.5s.
    SetTimerEx ( "CraftTable_VerifyGrant",  1500,                               0, "iii", playerid, CRAFT_RPG_WEAPONID, CRAFT_RPG_AMMO ) ;
    SetTimerEx ( "CraftTable_VerifyGrant",  3500,                               0, "iii", playerid, CRAFT_RPG_WEAPONID, CRAFT_RPG_AMMO ) ;
    return 1 ;
}

// /craft_bullet: synthesises a single RPG round (10 gunpowder + 5 iron).
// Adds +1 to the player's existing RPG ammo (or gives them weapon 35 with
// 1 round if they don't currently have it). Persists the consumed mats to
// the database so the count survives a server restart.
CMD:craft_bullet ( playerid, params [ ] )
{
    #pragma unused params
    if ( ! CraftTable_HasBulletMats ( playerid ) )
    {
        SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~ERR_MAT_B" ) ;
        return 1 ;
    }
    p_island_gunpowder [ playerid ] -= CRAFT_BULLET_REQ_GUNPOWDER ;
    p_island_iron      [ playerid ] -= CRAFT_BULLET_REQ_IRON ;
    HavanaIsland_UpdateToolSql ( playerid, 1 ) ; // iron
    HavanaIsland_UpdateToolSql ( playerid, 3 ) ; // gunpowder

    // Persist FIRST so a disconnect mid-give still keeps the round.
    p_info [ playerid ] [ rpg_save ] += 1 ;
    update_int_sql ( playerid, "rpg_save", p_info [ playerid ] [ rpg_save ] ) ;
    Craft_DisableACAmmo ( playerid ) ;
    give_weapon ( playerid, CRAFT_RPG_WEAPONID, 1 ) ;
    p_t_info [ playerid ] [ p_gun_immune_time ] = 6 ;

    new __m [ 160 ] ;
    format ( __m, sizeof __m, "{33FF33}* {FFFFFF} „  ’‰Ì⁄ —’«’… RPG Ê≈÷«› Â« ·Ã⁄» ﬂ" ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, __m ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~BULLET_OK" ) ;
    SetTimerEx ( "CraftTable_VerifyGrant",  1000,                               0, "iii", playerid, CRAFT_RPG_WEAPONID, p_info [ playerid ] [ rpg_save ] ) ;
    return 1 ;
}

CMD:craft_close ( playerid, params [ ] )
{
    #pragma unused params
    DeletePVar ( playerid, "craft_in_session" ) ;
    DeletePVar ( playerid, "craft_session_pickup" ) ;
    DeletePVar ( playerid, "craft_session_house" ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, "~CRAFT_UI~CLOSE" ) ;
    return 1 ;
}

// /giveresources [playerid] [amount]: admin-only.  Adds <amount> of every
// crafting material (springs/iron/scrap/gunpowder/wood) to the target player
// and persists each column to the database immediately so the values survive
// a disconnect or rcon gmx.
CMD:giveresources ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ admin ] < 5 )
    {
        SendClientMessage ( playerid, 0xFFFFFFFF, "{FF6464}* {FFFFFF}This command is restricted to head admins." ) ;
        return 1 ;
    }
    new target, amount ;
    if ( sscanf ( params, "ud", target, amount ) )
    {
        SendClientMessage ( playerid, 0xFFFFFFFF, "{FFCC00}USAGE:{FFFFFF} /giveresources [playerid] [amount]" ) ;
        return 1 ;
    }
    if ( ! IsPlayerConnected ( target ) )
    {
        SendClientMessage ( playerid, 0xFFFFFFFF, "{FF6464}* {FFFFFF}Target player is not connected." ) ;
        return 1 ;
    }
    if ( amount < 1 || amount > 100000 )
    {
        SendClientMessage ( playerid, 0xFFFFFFFF, "{FF6464}* {FFFFFF}Amount must be between 1 and 100000." ) ;
        return 1 ;
    }
    p_island_spring    [ target ] += amount ;
    p_island_iron      [ target ] += amount ;
    p_island_scrap     [ target ] += amount ;
    p_island_gunpowder [ target ] += amount ;
    p_island_wood      [ target ] += amount ;
    HavanaIsland_UpdateToolSql ( target, 0 ) ;
    HavanaIsland_UpdateToolSql ( target, 1 ) ;
    HavanaIsland_UpdateToolSql ( target, 2 ) ;
    HavanaIsland_UpdateToolSql ( target, 3 ) ;
    HavanaIsland_UpdateToolSql ( target, 4 ) ;
    new __scm [ 200 ] ;
    format ( __scm, sizeof __scm, "{33FF33}* {FFFFFF}Admin %s gave you {FFCC00}+%d{FFFFFF} of every crafting material.",
        p_info [ playerid ] [ name ], amount ) ;
    SendClientMessage ( target,   0xFFFFFFFF, __scm ) ;
    format ( __scm, sizeof __scm, "{33FF33}* {FFFFFF}You gave %s {FFCC00}+%d{FFFFFF} of every crafting material.",
        p_info [ target ] [ name ], amount ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, __scm ) ;
    return 1 ;
}
