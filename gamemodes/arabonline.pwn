// [HAVANA] 24/7 STORE ROBBERY HELPERS
forward Rob247_TimeoutTick();
forward Rob247_FailDelayed(playerid, bidx);

stock Rob247_FindShopByVW(vw)
{
	if (vw < 1001) return -1;
	new bid = vw - 1000;
	for (new i = 0 ; i < b_count ; i++)
	{
		if (b_info[i][b_id] == bid && b_info[i][b_type] == bizz_type_shop)
			return i;
	}
	return -1;
}

stock Rob247_PreCheck(playerid)
{
	if (p_info[playerid][level] < 2)
	{
		SendClientMessage(playerid, 0xFFAA55FF, "{FFAA55}* {FFFFFF}Ì·“„ „” ÊÏ 2 ·”—ﬁ… 24/7.");
		return 0;
	}
	if (!GetPVarInt(playerid, "p_masked"))
	{
		SendClientMessage(playerid, 0xFFAA55FF, "{FFAA55}* {FFFFFF}«·»” «·ﬁ‰«⁄ ﬁ»· ”—ﬁ… 24/7.");
		return 0;
	}
	if (g_rob247_player_cd[playerid] != 0 && gettime() - g_rob247_player_cd[playerid] < ROB247_PLAYER_COOLDOWN_S)
	{
		new _rem = (ROB247_PLAYER_COOLDOWN_S - (gettime() - g_rob247_player_cd[playerid])) / 60 + 1;
		new _msg[96];
		format(_msg, sizeof(_msg), "{FFAA55}* {FFFFFF}«‰ Ÿ— %d œﬁÌﬁ… ﬁ»· ”—ﬁ… 24/7 „—… √Œ—Ï.", _rem);
		SendClientMessage(playerid, 0xFFAA55FF, _msg);
		return 0;
	}
	return 1;
}

stock Rob247_Start(playerid, bidx)
{
	if (bidx < 0 || bidx >= b_count) return 0;
	if (g_rob247_state[bidx] != 0) return 0;
	if (g_rob247_cooldown[bidx] != 0)
	{
		if (GetTickCount() - g_rob247_cooldown[bidx] < ROB247_COOLDOWN_MS)
			return 0;
		g_rob247_cooldown[bidx] = 0;
	}
	g_rob247_state[bidx] = 1;
	g_rob247_robber[bidx] = playerid;
	g_rob247_alarm_t[bidx] = GetTickCount();

	new vw = b_info[bidx][b_id] + 1000;
	SetPlayerCheckpoint(playerid, ROB247_REGISTER_X, ROB247_REGISTER_Y, ROB247_REGISTER_Z, 1.6);
	if (g_rob247_cp[bidx] != -1) DestroyDynamicCP(g_rob247_cp[bidx]);
	g_rob247_cp[bidx] = CreateDynamicCP(ROB247_REGISTER_X, ROB247_REGISTER_Y, ROB247_REGISTER_Z, 1.6, vw, 17, -1, 200.0);
	if (g_rob247_blip[bidx] != -1) DestroyDynamicMapIcon(g_rob247_blip[bidx]);
	g_rob247_blip[bidx] = CreateDynamicMapIcon(ROB247_REGISTER_X, ROB247_REGISTER_Y, ROB247_REGISTER_Z, 41, 0xFF0000FF, vw, 17, -1, 99999.0, MAPICON_GLOBAL_CHECKPOINT);
	Streamer_Update(playerid);

	foreach(new i: logged_players)
	{
		if (GetPlayerVirtualWorld(i) == vw)
		{
			SendClientMessage(i, 0xFF3030FF, "{FF3030}[!] {FFFFFF}»œ√  ”—ﬁ… „ Ã— 24/7.");
			PlayerPlaySound(i, 1149, 0.0, 0.0, 0.0);
		}
	}
	return 1;
}

stock Rob247_End(bidx, bool:success)
{
	if (bidx < 0 || bidx >= b_count) return 0;
	new _rvw_end = b_info[bidx][b_id] + 1000;
	new _robber = g_rob247_robber[bidx];
	if (g_rob247_cp[bidx] != -1)
	{
		DestroyDynamicCP(g_rob247_cp[bidx]);
		g_rob247_cp[bidx] = -1;
	}
	if (g_rob247_blip[bidx] != -1)
	{
		DestroyDynamicMapIcon(g_rob247_blip[bidx]);
		g_rob247_blip[bidx] = -1;
	}
	if (_robber >= 0 && _robber < MAX_PLAYERS && IsPlayerConnected(_robber)) DisablePlayerCheckpoint(_robber);
	new _snd = success ? 1054 : 1058;
	foreach(new _pi: logged_players)
	{
		if (GetPlayerVirtualWorld(_pi) == _rvw_end)
		{
			PlayerPlaySound(_pi, 1150, 0.0, 0.0, 0.0);
			PlayerPlaySound(_pi, _snd, 0.0, 0.0, 0.0);
		}
	}
	g_rob247_state[bidx] = success ? 3 : 0;
	g_rob247_robber[bidx] = -1;
	g_rob247_alarm_t[bidx] = 0;
	if (success) g_rob247_cooldown[bidx] = GetTickCount();
	return 1;
}

public Rob247_TimeoutTick()
{
	static _alarm_counter = 0;
	_alarm_counter++;
	new now = GetTickCount();
	for (new i = 0 ; i < b_count ; i++)
	{
		if (g_rob247_state[i] == 1 || g_rob247_state[i] == 2)
		{
			if ((_alarm_counter % 4) == 0)
			{
				new _avw = b_info[i][b_id] + 1000;
				foreach(new _pj: logged_players)
				{
					if (GetPlayerVirtualWorld(_pj) == _avw) PlayerPlaySound(_pj, 1149, 0.0, 0.0, 0.0);
				}
			}
		}
		if (g_rob247_state[i] == 1 && now - g_rob247_alarm_t[i] > ROB247_TIMEOUT_MS) Rob247_End(i, false);
		if (g_rob247_state[i] == 3 && now - g_rob247_cooldown[i] > ROB247_COOLDOWN_MS)
		{
			g_rob247_state[i] = 0;
			g_rob247_cooldown[i] = 0;
		}
	}
	foreach(new _pp: logged_players)
	{
		if (g_rob247_progT[_pp] != 0 && now - g_rob247_progT[_pp] > 6000)
		{
			new _bidx2 = g_rob247_progBidx[_pp];
			new _rew = g_rob247_pending[_pp];
			g_rob247_progT[_pp] = 0;
			g_rob247_progBidx[_pp] = -1;
			g_rob247_pending[_pp] = 0;
			ClearAnimations(_pp);
			TogglePlayerControllable(_pp, 1);
			p_info[_pp][money] += _rew;
			GivePlayerMoney(_pp, _rew);
			update_int_sql(_pp, "u_money", p_info[_pp][money]);
			p_info[_pp][wanted] = 6;
			SetPlayerWantedLevel(_pp, 6);
			update_int_sql(_pp, "u_wanted", 6);
			g_rob247_player_cd[_pp] = gettime();
			new _msg2[96];
			format(_msg2, sizeof(_msg2), "{30FF6A}[+] {FFFFFF} „ ”—ﬁ… «·ﬂ«‘Ì— +%d$", _rew);
			SendClientMessage(_pp, 0x30FF6AFF, _msg2);
			ShowPlayerDialog(_pp, d_rob247_lockpick, DIALOG_STYLE_MSGBOX, "[!ROB247_CLOSE]", " ", "OK", "");
			if (_bidx2 >= 0 && _bidx2 < b_count) Rob247_End(_bidx2, true);
		}
	}
	return 1;
}

stock Rob247_OpenLockpick(playerid, bidx)
{
	if (bidx < 0 || bidx >= b_count) return 0;
	if (g_rob247_state[bidx] != 1) return 0;
	if (g_rob247_robber[bidx] != playerid) return 0;
	g_rob247_state[bidx] = 2;
	g_rob247_dialog[playerid] = bidx;
	p_t_info[playerid][p_dialog] = d_rob247_lockpick;
	ShowPlayerDialog(playerid, d_rob247_lockpick, DIALOG_STYLE_INPUT, "[!ROB247_OPEN]", "5", "«»œ√", "≈·€«¡");
	return 1;
}

public OnPlayerWeaponShot ( playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerWeaponShot] %d | %d | %d | %d | %f | %f | %f", weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ ) ;
	#endif
	if(hittype < 0 || hittype > 4) return 0;

	if (weaponid < 22 || weaponid > 38)
    	return 0;
	new Float:z;
 	GetPlayerPos(playerid, z, z, z);
 	
 	new currentTime = GetTickCount();

	if (weaponid == 24)
	{
	    // Check if the player is firing too quickly
	    if (currentTime - LastShotTime[playerid] < REAPER_FIRE_TIME)
	    {
	        ShotCount[playerid]++;

	        // If the player exceeds the rapid fire threshold
	        if (ShotCount[playerid] >= REAPER_FIRE_THRESHOLD)
	        {
	            // Take action against the player
	            SendClientMessage(playerid, 0xFF0000FF, " „ «ﬂ ‘«› ≈ÿ·«ﬁ ‰«— ”—Ì⁄! Â–« «·›⁄· €Ì— „”„ÊÕ.");
	            TogglePlayerControllable(playerid, false); // Temporarily freeze the player
	            SetTimerEx("UnfreezePlayer", 5000, false, "i", playerid); // Unfreeze after 3 seconds
	            ShotCount[playerid] = 0; // Reset their shot count
	        }
	    }
	    else
	    {
	        // Reset the shot count if enough time has passed
	        ShotCount[playerid] = 0;
	    }

	    // Update the last shot time
	    LastShotTime[playerid] = currentTime;
	}

    if(IsAGreenZone(playerid) && !gover_player(playerid) || IsAGreenZone(hitid)  && gover_player(hitid))


    {


        GreenZone_Warn(playerid);


        return 0;


    }
    if(weaponid > 46)
	{
		anti_cheat ( playerid, "no_fire_gun", 22 ) ;
		return 0;
	}
    if(!((22 <= weaponid <= 34) || weaponid == 38))
    {
		anti_cheat ( playerid, "no_fire_gun", 20 ) ;
		return 0;
	}
	if(!(-20000.0 <= z <= 20000.0))
		return 0;

 	if(hittype == BULLET_HIT_TYPE_PLAYER || hittype == BULLET_HIT_TYPE_VEHICLE)
	{
		if ((floatabs(fX) >= 10.0) || (floatabs(fY) >= 10.0) || (floatabs(fZ) >= 10.0)|| (floatabs(fX) <= -10.0) || (floatabs(fY) <= -10.0) || (floatabs(fZ) <= -10.0) )
		{
			return 0;
		}
	}
	if(hittype == BULLET_HIT_TYPE_PLAYER || hittype == BULLET_HIT_TYPE_VEHICLE)
	{
		static Float:oldX[MAX_PLAYERS], Float:oldY[MAX_PLAYERS], Float:oldZ[MAX_PLAYERS], t[MAX_PLAYERS];
		if(fX == 0.0 || fY == 0.0 || fZ == 0.0)
		{
			return 0 ;
		}
		if(fX == oldX[playerid] && fY == oldY[playerid] && fZ == oldZ[playerid])
		{
			return 0;
		}
		oldX[playerid] = fX; oldY[playerid] = fY; oldZ[playerid] = fZ;
		if ( weaponid !=  0 )
		{
			if(GetTickCount() - t[playerid] < HitTimeTable[weaponid + TABLE_OFFSET] - 75){

				t[playerid] = GetTickCount();
				return 0;
			}
			t[playerid] = GetTickCount();
		}
	}


	new Float: pos_x, Float:pos_y, Float:pos_z ;
	GetPlayerPos ( playerid, pos_x, pos_y, pos_z ) ;
    new Float:pos_px, Float:pos_py, Float:pos_pz, Float:pos_sx, Float:pos_sy, Float:pos_sz;
	GetPlayerLastShotVectors(playerid, pos_px, pos_py, pos_pz, pos_sx, pos_sy, pos_sz);

	switch(hittype)
	{
		case BULLET_HIT_TYPE_VEHICLE: if(!GetVehicleModel(hitid)) return 0;
		case BULLET_HIT_TYPE_OBJECT: if(!IsValidObject(hitid)) return 0;
		case BULLET_HIT_TYPE_PLAYER_OBJECT: if(!IsValidPlayerObject(playerid, hitid)) return 0;
	}


	p_t_info [ playerid ] [ p_shot_time ] = GetTickCount ( ) ;
	
	new slot = get_weapon_slot ( weaponid ) ;
	if ( p_t_info [ playerid ] [ p_gun_slot ] [ slot ] == 0 && p_t_info [ playerid ] [ p_tp_immune_time ] < 1 )return anti_cheat ( playerid, "DGun", 11 ), false ;
	
	if ( hittype == BULLET_HIT_TYPE_PLAYER && IsPlayerConnected ( hitid ) )
	{
     	if ( mw_gangzone != - 1 )
		{
		    if ( IsPlayerInQuad ( playerid, mw_quad [ 0 ], mw_quad [ 1 ], mw_quad [ 2 ], mw_quad [ 3 ] ) )
			{
   				if ( p_info [ playerid ] [ warblock ] > 0 )
   				{
   				    SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}⁄‰œﬂ ÕŸ— „›⁄¯· Ì√Œ– «·Ã“¡." ) ;
   				    return 0 ;
   				}
   				if ( p_info [ hitid ] [ warblock ] > 0 )
   				{
   				    SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«··«⁄» ⁄‰œÂ ÕŸ— «· ‘»À." ) ;
