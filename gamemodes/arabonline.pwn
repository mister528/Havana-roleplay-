		return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /”Ã‰ [”Ã‰ «·‰Ê⁄: 1/2] [ID/«·«”„] [œﬁÌﬁ…] [«·”»»]" ) ;
	if ( params [ 0 ] <= 0 || params [ 0 ] >= 3 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /”Ã‰ [”Ã‰ «·‰Ê⁄: 1/2] [ID/«·«”„] [œﬁÌﬁ…] [«·”»»]" ), SendClientMessage ( playerid, col_white,"√œ„‰ «·”Ã‰: 1 / «·”Ã‰ Alctraz: 2" ) ;
	if ( params [ 0 ] == 1 ) // Jail ADMIN
