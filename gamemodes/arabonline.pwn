	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» „«  „ «·⁄ÀÊ— ⁄·ÌÂ." ) ;

	new Float:pl_health ;
	GetPlayerHealth ( params [ 0 ], pl_health ) ;
	set_health ( params [ 0 ], pl_health - 5 ) ;

	SetTimerEx ( "check_player_nop", 1400, false, "iif", playerid, params [ 0 ], pl_health ) ;
	return true;
}

callback:check_player_nop(playerid, targetid, Float:pl_health )
{
	new Float:new_health ;
	GetPlayerHealth ( targetid, new_health ) ;
	new gm_result [ 16 ] ;


	if ( new_health == pl_health )format ( gm_result, 16, " NOP" ) ;
	else format ( gm_result, 16, "NOP  " ) ;
	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBL"}*  {"#cGR"}%s[%d]  %s[%d]  GM | : %s", p_info [ playerid ] [ name ], playerid, p_info [ targetid ] [ name ], targetid, gm_result ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_gray, scm_string ) ;
	return 1 ;
}

CMD:sethunger ( playerid, params[])
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	if (sscanf ( params, "ud", params [ 0 ], params [ 1 ]) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /sethunger [ID] [«·„»·€]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
	if(params[1] > 100 || params [1] < 0) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·ÃÊ⁄ «·„»·€ „« Ìﬁœ— ÌﬂÊ‰ √ﬁ· „‰ 0 √Ê √ﬂÀ— „‰ 100." ) ;
	p_info [ params [ 0 ] ] [ hunger ] = params[1] ;
	new query_string [ 128 ];
	mysql_format ( sql_connection, query_string, sizeof query_string, "UPDATE `users` SET `u_hunger`='%d' WHERE `u_id`='%d'", p_info[params[0]][hunger], p_info[params[0]][id]);
	mysql_tquery ( sql_connection, query_string ) ;
	new td_string [ 64 ] ;
	format ( td_string, sizeof ( td_string ), "%d%", p_info [ params[0] ] [ hunger ] ) ;
	// PlayerTextDrawSetString ( params[0], Hunger[params[0]][1], td_string ) ;
	new scm_string [ 128 ] ;
	format ( scm_string, sizeof ( scm_string  ),"{"#cBL"}*  {"#cGR"}%s[%d] √⁄«œ „·¡ «·‘»⁄ %s[%d]", p_info [ playerid ] [ name ], playerid, p_info [ params [ 0 ] ] [ name ], params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_gray, scm_string ) ;
	return true;
}

CMD:fv( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ admin ] < 8 )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /fv [id]" ) ;
	if ( params [ 0 ] < 1 || params [ 0 ] > MAX_VEHICLES ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·”Ì«—… „«  „ «·⁄ÀÊ— ⁄·ÌÂ«." ) ;
	AC_RepairVehicle ( params [ 0 ] ) ;
