CMD:coin(playerid, params[])
{
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, 496.6786,-73.3024,999.6721)) return 1;
    if ( sscanf ( params, "ud", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: {ffffff}/⁄„·… [ID] [«·„»·€] " ) ;
    
 	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— ‰‘ÿ." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì„œÌﬂ  ·⁄» „⁄ ‰›”ﬂ." ) ;
	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ." ) ;
	if ( p_t_info [ params [ 0 ] ] [ p_dialog ] != -1 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–« «··«⁄» ⁄‰œÂ œÌ«·Êﬁ „› ÊÕ." ) ;
    if ( p_info [ playerid ] [ money ] < params [ 1 ] )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ Â«·ﬁœ— „‰ «·›·Ê”." ) ;
	if ( !(1 <= params [ 1 ] < 1000000) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì„œÌﬂ  —«Â‰ √ﬁ· „‰ 1$ Ê·« √ﬂÀ— „‰ 1.000.000$." ) ;

	
    
    SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}⁄—÷ﬂ  „ ≈—”«·Â° «‰ Ÿ— ‘ÊÌ ⁄‘«‰ Ì—œ"  ) ;
    new _t_string [ 138 ];
    format ( _t_string, sizeof ( _t_string ),"{"#cBL"}%s{"#cWH"} offered √‰  ≈·Ï gamble „⁄ him „⁄ {"#cGN"}$%d.\n\n{"#cBL"}«›⁄· √‰  „Ê«›ﬁ…?", p_info [ playerid ] [ name ], params [ 1 ] ) ;
    show_dialog ( params [ 0 ], d_bar_offer, DIALOG_STYLE_MSGBOX, "{"#cBL"}«·»«— ⁄—÷", _t_string, "yes", "no" ) ;

    SetPVarInt ( params [ 0 ], "bar_offer", playerid ) ;
    SetPVarInt ( params [ 0 ], "bar_amount", params [ 1 ] ) ;


    return 1;
}

CMD:fleave(playerid)
{
    if ( family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_settings ] [ 3 ] <= p_info [ playerid ] [ family_rang ] )
	{
		show_family ( playerid ) ;
		return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}ﬁ«∆œ «·⁄«∆·… „« Ìﬁœ— Œ—ÊÃ ÂÊ." ) ;
	}
	new fleavestring[159];
	format(fleavestring, sizeof(fleavestring), "UPDATE `family` SET `fam_members`='%d' WHERE `fam_id` = '%d'", family_info[p_info[playerid][family]-1][fam_members] - 1, p_info [ playerid ] [ family ] ) ;
	mysql_tquery(sql_connection, fleavestring);
	
	new fm_string [ 128 ] ;
    format ( fm_string, sizeof ( fm_string ), "{%s}[%s] %s %s[%i] Ì”«— «·⁄«∆·…!", family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_chat_color ],family_info[ p_info[playerid][family]-1 ][fam_name] , family_rank [ p_info [ playerid ] [ family ] - 1 ] [ p_info [ playerid ] [ family_rang ] - 1 ], p_info [ playerid ] [ name ], playerid ) ;
    family_message ( p_info [ playerid ] [ family ], col_gray, fm_string ) ;


    p_info [ playerid ] [ family ] = 0 ;
	p_info [ playerid ] [ family_rang ] = 0 ;
	
	if ( p_info [ playerid ] [ family_text ] != Text3D:INVALID_3DTEXT_ID )
	{
		DestroyDynamic3DTextLabel ( p_info [ playerid ] [ family_text ] ) ;
		p_info [ playerid ] [ family_text ] = Text3D:INVALID_3DTEXT_ID ;
	}

	format(fm_string, sizeof(fm_string), "UPDATE `users` SET `u_family`='0',u_family_rank='0' WHERE `u_id` = '%d'", p_info [ playerid ] [ id ] ) ;
	mysql_tquery(sql_connection, fm_string);
	return 1;
}

