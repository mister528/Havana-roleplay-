	SendClientMessage ( playerid, col_gray,string) ;
	return 1;
}

alias:ch("chase")
CMD:ch(playerid, params[])
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return 1 ;
	if ( p_info [ playerid ] [ rank ] < 4 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}›ﬁÿ „ Ê›— „‰ — »… 4." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /ch(ase) [ID/«·«”„]" ) ;
	if(!IsPlayerConnected(params[0])) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ" ) ;
	if(params[0] == playerid) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  ÿ«—œ ‰›”ﬂ" ) ;
	if(p_info[params[0]][wanted] == 0) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–« «··«⁄» „Ê ›Ì „ÿ·Ê» «·ﬁ«∆„…") ;
	new Float:px,Float:py,Float:pz;
	GetPlayerPos(playerid, px,py,pz);
	if(!IsPlayerInRangeOfPoint(params[0],15, px,py,pz)) return SendClientMessage(playerid,col_gray,"{"#cRD"}* {"#cGR"}Â–« «··«⁄» ÂÊ „—… »⁄Ìœ." ) ;
	Chase[params[0]] = playerid;
	ChaseTimer[params[0]] = 150;
	CopChaseTimer[playerid] = 150;
	OnlyChase[params[0]] = 1;
	Chase[playerid] = params[0];
	new fomr[128];
	format(fomr, sizeof(fomr),"{"#cYW"}‘—ÿÌ/≈› »Ì ¬Ì %s[%d] ⁄‰œ chased √‰ . ≈–« √‰  ≈€·«ﬁ  ·⁄»…, √‰  ”ÌﬂÊ‰  ·ﬁ«∆Ì« „”ÃÊ‰",p_info[playerid][name], playerid);
	SendClientMessage ( params[0], col_gray,fomr) ;
	SendClientMessage(params[0],col_white,"{"#cBL"}·«“„  ﬂÊ‰ 150 „ — »⁄Ìœ ⁄‰ «·‘—ÿÌ/≈› »Ì ¬Ì ÊÊﬁ  «·„ÿ«—œ… Œ·’ ⁄‘«‰ «·„ÿ«—œ…  ‰ ÂÌ Ê√‰   Â—».");
	SendClientMessage(params[0],col_white,"{"#cBL"}«œŒ· {"#cYW"}/mych{"#cBL"} ≈·Ï  ⁄—› Õﬁﬂ „ƒﬁ  «·„ÿ«—œ….");
	new fccomr[128];
	format(fccomr, sizeof(fccomr),"{"#cYW"}Õﬁﬂ chase ⁄‰œ »‰Ã«Õ »œ√, —ﬂ÷ »⁄œ %s[%d] «·ÕÌ‰!!",p_info[params[0]][name], params[0]);
	SendClientMessage ( playerid, col_gray,fccomr) ;
	return 1;
}

alias:tz("tazer")
CMD:tz(playerid)
{
    if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return 1 ;
    if(!IsPlayerConnected(playerid)) return 1;
    if(p_info[playerid][jailed] > 0) return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ—  ” Œœ„ Â–« «·√„— ·„« √‰  ›Ì  ”Ã‰");
    if(p_t_info [ playerid ] [ mp_tp ] == 1) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  ” Œœ„ Â–« «·√„— ·„« √‰  ›Ì  ”Ã‰");
    if(tazertimer[playerid] == 0)
    {
        tazertimer[playerid] = 300;
        give_weapon(playerid, 23, 50);
        SendClientMessage(playerid, col_green, "*{ffffff} ⁄‰œﬂ Õ’· ⁄·Ï  50 «·–ŒÌ—… „‰ ’«⁄ﬁ.");
    }
    else
    {
        new formm[128];
        format(formm, sizeof(formm), "·«“„  ‰ Ÿ— %d ÀÊ«‰Ì ﬁ»· Ì√Œ–  ’«⁄ﬁ „—… À«‰Ì….",tazertimer[playerid]);
        SendClientMessage(playerid,col_gray,formm);
    }
	return 1;
}

CMD:push ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid )  && ! fbi_player ( playerid ) && ! mafia_player ( playerid ) && ! gang_player ( playerid ) && ! terrorist_player ( playerid ) ) return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /push [ID/«·«”„]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." );
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  ÿ»ﬁ Â–« ⁄·Ï ‰›”ﬂ." ) ;
	if ( IsPlayerInAnyVehicle ( playerid ) || IsPlayerInAnyVehicle ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  √Ê Õﬁﬂ Âœ› ÂÊ ”»ﬁ Ê ›Ì ”Ì«—…." ) ;
	if ( ! GetPVarInt ( params [ 0 ], "PlayerTied") && ! GetPVarInt ( params [ 0 ], "PlayerCuffed") )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"{«··«⁄» ·«“„ ÌﬂÊ‰ „ﬂ»¯· √Ê „ﬁÌ¯œ." ) ;

	if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;

	new veh_id = GetPlayerNearestVehicle ( playerid ) ;
	if ( veh_id != INVALID_VEHICLE_ID )
	{
		if ( veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_server || veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ member ] )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ ﬁ—Ì» „‰ «·‰ﬁ· «·—”„Ì." ) ;
		new seatid = GetVehicleFreeSeat ( veh_id ) ;
		if ( seatid != - 1 )
		{
			AC_PutPlayerInVehicle ( params [ 0 ], veh_id, seatid ) ;
			new scm_string [ 46 + ( MAX_PLAYER_NAME * 2 ) ] ;
			format ( scm_string, sizeof ( scm_string ), "%s ·ÊÏ %s's «·√ÌœÌ Ê ÷⁄ %s ≈·Ï œ«Œ·  ‰ﬁ·.", p_info [ playerid ] [ name ], (p_info [ playerid ] [ gender ]==1)?(""):("a"), p_info [ params [ 0 ] ] [ name ], (p_info [ playerid ] [ gender ]==1)?(""):("a") ) ;
			SetPlayerChatBubble(playerid, scm_string,0xDD90FFFF, 10.0, 10000 ) ;
		}
		else SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ›Ì „ﬁ«⁄œ ›«÷Ì… ›Ì √ﬁ—» „—ﬂ»… ‰ﬁ·." ) ;
	}

	else SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}ÌÊÃœ ·« ‰ﬁ· ﬁ—Ì» √‰ ." ) ;
	return 1;
}

CMD:mask ( playerid )
{
	if ( ! p_info [ playerid ] [ mask ] ) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ «·ﬁ‰«⁄.");
	if ( GetPVarInt(playerid,"p_masked")) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}„ﬁ‰¯⁄ ﬁ»·.");
	if(GetPVarInt(playerid, "on_dmarena") || GetPVarInt(playerid, "on_dmarena1")) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–« „Ê „„ﬂ‰ ›Ì „‰ÿﬁ… «·‹ DM." ) ;

	p_info [ playerid ] [ mask ] -- ;
	update_int_sql ( playerid, "u_mask", p_info [ playerid ] [ mask ] ) ;
	havana_push_inv_update ( playerid ) ;


	SetPlayerColor(playerid, 0x7a766700);
	SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „ «— œ«¡ «·ﬁ‰«⁄ - «ﬂ » /unmask ·«“«·… «·ﬁ‰«⁄" ) ;
 	GameTextForPlayer(playerid, "~b~Mask ON", 5000, 3);
  	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT && ! GetPVarInt ( playerid, "PlayerCuffed" )&& ! GetPVarInt ( playerid, "PlayerTied" ) )ApplyAnimation(playerid, "shop","ROB_Shifty",4.0,0,0,0,0,0,1);
	SetPlayerChatBubble(playerid, "puts on a mask", 0xDD90FFFF, 30.0, 10000 ) ;
	if ( ! p_info [ playerid ] [ enhancement ] [ 3 ] ) SetPVarInt ( playerid, "p_masked", 900 ) ;
	else SetPVarInt ( playerid, "p_masked", 1800 ) ;
	return 1;
}

CMD:unmask ( playerid )
{
	if ( ! GetPVarInt(playerid,"p_masked" ) ) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}„Ê ·«»” «·ﬁ‰«⁄.");
	if ( ! p_info [ playerid ] [ member ] ) SetPlayerColor ( playerid, 0xFFFFFF80 ) ; // col_white
	if ( p_info [ playerid ] [ member ] ) SetPlayerColor ( playerid, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;
	SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „ ≈“«·… «·ﬁ‰«⁄." ) ;
	DeletePVar ( playerid, "p_masked" ) ;
	return 1 ;
}

CMD:usedrugs ( playerid )
{
	if ( p_info [ playerid ] [ drugs ] <= 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ «·„Œœ—« ." ) ;
	if ( is_drug_effect { playerid } >= 1 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— Œ– «·„Œœ—«  »Ì‰„« ”ﬂ—«‰. «‰ Ÿ— 60 ÀÊ«‰Ì." ) ;
	
	if(DrugsLevel[playerid] == 4)
	{
	    is_drug_effect { playerid } = 60 ;

		p_info [ playerid ] [ drugs ] -= 1 ;
		update_int_sql ( playerid, "u_drugs", p_info [ playerid ] [ drugs ] ) ;

		ApplyAnimation ( playerid,"GANGS","smkcig_prtl_F",4.0,0,1,1,1,1 ) ;
		SetPlayerTime ( playerid, 17, 0 ) ;
		SetPlayerDrunkLevel ( playerid, 3000 ) ;
		SetPlayerWeather ( playerid, - 68 ) ;

		new Float:pl_health ;
		GetPlayerHealth ( playerid, pl_health ) ;
		if ( pl_health + 20 > 100 ) set_health ( playerid, 100 ) ;
		else set_health ( playerid, pl_health + 20 ) ;

		DrugsLevel[playerid] = 0;

		GameTextForPlayer ( playerid, "~g~+20’Õ…", 2000, 1 ) ;
		me_action ( playerid, "Ì√Œ– «·„Œœ—«  Ê ÌÕ’· ⁄·Ï ”ﬂ—«‰") ;
	    return 1;
	}

	p_info [ playerid ] [ drugs ] -= 1 ;
	update_int_sql ( playerid, "u_drugs", p_info [ playerid ] [ drugs ] ) ;

	ApplyAnimation ( playerid,"GANGS","smkcig_prtl_F",4.0,0,1,1,1,1 ) ;

	new Float:pl_health ;
	GetPlayerHealth ( playerid, pl_health ) ;
	if ( pl_health + 20 > 100 ) set_health ( playerid, 100 ) ;
	else set_health ( playerid, pl_health + 20 ) ;
	
	DrugsLevel[playerid] += 1;

	GameTextForPlayer ( playerid, "~g~+20’Õ…", 2000, 1 ) ;
	me_action ( playerid, "Ì√Œ– «·„Œœ—« ") ;
	return 1;
}

