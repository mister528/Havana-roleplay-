	format ( scm_string, sizeof ( scm_string  ),"{"#cBL"}*  {"#cGR"}%s[%d]   | ID:%d", p_info [ playerid ] [ name ], playerid, params [ 0 ] ) ;
	foreach(new i: admin_players)SendClientMessage ( i, col_gray, scm_string ) ;
	return 1;
}

