	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." );
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— «”Õ» ‰›”ﬂ." ) ;

	if ( p_info [ params [ 0 ] ] [ jailed ] > 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» ›Ì «·”Ã‰." ) ;
	if ( ! GetPVarInt ( params [ 0 ], "PlayerTied") && ! GetPVarInt ( params [ 0 ], "PlayerCuffed") )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"{«··«⁄» ·«“„ ÌﬂÊ‰ „ﬂ»¯· √Ê „ﬁÌ¯œ." ) ;

	if ( IsPlayerInAnyVehicle ( playerid ) || IsPlayerInAnyVehicle ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  √Ê Õﬁﬂ Âœ› ÂÊ ›Ì ”Ì«—…." ) ;
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;

    SetPVarInt ( playerid, "player_gotome", params [ 0 ] + 1 ) ;
    gotome_player [ params [ 0 ] ] = playerid ;

	new scm_string [ 58 + MAX_PLAYER_NAME ] ;
	format ( scm_string, sizeof ( scm_string ), "{"#cGN"}* {"#cWH"}√‰  led {"#cGN"}%s{"#cWH"} Œ·› √‰ .", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;
    return 1;
}
alias:mych("mychase","mychasetimer","mychtimer","mychtime","chasetimer","chtime")
