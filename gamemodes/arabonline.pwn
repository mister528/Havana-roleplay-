stock Quest_GetMissionStatusText(playerid, mission, dest[], len)
{
	new stage = 0, reward = 0;
	switch (mission)
	{
		case 0: { stage = p_info[playerid][MissionOne]; reward = p_info[playerid][MissionOneReward]; }
		case 1: { stage = p_info[playerid][MissionThree]; reward = p_info[playerid][MissionThreeReward]; }
		case 2: { stage = p_info[playerid][MissionSeven]; reward = p_info[playerid][MissionSevenReward]; }
		case 3: { stage = p_info[playerid][MissionSix]; reward = p_info[playerid][MissionSixReward]; }
		case 4: { stage = p_info[playerid][MissionEleven]; reward = p_info[playerid][MissionElevenReward]; }
		case 5: { stage = p_info[playerid][MissionFive]; reward = p_info[playerid][MissionFiveReward]; }
		case 6: { stage = p_info[playerid][MissionNine]; reward = p_info[playerid][MissionNineReward]; }
		case 7: { stage = p_info[playerid][MissionEight]; reward = p_info[playerid][MissionEightReward]; }
		case 8: { stage = p_info[playerid][MissionTen]; reward = p_info[playerid][MissionTenReward]; }
		case 9: { stage = p_info[playerid][MissionTwo]; reward = p_info[playerid][MissionTwoReward]; }
		case 10: { stage = p_info[playerid][MissionFour]; reward = p_info[playerid][MissionFourReward]; }
		case 11: { stage = p_info[playerid][MissionTwelve]; reward = p_info[playerid][MissionTwelveReward]; }
		case 12: { stage = p_info[playerid][MissionThirteen]; reward = p_info[playerid][MissionThirteenReward]; }
		case 13: { stage = p_info[playerid][MissionFourteen]; reward = p_info[playerid][MissionFourteenReward]; }
		case 14: { stage = p_info[playerid][MissionSixteen]; reward = p_info[playerid][MissionSixteenReward]; }
		case 15: { stage = p_info[playerid][MissionSeventeen]; reward = p_info[playerid][MissionSeventeenReward]; }
		case 16: { stage = p_info[playerid][MissionEighteenth]; reward = p_info[playerid][MissionEighteenthReward]; }
		case 17: { stage = p_info[playerid][MissionNineteen]; reward = p_info[playerid][MissionNineteenReward]; }
	}
	if ( stage == 0 ) format ( dest, len, "{"#cRD"}€Ì— „ﬂ „·" ) ;
	else if ( stage == 1 ) format ( dest, len, "{"#cYW"}ﬁÌœ «· ‰›Ì–" ) ;
	else if ( stage == 2 && reward == 0 ) format ( dest, len, "{"#cBL"}«÷€ÿ ··«” ·«„" ) ;
	else format ( dest, len, "{"#cGN"}„ﬂ „·" ) ;
	return 1;
}

public Quest_OpenMenuDeferred(playerid)
{
	if ( ! IsPlayerConnected ( playerid ) ) return 1;
	if ( GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT ) return 1;

	new bool:near_quest_actor = false;
	for ( new j = 0 ; j < MAX_QUEST_ACTORS ; j ++ )
	{
		if ( IsPlayerInRangeOfPoint ( playerid, 5.0, quest_actor [ j ] [ actor_pos ] [ 0 ], quest_actor [ j ] [ actor_pos ] [ 1 ], quest_actor [ j ] [ actor_pos ] [ 2 ] ) )
		{
			near_quest_actor = true;
			break;
		}
	}
	if ( ! near_quest_actor )
	{
		g_quest_menu_lock [ playerid ] = false;
		return 1;
	}
	g_quest_menu_lock [ playerid ] = true;

	new s0[32], s1[32], s2[32], s3[32], s4[32], s5[32], s6[32], s7[32], s8[32], s9[32], s10[32], s11[32], s12[32], s13[32], s14[32], s15[32], s16[32], s17[32];
	Quest_GetMissionStatusText(playerid, 0, s0, sizeof s0);
	Quest_GetMissionStatusText(playerid, 1, s1, sizeof s1);
	Quest_GetMissionStatusText(playerid, 2, s2, sizeof s2);
	Quest_GetMissionStatusText(playerid, 3, s3, sizeof s3);
	Quest_GetMissionStatusText(playerid, 4, s4, sizeof s4);
	Quest_GetMissionStatusText(playerid, 5, s5, sizeof s5);
	Quest_GetMissionStatusText(playerid, 6, s6, sizeof s6);
	Quest_GetMissionStatusText(playerid, 7, s7, sizeof s7);
	Quest_GetMissionStatusText(playerid, 8, s8, sizeof s8);
	Quest_GetMissionStatusText(playerid, 9, s9, sizeof s9);
	Quest_GetMissionStatusText(playerid, 10, s10, sizeof s10);
	Quest_GetMissionStatusText(playerid, 11, s11, sizeof s11);
	Quest_GetMissionStatusText(playerid, 12, s12, sizeof s12);
	Quest_GetMissionStatusText(playerid, 13, s13, sizeof s13);
	Quest_GetMissionStatusText(playerid, 14, s14, sizeof s14);
	Quest_GetMissionStatusText(playerid, 15, s15, sizeof s15);
	Quest_GetMissionStatusText(playerid, 16, s16, sizeof s16);
	Quest_GetMissionStatusText(playerid, 17, s17, sizeof s17);

	new dialog_string[1800];
	format(dialog_string, sizeof dialog_string,
		"{"#cYW"}1.{"#cWH"}„Â„… «·»‰«¡\t\t%s\n{"#cYW"}2.{"#cWH"}„Â„… «·„‰‘—…\t\t%s\n{"#cYW"}3.{"#cWH"} Ê’Ì· «·»Ì “«\t\t%s\n{"#cYW"}4.{"#cWH"}⁄«„· «·„‰Ã„\t\t%s\n{"#cYW"}5.{"#cWH"}⁄«„· «·„’‰⁄\t\t%s\n{"#cYW"}6.{"#cWH"}—Œ’… «·ﬁÌ«œ…\t\t%s\n{"#cYW"}7.{"#cWH"}—Œ’… «·ÿÌ—«‰\t\t%s\n{"#cYW"}8.{"#cWH"}—Œ’… «·ﬁ«—»\t\t%s\n{"#cYW"}9.{"#cWH"}—Œ’… «·”·«Õ\t\t%s\n{"#cYW"}10.{"#cWH"}‘—«¡ ÃÊ«·\t\t%s\n{"#cYW"}11.{"#cWH"} €ÌÌ— «·»Ì \t\t%s\n{"#cYW"}12.{"#cWH"}„Â„… «·»‰«¡ 2\t\t%s\n{"#cYW"}13.{"#cWH"}⁄«„· «·„‰Ã„ 2\t\t%s\n{"#cYW"}14.{"#cWH"} Ê’Ì· «·»Ì “« 2\t\t%s\n{"#cYW"}15.{"#cWH"}”—ﬁ… ”Ì«—…\t\t%s\n{"#cYW"}16.{"#cWH"} ”·Ì„ ”Ì«—…\t\t%s\n{"#cYW"}17.{"#cWH"} Ê’Ì· «·»Ì “« 3\t\t%s\n{"#cYW"}18.{"#cWH"}⁄«„· «·„‰Ã„ 3\t\t%s",
		s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17);

	return show_dialog(playerid, d_questsm, DIALOG_STYLE_LIST, "{"#cBL"}„Â„«  «·„» œ∆Ì‰", dialog_string, "«Œ —", "≈€·«ﬁ");
}

// [GREEN ZONE WARN] central helper used by the 4 enforcement points
// (give-damage / weapon-shot / generic damage / on-update draw guard).
stock GreenZone_Warn ( playerid )
{
    if ( !IsPlayerConnected ( playerid ) ) return 0;
    new tick = GetTickCount ( ) ;
    if ( gz_warn_cooldown [ playerid ] && tick - gz_warn_cooldown [ playerid ] < 1500 ) return 0;
    gz_warn_cooldown [ playerid ] = tick ;
    gz_violations [ playerid ] ++ ;
    SetPlayerArmedWeapon ( playerid, 0 ) ;
    ApplyAnimation ( playerid, "ped", "HANDSCOWER", 4.1, 0, 1, 1, 0, 0 ) ;
    new buf [ 32 ] ;
    format ( buf, sizeof buf, "~GZ_WARN~%d", gz_violations [ playerid ] ) ;
    SendClientMessage ( playerid, 0xFFFFFFFF, buf ) ;
    if ( gz_violations [ playerid ] >= GZ_MAX_VIOLATIONS )
    {
        SendClientMessage ( playerid, 0xE85C70FF, "«‰   „ ÿ—œﬂ »”»» „Õ«Ê·«  „ ﬂ——… œ«Œ· «·„‰ÿﬁ… «·„Õ„Ì… - «·÷—» Ê≈ÿ·«ﬁ «·‰«— „„‰Ê⁄" ) ;
        SetTimerEx ( "GreenZone_DoKick", 800, 0, "i", playerid ) ;
    }
    return 1;
}
forward GreenZone_DoKick ( playerid ) ;
public  GreenZone_DoKick ( playerid )
{
    if ( !IsPlayerConnected ( playerid ) ) return 1;
    Kick ( playerid ) ;
    return 1 ;
}
stock GreenZone_ResetViolations ( playerid )
{
    gz_violations [ playerid ] = 0 ;
    gz_warn_cooldown [ playerid ] = 0 ;
    if ( IsPlayerConnected ( playerid ) ) SendClientMessage ( playerid, 0xFFFFFFFF, "~GZ_WARN~RESET" ) ;
    return 1 ;
}

stock kick_player ( playerid )
{
	new ms = GetPlayerPing ( playerid ) > 200 ? 200 : GetPlayerPing ( playerid ) + 50 ;
	return SetTimerEx ( "fixed_kick", ms, 0, "i", playerid ) ;
}
callback: fixed_kick ( playerid )
{
	if ( ! IsPlayerConnected ( playerid ) ) return 1 ;
	Kick ( playerid ) ;
	return 1 ;
}

stock set_interior ( playerid, interior )
{
	p_t_info [ playerid ] [  p_data ] [ 0 ] = interior ;
	return SetPlayerInterior ( playerid, interior ) ;
}
stock set_world ( playerid, world )
{
	p_t_info [ playerid ] [ p_data ] [ 1 ] = world ;
	if ( p_t_info [ playerid ] [ p_logged ] == true && GetPVarInt ( playerid, "exam_vehicle" ) == 0 && is_drug_effect { playerid } == 0)
	{
		switch(world)
		{
			case 0:
			{
				new newhour, newminute, newsecond ;
				gettime ( newhour, newminute, newsecond ) ;
				SetPlayerTime ( playerid, newhour, newminute ), SetPlayerWeather ( playerid, global_weather ) ;
			}
			case 1..9: SetPlayerWeather ( playerid, 4 ), SetPlayerTime ( playerid, 18, 0 ) ;
			case 10:SetPlayerTime ( playerid, 12, 0 ), SetPlayerWeather ( playerid, global_weather ) ;
		}
	}
	if ( GetPVarInt ( playerid, "p_biz_id" ) != 0 )SetPlayerWeather ( playerid, 4 ), SetPlayerTime ( playerid, 18, 0 ) ;
	return SetPlayerVirtualWorld ( playerid, world ) ;
}

stock set_race_pos ( playerid, Float:x, Float:y, Float:z, Float:angle, interior, world )
{
	if ( world == 0 && p_t_info [ playerid ] [ p_data ] [ 1 ] != 0 && is_drug_effect { playerid } == 0) SetPlayerWeather ( playerid, global_weather ), SetPlayerTime ( playerid, global_hour, 0  ) ;
	if ( interior != -1 ) set_interior ( playerid, interior ) ;


	if ( world != -1 ) set_world ( playerid, world ) ;


	p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;
	SetPlayerPos ( playerid, x, y, z ) ;
	SetPlayerFacingAngle ( playerid, angle ) ;
	p_t_info [ playerid ] [ p_pos ] [ 0 ] = x ;
	p_t_info [ playerid ] [ p_pos ] [ 1 ] = y ;
	p_t_info [ playerid ] [ p_pos ] [ 2 ] = z ;
	p_t_info [ playerid ] [ p_pos ] [ 3 ] = angle ;

	p_t_info [ playerid ] [ p_ab_warnings ] = 0 ;
	if ( gotome_player [ playerid ] != -1 )
	{
		p_t_info [ gotome_player [ playerid ] ] [ p_tp_immune_time ] = 2 ;
		SetPlayerPos ( gotome_player [ playerid ], x, y, z ) ;
		SetPlayerFacingAngle ( gotome_player [ playerid ], angle ) ;
		p_t_info [ gotome_player [ playerid ] ] [ p_pos ] [ 0 ] = x ;
		p_t_info [ gotome_player [ playerid ] ] [ p_pos ] [ 1 ] = y ;
		p_t_info [ gotome_player [ playerid ] ] [ p_pos ] [ 2 ] = z ;
		p_t_info [ gotome_player [ playerid ] ] [ p_pos ] [ 3 ] = angle ;
		set_world ( gotome_player [ playerid ], world ) ;
		set_interior ( gotome_player [ playerid ], interior ) ;
	}

	ClearAnimations ( playerid, 1 ) ;
	SetCameraBehindPlayer ( playerid ) ;
	foreach(new i: admin_players)
	{
		if ( GetPVarInt ( i, "spectate_status" ) - 1 == playerid )
		{
			switch ( GetPlayerState ( playerid ) )
			{
				case 1:
				{
					SetPlayerInterior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					SetPlayerVirtualWorld ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					AC_TogglePlayerSpectating ( i, true ) ;
					PlayerSpectatePlayer ( i, playerid ) ;
				}
				case 2:
				{
					SetPlayerInterior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					SetPlayerVirtualWorld ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					AC_TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle ( i, veh_id ) ;
				}
				case 3:
				{
					SetPlayerInterior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					SetPlayerVirtualWorld ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					AC_TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle (i, veh_id ) ;
				}
			}
		}
	}

//	p_t_info [ playerid ] [ p_tp_ac_timer ] = SetTimerEx ( "ac_check", 12000, 0, "ifff", playerid, x, y, z ) ;
	return 1;
}

stock Float:GetDistanceBetweenPlayers(p1,p2)
{
	if(!IsPlayerConnected(p1) || !IsPlayerConnected(p2))
	{
		return -1.00;
	}
	new Float:x1,Float:y1,Float:z1,Float:x2,Float:y2,Float:z2;
	GetPlayerPos(p1,x1,y1,z1);
	GetPlayerPos(p2,x2,y2,z2);
	return floatsqroot(floatpower(floatabs(floatsub(x2,x1)),2)+floatpower(floatabs(floatsub(y2,y1)),2)+floatpower(floatabs(floatsub(z2,z1)),2));
}


stock set_pos ( playerid, Float:x, Float:y, Float:z, Float:angle, interior, world )
{
	if ( world == 0 && p_t_info [ playerid ] [ p_data ] [ 1 ] != 0 && is_drug_effect { playerid } == 0) SetPlayerWeather ( playerid, global_weather ), SetPlayerTime ( playerid, global_hour, 0  ) ;
	if ( interior != -1 ) set_interior ( playerid, interior ) ;

	if ( world != -1 ) set_world ( playerid, world ) ;
	if ( p_t_info [ playerid ] [ p_tp_ac_timer ] ) KillTimer ( p_t_info [ playerid ] [ p_tp_ac_timer ] ), p_t_info [ playerid ] [ p_tp_ac_timer ] = - 1 ;

	p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;
	SetPlayerPos ( playerid, x, y, z ) ;
	SetPlayerFacingAngle ( playerid, angle ) ;
	p_t_info [ playerid ] [ p_pos ] [ 0 ] = x ;
	p_t_info [ playerid ] [ p_pos ] [ 1 ] = y ;
	p_t_info [ playerid ] [ p_pos ] [ 2 ] = z ;
	p_t_info [ playerid ] [ p_pos ] [ 3 ] = angle ;

	p_t_info [ playerid ] [ last_alt ] = GetTickCount ( ) ;

	p_t_info [playerid][ old_pos ][0] = x;
	p_t_info [playerid][ old_pos ][1] = y;
	p_t_info [playerid][ old_pos ][2] = z;

	p_t_info [ playerid ] [ real_pos ] [ 0 ] = x ;
	p_t_info [ playerid ] [ real_pos ] [ 1 ] = y ;
	p_t_info [ playerid ] [ real_pos ] [ 2 ] = z ;

	p_t_info [ playerid ] [ p_ab_warnings ] = 0 ;

	ClearAnimations ( playerid, 1 ) ;
	SetCameraBehindPlayer ( playerid ) ;
	foreach(new i: admin_players)
	{
		if ( GetPVarInt ( i, "spectate_status" ) - 1 == playerid )
		{
			switch ( GetPlayerState ( playerid ) )
			{
				case 1:
				{
					SetPlayerInterior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					SetPlayerVirtualWorld ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					AC_TogglePlayerSpectating ( i, true ) ;
					PlayerSpectatePlayer ( i, playerid ) ;
				}
				case 2:
				{
					SetPlayerInterior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					SetPlayerVirtualWorld ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					AC_TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle ( i, veh_id ) ;
				}
				case 3:
				{
					SetPlayerInterior ( i, p_t_info [ playerid ][ p_data ] [ 0 ] ) ;
					SetPlayerVirtualWorld ( i, p_t_info [ playerid ][ p_data ] [ 1 ] ) ;
					new veh_id = GetPlayerVehicleID ( playerid ) ;
					AC_TogglePlayerSpectating ( i, true ) ;
					PlayerSpectateVehicle (i, veh_id ) ;
				}
			}
		}
	}

	p_t_info [ playerid ] [ p_tp_ac_timer ] = SetTimerEx ( "ac_check", 7500, false, "ifff", playerid, x, y, z ) ;

    if(p_info[playerid][load_textures] == 1) ShowPlayerLoadScreen ( playerid, 2 ) ;
    else
    {
		TogglePlayerControllable(playerid,0);
		SetTimerEx("Load_Texture_Off", 1500, false, "d", playerid);
    }
	return 1;
}

callback: SetRandomGLWeather()
{
	new string[128] ;

	if ( random_weather == 1 || random_weather == 18 ) random_weather = random ( 2 ) + 1 ;
	else if ( random_weather > 1 || random_weather < 4 ) random_weather = random ( 4 ) + 1 ;
	else
	{
		if ( random ( 2 ) == 1 ) random_weather = 1 ;
		else random_weather = 18 ;
	}

	format(
		string,
		sizeof string,
		"Weather forecast: expected %s {9ACD32}(-%d ¬∞–°)",
		gl_weather[random_weather][W_NAME],
		gl_weather[random_weather][W_DEGREES]);

	foreach(new i: logged_players)
		SendClientMessage(
			i,
			col_yellow,
			string);

	SetWeather(gl_weather[random_weather][W_ID]);
}

callback: az_loading ( )
{
	new fields ;
	cache_get_data ( az_count, fields ) ;
	if ( az_count )
	{
        for ( new t = 0 ; t < az_count ; t ++ )
        {
			az_info [ t ] [ az_id ] = cache_get_field_content_int ( t, "az_id", sql_connection ) ;
			az_info [ t ] [ az_owner ] = cache_get_field_content_int ( t, "az_owner", sql_connection ) ;
			az_info [ t ] [ az_spawn ] = cache_get_field_content_int ( t, "az_spawn", sql_connection ) ;

			az_info [ t ] [ az_pos ] [ 0 ] = cache_get_field_content_float ( t, "az_x", sql_connection ) ;
			az_info [ t ] [ az_pos ] [ 1 ] = cache_get_field_content_float ( t, "az_y", sql_connection ) ;
			az_info [ t ] [ az_pos ] [ 2 ] = cache_get_field_content_float ( t, "az_z", sql_connection ) ;
			az_info [ t ] [ az_pos ] [ 3 ] = cache_get_field_content_float ( t, "az_a", sql_connection ) ;

			az_info [ t ] [ az_created ] = GangZoneCreate ( az_info [ t ] [ az_pos ] [ 0 ],
															az_info [ t ] [ az_pos ] [ 1 ],
															az_info [ t ] [ az_pos ] [ 2 ],
															az_info [ t ] [ az_pos ] [ 3 ] ) ;

		}
	}

	printf ( "LOADING: Army Terrorist zone %d loaded.", az_count ) ;
	return 1 ;
}

stock SaveAzZone ( az_zoneid )
{
	new query_string [ 76 ];
    format ( query_string, 76, "UPDATE `az_zones` SET `az_owner`= '%d' WHERE `az_id` = '%d' LIMIT 1", az_info [ az_zoneid ] [ az_owner ], az_info [ az_zoneid ] [ az_id ] ) ;
	mysql_tquery ( sql_connection, query_string, "", "" ) ;
	return 1 ;
}

