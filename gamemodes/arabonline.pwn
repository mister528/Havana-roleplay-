callback: anticheat_loading()
{
    new rows, fields;
    cache_get_data ( rows, fields ) ;
    if(rows)
    {
         for(new i = 0; i < AC_MAX_CODES; i++)
        {
            AC_CODE_TRIGGER_TYPE[i] = cache_get_field_content_int(i, ""AC_TABLE_FIELD_TRIGGER"");

            if(AC_CODE_TRIGGER_TYPE[i] == AC_CODE_TRIGGER_TYPE_DISABLED)
                EnableAntiCheat(i, 0);
        }
    }
    return printf("[SERVER]   : %d.", rows);
}

callback: graffity_loading()
{
	new f;
	cache_get_data(CountGraffity, f);
	for( new t = 0; t < CountGraffity; t++)
	{
		new object;
		graf_info[t][g_id] = cache_get_row_int(t,0, sql_connection);
		graf_info[t][g_member] = cache_get_row_int(t,1, sql_connection);
		graf_info[t][gr_x][0] = cache_get_row_float(t,2, sql_connection);
		graf_info[t][gr_x][1] = cache_get_row_float(t,3, sql_connection);
		graf_info[t][gr_x][2] = cache_get_row_float(t,4, sql_connection);
		graf_info[t][gr_x][3] = cache_get_row_float(t,5, sql_connection);
		graf_info[t][gr_x][4] = cache_get_row_float(t,6, sql_connection);
		graf_info[t][gr_x][5] = cache_get_row_float(t,7, sql_connection);
		graf_info[t][gr_x][6] = cache_get_row_float(t,8, sql_connection);

		switch(graf_info[t][g_member])
		{
			case 0: object = 1525;
			case 18: object = 18659;
			case 22: object = 18661;
			case 21: object = 18663;
			case 19: object = 18664;
			case 20: object = 18665;
		}
		graf_info[t][g_object] = CreateDynamicObject(object, graf_info[t][gr_x][0], graf_info[t][gr_x][1], graf_info[t][gr_x][2], 0.0, 0.0, graf_info[t][gr_x][6]);
		CreateDynamic3DTextLabel("«÷€ÿ: {"#cWH"}\"H\"", col_blue, graf_info[t][gr_x][0], graf_info[t][gr_x][1], graf_info[t][gr_x][2], 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1);
	}
	if(CountGraffity == 0) print ( "LOADING: No graffiti found in database." ) ;
	else printf ( "LOADING: %i graffiti has been uploaded.", CountGraffity ) ;
	return 1;
}


const UNOCCUPIED_SYNC = 209;

IPacket:UNOCCUPIED_SYNC(playerid, BitStream:bs)
{
    new unoccupiedData[PR_UnoccupiedSync];

    BS_IgnoreBits(bs, 8);
    BS_ReadUnoccupiedSync(bs, unoccupiedData);

    if(!(-1.0 <= unoccupiedData[PR_roll][0] <= 1.0)
        || !(-1.0 <= unoccupiedData[PR_roll][1] <= 1.0)
        || !(-1.0 <= unoccupiedData[PR_roll][2] <= 1.0)
        || !(-1.0 <= unoccupiedData[PR_direction][0] <= 1.0)
        || !(-1.0 <= unoccupiedData[PR_direction][1] <= 1.0)
        || !(-1.0 <= unoccupiedData[PR_direction][2] <= 1.0)
        || !(-15000.0 <= unoccupiedData[PR_position][0] <= 15000.0)
        || !(-15000.0 <= unoccupiedData[PR_position][1] <= 15000.0)
        || !(-15000.0 <= unoccupiedData[PR_position][2] <= 15000.0)
    )
	{
    	return false;
    }
    return true;
}

