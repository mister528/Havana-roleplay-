CMD:asetbizprod(playerid, params[])
{
	if(p_info[playerid][admin] < 5) return SendClientMessage(playerid, 0xFF6A6AFF, "[„‘—›] Ì·“„ «·„” ÊÏ 5 √Ê √⁄·Ï.");
	new bid, amount;
	if(sscanf(params, "ii", bid, amount)) return SendClientMessage(playerid, 0xFFAA00FF, "«·«” Œœ«„: /asetbizprod [biz_ID] [«·„»·€]");
	if(bid < 1 || bid > MAX_BUSINESS) return SendClientMessage(playerid, 0xFF6A6AFF, "biz ID €Ì— ’«·Õ.");
	new _b = -1, i;
	for(i = 0; i < MAX_BUSINESS; i++) if(b_info[i][b_id] == bid) { _b = i; break; }
	if(_b == -1) return SendClientMessage(playerid, 0xFF6A6AFF, "«·„Õ· €Ì— „ÊÃÊœ.");
	if(amount < 0) amount = 0;
	if(amount > b_info[_b][b_maxproduct]) amount = b_info[_b][b_maxproduct];
	b_info[_b][b_product] = amount;
	new q[180];
	format(q, sizeof(q), "UPDATE `businesses` SET `b_product` = '%d' WHERE `b_id` = '%d' LIMIT 1", amount, bid);
	mysql_tquery(sql_connection, q);
	new msg[144];
	format(msg, sizeof(msg), "[„‘—›] Biz #%d (%s) «·„Œ“Ê‰ ÷⁄ ≈·Ï %d / %d.", bid, b_info[_b][b_owner_name], amount, b_info[_b][b_maxproduct]);
	SendClientMessage(playerid, 0x00FF66FF, msg);
	return 1;
}

stock ShowPlayer_AntiCheatSettings(playerid)
{
    static
        dialog_string_t[128 + 32 - 8 + (AC_MAX_CODE_LENGTH + AC_MAX_CODE_NAME_LENGTH + AC_MAX_TRIGGER_TYPE_NAME_LENGTH + 10)*AC_MAX_CODES_ON_PAGE] = EOS;

    new
        triggeredCount = 0,
        page = pAntiCheatSettingsPage{playerid},
        next = 0,
        index = 0;

    dialog_string_t = ""c_white"Name\t"c_white"Punishment\t"c_white"Number of operations\n";

    for(new i = 0; i < AC_MAX_CODES; i++)
    {
        if(i >= (page * AC_MAX_CODES_ON_PAGE) && i < (page * AC_MAX_CODES_ON_PAGE) + AC_MAX_CODES_ON_PAGE)
            next++;

        if(i >= (page - 1) * AC_MAX_CODES_ON_PAGE && i < ((page - 1) * AC_MAX_CODES_ON_PAGE) + AC_MAX_CODES_ON_PAGE)
        {
            triggeredCount = AC_CODE_TRIGGERED_COUNT[i];

            format(dialog_string_t, sizeof(dialog_string_t), "%s"c_server"%s |"c_white" %s\t%s\t"c_orange_red"%d\n",
                dialog_string_t,
                AC_CODE[i],
                AC_CODE_NAME[i],
                AC_TRIGGER_TYPE_NAME[AC_CODE_TRIGGER_TYPE[i]],
                triggeredCount);

            pAntiCheatSettingsMenuListData[playerid][index++] = i;
        }
    }

    if(next)
        strcat(dialog_string_t, ""AC_DIALOG_NEXT_PAGE_TEXT"\n");

    if(page > 1)
        strcat(dialog_string_t, AC_DIALOG_PREVIOUS_PAGE_TEXT);

    return show_dialog(playerid, d_anticheat_settings, DIALOG_STYLE_TABLIST_HEADERS, !""c_white"‰Ÿ«„ „ﬂ«›Õ… «·€‘ ≈⁄œ«œ« ", dialog_string_t, !"«Œ —", !"„·€Ï");
}

//    Yes    Yes  -
stock ShowPlayer_AntiCheatEditCode(playerid, code)
{
    new
        dialog_header[22 - 4 + AC_MAX_CODE_LENGTH + AC_MAX_CODE_NAME_LENGTH],
        dialog_string[AC_MAX_TRIGGER_TYPE_NAME_LENGTH*AC_MAX_TRIGGER_TYPES];

    format(dialog_header, sizeof(dialog_header), ""c_white"‰Ÿ«„ „ﬂ«›Õ… «·€‘: [%s] %s", AC_CODE[code], AC_CODE_NAME[code]);

    for(new i = 0; i < AC_MAX_TRIGGER_TYPES; i++)
    {
        strcat(dialog_string, AC_TRIGGER_TYPE_NAME[i]);

        if(i + 1 != AC_MAX_TRIGGER_TYPES)
            strcat(dialog_string, "\n");
    }

    return show_dialog(playerid, d_anticheat_edit_code, DIALOG_STYLE_LIST, dialog_header, dialog_string, !"«Œ —", !"„·€Ï");
}

