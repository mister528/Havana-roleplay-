CMD:setskin ( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ member ] == 0 ) return 1 ;
	if ( p_info [ playerid ] [ rank ] < f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 1 ] )return 1 ;
	if ( sscanf ( params, "d", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: / ⁄ÌÌ‰ «·”ﬂ‰ [ID]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
	if ( p_info [ params [ 0 ] ] [ member ] != p_info [ playerid ] [ member ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» „Ê ›Ì „‰Ÿ„ ﬂ. ");
    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;

	new dialog_string [ max_rank * 48 ],
		frac_id = p_info [ playerid ] [ member ] ;
	for ( new j = 0; j < max_rank; j ++ )
	{
		if ( f_skin [ frac_id - 1 ] [ p_info [ params [ 0 ] ] [ gender ] ] [ j ] == 1 )break ;
		new line_string [ 32 ] ;
		format ( line_string, 32, "%d\n", f_skin [ frac_id - 1 ] [ p_info [ params [ 0 ] ] [ gender ] ] [ j ] ) ;
		strcat ( dialog_string, line_string ) ;
	}
	SetPVarInt ( playerid, "frac_invite_sk_id", params [ 0 ] + 1 ) ;

	show_dialog ( playerid, d_set_fskin, DIALOG_STYLE_LIST, "{"#cBL"}«Œ Ì«— «·„·«»”", dialog_string, " €ÌÌ—", "≈·€«¡" ) ;
	return 1;
}

CMD:break ( playerid, params [ ] )
{
	new break_id = 0 ;
 	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return 1 ;
	if ( IsPlayerInAnyVehicle ( playerid ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— «” Œœ„ Â–« ›Ì  «·”Ì«—…." ) ;
    if ( p_t_info [ playerid ] [ p_data ] [ 0 ] !=0 || p_t_info [ playerid ] [ p_data ] [ 0 ] != 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR "}„« Ìﬁœ— ÌﬂÊ‰ „” Œœ„ ›Ì ≈‰ Ì—Ì—." ) ;
	if ( fbi_player ( playerid ) )
	{
	    if ( sscanf ( params, "d", break_id ) ) SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /«ﬂ”— [ID] (Õœœ 'ID' ··Õ–›)" ) ;
	}
	if ( IsPlayerConnected ( break_id ) && break_id != 0 )
	{
 		if ( GetPVarInt ( break_id, "SetBlock") )
		{
		    new Float:x, Float:y, Float:z;
		    GetDynamicObjectPos(GetPVarInt ( break_id, "SetBlock"), x, y, z);
			new here_distance = (!IsPlayerInAnyVehicle(break_id)) ? floatround(GetPlayerDistanceFromPoint(break_id, x, y, z)) : floatround(GetVehicleDistanceFromPoint(GetPlayerVehicleID(break_id), x, y, z));
			if ( here_distance > 5 )
			{
				DestroyDynamicObject ( GetPVarInt ( break_id, "SetBlock" ) ) ;
	       		DeletePVar ( break_id, "SetBlock" ) ;
	       		SendClientMessage ( break_id, col_white, "{"#cRD"}* {"#cGR"} ”Ê— √‰   „  À»Ì Â  „  „ ≈“«· Â." ) ;
				SendClientMessage ( playerid, col_white,"{"#cGN"}* {"#cGR"}”Ê—  „ „”ÕÂ »‰Ã«Õ." ) ;
			}
		}
		return true ;
	}
	if ( GetPVarInt ( playerid,"SetBlock") > 0)
	{
	    if ( IsValidDynamic3DTextLabel ( BlockText[playerid] ) ) DestroyDynamic3DTextLabel ( BlockText[playerid] ) ;
		DestroyDynamicObject ( GetPVarInt ( playerid,"SetBlock" ) ) ;
        DeletePVar ( playerid, "SetBlock" ) ;
        SendClientMessage ( playerid, col_white,"{"#cGN"}* {"#cWH"}Õ«Ã“  „ ≈“«· Â »‰Ã«Õ." ) ;
        return true;
	}
	show_dialog ( playerid, d_cop_break, DIALOG_STYLE_LIST, "{"#cBL"}ÕÊ«Ã“","{"#cBL"}1. {"#cWH"}Õ«Ã“ #1\n{"#cBL"}2. {"#cWH"}Õ«Ã“ #2\n{"#cBL"}3. {"#cWH"}Õ«Ã“ #3\n{"#cBL"}4. {"#cWH"}Õ«Ã“ #4\n{"#cBL"}5. {"#cWH"}Õ«Ã“ #5\n{"#cBL"}6. {"#cWH"}”Ê— #6", "«Œ —", "≈€·«ﬁ" ) ;
	return true;
}
CMD:siren(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid), Float:x, Float:y, Float:z, Float:tmp;
 	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return 1 ;
 
	if(!vehicleid)
	{
	    return 1;
	}
	if(!VehicleHasWindows(vehicleid))
	{
 		return 1;
	}
    
    
	if(!IsValidDynamicObject(vehicleSiren[vehicleid]))
	{
