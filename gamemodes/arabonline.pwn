CMD:yoffre ( playerid )
{
	if ( GetPVarInt ( playerid, "spectate_status" ) != 0 )
	{
		for ( new j = 0 ; j < 27 ; j ++ )
		{
			TextDrawHideForPlayer ( playerid, admin_panel [ j ] ) ;
			if ( j < 3 )
			{
				PlayerTextDrawDestroy ( playerid, admin_panel_ptd [ playerid ] [ j ] ) ;
				admin_panel_ptd [ playerid ] [ j ] = PlayerText:-1;
			}
		}
		CancelSelectTextDraw ( playerid ) ;
		TogglePlayerSpectating ( playerid, false ) ;
		p_t_info [ playerid ] [ sp_admin ] = 0 ;
	}
	return 1 ;
}

