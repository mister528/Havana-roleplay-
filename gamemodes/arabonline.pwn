	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
	if ( params [ 0 ] == playerid ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— «·»«‰œ ‰›”ﬂ." ) ;
    if ( !IsPlayerInRangeOfPoint ( playerid, 1.0, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;

	p_info [ playerid ] [ rope ] -- ;
	update_int_sql ( playerid, "u_rope", p_info [ playerid ] [ rope ] ) ;

	SetPVarInt ( params [ 0 ], "PlayerTied", 1 ) ;
	SetPlayerSpecialAction ( params [ 0 ], SPECIAL_ACTION_CUFFED ) ;

	new scm_string [ 50 + MAX_PLAYER_NAME ] ;
	format ( scm_string, sizeof ( scm_string ), "{"#cRD"}* {"#cWH"}√‰  tied »Ê«”ÿ… {"#cRD"}%s{"#cWH"}.", p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( params [ 0 ], col_white, scm_string ) ;
	format ( scm_string, sizeof ( scm_string ), "{"#cRD"}* {"#cWH"}√‰  tied »Ê«”ÿ… {"#cRD"}%s{"#cWH"}.", p_info [ params [ 0 ] ] [ name ] ) ;
	SendClientMessage ( playerid, col_white, scm_string ) ;
	return true;
}

