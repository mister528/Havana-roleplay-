GetNearbyVehicle(playerid)
{
	new Float:x, Float:y, Float:z;

	for(new i = 1; i < MAX_VEHICLES; i ++)
	{
	    if(IsVehicleStreamedIn(i, playerid))
	    {
	        GetVehiclePos(i, x, y, z);

	        if(IsPlayerInRangeOfPoint(playerid, 10.0, x, y, z))
	        {
	            return i;
			}
		}
	}

	return INVALID_VEHICLE_ID;
}

stock TranslateText(string[])
{
	return string;
}

stock antigm_OnPlayerSpawn(playerid)
{
	SetPlayerTeam(playerid, 1 ) ;
	player_killed[ playerid ] = 0;
	player_killed_sync[ playerid ] = 0;
	return 1;
}

stock antigm_OnPlayerDeath(playerid, killerid, reason)
{
	#pragma unused killerid
	#pragma unused reason

	player_killed_sync[ playerid ] = 1;
	return 1;
}

stock antigm_OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    #pragma unused fX
	#pragma unused fY
	#pragma unused fZ

    if ( hittype == BULLET_HIT_TYPE_PLAYER )
	{
		if ( IsPlayerStreamedIn ( hitid, playerid ) && IsPlayerStreamedIn ( playerid, hitid ) )
		{

			if ( GetTickCount ( ) - p_t_info [ hitid ] [ p_update ] > 1000 ) return 0;

	  		if ( player_killed [ playerid ] ) return 0;

	  		if ( ! ProxDetectorS ( 150.0, playerid, hitid ) ) return 0;

	  		player_legal_gun[ playerid ] = weaponid ;
	  		player_legal_damage[ playerid ] = hitid ;

		}
	}
	if ( hittype == BULLET_HIT_TYPE_VEHICLE )
	{
		foreach(new i: logged_players)
		{
			if ( GetPlayerVehicleID ( i ) == hitid )
			{
				if ( IsPlayerStreamedIn ( i, playerid ) && IsPlayerStreamedIn ( playerid, i ) )
				{

					if ( player_killed[ playerid ]) return 0;


					if ( !ProxDetectorS(150.0, playerid, i ) ) return 0;

					player_legal_gun [ playerid ] = weaponid;
					player_legal_damage [ playerid ] = i;

				}
			}
		}
	}
	return 1;
}

stock antigm_OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid, bodypart)
{
   //hanijey
	#pragma unused bodypart
 	#if defined debug_mode
		printf ( "[DEBUG] [antigm_OnPlayerGiveDamage] playerid:%d | damagedid:%d | amount:%f | weaponid:%d", playerid, damagedid, amount, weaponid ) ;
	#endif

    if(IsAGreenZone(playerid) && !gover_player(playerid) || IsAGreenZone(damagedid) && gover_player(damagedid))


    {


        GreenZone_Warn(playerid);


        return false;


    }
	if(gang_player(damagedid) && mafia_player(playerid))
	{
	     if(p_info[playerid][member] == p_info[damagedid][member] && gz_captured != -1 && !GetPVarInt(playerid, "on_dmarena") && !GetPVarInt(playerid, "on_dmarena1"))
	     {
	        return false;
	     }
	}
	if(p_info[damagedid][GM] == 1 && p_info[damagedid][admin]) return 0;
	if ( p_info [ playerid ] [ jailed ] > 0 )
	{
		anti_dm_warning { playerid } ++ ;
		show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBL"} Õ–Ì—","{FFFFFF}„„‰Ê⁄ «·ﬁ «·/≈ÿ·«ﬁ «·‰«— ›Ì Â–« «·„ﬂ«‰.\n\n{"#cRD"} - ›Ì Õ«·  ﬂ——  «·„Œ«·›« ° „„ﬂ‰  ‰ÿ—œ.", "„Ê«›ﬁ…", "" ) ;
		if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage(playerid, col_gray,"{"#cRD"}- {"#cGR"} √‰  « ÿ—œ  »”»» „Õ«Ê· ﬂ {"#cRD"}DM{"#cGR"} ›Ì  «·⁄«„ «·„ﬂ«‰."), kick_player ( playerid ) ;
		ApplyAnimation(playerid,"FAT","IDLE_tired",3.0,1,0,0,0,3000,1);
		return false;
	}
 	if ( weaponid == 9 )
	{
		if ( IsPlayerInRangeOfPoint ( playerid, 150.0, -1092.1349, -1643.6737, 76.373 ) && ! IsPlayerInRangeOfPoint ( playerid, 5, tree_positions [ GetPVarInt(playerid, #Derevo) ] [ 0 ], tree_positions [ GetPVarInt(playerid, #Derevo) ] [ 1 ],tree_positions [ GetPVarInt(playerid, #Derevo) ] [ 2 ] ) )
		{
			anti_dm_warning { playerid } ++ ;
			show_dialog ( playerid, d_none, DIALOG_STYLE_MSGBOX, "{"#cBL"} Õ–Ì—","{FFFFFF}„„‰Ê⁄ «” Œœ«„ «·„‰‘«— ·√€—«÷ À«‰Ì….\n\n{"#cRD"} - ›Ì Õ«·  ﬂ——  «·„Œ«·›« ° „„ﬂ‰  ‰ÿ—œ.", "„Ê«›ﬁ…", "" ) ;
			if ( anti_dm_warning { playerid } >= 5 ) SendClientMessage(playerid, col_gray,"{"#cRD"}- {"#cGR"} √‰  « ÿ—œ  »”»» „Õ«Ê· ﬂ {"#cRD"}DM{"#cGR"} ›Ì  «·⁄«„ «·„ﬂ«‰."), kick_player ( playerid ) ;
			return false ;
		}
	}
    if ( ( ( 22 <= weaponid <= 34) || weaponid == 38 ) )
	{
		#if defined debug_mode
			printf ( "22 <= weaponid <= 34) || weaponid == 38" ) ;
		#endif
	    if ( IsPlayerStreamedIn(damagedid, playerid) && IsPlayerStreamedIn(playerid, damagedid ) )
		{
			if ( pl_afk_time [ playerid ] > 2 )return 1 ;
	  		if ( player_killed [ playerid ]) return 0;


	  		if ( !ProxDetectorS ( 150.0, playerid, damagedid ) ) return 1;

	  		if ( player_legal_gun[ playerid ] == weaponid && player_legal_damage[ playerid ] == damagedid)
			{


			    switch(weaponid)
				{
					case 22: GiveDamageForPlayer(damagedid, playerid, weaponid, 4.0 ) ; // Colt
					case 23: GiveDamageForPlayer(damagedid, playerid, weaponid, 14.0 ) ; // SD Pistol
					case 24:
					{
					    if ( p_info [ playerid ] [ gun_skills ] [ 1 ] < 20)
					    {
					        GiveDamageForPlayer(damagedid, playerid, weaponid, 24.0 ) ; // Deagle
						}
						else
						{
							GiveDamageForPlayer(damagedid, playerid, weaponid, 47.0 ) ; // Deagle
						}
					}
					case 25:
					{
					    if ( amount <= 0.0 || amount > 30.0) amount = 30.0;
						GiveDamageForPlayer(damagedid, playerid, weaponid, amount ) ; // Shotgun
					}
					case 28: GiveDamageForPlayer(damagedid, playerid, weaponid, 6.0 ) ;  // Micro-Uzi
					case 29: GiveDamageForPlayer(damagedid, playerid, weaponid, 8.0 ) ;  // MP5
					case 30: GiveDamageForPlayer(damagedid, playerid, weaponid, 10.0 ) ; // AK-47
					case 31: GiveDamageForPlayer(damagedid, playerid, weaponid, 10.0 ) ; // M4A1
					case 33: GiveDamageForPlayer(damagedid, playerid, weaponid, 25.0 ) ; // Rifle
					case 34: GiveDamageForPlayer(damagedid, playerid, weaponid, 41.0 ) ; // Sniper
					case 38: GiveDamageForPlayer(damagedid, playerid, weaponid, 47.0 ) ; // Minigun
					default: return 1;
				}
				player_legal_gun[ playerid ] = 0;
    			player_legal_damage[ playerid ] = INVALID_PLAYER_ID;
			}
		}
		return 1;
	}
	else
	{

	    if ( player_killed[ playerid ]) return 0;

	    if ( amount <= 0.0 || amount > 7.0) return 1;

	    if ( !ProxDetectorS(5.0, playerid, damagedid ) ) return 1;

		#if defined IsAntiFist
  		if ( IsAntiFist(playerid ) ) return 1;
  		#endif

		GiveDamageForPlayer(damagedid, playerid, weaponid, amount ) ;
	}
	return 1;
}

stock antigm_OnPlayerTakeDamage(playerid, issuerid, Float: amount, weaponid, bodypart)
{
    #pragma unused bodypart

    if ( weaponid == 49 || weaponid == 50)
	{
	    if ( amount <= 0.0) return 1;

	    if ( IsPlayerStreamedIn(issuerid, playerid ) )
	    {
	    	if ( IsPlayerInAnyVehicle(issuerid ) )
			{
			    GiveDamageForPlayer(playerid, issuerid, weaponid, amount ) ;
			}
		}
	}
	return 1;
}

stock antigm_OnPlayerConnect(playerid)
{
    player_legal_gun[ playerid ] = 0;
    player_legal_damage[ playerid ] = INVALID_PLAYER_ID;
	player_killed[ playerid ] = 0;
	player_killed_sync[ playerid ] = 0;
	return 1;
}
 
stock _DestroyDynamicObject ( objectid )
{
	if ( objectid < static_object_count ) return printf ( "[STREAMER ERROR] %d objectid destroy warning. Try to destroy static object." ) ;
	return DestroyDynamicObject ( objectid ) ;
}

stock _CreateDynamicPickup( modelid, type, Float:x, Float:y, Float:z, worldid = -1, interiorid = -1, playerid = -1 )
{
	new pickupid = CreateDynamicPickup ( modelid, type, x, y, z, worldid, interiorid, playerid ) ;

	pick_info [ pickupid ] [ pick_pos ] [ 0 ] = x ;
	pick_info [ pickupid ] [ pick_pos ] [ 1 ] = y ;
	pick_info [ pickupid ] [ pick_pos ] [ 2 ] = z ;
	return pickupid ;
}

stock GetVehicleSpeed ( vehicleid )
{
    new Float:X, Float:Y, Float:Z, Float:_speed;
    GetVehicleVelocity(vehicleid, X, Y, Z ) ;
    _speed = ( (floatsqroot( (X*X) + (Y*Y) )*10) / 1.65 ) * 30;
    return floatround ( _speed, floatround_round ) ;
}
stock GetVehicleSpeed_(vehicleid)
{
    new Float:Px,Float:Py,Float:Pz;
    GetVehicleVelocity(vehicleid,Px,Py,Pz);
    return floatround(floatsqroot(Px*Px+Py*Py+Pz*Pz) * 100.0);
}

stock get_player_veh_count ( playerid )
{
	new _veh_count = 0,
		query_string [ 78 ] ;
	format ( query_string, sizeof ( query_string ),"SELECT * FROM users_vehicles WHERE v_owner = '%d'", p_info [ playerid ] [ id ] ) ;
	new Cache:result = mysql_query ( sql_connection, query_string ) ;
	_veh_count = cache_num_rows ( ) ;
	cache_delete ( result ) ;
	return _veh_count ;
}

stock get_player_med_card ( playerid )
{
	new _veh_count = 0,
		query_string [ 78 ] ;
	format ( query_string, sizeof ( query_string ),"SELECT * FROM users_medcards WHERE mc_owner = '%d'", p_info [ playerid ] [ id ] ) ;
	new Cache:result = mysql_query ( sql_connection, query_string ) ;
	_veh_count = cache_num_rows ( ) ;
	cache_delete ( result ) ;
	return _veh_count ;
}

stock get_player_warn_count ( playerid )
{
	new _warn_count = 0,
		query_string [ 78 ] ;

	format ( query_string, sizeof ( query_string ),"SELECT * FROM users_warns WHERE w_owner = '%d' AND `w_end` > NOW( )", p_info [ playerid ] [ id ] ) ;
	new Cache:result = mysql_query ( sql_connection, query_string ) ;
	_warn_count = cache_num_rows ( ) ;
	cache_delete ( result ) ;
	return _warn_count ;
}

stock is_player_fraction_bl ( playerid, fractionid )
{
	new _bl_count = 0;

	static query_string[] = "SELECT * FROM `fractions_blacklist` WHERE bl_player = '%d' AND bl_fraction = '%d'";
	new fmt_query[(sizeof(query_string) - 4) + 11 * 2];
	format ( fmt_query, sizeof ( fmt_query ), query_string, p_info [ playerid ] [ id ], fractionid ) ;
	new Cache:result = mysql_query ( sql_connection, fmt_query ) ;
	_bl_count = cache_num_rows ( ) ;
	cache_delete ( result ) ;
	return _bl_count ;
}

stock n_ChangeVehicleColor(vehicleID, color1, color2)
{
	veh_info [ vehicleID - 1 ] [ v_color ] [ 0 ] = color1 ;
	veh_info [ vehicleID - 1 ] [ v_color ] [ 1 ] = color2 ;
	return ChangeVehicleColor ( vehicleID, color1, color2 ) ;
}

stock GetVehicleColor(vehicleID, &color1, &color2)
{
	color1 = veh_info [ vehicleID - 1 ] [ v_color ] [ 0 ] ;
	color2 = veh_info [ vehicleID - 1 ] [ v_color ] [ 1 ] ;
	return 1 ;
}

stock load_phonebook ( playerid )
{
	if ( p_info [ playerid ] [ number ] )
	{
		new sscanf_delimit [ 60 ], rows, fields;
		format ( sscanf_delimit, 60, "SELECT * FROM `users_phonebook` WHERE `u_id` = '%d'", p_info [ playerid ] [ id ] ) ;
		mysql_query ( sql_connection, sscanf_delimit ) ;
		cache_get_data ( rows, fields ) ;
		p_info [ playerid ] [ phones ] = rows ;
		for ( new i; i < rows; i ++ )
		{
			cache_get_field_content ( i, "u_phone_name", phone_info [ playerid ] [ i ], sql_connection, MAX_PLAYER_NAME ) ;
			p_info [ playerid ] [ phone_num ] [ i ] = cache_get_field_content_int ( i, "u_phone_num", sql_connection ) ;
		}
	}
	return 1 ;
}

stock PhonePush ( playerid, const payload [ ] )
{
	if ( ! IsPlayerConnected ( playerid ) ) return 0 ;
	new string [ 512 ] ;
	format ( string, sizeof ( string ), "~PHONE_UI~%s", payload ) ;
	SendClientMessage ( playerid, 0xFFFFFFFF, string ) ;
	return 1 ;
}

stock PhoneClearCache ( playerid )
{
	phone_friend_count [ playerid ] = 0 ;
	phone_request_count [ playerid ] = 0 ;
	phone_last_chat [ playerid ] = 0 ;
	for ( new i ; i < PHONE_MAX_FRIENDS ; i ++ )
	{
		phone_friend_id [ playerid ] [ i ] = 0 ;
		phone_friend_name [ playerid ] [ i ] [ 0 ] = EOS ;
	}
	for ( new i ; i < PHONE_MAX_REQUESTS ; i ++ )
	{
		phone_request_id [ playerid ] [ i ] = 0 ;
		phone_request_name [ playerid ] [ i ] [ 0 ] = EOS ;
	}
	return 1 ;
}

stock PhoneFindOnlineByUid ( uid )
{
	foreach(new i: logged_players)
	{
		if ( p_info [ i ] [ id ] == uid ) return i ;
	}
	return INVALID_PLAYER_ID ;
}

stock PhoneAreFriends ( playerid, targetid )
{
	if ( ! IsPlayerConnected ( targetid ) ) return 0 ;
	new query [ 160 ] ;
	format ( query, sizeof ( query ), "SELECT `id` FROM `players_phone_friends` WHERE `user_id`='%d' AND `friend_uid`='%d' AND `status`='1' LIMIT 1", p_info [ playerid ] [ id ], p_info [ targetid ] [ id ] ) ;
	new Cache:result = mysql_query ( sql_connection, query ) ;
	new rows = cache_num_rows ( ) ;
	cache_delete ( result ) ;
	return rows ;
}

stock PhoneAreFriendsByUid ( playerid, uid )
{
	if ( uid <= 0 ) return 0 ;
	new query [ 160 ] ;
	format ( query, sizeof ( query ), "SELECT `id` FROM `players_phone_friends` WHERE `user_id`='%d' AND `friend_uid`='%d' AND `status`='1' LIMIT 1", p_info [ playerid ] [ id ], uid ) ;
	new Cache:result = mysql_query ( sql_connection, query ) ;
	new rows = cache_num_rows ( ) ;
	cache_delete ( result ) ;
	return rows ;
}

stock PhoneGetAccountNameByUid ( uid, out_name [ ], size = MAX_PLAYER_NAME )
{
	out_name[0] = EOS ;
	new online_id = PhoneFindOnlineByUid ( uid ) ;
	if ( online_id != INVALID_PLAYER_ID )
	{
		format ( out_name, size, "%s", p_info [ online_id ] [ name ] ) ;
		return 1 ;
	}
	new query [ 96 ] ;
	mysql_format ( sql_connection, query, sizeof ( query ), "SELECT `u_name` FROM `users` WHERE `u_id`='%d' LIMIT 1", uid ) ;
	new Cache:result = mysql_query ( sql_connection, query ) ;
	if ( ! cache_num_rows ( ) )
	{
		cache_delete ( result ) ;
		return 0 ;
	}
	cache_get_field_content ( 0, "u_name", out_name, sql_connection, size ) ;
	cache_delete ( result ) ;
	return 1 ;
}

stock PhoneLoadFriends ( playerid )
{
	PhoneClearCache ( playerid ) ;
	if ( p_info [ playerid ] [ id ] <= 0 ) return 0 ;
	new query [ 256 ] ;
	format ( query, sizeof ( query ), "SELECT `friend_uid`,`friend_name` FROM `players_phone_friends` WHERE `user_id`='%d' AND `status`='1' ORDER BY `id` DESC LIMIT %d", p_info [ playerid ] [ id ], PHONE_MAX_FRIENDS ) ;
	new Cache:friends = mysql_query ( sql_connection, query ) ;
	new rows = cache_num_rows ( ) ;
	for ( new i ; i < rows && i < PHONE_MAX_FRIENDS ; i ++ )
	{
		phone_friend_id [ playerid ] [ i ] = cache_get_field_content_int ( i, "friend_uid", sql_connection ) ;
		cache_get_field_content ( i, "friend_name", phone_friend_name [ playerid ] [ i ], sql_connection, MAX_PLAYER_NAME ) ;
		phone_friend_count [ playerid ] ++ ;
	}
	cache_delete ( friends ) ;

	format ( query, sizeof ( query ), "SELECT `friend_uid`,`friend_name` FROM `players_phone_friends` WHERE `user_id`='%d' AND `status`='0' ORDER BY `id` DESC LIMIT %d", p_info [ playerid ] [ id ], PHONE_MAX_REQUESTS ) ;
	new Cache:req = mysql_query ( sql_connection, query ) ;
	rows = cache_num_rows ( ) ;
	for ( new i ; i < rows && i < PHONE_MAX_REQUESTS ; i ++ )
	{
		phone_request_id [ playerid ] [ i ] = cache_get_field_content_int ( i, "friend_uid", sql_connection ) ;
		cache_get_field_content ( i, "friend_name", phone_request_name [ playerid ] [ i ], sql_connection, MAX_PLAYER_NAME ) ;
		phone_request_count [ playerid ] ++ ;
	}
	cache_delete ( req ) ;
	return 1 ;
}

stock PhoneSendSnapshot ( playerid )
{
	if ( ! IsPlayerConnected ( playerid ) ) return 0 ;
	new payload [ 512 ] ;
	format ( payload, sizeof ( payload ), "CLEAR" ) ;
	PhonePush ( playerid, payload ) ;
	format ( payload, sizeof ( payload ), "OPEN|%d|%d|%s", p_info [ playerid ] [ id ], p_info [ playerid ] [ bank ], p_info [ playerid ] [ name ] ) ;
	PhonePush ( playerid, payload ) ;
	PhoneLoadFriends ( playerid ) ;
	for ( new i ; i < phone_friend_count [ playerid ] ; i ++ )
	{
		format ( payload, sizeof ( payload ), "F|%d|%s", phone_friend_id [ playerid ] [ i ], phone_friend_name [ playerid ] [ i ] ) ;
		PhonePush ( playerid, payload ) ;
	}
	for ( new i ; i < phone_request_count [ playerid ] ; i ++ )
	{
		format ( payload, sizeof ( payload ), "R|%d|%s", phone_request_id [ playerid ] [ i ], phone_request_name [ playerid ] [ i ] ) ;
		PhonePush ( playerid, payload ) ;
	}
	return 1 ;
}

stock PhoneRefreshMessagesPage ( playerid )
{
	if ( ! IsPlayerConnected ( playerid ) ) return 0 ;
	PhoneSendSnapshot ( playerid ) ;
	PhonePush ( playerid, "PAGE|MESSAGES" ) ;
	return 1 ;
}

stock PhoneEnsureTables ( )
{
	mysql_tquery ( sql_connection, "CREATE TABLE IF NOT EXISTS `players_phone_friends` (`id` INT NOT NULL AUTO_INCREMENT, `user_id` INT NOT NULL, `friend_uid` INT NOT NULL, `friend_name` VARCHAR(24) NOT NULL, `status` TINYINT NOT NULL DEFAULT 0, `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (`id`), UNIQUE KEY `phone_pair` (`user_id`,`friend_uid`), INDEX (`friend_uid`)) ENGINE=InnoDB DEFAULT CHARSET=utf8", "", "" ) ;
	mysql_tquery ( sql_connection, "CREATE TABLE IF NOT EXISTS `players_phone_messages` (`id` INT NOT NULL AUTO_INCREMENT, `from_uid` INT NOT NULL, `to_uid` INT NOT NULL, `message_type` TINYINT NOT NULL DEFAULT 0, `message_text` VARCHAR(160) NOT NULL DEFAULT '', `amount` INT NOT NULL DEFAULT 0, `pos_x` FLOAT NOT NULL DEFAULT 0, `pos_y` FLOAT NOT NULL DEFAULT 0, `pos_z` FLOAT NOT NULL DEFAULT 0, `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (`id`), INDEX (`from_uid`), INDEX (`to_uid`)) ENGINE=InnoDB DEFAULT CHARSET=utf8", "", "" ) ;
	mysql_tquery ( sql_connection, "CREATE TABLE IF NOT EXISTS `players_phone_transfers` (`id` INT NOT NULL AUTO_INCREMENT, `from_uid` INT NOT NULL, `to_uid` INT NOT NULL, `amount` INT NOT NULL, `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (`id`), INDEX (`from_uid`), INDEX (`to_uid`)) ENGINE=InnoDB DEFAULT CHARSET=utf8", "", "" ) ;
	return 1 ;
}

stock PhoneOpenForPlayer ( playerid )
{
	if ( ! p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ  ·›Ê‰." ) ;
	PhoneEnsureTables ( ) ;
	PhoneSendSnapshot ( playerid ) ;
	PhonePush ( playerid, "SHOW" ) ;
	return 1 ;
}

stock PhonePushMessage ( playerid, peerUid, peerName [ ], outgoing, msgtype, text [ ], amount = 0, Float:x = 0.0, Float:y = 0.0, Float:z = 0.0 )
{
	new payload [ 512 ] ;
	if ( msgtype == 1 ) format ( payload, sizeof ( payload ), "GPS|%d|%s|%d|%f|%f|%f", peerUid, peerName, outgoing, x, y, z ) ;
	else if ( msgtype == 2 ) format ( payload, sizeof ( payload ), "MONEY|%d|%s|%d|%d", peerUid, peerName, outgoing, amount ) ;
	else format ( payload, sizeof ( payload ), "MSG|%d|%s|%d|%s", peerUid, peerName, outgoing, text ) ;
	return PhonePush ( playerid, payload ) ;
}

stock PhoneLoadChat ( playerid, target_uid, target_name [ ] )
{
	new payload [ 64 ], query [ 320 ] ;
	format ( payload, sizeof ( payload ), "CLEARMSG|%d", target_uid ) ;
	PhonePush ( playerid, payload ) ;
	mysql_format ( sql_connection, query, sizeof ( query ), "SELECT * FROM `players_phone_messages` WHERE (`from_uid`='%d' AND `to_uid`='%d') OR (`from_uid`='%d' AND `to_uid`='%d') ORDER BY `id` DESC LIMIT %d", p_info [ playerid ] [ id ], target_uid, target_uid, p_info [ playerid ] [ id ], PHONE_MAX_MESSAGES ) ;
	new Cache:msgs = mysql_query ( sql_connection, query ) ;
	new rows = cache_num_rows ( ) ;
	new msg [ 170 ], type, amount, fromUid, Float:x, Float:y, Float:z ;
	for ( new i = rows - 1 ; i >= 0 ; i -- )
	{
		fromUid = cache_get_field_content_int ( i, "from_uid", sql_connection ) ;
		type = cache_get_field_content_int ( i, "message_type", sql_connection ) ;
		amount = cache_get_field_content_int ( i, "amount", sql_connection ) ;
		cache_get_field_content ( i, "message_text", msg, sql_connection, sizeof ( msg ) ) ;
		x = cache_get_field_content_float ( i, "pos_x", sql_connection ) ;
		y = cache_get_field_content_float ( i, "pos_y", sql_connection ) ;
		z = cache_get_field_content_float ( i, "pos_z", sql_connection ) ;
		PhonePushMessage ( playerid, target_uid, target_name, fromUid == p_info [ playerid ] [ id ], type, msg, amount, x, y, z ) ;
	}
	cache_delete ( msgs ) ;
	return 1 ;
}

stock _RemovePlayerFromVehicle ( playerid )
{
	switch(GetVehicleModel(GetPlayerVehicleID(playerid))) { case 0, 441, 464, 465, 501, 564, 594: return 0; }
	playerRemoveVehicle{playerid} = (2 + SleepTime(playerid));
	new Float:pos_x, Float:pos_y, Float:pos_z;
	GetPlayerPos(playerid, pos_x, pos_y, pos_z);

   	RemovePlayerFromVehicle(playerid ) ;
    SetPVarInt ( playerid, "removetimer", 15 ) ;
    RemovePlayerFromVehicle ( playerid ) ;
	return 1;
}

stock CanWeCheck(playerid)
{
	if ( ( p_t_info [ playerid ] [ p_update ] - p_t_info [ playerid ] [ last_alt ] ) > 2000) return 1;
	return 0;
}

Float:GetDistanceBetweenPoints(Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2)
{
