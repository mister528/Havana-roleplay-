	    if ( p_info [ playerid ] [ admin ] < p_info [ params [ 1 ] ] [ admin ] )
			return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „«  ﬁœ—  ’œ— «·⁄ﬁÊ»… ·„”ƒÊ· √⁄·Ï „‰ﬂ — »…." ) ;

		new scm_string [ 248 ] ;
		format( scm_string, 144, "≈œ«—Ì %s ÷⁄ %s ›Ì «·”Ã‰ ·‹ %d œﬁÌﬁ…. «·”»»: %s", p_info [ playerid ] [ name ], p_info [ params [ 1 ] ] [ name ], params [ 2 ], params [ 3 ] ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, scm_string ) ;

		format( scm_string, 144, "%s ⁄‰œ ÷⁄ √‰  ›Ì ”Ã‰ ·‹ %d œﬁÌﬁ…. «·”»»: %s", p_info [ playerid ] [ name ], params [ 2 ], params [ 3 ] ) ;
		SendClientMessage ( params [ 1 ] , col_light_red, scm_string ) ;

		format ( scm_string,sizeof(scm_string),"UPDATE `users_admins` SET `u_a_jails` = `u_a_jails`+1 WHERE `u_a_name` = '%s' LIMIT 1", p_info [ playerid ] [ name ] ) ;
		mysql_tquery ( sql_connection, scm_string, "", "" ) ;

		format(scm_string, 128, "%s planted %s. «·”»»: %s", p_info [ playerid ] [ name ], p_info [ params [ 1 ] ] [ name ], params [ 3 ] );
		WriteLog(TYPE_LOG_JAIL, scm_string);

		p_info [ params [ 1 ] ] [ jailed ] = params [ 2 ] * 60 ;
		p_info [ params [ 1 ] ] [ jail ] = 10 ;
		set_pos ( params [ 1 ], 5048.978515, -765.416931, 12.459382+3.0, 0.0, 0, 15 ) ;

		DeletePVar(params [ 1 ], "Health");
		DeletePVar(params [ 1 ], "on_dmarena");
		DeletePVar(params [ 1 ], "arena_weapon_set");
		DeletePVar(playerid, "AntiCBUG");
		DeletePVar(playerid, "on_dmarena1");
		ondmz[params [ 1 ]] = 0;
	    dmzone1_players --;

		reset_player_weapon ( params [ 1 ] ) ;

		update_int_sql ( params [ 1 ], "u_jail", p_info [ params [ 1 ] ] [ jail ] ) ;
		update_int_sql ( params [ 1 ], "u_jailed", p_info [ params [ 1 ] ] [ jailed ] ) ;
	}
	else if ( params [ 0 ] == 2 ) // Prison Alcatraz
	{
	    if ( ! IsPlayerConnected ( params [ 1 ] ) )
		return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
		if ( params [ 2 ] < 1 || params [ 2 ] > 900 )
			return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „œ… «·«Õ Ã«“ ·«“„  ﬂÊ‰ »Ì‰ 1 Ê240 œﬁÌﬁ…." ) ;
		if(p_info [ params [ 1 ] ] [ jailed ] > 0)
		    return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» ÂÊ ”»ﬁ Ê ›Ì ”Ã‰!" ) ;
	    if ( p_info [ playerid ] [ admin ] < p_info [ params [ 1 ] ] [ admin ] )
			return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „«  ﬁœ—  ’œ— «·⁄ﬁÊ»… ·„”ƒÊ· √⁄·Ï „‰ﬂ — »…." ) ;
		if ( p_info [ params [ 1 ] ] [ member ] == 12 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–« «··«⁄» „‰ ”Ã‰ Faction Alctraz." ) ;
		new scm_string [ 248 ] ;
		format( scm_string, 144, "≈œ«—Ì %s ÷⁄ %s ›Ì «·”Ã‰ ·‹ %d œﬁÌﬁ…. «·”»»: %s", p_info [ playerid ] [ name ], p_info [ params [ 1 ] ] [ name ], params [ 2 ], params [ 3 ] ) ;
		foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, scm_string ) ;

		format( scm_string, 144, "%s ⁄‰œ ÷⁄ √‰  ›Ì ”Ã‰ ·‹ %d œﬁÌﬁ…. «·”»»: %s", p_info [ playerid ] [ name ], params [ 2 ], params [ 3 ] ) ;
		SendClientMessage ( params [ 1 ] , col_light_red, scm_string ) ;

		format ( scm_string,sizeof(scm_string),"UPDATE `users_admins` SET `u_a_jails` = `u_a_jails`+1 WHERE `u_a_name` = '%s' LIMIT 1", p_info [ playerid ] [ name ] ) ;
		mysql_tquery ( sql_connection, scm_string, "", "" ) ;

		format(scm_string, 128, "%s planted %s. «·”»»: %s", p_info [ playerid ] [ name ], p_info [ params [ 1 ] ] [ name ], params [ 3 ] );
		WriteLog(TYPE_LOG_JAIL, scm_string);

		p_info [ params [ 1 ] ] [ jailed ] = params [ 2 ] * 60 ;
		p_info [ params [ 1 ] ] [ jail ] = 20 ;
		set_pos ( params [ 1 ], 1383.3717,964.0858,3016.7773, 89.6736, 27, 27) ;

		DeletePVar(params [ 1 ], "Health");
		DeletePVar(params [ 1 ], "on_dmarena");
		DeletePVar(params [ 1 ], "arena_weapon_set");
		DeletePVar(playerid, "AntiCBUG");
		DeletePVar(playerid, "on_dmarena1");
		ondmz[params [ 1 ]] = 0;
	    dmzone1_players --;

		reset_player_weapon ( params [ 1 ] ) ;

		update_int_sql ( params [ 1 ], "u_jail", p_info [ params [ 1 ] ] [ jail ] ) ;
		update_int_sql ( params [ 1 ], "u_jailed", p_info [ params [ 1 ] ] [ jailed ] ) ;
	}
	return 1 ;
}
