				RemovePlayerAttachedObject(playerid, 4);
				SimulatorUse[3] = false;
			}
		}
		if ( GetPVarInt ( playerid , "Grafity" ) == -1)
		{
			for(new i = 0; i < CountGraffity; i++)
			{
				if(IsPlayerInRangeOfPoint(playerid, 3.0, graf_info[i][gr_x][0], graf_info[i][gr_x][1], graf_info[i][gr_x][2]))
				{
					if(! gang_player ( playerid ) ) return SendClientMessage(playerid, col_gray, "* √‰  „Ê ›Ì «·⁄’«»…!");
					if(p_info[playerid][member] == graf_info[i][g_member]) return SendClientMessage(playerid, col_gray, "* Â–« €—«›Ì Ìﬂ √’·«!");
					if(GetPlayerWeapon(playerid) != 41) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ »«·Ê‰° «‘ —ÌÂ „‰ „Õ· 24/7.");

					SetPVarInt(playerid, "Grafity", i);

