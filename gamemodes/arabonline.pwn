					TextDrawSetString ( az_capture_td [ 16 ], query_string ) ;

					new f_string [ 61 + MAX_PLAYER_NAME * 2 + 28 + 8 + 22 ] ;
					format(f_string, sizeof f_string, "[U] %s[%s] ›‘· %s[%s](+%d «·‰ﬁ«ÿ). ›Õ’: %s[%d] : [%d]%s", p_info [ killerid ] [ name ], f_info [ p_info [ killerid ] [ member ] - 1 ] [ f_name ], p_info [ playerid ] [ name ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ], a_expcapt, f_info [ p_info [ killerid ] [ member ] - 1 ] [ f_name ], az_owner_points, az_attacker_points, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ] ) ;
					SendAzMessage ( f_info [ p_info [ killerid ] [ member ] - 1 ] [ f_radar_color ], f_string ) ;
				}
			}
			update_activity ( killerid ) ;
		}
	}
	if ( gz_captured != - 1 )
	{
	    new expcapt = 0 ;

		if ( ( IsPlayerInGangZone ( playerid, gz_captured ) || ( IsPlayerInRangeOfQuad ( playerid, gz_info [ gz_captured ] [ gz_pos ] [ 2 ], gz_info [ gz_captured ] [ gz_pos ] [ 3 ] ) < 200 || IsPlayerInRangeOfQuad ( playerid, gz_info [ gz_captured ] [ gz_pos ] [ 0 ], gz_info [ gz_captured ] [ gz_pos ] [ 1 ] ) < 200 ) ) && ( p_info [ playerid ] [ member ] >= 18 && p_info [ playerid ] [ member ] <= 28 ) && ( p_info [ killerid ] [ member ] >= 18  && p_info [ killerid ] [ member ] <= 28 ) && p_info [ killerid ] [ member ] != p_info [ playerid ] [ member ] )
		{
			if ( p_info [ killerid ] [ member ] == gz_info [ gz_captured ] [ gz_attacker ] && p_info [ playerid ] [ member ] == gz_info [ gz_captured ] [ gz_owner ] ||
			    p_info [ killerid ] [ member ] == gz_info [ gz_captured ] [ gz_attacker ] && f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [  gz_info [ gz_captured ] [ gz_owner ] - 18 ] == dip_status_alliance ||
				f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_attacker ] - 18 ] == dip_status_alliance && p_info [ playerid ] [ member ] == gz_info [ gz_captured ] [ gz_owner ] && f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_owner ] - 18 ] == dip_status_war ||
				f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_attacker ] - 18 ] == dip_status_alliance && f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [  gz_info [ gz_captured ] [ gz_owner ] - 18 ] == dip_status_alliance && f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_owner ] - 18 ] == dip_status_war )
			{
				foreach(new i: logged_players)
				{
					if ( ! gang_player ( i ) && ! mafia_player ( i )) continue ;
				    SendDeathMessageToPlayer ( i, killerid, playerid, reason ) ;
				}
				if ( gz_capture_type == gz_type_kills )
				{
				    if ( GetPlayerWeapon ( killerid ) == 5 || GetPlayerWeapon ( killerid ) == 0 )
				    {
						attacker_points += 3 ;
