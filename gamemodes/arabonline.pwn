stock update_gdorm_text ( fractionid )
{
	if ( fractionid < 18 ) return 1 ;
	new t_string [ 300 ], gang_gz_count ;
	if(fractionid >= 18 && fractionid <= 25)
	{
	    for ( new i = 0 ; i < gz_count ; i ++ )
		{
			if ( gz_info [ i ] [ gz_owner ] == fractionid ) gang_gz_count ++ ;
