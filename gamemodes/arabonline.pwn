CMD:jack(playerid, params[])
{
    if ( GetPVarInt ( playerid, "PlayerCuffed" ) )
	{
		SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  ﬁœ—  ” Œœ„  ’Ì«‰… «·⁄œ… »Ì‰„« ﬂ»¯·.");
		return 1;
	}
	if(p_info[playerid][u_corrcar] == 0) return SendClientMessage(playerid, col_gray,"* „« ⁄‰œﬂ √œÊ«   ‘€Ì·");
	if ( !IsPlayerInAnyVehicle(playerid)) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}·«“„ ÌﬂÊ‰ œ«Œ·  «·”Ì«—….");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}·«“„ ÌﬂÊ‰  «·”«∆ﬁ «·‹ «·”Ì«—….");
	if ( GetVehicleSpeed ( player_vehicle [ playerid ] ) > 3 ) return SendClientMessage ( playerid, col_gray, !"{"#cRD"}* {"#cGR"}·« «” Œœ„  √œÊ«   ‘€Ì· ⁄·Ï —ÊÕ.");
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == 0)
    {
            SendClientMessage(playerid, col_gray,"* ·«“„ ÌﬂÊ‰ ›Ì ”Ì«—…!");
            return 1;
    }

    new Float:x, Float:y, Float:z;
    new Float:angle;
    GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, angle);
    SetVehiclePos(vehicleid, x, y, z + 1.5);
    SetVehicleZAngle(vehicleid, angle);

	p_info[playerid][u_corrcar] -= 1;
	update_int_sql(playerid,"u_corrcar",p_info[playerid][u_corrcar]);
	
    SendClientMessage(playerid, col_green, "* {FFFFFF}—ﬂ‰  ”Ì«— ﬂ ’Õ.");
    return 1;
}

