					TextDrawSetString ( capture_td [ 17 ], query_string ) ;

					new f_string [ 61 + MAX_PLAYER_NAME * 2 + 28 + 8 + 22 ] ;
					format(f_string, sizeof f_string, "[U] %s[%s] ›‘·() %s[%s](+%d «·‰ﬁ«ÿ). ›Õ’: %s[%d] : [%d]%s", p_info [ killerid ] [ name ], f_info [ p_info [ killerid ] [ member ] - 1 ] [ f_name ], p_info [ playerid ] [ name ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ], expcapt, f_info [ p_info [ killerid ] [ member ] - 1 ] [ f_name ], attacker_points, owner_points, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_name ] ) ;
					SendGangMessage ( f_info [ p_info [ killerid ] [ member ] - 1 ] [ f_radar_color ], f_string ) ;

				}
			}
			if ( p_info [ killerid ] [ member ] == gz_info [ gz_captured ] [ gz_owner ] && p_info [ playerid ] [ member ] == gz_info [ gz_captured ] [ gz_attacker ] ||
			    p_info [ killerid ] [ member ] == gz_info [ gz_captured ] [ gz_owner ]  && f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_attacker ] - 18 ] == dip_status_alliance ||
				f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [  gz_info [ gz_captured ] [ gz_owner ] - 18 ] == dip_status_alliance && p_info [ playerid ] [ member ] == gz_info [ gz_captured ] [ gz_attacker ] && f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_attacker ] - 18 ] == dip_status_war ||
				f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [  gz_info [ gz_captured ] [ gz_owner ] - 18 ] == dip_status_alliance && f_diplomacy [ p_info [ playerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_attacker ] - 18 ] == dip_status_alliance && f_diplomacy [ p_info [ killerid ] [ member ] - 18 ] [ gz_info [ gz_captured ] [ gz_attacker ] - 18 ] == dip_status_war )
			{
				foreach(new i: logged_players)
				{
					if ( ! gang_player ( i ) && ! mafia_player ( i ) ) continue ;
