stock WriteLog(type, text[])
{
	new day, month, year;
	getdate(year, month, day);

	format(global_string, sizeof global_string, "INSERT INTO `logs_all`(`member`, `type`, `Text`, `day`, `month`, `year`) VALUES ('0','%d','%s','%02d','%02d','%d')", type, text, day, month, year);
	mysql_tquery(sql_connection, global_string, "", "");
	return 1;
}

stock WriteLogs(org, type, text[])
{
	new day, month, year;
	getdate(year, month, day);

	format(global_string, sizeof global_string, "INSERT INTO `logs_all`(`member`, `type`, `Text`, `day`, `month`, `year`) VALUES ('%d','%d','%s','%02d','%02d','%d')", org, type, text, day, month, year);
	mysql_tquery(sql_connection, global_string, "", "");
	return 1;
}

callback: JackCar2 (playerid)
{
	new rand = random(10);
	switch(rand)
	{
	    case 0..7:
	    {
	        new veh_id = GetPVarInt ( playerid, "CarJack" ) ;

			PlayerPlaySound ( playerid, 1145, 0.0, 0.0, 0.0 ) ;

            new engine, lights, alarm, doors, bonnet, boot, objective ;
			veh_info [ veh_id - 1 ] [ v_locked ] = false ;
			GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
			SetVehicleParamsEx ( veh_id, engine, lights, alarm, false, bonnet, boot, objective ) ;

			SendClientMessage ( playerid, col_gray, "{"#cGN"}* {"#cGR"}‰ﬁ·  „ › ÕÂ.");

			SetPVarInt(playerid, "NormCar", 1);

			if ( p_info [ playerid ] [ wanted ] + 3 < 6 )
			{
			    p_info [ playerid ] [ wanted ] += 3 ;
				update_int_sql ( playerid, "u_wanted", p_info [ playerid ] [ wanted ] ) ;
				SetPlayerWantedLevel ( playerid, p_info [ playerid ] [ wanted ] ) ;
			}

		    SendClientMessage ( playerid, col_light_red, " „ Ê÷⁄ﬂ ›Ì ﬁ«∆„… «·„ÿ·Ê»Ì‰. «·”»»: ”—ﬁ… ”Ì«—…" ) ;
		    new scm_string [ 144 ] ;
		    format ( scm_string, sizeof ( scm_string ), "Õﬁﬂ «·Õ«·Ì „” ÊÏ «·„ÿ·Ê»: %d", p_info [ playerid ] [ wanted ] ) ;
		    SendClientMessage ( playerid, col_light_red, scm_string ) ;

		    foreach(new i: logged_players)
			{
				if ( cop_player ( i ) || fbi_player ( i ) || army_player ( i ) )
				{
				    new stringer[228];
				    format(stringer, sizeof(stringer),"%s ﬂ«‰ ÷⁄ ⁄·Ï „ÿ·Ê» «·ﬁ«∆„…! «·„ Â¯„ „‰: Passerby | «·”»»: «·”Ì«—… ”—ﬁ… | „” ÊÏ «·„ÿ·Ê»: %d", p_info [ playerid ] [ name ], p_info [ playerid ] [ wanted ]);
					SendClientMessage ( i, col_lblue, stringer ) ;
				}
			}

		    SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}·«“„  ”Êﬁ «·”Ì«—… ··⁄·«„… «·Õ„—«¡ ⁄·Ï «·Œ—Ìÿ…." ) ;

		    SetPlayerRaceCheckpoint ( playerid, 1,214.9941,-221.7877,1.5703,214.9941,-221.7877,1.5703, 4.0 ) ;
		    is_gps_used { playerid } = 1 ;
		    //GameTextForPlayer(playerid, "GPS: ON", 0, 1);
		    SetPVarInt ( playerid,"checkpoint_breaking", 1 ) ;
		    ClearAnimations ( playerid, 1 ) ;
		    p_info [ playerid ] [ jackcar ] -= 1 ;
		    update_int_sql ( playerid, "u_jackcar", p_info [ playerid ] [ jackcar ] ) ;
	    }
	    case 8..10:
	    {
	        p_info [ playerid ] [ jackcar ] -= 1 ;
		    update_int_sql ( playerid, "u_jackcar", p_info [ playerid ] [ jackcar ] ) ;
	        ClearAnimations ( playerid, 1 ) ;
	        SendClientMessage(playerid, col_light_red, "* {FFFFFF}Â–« «·√œ«… „«  ﬁœ—  › Õ «·”Ì«—…° Õ«Ê·  ﬂ”— «·”Ì«—… »√œ«… À«‰Ì….");
	        //GameTextForPlayer(playerid, "~r~INVAILD LOCKPICK", 2000, 3);
	    }
	}
    return 1;
}
CMD:breaking(playerid)
{
	if( ! p_info [ playerid ] [ jackcar ] ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ √œÊ«  ›ﬂ √ﬁ›«·.");
	if(player_Breakcar [playerid] == INVALID_VEHICLE_ID)  return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ”Ì«—«  „ﬂ”Ê—… »«·⁄„·Ì….");

	new Float:X, Float:Y, Float:Z;
	new bool:check_vehicle = false;

    new vehb = player_Breakcar [playerid];
	{
		GetVehiclePos(vehb, X, Y, Z);
		if ( IsPlayerInRangeOfPoint (playerid, 4.0, X, Y, Z ) )
		{
			SetPVarInt(playerid, "CarJack", vehb);
			check_vehicle = true;
		}
	}

	if(!check_vehicle) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}·«“„  ”—ﬁ ”Ì«—… «·„⁄·¯„… ⁄·Ï «·Œ—Ìÿ….");

    SetTimerEx("JackCar2", 15000, 0, "i", playerid);
	ApplyAnimation(playerid,"BD_FIRE","wash_up",4.1,1,0,0,0,0,0);
	return 1;
}

cmd:entertr(playerid)
{
	new Float:vX,
		Float:vY,
		Float:vZ;
	for(new i =0; i < MAX_TRAILERS; i++)
	{
		GetVehiclePos(TrailerInfo[i][d_trailer],vX,vY,vZ);
		if(IsPlayerInRangeOfPoint(playerid,3.0,vX,vY,vZ))
		{
			if(!strcmp(p_info[playerid][name],TrailerInfo[i][d_owner]) || TrailerInfo[i][d_door] == 1)
			{
				SetPlayerPos(playerid, 289.0337,417.4389,3563.3459); //    3
                SetPlayerInterior(playerid, 5);
				SetPlayerFacingAngle(playerid,269.4225);
				set_world(playerid,TrailerInfo[i][d_id]);
				TogglePlayerControllable(playerid,0);
				SetTimerEx("Load_Texture_Off", 1500, false, "d", playerid);
				SendClientMessage(playerid,COLOR_GREY,"œŒ·   «·„ﬁÿÊ—…!");
				SetPVarInt(playerid,"InTrailer",i);
				break;
			}
		}
	}
	return 1;
}
CMD:exittr(playerid)
{
	new i = GetPVarInt(playerid,"InTrailer");
	new Float:vX,
	Float:vY,
	Float:vZ;
	GetVehiclePos(TrailerInfo[i][d_trailer],vX,vY,vZ);
	SetPlayerPos(playerid,vX - 3.0,vY,vZ);
	SetPlayerInterior(playerid,0);
	set_world(playerid,0);
	return DeletePVar(playerid,"InTrailer");
}
CMD:park(playerid)
{
	if(p_info[playerid][buyedtr])
	{
		if(IsPlayerInAnyVehicle(playerid))
		{
			if(is_player_in_dmzone { playerid } == 1) return SendClientMessage(playerid,COLOR_GREY,"„Ê „”„ÊÕ Â‰«!");
			new query[120];
			format(query,sizeof(query),"SELECT * FROM `DNK` WHERE `d_owner` = '%s'",p_info[playerid][name]);
			mysql_function_query(sql_connection,query,false,"Parking","i",playerid);
		}
	}
	else SendClientMessage(playerid,COLOR_GREY,"„« ⁄‰œﬂ «·„ﬁÿÊ—…!");
	return 1;
}
callback: Parking(playerid)
{
	new rows,fields;
	cache_get_data(rows,fields);
	if(rows)
	{
		for(new i = 0; i < MAX_TRAILERS; i++)
		{
			if(!strcmp(p_info[playerid][name],TrailerInfo[i][d_owner]))
			{
				GetVehiclePos(TrailerInfo[i][d_trailer],TrailerInfo[i][d_posx],TrailerInfo[i][d_posy],TrailerInfo[i][d_posz]);
				GetVehicleZAngle(TrailerInfo[i][d_trailer],TrailerInfo[i][d_posa]);
				new query[400];
				format(query,sizeof(query),"UPDATE `DNK` SET `d_posx` = '%f',`d_posy` = '%f',`d_posz` = '%f',`d_posa` = '%f' WHERE `d_owner` = '%s'",TrailerInfo[i][d_posx],TrailerInfo[i][d_posy],TrailerInfo[i][d_posz],TrailerInfo[i][d_posa],p_info[playerid][name]);
				mysql_function_query(sql_connection,query,false,"","");
				break;
			}
		}
		SendClientMessage(playerid,COLOR_GREY,"  „  ÕœÌœ „Êﬁ⁄ ŸÂÊ— ÃœÌœ!");
	}
	return 1;
}

CMD:locktr(playerid)
{
	for(new i = 0; i < MAX_TRAILERS; i++)
 	{
		if(!strcmp(p_info[playerid][name],TrailerInfo[i][d_owner]))
		{
			TrailerInfo[i][d_door] = !TrailerInfo[i][d_door];
			new temporary[100];
			new engine, lights, alarm, doors, bonnet, boot, objective;
			veh_info[TrailerInfo[i][d_trailer]][v_locked] = !veh_info[TrailerInfo[i][d_trailer]][v_locked];
			GetVehicleParamsEx(TrailerInfo[i][d_trailer], engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(TrailerInfo[i][d_trailer], engine, lights, alarm, veh_info[TrailerInfo[i][d_trailer]][v_locked], bonnet, boot, objective);
			me_action(playerid, (!veh_info[TrailerInfo[i][d_trailer]][v_locked])? "› Õ(- ) «·„—ﬂ»…" : "„€·ﬁ  ‰ﬁ·");
			format(temporary,sizeof(temporary),"{ffffff}«·„«·ﬂ: %s\n{ffffff}«·»«»: %s", TrailerInfo[i][d_owner],(!veh_info[TrailerInfo[i][d_trailer]][v_locked])? "{00FF7F}„› ÊÕ" : "{ff0000}„€·ﬁ");
			UpdateDynamic3DTextLabelText(TrailerInfo[i][d_label],-1,temporary);
			format(temporary,sizeof(temporary),"√‰  %s {ffffff}«·„ﬁÿÊ—… «·√»Ê«»!", (!veh_info[TrailerInfo[i][d_trailer]][v_locked])? "{00FF7F} „ › ÕÂ" : "{FF0000}„€·ﬁ");
			SendClientMessage(playerid,-1,temporary);
			format(temporary,sizeof(temporary),"UPDATE `DNK` SET `d_statusdoor` = '%d' WHERE `d_owner` = '%s'",TrailerInfo[i][d_door],TrailerInfo[i][d_owner]);
			mysql_function_query(sql_connection,temporary,false,"","");
			break;
		}
	}
	return 1;
}

CMD:returntr(playerid)
{
	new query[100];
	format(query,sizeof(query),"SELECT * FROM `DNK` WHERE `d_owner` = '%s'",p_info[playerid][name]);
	return mysql_function_query(sql_connection,query,false,"ReturningTR","d",playerid);
}
callback: ReturningTR(playerid)
{
	new rows,fields;
	cache_get_data(rows,fields);
	if(!rows) return SendClientMessage(playerid,COLOR_GREY,"„« Œ«’…  «·„ﬁÿÊ—…!");
	if(p_info[playerid][money] < 1000) return SendClientMessage(playerid,-1," ﬂ·›… «·”Õ» - 1.000$");
	if(rows)
	{
		for(new i = 0; i < MAX_TRAILERS; i++)
		{
			if(!strcmp(p_info[playerid][name],TrailerInfo[i][d_owner]))
			{
				DestroyVehicle(TrailerInfo[i][d_trailer]);
				TrailerInfo[i][d_trailer] = CreateVehicle(508,TrailerInfo[i][d_posx],TrailerInfo[i][d_posy],TrailerInfo[i][d_posz],TrailerInfo[i][d_posa],1,1,-1);
				SetVehicleNumberPlate(TrailerInfo[i][d_trailer], TrailerInfo[i][d_owner]);
				give_money(playerid,-1000);
				SendClientMessage(playerid,COLOR_GREY,"”Ì«— ﬂ  „ √⁄«œ..");
				GameTextForPlayer ( playerid, "~r~-1000$", 2000, 6 ) ;
				break;
			}
		}
	}
	return 1;
}

callback: GiveAmount(playerid)
{
	new rows,fields,d_nomer,query[200];
	cache_get_data(rows,fields);
	if(rows)
	{
		d_nomer = cache_get_field_content_int(0,"d_id",sql_connection);
		format(query,sizeof(query),"UPDATE `users` SET `u_trailer` = '%d',`u_buyedtr` = '1' WHERE `u_id` = '%d'",d_nomer,p_info[playerid][id]);
		mysql_function_query(sql_connection,query,false,"","");
		p_info[playerid][buyedtr] = 1;
		p_info[playerid][u_trailer] = d_nomer;
	}
}
callback: GiveTrailer(playerid)
{
	new rows,fields;
	cache_get_data(rows,fields);
	if(!rows)
	{
		p_info[playerid][buyedtr] = 0;
		update_int_sql(playerid,"u_buyedtr",p_info[playerid][buyedtr]);
		return SendClientMessage(playerid,COLOR_GREY,"„ﬁÿÊ— ﬂ „«  „ —›⁄Â« ·√‰Â« „« ·ﬁÌ  ›Ì ﬁ«⁄œ… «·»Ì«‰« . „‰ ›÷·ﬂ  Ê«’· „⁄ «·≈œ«—… «·⁄·Ì«!");
	}
	for(new i = 0; i < MAX_TRAILERS;i++)
	{
		if(TrailerInfo[i][d_id] == -1)
		{
			new temporary[200];
			TrailerInfo[i][d_id] = cache_get_field_content_int(i,"d_id",sql_connection);
			TrailerInfo[i][d_materials] = cache_get_field_content_int(i,"d_materials",sql_connection);
			TrailerInfo[i][userID] = cache_get_field_content_int(i,"aimid",sql_connection);
			TrailerInfo[i][d_deagle] = cache_get_field_content_int(i,"d_Deagle",sql_connection);
			TrailerInfo[i][d_m4] = cache_get_field_content_int(i,"d_M4",sql_connection);
			TrailerInfo[i][d_posx] = cache_get_field_content_float(i,"d_posx",sql_connection);
			TrailerInfo[i][d_posy] = cache_get_field_content_float(i,"d_posy",sql_connection);
			TrailerInfo[i][d_posz] = cache_get_field_content_float(i,"d_posz",sql_connection);
			TrailerInfo[i][d_posa] = cache_get_field_content_float(i,"d_posa",sql_connection);
			TrailerInfo[i][d_door] = cache_get_field_content_int(i,"d_statusdoor",sql_connection);
			cache_get_field_content(i,"d_owner",TrailerInfo[i][d_owner],sql_connection,MAX_PLAYER_NAME);
			format(temporary,sizeof(temporary),"{ffffff}«·„«·ﬂ: %s\n{ffffff}«·»«»: %s",TrailerInfo[i][d_owner],(TrailerInfo[i][d_door])? "{00FF7F}„› ÊÕ" : "{ff0000}„€·ﬁ");
			TrailerInfo[i][d_trailer] = CreateVehicle(508,TrailerInfo[i][d_posx],TrailerInfo[i][d_posy],TrailerInfo[i][d_posz],TrailerInfo[i][d_posa],1,1,-1);
			TrailerInfo[i][d_label] = CreateDynamic3DTextLabel(temporary, col_white, TrailerInfo[ i ]  [ d_posx ],TrailerInfo[ i ][ d_posy ],TrailerInfo[ i ][ d_posz ], 10.0, INVALID_PLAYER_ID,TrailerInfo[ i ][ d_trailer ],0,-1,-1);
			totaltrailers++;
			SetVehicleNumberPlate(TrailerInfo[i][d_trailer], TrailerInfo[i][d_owner]);
			break;
		}
	}
	return 1;
}

callback: UpdateSpawn(playerid)
{
	new rows,fields;
	cache_get_data(rows,fields);
	if(!rows)
	{
		p_info[playerid][sspawn] = 0;
		p_info[playerid][u_trailer] = 0;
		update_int_sql(playerid,"pSpawn",p_info[playerid][sspawn]);
		update_int_sql(playerid,"u_trailer",p_info[playerid][u_trailer]);
		p_info[playerid][buyedtr] = 0;
		update_int_sql(playerid,"u_buyedtr",p_info[playerid][buyedtr]);
	}
}

