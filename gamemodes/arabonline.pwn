    CreateDynamic3DTextLabel("{FFD700}[ „” Êœ⁄ «·«”·Õ… ]\n{FFFFFF}«”·Õ… Êœ—Ê⁄ «·‘—ÿ…", 0xFFD700FF, LSPD_NEW_ARMOURY_X, LSPD_NEW_ARMOURY_Y, LSPD_NEW_ARMOURY_Z + 0.8, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, LSPD_NEW_VW, LSPD_NEW_INT);
    return 1;
}





// ===========================================================================
// [HAVANA] POLICE HUD OVERLAY - circular handcuff button for on-duty cops/FBI.
//
// The launcher renders a small circular HUD with a handcuff icon. The server
// only tells the launcher when to show it (player went on duty as cop/FBI)
// or hide it (off-duty / disconnect). When the cop taps the button, the
// launcher sends "/cuffnear" as a chat command - we then resolve the closest
// wanted player within reach and run the same logic as /cuff.
// ===========================================================================

forward PoliceHUD_Tick();
public  PoliceHUD_Tick()
{
    foreach(new pid: logged_players)
    {
        new bool:should_show = false;
        if (is_fraction_duty{pid} && (cop_player(pid) || fbi_player(pid)))
            should_show = true;

        if (should_show && !g_police_hud_state{pid})
        {
            g_police_hud_state{pid} = 1;
            // NOTE: do NOT register this dialog in p_t_info[][p_dialog]
            // - the server-wide dialog guard would then reject every command
            // and the player would feel "frozen". The launcher consumes the
            // RPC before SAMP creates a dialog state, and we never expect a
            // dialog response back, so it must stay unregistered.
            // Push the saved layout (position + size) before turning the HUD on.
            new _hudbody[64];
            format(_hudbody, sizeof(_hudbody), "%.4f %.4f %.4f",
                g_police_hud_x[pid], g_police_hud_y[pid], g_police_hud_sz[pid]);
            ShowPlayerDialog(pid, d_police_hud, DIALOG_STYLE_MSGBOX,
                "[!POLICE_HUD_CFG]", _hudbody, " ", " ");
            new _whbody[64];
            format(_whbody, sizeof(_whbody), "%.4f %.4f %.4f",
                g_wanted_hud_x[pid], g_wanted_hud_y[pid], g_wanted_hud_sz[pid]);
            ShowPlayerDialog(pid, d_police_hud, DIALOG_STYLE_MSGBOX,
                "[!WANTED_HUD_CFG]", _whbody, " ", " ");
            ShowPlayerDialog(pid, d_police_hud, DIALOG_STYLE_MSGBOX,
                "[!POLICE_HUD_ON]", " ", " ", " ");
            // Prime the list right away so the panel never appears empty.
            Havana_PushWantedList(pid);
        }
        else if (!should_show && g_police_hud_state{pid})
        {
            g_police_hud_state{pid} = 0;
            ShowPlayerDialog(pid, d_police_hud, DIALOG_STYLE_MSGBOX,
                "[!POLICE_HUD_OFF]", " ", " ", " ");
        }
    }
    // [HAVANA] Push the wanted list to every cop with the HUD on.
    // Lightweight: 1.5s tick is fine because each push is a single dialog RPC.
    static _havana_tick_n = 0;
    _havana_tick_n++;
    if ((_havana_tick_n & 1) == 0) Havana_PushAllWantedLists();
    return 1;
}

// ---------------------------------------------------------------------------
// /cuffnear - auto-cuff the closest wanted player within 5m. Triggered by
// the launcher's PoliceHUD button. Mirrors the validation rules in /cuff.
// ---------------------------------------------------------------------------
CMD:cuffnear(playerid, params[])
{
    #pragma unused params
    if (!cop_player(playerid) && !fbi_player(playerid)) return 1;
    if (GetPVarInt(playerid, "PlayerCuffed"))
        return SendClientMessage(playerid, col_gray,
            "{"#cRD"}* {"#cGR"}√‰  „ﬂ·»‘.");
    if (GetPVarInt(playerid, "PlayerTied"))
        return SendClientMessage(playerid, col_gray,
            "{"#cRD"}* {"#cGR"} „ « ’«·ﬂ.");
    if (p_info[playerid][rank] < 2)
        return SendClientMessage(playerid, col_gray,
            "{"#cRD"}* {"#cGR"}„ «Õ „‰ «·— »… 2.");

    new Float:px, Float:py, Float:pz, vw = GetPlayerVirtualWorld(playerid);
    GetPlayerPos(playerid, px, py, pz);

    new target = INVALID_PLAYER_ID;
    new Float:bestDist = 5.0;
    foreach(new j: logged_players)
    {
        if (j == playerid) continue;
        if (GetPlayerVirtualWorld(j) != vw) continue;
        if (p_info[j][wanted] < 1) continue;
        if (GetPVarInt(j, "PlayerCuffed")) continue;

        new Float:tx, Float:ty, Float:tz;
        GetPlayerPos(j, tx, ty, tz);
        new Float:d = floatsqroot(
            (tx-px)*(tx-px) + (ty-py)*(ty-py) + (tz-pz)*(tz-pz));
        if (d < bestDist)
        {
            bestDist = d;
            target   = j;
        }
    }

    if (target == INVALID_PLAYER_ID)
        return SendClientMessage(playerid, col_gray,
            "{"#cRD"}* {"#cGR"}„« ›ÌÂ „ÿ·Ê» ﬁ—Ì».");

    SetPVarInt(playerid, "Player_Cuffed", target);
    SetPVarInt(target,   "PlayerCuffed",  playerid);
    SetPlayerAttachedObject(target, 1, 19418, 6,
        -0.011000, 0.028000, -0.022000, -15.600012, -33.699977, -81.700035,
         0.891999, 1.000000, 1.168000);
    SetPlayerSpecialAction(target, SPECIAL_ACTION_CUFFED);

    new scm[96];
    format(scm, sizeof(scm), "%s[%d] ﬂ»· √‰ .",
        p_info[playerid][name], playerid);
    SendClientMessage(target, col_wavy, scm);

    format(scm, sizeof(scm), "ﬂ»· %s", p_info[target][name]);
    me_action(playerid, scm);
    update_activity(playerid);
    return 1;
}


// ===========================================================================
// [HAVANA] /hud - opens layout editor on the launcher (drag + size). The
// edit overlay sends back a /hudset command with the new values when the
// player presses Save.
// ===========================================================================
CMD:hud(playerid, params[])
{
    #pragma unused params
    if (!cop_player(playerid) && !fbi_player(playerid))
        return SendClientMessage(playerid, col_gray,
            "{"#cRD"}* {"#cGR"}„ «Õ ›ﬁÿ ··‘—ÿ….");
    if (!is_fraction_duty{playerid})
        return SendClientMessage(playerid, col_gray,
            "{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ ›Ì «·œÊ«„.");

    new body[128];
    format(body, sizeof(body), "%.4f %.4f %.4f %.4f %.4f %.4f",
        g_police_hud_x [playerid], g_police_hud_y [playerid], g_police_hud_sz [playerid],
        g_wanted_hud_x [playerid], g_wanted_hud_y [playerid], g_wanted_hud_sz [playerid]);
    ShowPlayerDialog(playerid, d_police_hud, DIALOG_STYLE_MSGBOX,
        "[!POLICE_HUD_EDIT]", body, " ", " ");

    SendClientMessage(playerid, col_white,
        "{"#cGN"}* {"#cWH"} „ › Õ Ê÷⁄  ⁄œÌ· Ê«ÃÂ… «·ﬂ·»‘….");
    return 1;
}

// ---------------------------------------------------------------------------
// /hudset X Y SIZE - persist the new layout to MySQL. Called by the launcher
// after the player presses Save. Values are clamped to safe ranges.
// ---------------------------------------------------------------------------
CMD:hudset(playerid, params[])
{
    if (!cop_player(playerid) && !fbi_player(playerid)) return 1;

    new Float:hx, Float:hy, Float:hs, Float:wx, Float:wy, Float:ws;
    new ok6 = !sscanf(params, "ffffff", hx, hy, hs, wx, wy, ws);
    new ok3 = !ok6 && !sscanf(params, "fff", hx, hy, hs);
    if (!ok6 && !ok3)
        return SendClientMessage(playerid, col_gray,
            "{"#cRD"}* {"#cGR"}«·«” Œœ«„ €·ÿ.");

    if (hx < 0.05) hx = 0.05;
    if (hx > 0.95) hx = 0.95;
    if (hy < 0.05) hy = 0.05;
    if (hy > 0.95) hy = 0.95;
    if (hs < 0.5)  hs = 0.5;
    if (hs > 2.0)  hs = 2.0;

    g_police_hud_x [playerid] = hx;
    g_police_hud_y [playerid] = hy;
    g_police_hud_sz[playerid] = hs;

    if (!ok6)
    {
        wx = g_wanted_hud_x [playerid];
        wy = g_wanted_hud_y [playerid];
        ws = g_wanted_hud_sz[playerid];
    }
    else
    {
        if (wx < 0.05) wx = 0.05;
        if (wx > 0.95) wx = 0.95;
        if (wy < 0.05) wy = 0.05;
        if (wy > 0.95) wy = 0.95;
        if (ws < 0.5)  ws = 0.5;
        if (ws > 2.0)  ws = 2.0;
        g_wanted_hud_x [playerid] = wx;
        g_wanted_hud_y [playerid] = wy;
        g_wanted_hud_sz[playerid] = ws;
    }

    new q[320];
    format(q, sizeof(q),
        "UPDATE `users` SET `u_hud_x`='%f', `u_hud_y`='%f', `u_hud_size`='%f', `u_whud_x`='%f', `u_whud_y`='%f', `u_whud_size`='%f' WHERE `u_id`='%d' LIMIT 1",
        hx, hy, hs, wx, wy, ws, p_info[playerid][id]);
    mysql_tquery(sql_connection, q, "", "");

    // Also push the new layout to the launcher right now (in case the player
    // is still on duty and the HUD is showing).
    new body[64];
    format(body, sizeof(body), "%.4f %.4f %.4f", hx, hy, hs);
    ShowPlayerDialog(playerid, d_police_hud, DIALOG_STYLE_MSGBOX,
        "[!POLICE_HUD_CFG]", body, " ", " ");
    format(body, sizeof(body), "%.4f %.4f %.4f", wx, wy, ws);
    ShowPlayerDialog(playerid, d_police_hud, DIALOG_STYLE_MSGBOX,
        "[!WANTED_HUD_CFG]", body, " ", " ");

    SendClientMessage(playerid, col_white,
        "{"#cGN"}* {"#cWH"} „ Õ›Ÿ „ﬂ«‰ ÊÕÃ„ «·Ê«ÃÂ….");
    return 1;
}


// ===========================================================================

// ===========================================================================
// [HAVANA] WANTED PLAYER OVERLAY - server side
//
// Pushes the live wanted list to the launcher's wanted-overlay panel and
// answers /wantedlocate /wantedinfo /wantedrefresh requests from it.
//
// The launcher recognises three dialog titles via netrpc:
//   "[!POLICE_HUD_LIST]"  body = "id|name|stars|level\n..."
//   "[!POLICE_HUD_INFO]"  body = "id|name|stars|level|reason|by|hh:mm:ss"
// The list is refreshed every 3s by PoliceHUD_Tick (already running 1.5s)
// for any cop that currently has the HUD shown.
// ===========================================================================

stock Havana_ResetWantedMeta ( target )
{
    g_wanted_meta_known   { target } = 0 ;
    g_wanted_meta_time    [ target ] = 0 ;
    g_wanted_meta_reason  [ target ] [ 0 ] = EOS ;
    g_wanted_meta_byname  [ target ] [ 0 ] = EOS ;
    return 1 ;
}

stock Havana_SetWantedMeta ( target, const reason [ ], const by_name [ ] )
{
    new clean_reason [ 96 ] ;
    new k = 0 ;
    for ( new i = 0 ; reason [ i ] != EOS && k < sizeof ( clean_reason ) - 1 ; i++ )
    {
        new ch = reason [ i ] ;
        if ( ch == '|' || ch == '\n' || ch == '\r' ) ch = ' ' ;
        clean_reason [ k++ ] = ch ;
    }
    clean_reason [ k ] = EOS ;

    format ( g_wanted_meta_reason [ target ], sizeof ( g_wanted_meta_reason [ ] ), "%s", clean_reason ) ;
    format ( g_wanted_meta_byname [ target ], sizeof ( g_wanted_meta_byname [ ] ), "%s", by_name ) ;
    g_wanted_meta_time   [ target ] = gettime ( ) ;
    g_wanted_meta_known  { target } = 1 ;
    return 1 ;
}

// Build & push "[!POLICE_HUD_LIST]" to one cop. Sorted by stars descending
// so the most-wanted players appear first.
stock Havana_PushWantedList ( cop_id )
{
    if ( ! IsPlayerConnected ( cop_id ) ) return 0 ;
    if ( ! g_police_hud_state { cop_id } )         return 0 ;

    static buf [ 1280 ] ;
    new len = 0 ;
    buf [ 0 ] = EOS ;

    // Collect wanted players (cap to 24 rows).
    new ids [ 24 ], stars [ 24 ], count = 0 ;
    foreach(new pid: logged_players)
    {
        // Include EVERYONE who is wanted (matches /wanted output exactly).
        if ( p_info [ pid ] [ wanted ] <= 0 ) continue ;
        ids   [ count ] = pid ;
        stars [ count ] = p_info [ pid ] [ wanted ] ;
        count ++ ;
        if ( count >= sizeof ( ids ) ) break ;
    }
    // Simple stars-desc bubble sort (count is tiny so this is cheap).
    for ( new i = 0 ; i < count - 1 ; i++ )
    {
        for ( new j = 0 ; j < count - 1 - i ; j++ )
        {
            if ( stars [ j ] < stars [ j + 1 ] )
            {
                new ts = stars [ j ] ; stars [ j ] = stars [ j + 1 ] ; stars [ j + 1 ] = ts ;
                new ti = ids   [ j ] ; ids   [ j ] = ids   [ j + 1 ] ; ids   [ j + 1 ] = ti ;
            }
        }
    }

    new line [ 64 + MAX_PLAYER_NAME ] ;
    for ( new i = 0 ; i < count ; i++ )
    {
        new pid = ids [ i ] ;
        format ( line, sizeof ( line ), "%d|%s|%d|%d\n",
            pid,
            p_info [ pid ] [ name ],
            p_info [ pid ] [ wanted ],
            p_info [ pid ] [ level ] ) ;
        new add = strlen ( line ) ;
        if ( len + add >= sizeof ( buf ) - 1 ) break ;
        strcat ( buf, line ) ;
        len += add ;
    }
    if ( buf [ 0 ] == EOS )
    {
        // empty list - launcher will display "no wanted" message
        ShowPlayerDialog ( cop_id, d_police_hud, DIALOG_STYLE_MSGBOX,
            "[!POLICE_HUD_LIST]", " ", " ", " " ) ;
    }
    else
    {
        ShowPlayerDialog ( cop_id, d_police_hud, DIALOG_STYLE_MSGBOX,
            "[!POLICE_HUD_LIST]", buf, " ", " " ) ;
    }
    return 1 ;
}

forward Havana_PushAllWantedLists ( ) ;
public  Havana_PushAllWantedLists ( )
{
    foreach(new pid: logged_players)
    {
        if ( g_police_hud_state { pid } )
            Havana_PushWantedList ( pid ) ;
    }
    return 1 ;
}

CMD:wantedrefresh ( playerid )
{
    if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return 1 ;
    Havana_PushWantedList ( playerid ) ;
    return 1 ;
}

CMD:wantedlocate ( playerid, params [ ] )
{
    if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return 1 ;
    new tid ;
    if ( sscanf ( params, "u", tid ) )
        return SendClientMessage ( playerid, col_gray,
            "{"#cRD"}* {"#cGR"}«·«” Œœ«„ /wantedlocate [ID/«·«”„]" ) ;
    if ( ! IsPlayerConnected ( tid ) )
        return SendClientMessage ( playerid, col_gray,
            "{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ ’·" ) ;
    if ( p_info [ tid ] [ wanted ] <= 0 )
        return SendClientMessage ( playerid, col_gray,
            "{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÿ·Ê»" ) ;

    DisablePlayerRaceCheckpoint ( playerid ) ;
    SetPlayerRaceCheckpoint ( playerid, 1,
        p_t_info [ tid ] [ p_pos ] [ 0 ],
        p_t_info [ tid ] [ p_pos ] [ 1 ],
        p_t_info [ tid ] [ p_pos ] [ 2 ],
        0.0, 0.0, 0.0, 5 ) ;
    is_gps_used { playerid } = 1 ;

    new scm [ 96 + MAX_PLAYER_NAME ] ;
    format ( scm, sizeof ( scm ),
        "{"#cGN"}* {"#cWH"} „  ÕœÌœ {"#cGN"}%s[%d]{"#cWH"} ⁄·Ï «·Œ—Ìÿ….",
        p_info [ tid ] [ name ], tid ) ;
    SendClientMessage ( playerid, col_white, scm ) ;
    return 1 ;
}

CMD:wantedinfo ( playerid, params [ ] )
{
    if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) ) return 1 ;
    new tid ;
    if ( sscanf ( params, "u", tid ) )
        return SendClientMessage ( playerid, col_gray,
            "{"#cRD"}* {"#cGR"}«·«” Œœ«„ /wantedinfo [ID/«·«”„]" ) ;
    if ( ! IsPlayerConnected ( tid ) )
        return SendClientMessage ( playerid, col_gray,
            "{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ ’·" ) ;

    new reason [ 96 ], by_name [ MAX_PLAYER_NAME + 1 ], elapsed_str [ 16 ] ;
    if ( g_wanted_meta_known { tid } && p_info [ tid ] [ wanted ] > 0 )
    {
        format ( reason,  sizeof ( reason ),  "%s", g_wanted_meta_reason [ tid ] ) ;
        format ( by_name, sizeof ( by_name ), "%s", g_wanted_meta_byname [ tid ] ) ;
        new dt = gettime ( ) - g_wanted_meta_time [ tid ] ;
        if ( dt < 0 ) dt = 0 ;
        new hh = dt / 3600 ;
        new mm = ( dt % 3600 ) / 60 ;
        new ss = dt % 60 ;
        format ( elapsed_str, sizeof ( elapsed_str ), "%02d:%02d:%02d", hh, mm, ss ) ;
    }
    else
    {
        format ( reason,  sizeof ( reason ),  "%s", "" ) ;
        format ( by_name, sizeof ( by_name ), "%s", "" ) ;
        format ( elapsed_str, sizeof ( elapsed_str ), "%s", "" ) ;
    }

    new body [ 256 + MAX_PLAYER_NAME ] ;
    format ( body, sizeof ( body ), "%d|%s|%d|%d|%s|%s|%s",
        tid,
        p_info [ tid ] [ name ],
        p_info [ tid ] [ wanted ],
        p_info [ tid ] [ level ],
        reason,
        by_name,
        elapsed_str ) ;

    ShowPlayerDialog ( playerid, d_police_hud, DIALOG_STYLE_MSGBOX,
        "[!POLICE_HUD_INFO]", body, " ", " " ) ;
    return 1 ;
}

