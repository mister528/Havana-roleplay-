// Admin teleport helper: /shopcarmap -> jump to the centre of the new car-shop
// interior so admins can find coordinates for displayed vehicles.
CMD:shopcarmap ( playerid, params [ ] )
{
    if ( p_info [ playerid ] [ admin ] < 5 )
    {
        SendClientMessage ( playerid, col_gray,
            "{"#cRD"}* {"#cGR"}Â–« «·√„— ··≈œ«—… ›ﬁÿ („” ÊÏ 5+)." ) ;
        return 1 ;
    }
    set_world    ( playerid, 0 ) ;
    set_interior ( playerid, 0 ) ;
    SetPlayerPos ( playerid, CAR_PREV_X, CAR_PREV_Y - 6.0, CAR_PREV_Z ) ;
    SetPlayerFacingAngle ( playerid, 0.0 ) ;
    SetCameraBehindPlayer ( playerid ) ;
    SendClientMessage ( playerid, col_white,
        "{"#cGN"}* {"#cWH"} „  ·Ì»Ê— ﬂ ≈·Ï œ«Œ·Ì… „ Ã— «·”Ì«—«  «·ÃœÌœ…." ) ;
    SendClientMessage ( playerid, col_white,
        "{"#cGN"}* {"#cWH"} Õ—ﬂ »œ«Œ· «·„ Ã— À„ «” Œœ„ {"#cGN"}/save{"#cWH"} ·«· ﬁ«ÿ «·≈Õœ«ÀÌ« ." ) ;
    return 1 ;
}


