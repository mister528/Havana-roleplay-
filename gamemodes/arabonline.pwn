			SendClientMessage ( params [ 0 ], col_white, string ) ;
			format ( string, sizeof ( string ), "{"#cGN"}* {"#cWH"}‰ÃÕ  ›Ì collected Õﬁﬂ «·”Ì«—… „›« ÌÕ „‰ {"#cBL"}%s{"#cWH"}.", p_info [ params [ 0 ] ] [ name ] ) ;
			SendClientMessage ( playerid, col_white, string ) ;
			return 1;
		}
		else continue ;
	}
	SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«··«⁄» „« ⁄‰œÂ  „›« ÌÕ ≈·Ï «·”Ì«—…." ) ;
	return 1 ;
}

CMD:sleep(playerid)
{
	for ( new j = 0 ; j < 24 ; j ++ )
	{
		if ( IsPlayerInRangeOfPoint ( playerid, 1.5, sleep_spawn [ j ] [ 0 ], sleep_spawn [ j ] [ 1 ], sleep_spawn [ j ] [ 2 ] ) )
		{
			if(sleeping[playerid] == 0)
			{
			    set_pos(playerid, sleep_spawn [ j ] [ 0 ], sleep_spawn [ j ] [ 1 ], sleep_spawn [ j ] [ 2 ], sleep_spawn [ j ] [ 3 ],3,3);
			    toggle_controlable ( playerid, false, false ) ;
				ApplyAnimation ( playerid,  "CRACK",  "crckidle2",  4.1,  0,  1,  1,  1,  1,  1 ) ;
				PlayerPlaySound ( playerid,  1058,  0.0,  0.0,  0.0 ) ;
				sleeping[playerid] = 1;
				SendClientMessage(playerid, COLOR_SERVER,"√‰  ‰«Ì„ «·ÕÌ‰! —«Õ  ” ·„ 10$ »«·œﬁÌﬁ… Ê ﬁœ—  Õ’· ⁄·Ï ÌÊ„ «·—« » ·„«  ﬂÊ‰ »⁄Ìœ ⁄‰ «·ﬂÌ»Ê—œ.");
				SendClientMessage(playerid, COLOR_SERVER,"√œŒ· {ffffff}'/‰Ê„' {"#col_serv"}„—… À«‰Ì…° ≈–«  »Ì  ’ÕÏ.");
				//show_dialog(playerid,d_sleeping,DIALOG_STYLE_MSGBOX,"Sleeping","{ffffff}By sleeping in the spawn area you can get {"#cGN"}10$ {ffffff}per minute\n\n        {ffffff}If you want to wake up, just click on {"#col_serv"}'UnSleep'","Okye","UnSleep");
				}
			else
			{
			    sleeping[playerid] = 0;
			    ClearAnimations ( playerid,  1 ) ;
			    toggle_controlable ( playerid, true, false ) ;
			}
		}
	}
	return 1;
}

CMD:fsellcar(playerid, params[])
{
	if(p_info[playerid][family] == 0) return 1;
	if(p_info[playerid][family_rang] < 7) return 1;
	if(!IsPlayerInAnyVehicle(playerid)) return 1;
	new veh_id = GetPlayerVehicleID ( playerid ) ;
	new veh_model = GetVehicleModel ( veh_id ) ;
	new veh_price = GetModelPrice ( veh_model );
	new string[338];
	format(string, sizeof(string), "        {FFFFFF}„ √ﬂœ  »Ì »Ì⁄ Â–Â «·⁄«∆·… «·”Ì«—…? {"#col_serv"}[%s]\n\n{FFFFFF}»Ê«”ÿ… clicking {"#col_serv"}'‰⁄„'{FFFFFF}, ⁄«∆· ﬂ «·”Ì«—… ”Ê› —ÊÕ ≈·Ï  «·ÕﬂÊ„… ·‹ {"#cGN"}%d$",vehicle_name [ GetVehicleModel ( veh_id ) - 400 ], floatround ( veh_price - veh_price / 10 ));
	show_dialog(playerid, d_fsellcar,DIALOG_STYLE_MSGBOX,"”Ì«—… «·⁄«∆·…", string, "‰⁄„", "·«");
	return 1;
}

CMD:selltrailer(playerid, params[])
{
	// 1. Check if the player owns a trailer
	if(p_info[playerid][buyedtr] == 0)
	{
		return SendClientMessage(playerid, -1, "„« Œ«’… √Ì «·„ﬁÿÊ—… ·»Ì⁄!");
	}

	new TrailerID = -1;

	// 2. Search for the player's trailer in the TrailerInfo array
	for(new i = 0; i < MAX_TRAILERS; i++)
	{
		// Check if the trailer is active (d_trailer != 0) AND the owner ID matches the player's ID
		// Using 'userID' is more reliable than 'd_owner' string comparison
		if(TrailerInfo[i][d_trailer] != 0 && TrailerInfo[i][userID] == p_info[playerid][id])
		{
			TrailerID = i; // Found the trailer's index in the array
			break;
		}
	}

	// 3. Safety check: If buyedtr is 1 but we couldn't find the trailer, reset the ownership flag.
	if(TrailerID == -1)
	{
		p_info[playerid][buyedtr] = 0;
		update_int_sql(playerid, "u_buyedtr", p_info[playerid][buyedtr]);
		return SendClientMessage(playerid, -1, "Œÿ√: „ﬁÿÊ— ﬂ „« ·ﬁÌ  ›Ì «·‰Ÿ«„. Õ«·… «·„·ﬂÌ…  „ ≈⁄«œ…  ⁄ÌÌ‰Â«.");
	}

	// 4. Determine the selling price (half the purchase price: $1,500,000 / 2)
	new sell_price_tr = 750000;

	// 5. Delete the trailer from the database (using 'd_aimid' which is the player's ID)
	new query[256];
	format(query, sizeof(query), "DELETE FROM `DNK` WHERE `d_aimid` = '%d'", p_info[playerid][id]);
	mysql_tquery(sql_connection, query, "", "");

	// 6. Delete the trailer object and the 3D text label from the server
	AC_DestroyVehicle(TrailerInfo[TrailerID][d_trailer]);
	DestroyDynamic3DTextLabel(TrailerInfo[TrailerID][d_label]);

	// 7. Reset the trailer data in the array
	// This makes the slot available for a new trailer
	p_info [ params [ 0 ] ] [ spawnchange ] = 0 ;
	TrailerInfo[TrailerID][d_trailer] = 0; // Mark as deleted/inactive
	TrailerInfo[TrailerID][d_id] = -1; // Added: Reset d_id based on your buy script structure
	TrailerInfo[TrailerID][userID] = -1;
	// No need to reset all other values (posx, posy, etc.) as the 'd_trailer = 0' and 'userID = -1' are enough.

	// 8. Update player ownership status (in-game and in DB)
	p_info[playerid][buyedtr] = 0;
	update_int_sql(playerid, "u_buyedtr", p_info[playerid][buyedtr]);

	// 9. Give the player the money
	give_money(playerid, sell_price_tr);

	// 10. Send confirmation message
	new message[128];
	format(message, sizeof(message), "‰ÃÕ  ›Ì sold Õﬁﬂ «·„ﬁÿÊ—… ·‹ $%s!", format_number(sell_price_tr));
	SendClientMessage(playerid, 0x00FF00FF, message); // Green color for success

	return true;
}

// Helper function to format large numbers (if you have one, otherwise replace with normal number)
stock format_number(num)
{
	new buf[32];
	format(buf, sizeof(buf), "%i", num);
	return buf;
}

CMD:sellcar(playerid, params[])
{
	new veh_id = GetPlayerVehicleID ( playerid ) ;
	if ( IsValidVehicle ( veh_id ) )
	{
		if ( veh_info [ veh_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] || veh_info [ veh_id - 1 ] [ v_type ] != vehicle_type_player )return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}·«“„  ﬂÊ‰ ›Ì „—ﬂ» ﬂ «·‘Œ’Ì…!");
		if(sscanf(params, "ud", params[0], params[1]))
		{
			SetPVarInt ( playerid, "sc_sellveh", veh_id ) ;
			new veh_model = GetVehicleModel ( veh_id ) ;
			new veh_price = GetModelPrice ( veh_model ),
				dialog_str [ 168 ] ;

			format ( dialog_str, sizeof ( dialog_str ),"{"#cBL"}„ √ﬂœ  »Ì »Ì⁄ %s ≈·Ï «·ÕﬂÊ„… ·‹ %d$?\n\n{AFAFAF}* ·»Ì⁄ ≈·Ï «··«⁄» «·«” Œœ«„: /sellcar [ID/«·«”„] [«·”⁄—]",
			vehicle_name [ veh_model - 400 ], floatround ( veh_price - veh_price / 10 ) ) ;
			show_dialog(playerid, d_sellcar_gov, DIALOG_STYLE_MSGBOX," {"#cBL"} »Ì⁄ Ê”Ì·… «·‰ﬁ·", dialog_str, "√ÌÊÂ", "·√");
			return 1 ;
		}
		if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» „«  „ «·⁄ÀÊ— ⁄·ÌÂ." ) ;
		if ( params[0] == playerid ) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}√œŒ·  ID ‰›”ﬂ." ) ;
		if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» »⁄Ìœ Ãœ«." ) ;
		if ( params [ 1 ] < 1 || params [ 1 ] > 10000000 )return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"} «·”⁄— „« Ìﬁœ— ÌﬂÊ‰ √ﬁ· „‰ {"#cRD"}1${"#cGR"} √Ê √ﬂÀ— {"#cRD"}10.000.000$" ) ;

		if ( p_t_info [ params [ 0 ] ] [ p_dialog ] != -1 )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} «··«⁄» „« Ìﬁœ— Ì”ÊÌ ’›ﬁ«  ›Ì Â–« «·Êﬁ .") ;
		new _d_str [ 128 ] ;
		format ( _d_str, 128, "{ffffff}%s[%d]    {"#cBL"}%s\n{ffffff}: {"#cBL"}%d$",
		p_info [ playerid ] [ name ], playerid, vehicle_name [ GetVehicleModel ( veh_id ) - 400 ], params [ 1 ] ) ;
		show_dialog ( params [ 0 ], d_sellcar, DIALOG_STYLE_MSGBOX, "{"#cBL"} »Ì⁄ «·»Ì“‰”", _d_str, "«‘ —Ì", "≈·€«¡" ) ;
		SetPVarInt ( playerid, "sc_price", params [ 1 ] ) ;
		SetPVarInt ( playerid, "sc_buyer", params [ 0 ] + 1 ) ;
		SetPVarInt ( params [ 0 ], "sc_seller", playerid + 1 ) ;
		SetPVarInt ( params [ 0 ], "sc_sellveh", veh_id ) ;
	}
	return 1 ;
}

CMD:gps(playerid, params[])
{
	if ( GetPVarInt ( playerid, "PlayerCuffed" ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  „ﬂ·»‘." );
	if ( GetPVarInt ( playerid, "PlayerTied" )) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „ « ’«·ﬂ." ) ;
	if ( GetPVarInt ( playerid, "exam_vehicle" ) != 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„Ê „„ﬂ‰ √À‰«¡ «·«Œ »«—." ) ;
	if ( p_t_info [playerid][pBusRoute] )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì„ﬂ‰ «” Œœ«„Â« «·¬‰." ) ;
	if(InPizza[playerid] == 1) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì„ﬂ‰ «” Œœ«„Â« «·¬‰." ) ;
	if(InTyarajob[playerid] == 1) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì„ﬂ‰ «” Œœ«„Â« «·¬‰." ) ;
	if(InDrebajob[playerid] == 1) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì„ﬂ‰ «” Œœ«„Â« «·¬‰." ) ;
	if(InFarmer[playerid] == 1) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì„ﬂ‰ «” Œœ«„Â« «·¬‰." ) ;
	if(InBankjob[playerid] == 1) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì„ﬂ‰ «” Œœ«„Â« «·¬‰." ) ;
	if(InBuilder[playerid] == 1) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì„ﬂ‰ «” Œœ«„Â« «·¬‰." ) ;
	if(InGunjob[playerid] == 1) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}„« Ì„ﬂ‰ «” Œœ«„Â« «·¬‰." ) ;
	if ( is_gps_used { playerid } )
	{
