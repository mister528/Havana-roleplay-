public OnPlayerDeath ( playerid, killerid, reason )
{

	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerDeath] playerid:%d | killerid:%d | reason:%d", playerid, killerid, reason ) ;
	#endif
	//ac_test_OnPlayerDeath ( playerid, killerid, reason ) ;
    #if defined __anti_godmode
	antigm_OnPlayerDeath(playerid, killerid, reason);
	#endif

    new weapon[13], ammo[13] ;
    for(new v = 0; v < 12; v++)
    {
        if(!GetPVarInt(playerid, "on_dmarena") && !GetPVarInt(playerid, "on_dmarena1") && TeamPaint[playerid] == 0 && p_info [ playerid ] [ jailed ] < 1 && !IsPlayerToSquare ( playerid, 80.8047, 1762.5040, 390.7005, 2093.4778))
        {
			if ( GetPlayerState ( playerid ) != PLAYER_STATE_DRIVER || GetPlayerState ( playerid ) != PLAYER_STATE_PASSENGER )
			{
				GetPlayerWeaponData(playerid, v, weapon[v], ammo[v]);

			    if((ammo[v] > 0 || weapon[v] > 0 && ondmz[playerid] == 0))
			    {
			        new slot = get_weapon_slot ( weapon[v] ) ;
			        if(p_t_info[playerid][p_gun_slot][get_weapon_slot ( weapon[v] )] == weapon[v])
			        {
			            if(p_t_info[playerid][p_gun_ammo][slot] >= ammo[v])
			            {
			                if(!IsPlayerInAnyVehicle(playerid))
			                {//stalk
			                    new Float:x, Float:y, Float:z,Float:eagle;
			                    GetPlayerPos(playerid, x, y, z);
			                    GetPlayerFacingAngle(playerid,eagle);
			                    if(!NotGoodGun(weapon[v]))
			                    {
			                        new idgun = GunObjects[weapon[v]];
			                        new idobject=-1;
			                        for(new i;i<MAX_DGUNS;i++)
			                        {
			                            if(dguns[i]==-1)
			                            {
			                                idobject=i;
			                                break;
			                            }
			                        }
			                        if(idobject==-1)
			                        {
			                            new min1=CurrentTimer;
			                            for(new i;i<MAX_DGUNS;i++)
			                            {
			                                if(dguntime[i]<min1)
			                                {
			                                    min1=dguntime[i];
			                                    idobject=i;
			                                }
			                            }
			                            DestroyDynamicObject(dguns[idobject]);
			                            DestroyDynamic3DTextLabel(DgunText[idobject]);
			                        }
			                        dguntime[idobject]=CurrentTimer;
			                        dpatrons[idobject]=ammo[v];
			                        dgunn[idobject]=weapon[v];
			                        dguns[idobject] = CreateDynamicObject(idgun, x, y, z-0.97, 96, 110, eagle, GetPlayerVirtualWorld(playerid));

			                        new buffer[100];
			                        format(buffer, sizeof(buffer), "{"#cWH"}«ﬂ » {"#cYW"}'/pgun'{"#cWH"} ··Õ’Ê· ⁄·Ï  «·”·«Õ", GunNames[weapon[v]]);
			                        DgunText[idobject] =CreateDynamic3DTextLabel(buffer, -1, x, y, z-0.971,15.0);
			                    }
			                }
			            }
			        }
				}
		    }
		}
	}

	reset_player_weapon ( playerid ) ;

	is_player_fake_spawn { playerid } = 1 ;
	p_t_info [ playerid ] [ p_tp_immune_time ] = 3 ;
	p_t_info [ playerid ] [ p_gun_immune_time ] = 8 ;
	p_t_info [ playerid ] [ p_dialog ] = -1 ;

	//StopAudioStreamForPlayer ( playerid ) ;

    if ( playerid == killerid ) return anti_cheat ( playerid, "fake death", 211 ) ;
	if(!IsPlayerConnected(killerid) && killerid != INVALID_PLAYER_ID) return anti_cheat ( playerid, "fake death", 212  );
	//if(GetPlayerState(playerid) != 7) return anti_cheat ( playerid, "fake death", 210 ) ;



    if(Insamiq[playerid] == 1)
    {
       //if(!response) return 1;
       new zbbbbbb[200];
       format(zbbbbbb,sizeof(zbbbbbb),"{1562C6}[›·Ê”]: {FFFFFF}Ã„⁄  {1562C6}%d$.{FFFFFF}.", totalsami[playerid]*MUSORSAMI);
       SendClientMessage(playerid, 0xFFFFFFAA, zbbbbbb);
       GivePlayerMoney(playerid, total[playerid]*MUSORSAMI);
       new txxxxxxxxx[10];
       format(txxxxxxxxx,sizeof(txxxxxxxxx),"~g~+%d$",totalsami[playerid]*MUSORSAMI);
       GameTextForPlayer(playerid,txxxxxxxxx,100,1);
       totalsami[playerid] = 0;
   	//PlayerPlaySound(playerid, 17000, 0.0, 0.0, 10.0);
       musorsami[playerid] = 0;
       Insamiq[playerid] = 0;
       onCheckskinsamilos[playerid] = false;
       SendClientMessage(playerid, col_green, "* {"#cWH"}√‰ÂÌ  Ê—œÌ… ⁄„·ﬂ");
       if ( is_fraction_duty { playerid } == 1 )SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ), SetPlayerColor ( playerid, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;
       else SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;
       AC_DestroyVehicle(player_samiq[playerid]);
       //set_armour ( playerid, 0 ) ;
       //ResetPlayerWeapons( playerid ) ;
       //p_info[playerid][banktimer] = 0;
       varsami[playerid] = 0;DisablePlayerRaceCheckpoint(playerid);samieezq[playerid] = false;
    }

    if(InBankjob[playerid] == 1)
    {
       //if(!response) return 1;
       new zp[200];
       format(zp,sizeof(zp),"{1562C6}[›·Ê”]: {FFFFFF}Ã„⁄  {1562C6}%d$.{FFFFFF}.", total[playerid]*MUSOR);
       SendClientMessage(playerid, 0xFFFFFFAA, zp);
       GivePlayerMoney(playerid, total[playerid]*MUSOR);
       new tx[10];
       format(tx,sizeof(tx),"~g~+%d$",total[playerid]*MUSOR);
       GameTextForPlayer(playerid,tx,100,1);
       total[playerid] = 0;
   	   PlayerPlaySound(playerid, 17000, 0.0, 0.0, 10.0);
       musor[playerid] = 0;
       InBankjob[playerid] = 0;
       onCheckskinbanklos[playerid] = false;
       SendClientMessage(playerid, col_green, "* {"#cWH"}√‰ÂÌ  Ê—œÌ… ⁄„·ﬂ");
       if ( is_fraction_duty { playerid } == 1 )SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ), SetPlayerColor ( playerid, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;
       else SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;
       AC_DestroyVehicle(player_banker[playerid]);
       set_armour ( playerid, 0 ) ;
       ResetPlayerWeapons( playerid ) ;
       p_info[playerid][banktimer] = 0;
       VarCP[playerid] = 0;DisablePlayerRaceCheckpoint(playerid);IniciouEmprego[playerid] = false;
    }

	if ( ! GetPVarInt ( playerid, "p_dead" ) )
	{
		if(IsPlayerToSquare ( playerid, -891.3302, -2950.0190,2915.9917,560.3257)) SetPVarInt ( playerid, "p_dead", 1 ) ;	 // LS
		else if(IsPlayerToSquare ( playerid,-2929.6589,-2889.1660,-1326.9077,1493.1770)) SetPVarInt ( playerid, "p_dead", 2 ) ; // SF
		else SetPVarInt ( playerid, "p_dead", 3 ) ;	 // LV
		if ( army_player ( playerid ) ) SetPVarInt ( playerid, "p_dead", 4 ) ;
		if ( gang_player ( playerid ) && IsPlayerToSquare ( playerid,1638.0592,-2182.7468,2960.9487,-954.5435 ) ) SetPVarInt ( playerid, "p_dead", 5 ) ; // ghetto
		if ( gang_player ( playerid ) && IsPlayerToSquare ( playerid, 79.4755, -217.2198, 373.1118, 76.5940 ) ) SetPVarInt ( playerid, "p_dead", 5 ) ;
		if ( gang_player ( playerid ) && IsPlayerToSquare ( playerid, 581.9171,- 669.1658, 861.9171, -431.1658 ) ) SetPVarInt ( playerid, "p_dead", 5 ) ;
		if ( gang_player ( playerid ) && IsPlayerToSquare ( playerid, 2168.9170, -156.4315, 2574.0967, 221.8066 ) ) SetPVarInt ( playerid, "p_dead", 5 ) ;
		if ( gang_player ( playerid ) && IsPlayerToSquare ( playerid, 1185.7626, 108.5745, 1507.7626, 514.5745 ) ) SetPVarInt ( playerid, "p_dead", 5 ) ;
        if ( terrorist_player ( playerid ) ) SetPVarInt ( playerid, "p_dead", 4 ) ;


        if ( GetPVarInt ( playerid, "tyara_vehicle" ) != 0 )
		{
			SendClientMessage ( playerid, col_gray, "{"#cRD"}* {999999}√‰  ›‘· ≈·Ï  Ê’Ì·  «·ÿ«∆—…." ) ;
			GameTextForPlayer ( playerid, "~r~›‘·", 5000, 6 ) ;
			set_world ( playerid, 0 ) ;
			tyara_veh[playerid] = GetPVarInt ( playerid, "tyara_vehicle" ) ;
			DeletePVar ( playerid, "tyara_vehicle" ) ;
		    InTyarajob[playerid] = 0;
		    DeletePVar(playerid, "Tyara_Taked");
		    DisablePlayerRaceCheckpoint(playerid);
			AC_DestroyVehicle(tyara_veh[playerid]);
			return 0;
		}
		
		
		if ( GetPVarInt ( playerid, "exam_vehicle" ) != 0 )
		{
			is_leave_exam_vehicle { playerid } = 0 ;
			SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}”ÊÌ  √Œÿ«¡ ›«œÕ…° «·«Œ »«— ÿ«Õ." ) ;
			GameTextForPlayer ( playerid, "~r~›‘·", 5000, 6 ) ;
			new vehicle_id = GetPVarInt ( playerid, "exam_vehicle" ) ;
			DeletePVar ( playerid, "exam_vehicle" ) ;
			DeletePVar ( playerid, "driving_cp" ) ;
			DisablePlayerRaceCheckpoint ( playerid ) ;

			SetPVarInt ( playerid, "p_dead", GetVehicleModel ( vehicle_id ) ) ;
			AC_DestroyVehicle ( vehicle_id ) ;
		}
	}
	if ( GetPVarInt ( playerid, "filling_timer" ) != 0 ) KillTimer ( GetPVarInt ( playerid, "filling_timer" ) ), DeletePVar ( playerid, "filling_timer" )  ;
	if ( GetPVarInt ( playerid,"Stol" ) ) ExitBone ( playerid ) ;

	if ( GetPVarInt ( playerid, "p_h_bed") > 0 )
	{
		h_bed_toggled [ GetPVarInt ( playerid, "p_h_bed" ) - 1 ] [ GetPlayerVirtualWorld ( playerid ) - 1 ] = false ;
		DeletePVar ( playerid, "p_h_bed" ) ;
	}
	if ( ( gang_player ( playerid ) || mafia_player ( playerid ) ) && IsPlayerToSquare ( playerid, 80.8047, 1762.5040, 390.7005, 2093.4778 ) )
	{
		p_info [ playerid ] [ crim_ammo ] = 0 ;
		p_info [ playerid ] [ crim_guns ] = 0 ;
		SendClientMessage ( playerid, col_gray, "* »‰«¡ ⁄·Ï —√Ìﬂ ›Ì «·ﬁÊ…°  ›÷Ì·« ﬂ Ê ⁄·Ì„« ﬂ." ) ;
	}

	if ( GetPVarInt(playerid,"p_masked"))DeletePVar ( playerid, "p_masked" ) ;

	if ( p_info [ playerid ] [ timejob ] )
	{
		give_money ( playerid, p_info [ playerid ] [ salary ] ) ;
		p_info [ playerid ] [ salary ] = 0 ;
		if ( p_info [ playerid ] [ timejob ] == job_porter || p_info [ playerid ] [ timejob ] == job_forklift )
		{
			give_money ( playerid, p_info [ playerid ] [ salary ] ) ;
			insert_money_log ( playerid, INVALID_PLAYER_ID, p_info [ playerid ] [ salary ], "—« » «·„Ì‰«¡" ) ;

			SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}€«œ—   «·„Ì‰«¡ «·„‰ÿﬁ… Ê √ﬂ„·  œÊ«„ ‘€·ﬂ." );
			new __t_string [ 72 ] ;
			format ( __t_string, sizeof ( __t_string ), "{"#cGN"}* {"#cWH"}Earned »Ê«”ÿ…: {"#cGN"}%d$", p_info [ playerid ] [ salary ] ) ;
			SendClientMessage ( playerid, col_white, __t_string ) ;

			new pljob = p_info [ playerid ] [ timejob ];

			p_info [ playerid ] [ timejob ] = 0 ;
			p_info [ playerid ] [ salary ] = 0 ;

			if ( is_fraction_duty { playerid } == 1 ) SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ) ;
			else SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;

			hide_payment ( playerid ) ;
			DisablePlayerRaceCheckpoint ( playerid ) ;

			if ( pljob == job_forklift )
			{
				if ( forklift_ptd [ playerid ] != PlayerText:-1 )
				{
					PlayerTextDrawDestroy ( playerid, forklift_ptd [ playerid ] ) ;
					TextDrawHideForPlayer ( playerid, forklift_td ) ;

					forklift_ptd [ playerid ] = PlayerText:-1;
					forklift_time [ playerid ] = -600 ;
				}
				new _v_id = player_rentcar [ playerid ] ;
				player_rentcar [ playerid ] = INVALID_VEHICLE_ID;

				AC_SetVehicleToRespawn ( _v_id  ) ;
				if ( GetPVarInt ( playerid, "fork_object") )
				{
					DestroyDynamicObject ( GetPVarInt ( playerid, "fork_object" ) ) ;
					DeletePVar ( playerid, "fork_object" ) ;
				}
			}
			else if ( pljob == job_porter )
			{
				if ( IsPlayerAttachedObjectSlotUsed ( playerid, 1 ) ) RemovePlayerAttachedObject ( playerid, 1 ) ;
				ClearAnimations ( playerid ) ;
				DeletePVar ( playerid, "have_factory_box" ) ;
			}

		}
		p_info [ playerid ] [ timejob ] = job_none ;
		if(IsPlayerAttachedObjectSlotUsed(playerid, 0)) RemovePlayerAttachedObject(playerid, 0);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
		DisablePlayerRaceCheckpoint ( playerid ) ;

	}
    
	if ( td_db [ playerid ] [ 1 ] != PlayerText:-1 )
	{
		for ( new j = 0 ; j < 4 ; j ++ )
		{
			PlayerTextDrawDestroy ( playerid, td_db [ playerid ] [ j ] ) ;
			td_db [ playerid ] [ j ] = PlayerText:-1 ;
		}
	}
	if ( GetPVarInt ( playerid, "Player_Cuffed" ) > 0 || GetPVarInt ( playerid, "PlayerCuffed" ) > 0 )
	{
	    if ( GetPVarInt ( playerid, "Player_Cuffed" ) > 0 && reason != 0 )
		{
			if ( ( cop_player ( playerid ) && GetPVarInt ( playerid, "Player_Cuffed" ) > 0 ) || ( fbi_player ( playerid ) && GetPVarInt ( playerid, "Player_Cuffed" ) > 0 ) )
			{
			    new player_cuff = GetPVarInt ( playerid, "Player_Cuffed" ) ;
			    DeletePVar ( player_cuff, "PlayerCuffed" ) ;
			    DeletePVar ( playerid, "Player_Cuffed" ) ;
			    DeletePVar ( playerid, "player_gotome" ) ;
			    DeletePVar ( player_cuff, "player_gotome" ) ;
				SetPlayerSpecialAction ( player_cuff, SPECIAL_ACTION_NONE ) ;
				RemovePlayerAttachedObject ( player_cuff, 1 ) ;
				SendClientMessage ( player_cuff, col_gray, "{"#cGN"}* {"#cGR"} «·÷«»ÿ «··Ì ﬂ»¯·ﬂ „« .  „  ≈“«·… «·√’›«œ." ) ;
			}
		}
		else
		{
			new player_cuff = GetPVarInt ( playerid, "PlayerCuffed" ) ;
		    DeletePVar ( playerid, "PlayerCuffed" ) ;
		    DeletePVar ( player_cuff, "Player_Cuffed" ) ;
		    DeletePVar ( playerid, "player_gotome" ) ;
		    DeletePVar ( player_cuff, "player_gotome" ) ;
			SetPlayerSpecialAction ( playerid, SPECIAL_ACTION_NONE ) ;
			RemovePlayerAttachedObject ( playerid, 1 ) ;
		}
	}
	if ( GetPVarInt ( playerid, "PlayerTied" ) > 0 )
	{
		DeletePVar ( playerid, "PlayerTied" ) ;
		DeletePVar ( playerid, "player_gotome" ) ;
		SetPlayerSpecialAction ( playerid, SPECIAL_ACTION_NONE ) ;
	}

	is_ether { playerid } = 0 ; //  

	if(quest_photographer_id[playerid] != -1)
		EndJobPhotographer(playerid);
	if ( p_t_info [ playerid ] [ phone_id ] != INVALID_PLAYER_ID )
	{
		SetPlayerSpecialAction ( playerid, SPECIAL_ACTION_STOPUSECELLPHONE ) ;
		SetPlayerSpecialAction ( p_t_info [ playerid ] [ phone_id ], SPECIAL_ACTION_STOPUSECELLPHONE ) ;
		RemovePlayerAttachedObject ( playerid, 2 ) ;
		RemovePlayerAttachedObject ( p_t_info [ playerid ] [ phone_id ], 2 ) ;

		SendClientMessage ( p_t_info [ playerid ] [ phone_id ], 0x940000FF, "«‰ﬁÿ⁄ «·« ’«·..." ) ;
		me_action ( p_t_info [ playerid ] [ phone_id ], " ⁄·¯ﬁ", 5.0 ) ;

		p_t_info [ p_t_info [ playerid ] [ phone_id ] ] [ phone_id ] = INVALID_PLAYER_ID ;
		p_t_info [ p_t_info [ playerid ] [ phone_id ] ] [ phone_caller ] = 0 ;

		p_t_info [ playerid ] [ phone_id ] = INVALID_PLAYER_ID ;
		p_t_info [ playerid ] [ phone_caller ] = 0 ;
	}
	if ( GetPVarInt ( playerid, "p_sm_used" ) != 0 )
	{
		CancelSelectTextDraw ( playerid ) ;
		PlayerTextDrawDestroy ( playerid, sm_ptd [ playerid ] ) ;
		sm_ptd [ playerid ] = PlayerText:INVALID_TEXT_DRAW ;
		for ( new i = 0 ; i < 4 ; i ++ )
		{
			TextDrawHideForPlayer ( playerid, sm_td [ i ] ) ;
		}
		sm_used [ GetPVarInt ( playerid, "p_sm_used" ) - 1 ] = false ;
		DeletePVar ( playerid, "p_sm_used" ) ;
		DeletePVar ( playerid, "sm_bet" ) ;
	}

	if ( GetPVarInt ( playerid, "p_skin_shop") == 1 )
	{
		DeletePVar ( playerid, "skin_select_number" ) ;
		DeletePVar ( playerid, "p_skin_shop" ) ;

		TogglePlayerControllable ( playerid, true ) ;
		SetCameraBehindPlayer ( playerid ) ;
		set_world ( playerid, 0 ) ;

		for ( new i = 0; i < 19 ; i ++ )
		{
			TextDrawHideForPlayer ( playerid, td_skinshop [ i ] ) ;
		}
		CancelSelectTextDraw ( playerid ) ;
		PlayerTextDrawDestroy ( playerid, td_skinshop_price [ playerid ] ) ;
		td_skinshop_price [ playerid ] = PlayerText:-1;
		SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;
	}

	if ( duel_opponent [ playerid ] != INVALID_PLAYER_ID )
	{
		new _text_string [ 144 ] ;
		format ( _text_string, sizeof ( _text_string ), "{"#cGN"}* {"#cWH"}√‰  defeated {"#cGN"}%s{"#cWH"} Ê ›«“  wager „‰ {"#cGN"}%d$", p_info [ playerid ] [ name ], duel_price [ playerid ] ) ;
		SendClientMessage ( duel_opponent [ playerid ], col_white, _text_string ) ;


		give_money ( duel_opponent [ playerid ], duel_price [ playerid ]*2 ) ;
		insert_money_log ( playerid, duel_opponent [ playerid ], duel_price [ playerid ], "duel" ) ;

		SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}Œ”—   «·„»«—“…." ) ;

		set_pos(duel_opponent [ playerid ], 1552.4939,-1675.5966,16.1953,88.9340,0,0);
		SetPVarInt ( duel_opponent [ playerid ], "tp_area_used", 1 ) ;
		reset_player_weapon ( duel_opponent [ playerid ] ) ;
		for ( new i = 0 ; i < 12 ; i ++ )
		{
			give_weapon ( duel_opponent [ playerid ], duel_guns [ duel_opponent [ playerid ] ] [ i ] [ 0 ], duel_guns [ duel_opponent [ playerid ] ] [ i ] [ 1 ] ) ;
		}
		duel_price [ playerid ] = 0 ;
		duel_price [ duel_opponent [ playerid ] ] = 0 ;
		duel_opponent [ duel_opponent [ playerid ] ] = INVALID_PLAYER_ID ;
		duel_opponent [ playerid ] = INVALID_PLAYER_ID ;
		
		set_health ( duel_opponent [ playerid ], 100 ) ;
		set_health ( playerid, 100 ) ;
	}
	if ( GetPVarInt ( playerid, "fork_object") )
	{
		DestroyDynamicObject ( GetPVarInt ( playerid, "fork_object" ) ) ;
		DeletePVar ( playerid, "fork_object" ) ;
	}
	
	if(GetPVarInt(playerid, "GYM_Dumbbells") == 1)
	{
		SetPVarInt(playerid, "GYM_Dumbbells", 0);
		RemovePlayerAttachedObject(playerid, 4);
		SimulatorUse[3] = false;
	}
	if(GetPVarInt(playerid, "GYM_Bar") == 1)
	{
		SetPVarInt(playerid, "GYM_Bar", 0);
		RemovePlayerAttachedObject(playerid, 4);
		SimulatorUse[2] = false;
	}
	if(GetPVarInt(playerid, "GYM_Thread") == 1)
	{
		SetPVarInt(playerid, "GYM_Threadr", 0);
		SimulatorUse[1] = false;
	}
	if(GetPVarInt(playerid, "GYM_Bike") == 1)
	{
		SetPVarInt(playerid, "GYM_Bike", 0);
		SimulatorUse[0] = false;
	}
	reset_player_weapon ( playerid ) ;
	new stringsx[128];
	format(stringsx, sizeof(stringsx) , " „  „ ﬁ ·Â »Ê«”ÿ… %s(%d)",p_info[killerid][name],killerid);
	SendClientMessage(playerid, col_red, stringsx);
	return 1 ;
}

forward UnFreez(playerid);
public UnFreez(playerid) return TogglePlayerControllable(playerid, true);
public OnPlayerSpawn ( playerid )
{
	if ( IsPlayerNPC(playerid) )
	{
		SetPlayerSkin(playerid, NPCTEST_SKIN_ID);
		return 1;
	}
    Fisherman_OnPlayerSpawn(playerid);
    objedit_send_perm_scales ( playerid ) ;
    HavanaIsland_ShowZone ( playerid ) ;
    if ( HavanaIsland_LoadToolInventory ( playerid ) ) HavanaIsland_PushToolInventory ( playerid ) ;

    if(!p_t_info[playerid][glitch_logged] && p_info[playerid][pc] != 1)
	{
	    anti_cheat ( playerid, "fake spawn", 19323 ) ;
	    return 1;
    }
    
    //PlayerPlaySound(playerid, 1184, 0.0, 0.0, 0.0);

	for(new i;i<9;i++) TextDrawHideForPlayer(playerid, Welcome_TD[i]);
	#if defined __anti_godmode
	antigm_OnPlayerSpawn(playerid);
	#endif
	ac_test_OnPlayerSpawn ( playerid ) ;
 	is_player_fake_spawn { playerid } = 0 ;

 	DP_SetPlayerFightingStyle ( playerid ) ;

	/* if ( google_checking { playerid } == 1 )
	{
		show_dialog ( playerid, d_googleauth_entrance, DIALOG_STYLE_INPUT, "{"#cBL"}„’«œﬁ… ﬁÊﬁ·", "{"#cWH"}Enter   :", "Enter", "Exit" );
	}*/
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerSpawn] playerid:%d", playerid ) ;
	#endif 

	set_health ( playerid, 100) ;
	SetPlayerScore ( playerid, p_info [ playerid ] [ level ] ) ;
	SetPlayerSkills ( playerid ) ;
	p_t_info [ playerid ] [ p_tp_immune_time ] = 4 ;
	p_t_info [ playerid ] [ p_gun_immune_time ] = 8 ;
	
	DrugsLevel[playerid] = 0;
	
	for ( new j = 0 ; j < 14 ; j ++ )
	{
		TextDrawHideForPlayer ( playerid, TDEditor_TD [ j ] ) ;
	}
	
	if ( ! p_t_info [ playerid ] [ p_logged ] )
	{
		AC_TogglePlayerSpectating ( playerid, false ) ;
		TogglePlayerControllable ( playerid, true ) ;
		set_world ( playerid, playerid ) ;
		set_interior ( playerid, 0 ) ;
		TogglePlayerControllable ( playerid, 0 ) ;

        p_t_info [ playerid ] [ p_logged ] = true;

		if( reg_info [ playerid ] [ reg_gender ] == 1 )
        {
            new i = random (3);
            switch(i)
            {
                case 0: p_info[playerid][skin] = 79;
                case 1: p_info[playerid][skin] = 78;
                case 2: p_info[playerid][skin] = 135;
            }
            SetPlayerSkin ( playerid, p_info[playerid][skin] ) ;
        }
        else
        {
            new i = random (2);
            switch(i)
            {
                case 1: p_info[playerid][skin] = 152;
                case 2: p_info[playerid][skin] = 131;
            }
            SetPlayerSkin ( playerid, p_info[playerid][skin] ) ;
        }
        toggle_controlable ( playerid, true, false ) ;
//		reg_info [ playerid ] [ reg_skin ] = registration_skins [ reg_info [ playerid ] [ reg_national ] - 1 ][ reg_info [ playerid ] [ reg_gender ] - 1 ] [ GetPVarInt ( playerid, "skin_select_number" ) ] ;
        new ds_password [ 32 ], ds_email [ 32 ], ds_referal [ MAX_PLAYER_NAME ], ds_gender, ds_race, ds_skin, ds_age ;
        format ( ds_password, 32, "%s", reg_info [ playerid ][ reg_password ] ) ;
        format ( ds_email, 32, "%s", reg_info [ playerid ][ reg_email ] ) ;
        format ( ds_referal, 24, "%s", reg_info [ playerid ][ reg_referal ] ) ;
        ds_gender = reg_info [ playerid ] [ reg_gender ] ;
        ds_race = reg_info [ playerid ] [ reg_national ] ;
        ds_skin = p_info [ playerid ] [ skin ] ;
        ds_age = reg_info [ playerid ] [ reg_age ] ;
        new query_string [ 299 ] ;
        mysql_format ( sql_connection, query_string, sizeof ( query_string ), "INSERT INTO `users` (`u_name`,`u_password`,`u_ip_registration`,`u_date_registration`,`u_referal`,`u_gender`,`u_national`,`u_email`,`u_skin`,`u_age`) VALUES ('%s',MD5('%e'),'%s',NOW(),'%s','%d','%d','%e','%d','%d')",
        p_info [ playerid ] [ name ], ds_password, p_t_info [ playerid ] [ p_ip ], ds_referal, ds_gender - 1, ds_race, ds_email, ds_skin, ds_age ) ;
        mysql_query ( sql_connection, query_string) ;

        mysql_format ( sql_connection, query_string, 128, "SELECT * FROM `users` WHERE `u_name` = '%s' AND `u_password` = MD5('%e') LIMIT 1", p_info [ playerid ] [ name ], ds_password ) ;
        mysql_tquery ( sql_connection, query_string, "load_user", "i", playerid ) ;
        SetPVarInt ( playerid, "first_entrance", 1 ) ;
		new i = random ( 2 );
		set_pos ( playerid, newbie_spawn_pos [ i ] [ 0 ], newbie_spawn_pos [ i ][ 1 ], newbie_spawn_pos [ i ][ 2 ] , newbie_spawn_pos [ i ][ 3 ], 0, 0 ) ;
		TogglePlayerControllable(playerid, false);
		SetTimerEx("UnFreezee", 5000, 0, "d", playerid);
        return 1;
    }
    
    //unfreeze
    TogglePlayerControllable(playerid, true);
    
    
    // spback
	SpTimer[playerid] = 120;
	p_info[playerid][tLastSpawn] = 0;
    if(p_info[playerid][sdpistol_save] > 0)
    {
        give_weapon(playerid, 23, p_info[playerid][sdpistol_save]);
        p_info[playerid][sdpistol_save] = 0;
        update_int_sql ( playerid, "sdpistol_save", p_info [ playerid ] [ sdpistol_save ] ) ;
    }
    if(p_info[playerid][deagle_save] > 0)
    {
        give_weapon(playerid, 24, p_info[playerid][deagle_save]);
        p_info[playerid][deagle_save] = 0;
        update_int_sql ( playerid, "deagle_save", p_info [ playerid ] [ deagle_save ] ) ;
    }
    if(p_info[playerid][shotgun_save] > 0)
    {
        give_weapon(playerid, 25, p_info[playerid][shotgun_save]);
        p_info[playerid][shotgun_save] = 0;
