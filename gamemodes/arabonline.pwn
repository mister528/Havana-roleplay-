CMD:gotome ( playerid, params [ ] )
{
	if ( ! cop_player ( playerid ) && ! fbi_player ( playerid ) && ! army_player ( playerid ) && ! mafia_player ( playerid ) && ! gang_player ( playerid ) && ! terrorist_player ( playerid )) return 1 ;
