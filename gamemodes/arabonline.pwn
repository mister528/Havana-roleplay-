	return 1;
}

CMD:h( playerid )
{
	if ( ! p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ÃÊ«·." );
	if ( ! p_t_info [ playerid ] [ phone_toggled ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}ÃÊ«·ﬂ „€·ﬁ." ) ;
	if ( p_t_info [ playerid ] [ phone_id ] == INVALID_PLAYER_ID && is_ether_calling { playerid } == 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}·« Ê«Õœ ÂÊ Ì ’· √‰ ." ) ;


	if ( is_ether_calling { playerid } != 0 )
	{
		is_ether { playerid } = 0 ;
		is_ether_calling { playerid } = 0 ;
		SetPlayerSpecialAction ( playerid, SPECIAL_ACTION_STOPUSECELLPHONE ) ;
		RemovePlayerAttachedObject ( playerid, 3 ) ;
		SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}ÿ·⁄  „‰ «·ÂÊ«¡." ) ;

		return 1 ;
	}
	new scm_string [ 20 + MAX_PLAYER_NAME ] ;
	format ( scm_string, sizeof ( scm_string ), "%s ﬁ›· «·Â« ›.", p_info [ playerid ] [ name ] ) ;
	SendClientMessage ( p_t_info [ playerid ] [ phone_id ], col_light_purple, scm_string ) ;
	SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}⁄‰œﬂ «‰ ÂÏ  «·Õ«·Ì „Õ«œÀ…." ) ;


 	SetPlayerSpecialAction ( playerid, SPECIAL_ACTION_STOPUSECELLPHONE ) ;
 	SetPlayerSpecialAction ( p_t_info [ playerid ] [ phone_id ], SPECIAL_ACTION_STOPUSECELLPHONE ) ;
  	RemovePlayerAttachedObject ( playerid, 3 ) ;
  	RemovePlayerAttachedObject ( p_t_info [ playerid ] [ phone_id ], 3 ) ;

	p_t_info [ p_t_info [ playerid ] [ phone_id ] ] [ phone_id ] = INVALID_PLAYER_ID ;
	p_t_info [ p_t_info [ playerid ] [ phone_id ] ] [ phone_caller ] = 0 ;

	p_t_info [ playerid ] [ phone_id ] = INVALID_PLAYER_ID ;
	p_t_info [ playerid ] [ phone_caller ] = 0 ;

	return 1;
}
CMD:sms( playerid, params [ ] )
{
	if ( p_info [ playerid ] [ mute ] )
	{
		new _t_string [ 38 ] ;
		format ( _t_string, sizeof ( _t_string ),"√‰  „„‰Ê⁄ „‰ «·‘«  | %d À«‰Ì…", p_info [ playerid ] [ mute ] ) ;
		SendClientMessage ( playerid, col_light_red, _t_string ) ;
		return false ;
	}
	if ( GetPVarInt ( playerid, "PlayerCuffed" ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  „ﬂ·»‘." );
	if ( GetPVarInt ( playerid, "PlayerTied" )) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „ « ’«·ﬂ." ) ;
	if ( ! p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ÃÊ«·." ) ;
	if ( ! p_t_info [ playerid ] [ phone_toggled ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}ÃÊ«·ﬂ „€·ﬁ." ) ;
	if ( p_info [ playerid ] [ phone_balance ] < 5 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ Ê”Ì·… ·≈—”«· SMS." ) ;
	if ( sscanf ( params, "ds[82]", params [ 0 ], params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /sms [«·—ﬁ„] [«·‰’]" ) ;
	if ( params [ 0 ] == 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–« «·—ﬁ„ €Ì— „ÊÃÊœ." ) ;
	check_advertise ( playerid, params [ 1 ] ) ;
	foreach(new i: logged_players)
	{
		if ( p_info [ i ][ number ] == params [ 0 ] )
		{
			if ( i == playerid )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ—  —”· SMS ·‰›”ﬂ." ) ;
            if(pl_afk_time [ i ] > 0) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» ÂÊ »⁄Ìœ ⁄‰ «·ﬂÌ»Ê—œ ⁄‰œ ·ÕŸ…." ) ;
			if ( ! p_t_info [ i ] [ phone_toggled ] )
			{
				return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄»'s «·ÃÊ«· «·Â« › ÂÊ „⁄ÿ¯·." ) ;
			}
			new scm_string [ 144 ] ;

			format ( scm_string, sizeof ( scm_string ), "SMS: %s | Recipient: %s(%i) [√‰«.e. %i]", params [ 1 ], p_info [ i ] [ name ], i, p_info [ i ] [ number ] ) ;
			SendClientMessage ( playerid, col_yellow, scm_string ) ;
