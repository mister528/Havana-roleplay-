CMD:setgps ( playerid )
{
	if ( p_info [ playerid ] [ gps_tracker ] <= 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ÃÂ«“   »⁄ GPS." ) ;
