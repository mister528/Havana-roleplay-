	return 1 ;
}

CMD:bheal ( playerid )
{
	new _b_id = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
	if ( _b_id == -1 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} ·«“„  ﬂÊ‰ ›Ì »Ì“‰”." ) ;
	if ( ! b_info [ _b_id ] [ b_improve ] [ 1 ] )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ›Ì Œœ„… ÿ»Ì… ›Ì Â–« «·»Ì“‰”." ) ;
	if ( p_info [ playerid ] [ money ] < 250 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ›·Ê” ﬂ«›Ì… ·«” Œœ«„ «·Œœ„… «·ÿ»Ì…." ) ;
	if ( b_info [ _b_id ] [ b_product ] < 5 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ›Ì „‰ Ã«  ﬂ«›Ì… ›Ì «·»Ì“‰”" ) ;

	give_money ( playerid, -250 ) ;
	insert_money_log ( playerid, INVALID_PLAYER_ID, -250, "business first aid kit" ) ;

 	b_info [ _b_id ] [ b_money ] += 250 ;
	b_info [ _b_id ] [ b_cash_today ] += 250 ;
	b_info [ _b_id ] [ b_product ] -= 5 ;

	new Float:pl_health ;
	GetPlayerHealth ( playerid, pl_health ) ;
	if ( pl_health + 65 > 100 ) set_health ( playerid, 100 ) ;
	else set_health ( playerid, pl_health + 65 ) ;

	GameTextForPlayer ( playerid, "~g~+65’Õ…", 2000, 1 ) ;

	me_action ( playerid, "«” Œœ„(- ) «·’Ìœ·Ì…") ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT && ! GetPVarInt ( playerid, "PlayerCuffed" )&& ! GetPVarInt ( playerid, "PlayerTied" ) ) ApplyAnimation(playerid, "ped", "gum_eat", 4.0, 0, 0, 0, 0, 0, 1);
	return 1 ;
}

CMD:hheal ( playerid )
{
	new h = GetPVarInt ( playerid, "house_id" ) - 1 ;
	if ( h == -1 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} ·«“„  ﬂÊ‰ ›Ì «·»Ì ." ) ;
	if ( ! h_info [ h ] [ h_heal ] )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ›Ì ’Ìœ·Ì«  ›Ì Â–« «·»Ì ." ) ;
	if ( p_info [ playerid ] [ money ] < 250 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ›·Ê” ﬂ«›Ì… ·«” Œœ«„ «·’Ìœ·Ì… ›Ì Â–« «·»Ì ." ) ;

	give_money ( playerid, -250 ) ;
	insert_money_log ( playerid, INVALID_PLAYER_ID, -250, "first aid kit at home" ) ;
	
	h_info [ h ] [ h_heal ] -= 1 ;
	h_info [ h ] [ h_safe_data ] [ 1 ] += 250 ;

	new _text_string [ 200 ] ;
	format ( _text_string, sizeof _text_string, "UPDATE `houses` SET `h_safe_data` = '%d|%d|%d|%d|%d|%d|%d|%d', `h_heal` = '%d' WHERE `h_id` = '%d' LIMIT 1",
	h_info [ h ] [ h_safe_data ] [ 0 ], h_info [ h ] [ h_safe_data ] [ 1 ],
	h_info [ h ] [ h_safe_guns ] [ 0 ],	h_info [ h ] [ h_safe_guns ] [ 1 ], h_info [ h ] [ h_safe_guns ] [ 2 ],
	h_info [ h ] [ h_safe_guns ] [ 3 ],	h_info [ h ] [ h_safe_guns ] [ 4 ], h_info [ h ] [ h_safe_guns ] [ 5 ],
	h_info [ h ] [ h_id ] ) ;
	mysql_tquery ( sql_connection, _text_string ) ;

	new Float:pl_health ;
	GetPlayerHealth ( playerid, pl_health ) ;
	if ( pl_health + 65 > 100 ) set_health ( playerid, 100 ) ;
	else set_health ( playerid, pl_health + 65 ) ;

	GameTextForPlayer ( playerid, "~g~+65’Õ…", 2000, 1 ) ;

	me_action ( playerid, "«” Œœ„(- ) «·’Ìœ·Ì…") ;
	if ( GetPlayerState ( playerid ) == PLAYER_STATE_ONFOOT && ! GetPVarInt ( playerid, "PlayerCuffed" )&& ! GetPVarInt ( playerid, "PlayerTied" ) ) ApplyAnimation(playerid, "ped", "gum_eat", 4.0, 0, 0, 0, 0, 0, 1);
	return 1 ;
}

CMD:service ( playerid )
{
