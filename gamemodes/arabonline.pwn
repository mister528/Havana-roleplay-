public OnPlayerGiveDamage(playerid, damagedid, Float: amount, weaponid, bodypart)
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerGiveDamage] playerid:%d | damagedid:%d | amount:%f | weaponid:%d", playerid, damagedid, amount, weaponid ) ;
	#endif
	if ( weaponid == 0 && GetPlayerState ( playerid ) != PLAYER_STATE_ONFOOT ) return false ;
	if ( weaponid == 0 && ( GetPlayerDistanceToPlayer ( playerid,damagedid ) > 2 || amount > 6.71 || bodypart == 9 ) ) return false ;
    if(weaponid == 20090)return false;
    if(amount>1000000)return false;

	if(IsAGreenZone(playerid) && !gover_player(playerid) || IsAGreenZone(damagedid)  && gover_player(damagedid))


	{


	    GreenZone_Warn(playerid);


	    return 0;


	}
	
    #if defined __anti_godmode
	antigm_OnPlayerGiveDamage(playerid, damagedid, amount, weaponid, bodypart);
	#endif

 	if ( damagedid != INVALID_PLAYER_ID && playerid != INVALID_PLAYER_ID && IsPlayerConnected ( damagedid ) )
	{
		if ( weaponid == 3 && ( cop_player ( playerid ) || fbi_player ( playerid ) || mayor_player ( playerid ) ) && is_fraction_duty{playerid} == 1)
		{
		    if( ! GetPVarInt ( damagedid, "PlayerCuffed" ) && is_tazered { damagedid } == 0 && GetPlayerState ( damagedid ) == PLAYER_STATE_ONFOOT )
			{
				ApplyAnimation ( damagedid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0 ) ;
				SetTimerEx ( "untazer_timer", 15000, false, "i", damagedid ) ;
		 		TogglePlayerControllable ( damagedid, 0 ) ;
		 		tazered[playerid] = 15;
		   		is_tazered { damagedid } = 1 ;

				new _text_string [ 128 ] ;
				format ( _text_string, sizeof ( _text_string ), "{"#cBL"}* {"#cWH"}√‰  stunned  citizen {"#cBL"}%s{"#cWH"} ·‹ 15 ÀÊ«‰Ì.", p_info [ damagedid ] [ name ] ) ;
				SendClientMessage ( playerid, col_white, _text_string ) ;

				format ( _text_string, sizeof ( _text_string ), "{"#cBL"}* {"#cWH"} „ stunned »Ê«”ÿ… {"#cBL"}%s{"#cWH"} ·‹ 15 ÀÊ«‰Ì.", p_info [ playerid ] [ name ] ) ;
				SendClientMessage ( damagedid, col_white, _text_string ) ;
			}
		}
	}
	return 1 ;
}
public OnPlayerTakeDamage(playerid, issuerid, Float:amount, weaponid, bodypart)
{
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerTakeDamage] playerid:%d | issuerid:%d | amount:%f | weaponid:%d | bodypart:%d", playerid, issuerid, amount, weaponid, bodypart ) ;
	#endif
	#if defined __anti_godmode
	antigm_OnPlayerTakeDamage(playerid, issuerid, Float: amount, weaponid, bodypart);
	#endif
	
	/*static fmt_str[] = "-%.0f HP";
	const fmt_size = sizeof(fmt_str)-2+3;
	new string[fmt_size];
	format(string, sizeof(string), fmt_str, amount);
	SetPlayerChatBubble(playerid, string, col_light_red, 50.0, 2000);*/
	
	new Float:fOriginX, Float:fOriginY, Float:fOriginZ, Float:fHitPosX, Float:fHitPosY, Float:fHitPosZ, PlayerText3D:hitbar, string[10];
    format(string, 10, "%.0f", amount);
    GetPlayerLastShotVectors(issuerid, fOriginX, fOriginY, fOriginZ, fHitPosX, fHitPosY, fHitPosZ);
    hitbar = CreatePlayer3DTextLabel(issuerid, string, -1, fHitPosX, fHitPosY, fHitPosZ, 70); SetTimerEx("destroyHidBar", 1200, 0, "dd", issuerid, _:hitbar);
    
	if(issuerid != 65535)
	{
	    if(weaponid >= 0 && weaponid <= 8)
	    {
			if(p_info[issuerid][stats][2] > 0)
			{
				p_t_info [ playerid ] [ p_health ] -= float(p_info[issuerid][stats][2]/4);
				set_health(playerid, p_t_info [ playerid ] [ p_health ]);
			}
		}
	}
 	if(p_info[issuerid][admin] && p_info[issuerid][GM] == 1) return false;
	return 1 ;
}

forward UnfreezePlayer(playerid);
public UnfreezePlayer(playerid)
{
    TogglePlayerControllable(playerid, true);
    SendClientMessage(playerid, 0x00FF00FF, " „ ›ﬂ «· Ã„Ìœ. „‰ ›÷·ﬂ  Ã‰» «” Œœ«„ ≈ÿ·«ﬁ ‰«— Reaper.");
    return 1;
}

public OnPlayerKeyStateChange ( playerid, newkeys, oldkeys )
{
	#if defined debug_mode
//		printf ( "[DEBUG] [OnPlayerKeyStateChange] playerid:%d | newkeys:%d | oldkeys:%d", playerid, newkeys, oldkeys ) ;
	#endif
	#define PRESSED(%0) (((newkeys & (%0)) == (%0)) && ((oldkeys & (%0)) != (%0)))

	if ((newkeys & 4) && !(oldkeys & 4))
	{
		new _rwid = GetPlayerWeapon(playerid);
		if (_rwid >= 22 && _rwid <= 38)
		{
			new _ribx = Rob247_FindShopByVW(GetPlayerVirtualWorld(playerid));
			if (_ribx != -1)
			{
				if (Rob247_PreCheck(playerid))
				{
					if (g_rob247_state[_ribx] == 0) Rob247_Start(playerid, _ribx);
					else SendClientMessage(playerid, 0xFFAA55FF, "{FFAA55}* {FFFFFF}Â–« «·„ Ã—  „ ”—ﬁ Â „ƒŒ—«.");
				}
			}
		}
	}

	if (g_house_guard_active[playerid] && (PRESSED(KEY_YES) || PRESSED(KEY_NO)))
	{
		if (g_house_guard_key_step[playerid] >= 0)
		{
			new pressed_dir = -1;
			if (PRESSED(KEY_YES)) pressed_dir = 0;
			if (PRESSED(KEY_NO)) pressed_dir = 1;
			if (pressed_dir == g_house_guard_key_dir[playerid])
			{
				g_house_guard_key_step[playerid]++;
				if (g_house_guard_key_step[playerid] >= 2)
				{
					g_house_guard_pay[playerid] += HOUSE_GUARD_REWARD;
					g_house_guard_stage[playerid]++;
					SendClientMessage(playerid, col_white, "{00BFFF}[Õ«—” «·„‰“·] {FFFFFF} „ › Õ «·ﬁ›·. «·»Ì  „Õ„Ì „‰ «·„Ã—„Ì‰. {00FF00}+$5000");
	SendClientMessageToAll(col_white, "{00BFFF}[Õ«—” «·„‰“·] {FFFFFF} „  √„Ì‰ √Õœ «·„‰«“· ÊÕ„«Ì Â „‰ «·„Ã—„Ì‰.");
					g_house_guard_key_step[playerid] = 0;
					return house_guard_show_next(playerid);
				}
				return house_guard_open_lock(playerid);
			}
			SendClientMessage(playerid, col_gray, "{FF5555}* {FFFFFF}« Ã«Â «·„› «Õ €·ÿ. Ã—»  ﬁ›· „—… À«‰Ì….");
			return house_guard_open_lock(playerid);
		}
	}
	if (((newkeys & KEY_WALK && newkeys & KEY_UP) || (newkeys & KEY_WALK && newkeys & KEY_DOWN) || (newkeys & KEY_WALK && newkeys & KEY_LEFT) || (newkeys & KEY_WALK && newkeys & KEY_RIGHT))
			|| ((oldkeys & KEY_WALK && newkeys & KEY_UP) || (oldkeys & KEY_WALK && newkeys & KEY_DOWN) || (oldkeys & KEY_WALK && newkeys & KEY_LEFT) || (oldkeys & KEY_WALK && newkeys & KEY_RIGHT))
			|| ((newkeys & KEY_WALK && oldkeys & KEY_UP) || (newkeys & KEY_WALK && oldkeys & KEY_DOWN) || (newkeys & KEY_WALK && oldkeys & KEY_LEFT) || (newkeys & KEY_WALK && oldkeys & KEY_RIGHT))
			&& GetPlayerState(playerid) == PLAYER_STATE_ONFOOT){
				walk_timer [ playerid ] = SetTimerEx ( "walking_style_callback",400,0,"d", playerid ) ;
			}
    
	if((newkeys == KEY_CROUCH)||(newkeys == KEY_CTRL_BACK))
	{
		if ( army_player ( playerid ) || cop_player ( playerid ) || fbi_player ( playerid ) || gov_player ( playerid ) )
		{
			for ( new j = 0 ; j < 6 ; j ++ )
			{
				if ( IsPlayerInRangeOfPoint ( playerid, 10.0, barrier_pos [ j ] [ 0 ] [ 0 ], barrier_pos [ j ] [ 0 ] [ 1 ], barrier_pos [ j ] [ 0 ] [ 2 ] ) )
				{
					MoveDynamicObject ( barrier_object [ j ], barrier_pos [ j ] [ 0 ] [ 0 ], barrier_pos [ j ] [ 0 ] [ 1 ], barrier_pos [ j ] [ 0 ] [ 2 ],
														0.07,barrier_pos [ j ] [ 0 ] [ 3 ], barrier_pos [ j ] [ 0 ] [ 4 ], barrier_pos [ j ] [ 0 ] [ 5 ] ) ;

					SendClientMessage ( playerid, col_gray, "{"#cBL"}* {"#cGR"}«·‘·ﬁ»«Ê„ ”Ìı› Õ Œ·«· {"#cBL"}10 ÀÊ«‰Ì{"#cGR"}." ) ;

					SetTimerEx("barrier_callback", 10000, 0, "i", j ) ;
					return 1 ;
				}
			}
			for ( new t = 0 ; t < 9 ; t ++ )
			{
				if ( IsPlayerInRangeOfPoint ( playerid, 5.0, door_pos [ t ] [ 0 ] [ 0 ], door_pos [ t ] [ 0 ] [ 1 ], door_pos [ t ] [ 0 ] [ 2 ] ) )
				{
					MoveDynamicObject ( door_object [ t ], door_pos [ t ] [ 0 ] [ 0 ], door_pos [ t ] [ 0 ] [ 1 ], door_pos [ t ] [ 0 ] [ 2 ],
														2.00,door_pos [ t ] [ 0 ] [ 3 ], door_pos [ t ] [ 0 ] [ 4 ], door_pos [ t ] [ 0 ] [ 5 ] ) ;

					SendClientMessage ( playerid, col_gray, "{"#cBL"}* {"#cGR"} «·Õ«Ã“ ”Ì‰Œ›÷ Œ·«· {"#cBL"}6 ÀÊ«‰Ì{"#cGR"}." ) ;

					SetTimerEx("door_callback", 6000, 0, "i", t ) ;
					return 1 ;
				}
			}
		}
	}
	if(newkeys == KEY_WALK)
	{
		if(IsPlayerInRangeOfPoint(playerid,2.0,288.5317,417.3707,3563.3459)) //  
		{
				new i = GetPVarInt(playerid,"InTrailer");
				new Float:vX,
				Float:vY,
				Float:vZ;
				GetVehiclePos(TrailerInfo[i][d_trailer],vX,vY,vZ);
				SetPlayerPos(playerid,vX - 3.0,vY,vZ);
				SetPlayerInterior(playerid,0);
				set_world(playerid,0);
				return DeletePVar(playerid,"InTrailer");
		}
	}
	if(newkeys == KEY_WALK)
	{
		new Float:vX,
		Float:vY,
		Float:vZ;
		for(new i =0; i < MAX_TRAILERS; i++)
		{
			GetVehiclePos(TrailerInfo[i][d_trailer],vX,vY,vZ);
			if(IsPlayerInRangeOfPoint(playerid,3.0,vX,vY,vZ))
			{
				if(!strcmp(p_info[playerid][name],TrailerInfo[i][d_owner]) || TrailerInfo[i][d_door] == 1)
				{
					SetPlayerPos(playerid, 289.0337,417.4389,3563.3459); //   
					SetPlayerInterior(playerid, 5);
					SetPlayerFacingAngle(playerid,269.4225);
					TogglePlayerControllable(playerid,0);
					SetTimerEx("Load_Texture_Off", 1500, false, "d", playerid);
					set_world(playerid,TrailerInfo[i][d_id]);
					SendClientMessage(playerid,COLOR_GREY,"œŒ·   «·„ﬁÿÊ—…!");
					SetPVarInt(playerid,"InTrailer",i);
					break;
				}
			}
		}
	}
	if(newkeys == KEY_WALK)
	{
		for(new i = 0; i < MAX_TRAILERS; i++)
		{
			if(TrailerInfo[i][d_door])
			{
				new Float:xX,Float:yY,Float:zZ;
				GetVehiclePos(TrailerInfo[i][d_trailer],xX,yY,zZ);
				if(IsPlayerInRangeOfPoint(playerid,4.0,xX,yY,zZ)) pc_cmd_entertr(playerid);
				break;
			}
		}
	}
	if(newkeys == KEY_YES)
	{
		if ( prisoner_player ( playerid ) )
		{
			for ( new t = 0 ; t < 37 ; t ++ )
			{
				if ( IsPlayerInRangeOfPoint ( playerid, 2.0, prison_pos [ t ] [ create_position ] [ 0 ], prison_pos [ t ] [ create_position ] [ 1 ], prison_pos [ t ] [ create_position ] [ 2 ] ) )
				{
				    if ( t > 15 && p_info [ playerid ] [ rank ] >= 8 ) MoveDynamicObject ( prison_gate [ t ], prison_pos [ t ] [ move_position ] [ 0 ] + 2, prison_pos [ t ] [ move_position ] [ 1 ], prison_pos [ t ] [ move_position ] [ 2 ], 2.00,prison_pos [ t ] [ move_position ] [ 3 ], prison_pos [ t ] [ move_position ] [ 4 ], prison_pos [ t ] [ move_position ] [ 5 ] ) ;
				    else MoveDynamicObject ( prison_gate [ t ], prison_pos [ t ] [ move_position ] [ 0 ], prison_pos [ t ] [ move_position ] [ 1 ], prison_pos [ t ] [ move_position ] [ 2 ], 2.00,prison_pos [ t ] [ move_position ] [ 3 ], prison_pos [ t ] [ move_position ] [ 4 ], prison_pos [ t ] [ move_position ] [ 5 ] ) ;
					SendClientMessage ( playerid, col_gray, "{"#cBL"}* {"#cGR"} «·»Ê«»… ”Ê›  ‰Œ›÷ Œ·«· {"#cBL"}5 ÀÊ«‰Ì{"#cGR"}." ) ;

					SetTimerEx("prison_callback", 5000, 0, "i", t ) ;
					return 1 ;
				}
			}
			for ( new t = 0 ; t < 2 ; t ++ )
			{
				if ( IsPlayerInRangeOfPoint ( playerid, 8.0, prison_pos1 [ t ] [ create_position1 ] [ 0 ], prison_pos1 [ t ] [ create_position1 ] [ 1 ], prison_pos1 [ t ] [ create_position1 ] [ 2 ] ) )
