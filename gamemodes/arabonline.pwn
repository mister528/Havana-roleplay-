	if ( GetPVarInt ( playerid, "PlayerTied" )) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"} „ « ’«·ﬂ." ) ;
	if ( sscanf ( params, "u", params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /tie [ID/«·«”„]" ) ;
