	if ( GetPVarInt ( playerid, "PlayerTied" ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰  „—»Êÿ." ) ;
	if ( ! p_info [ playerid ] [ number ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ  ·›Ê‰." ) ;
	if ( ! p_t_info [ playerid ] [ phone_toggled ] ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}ÃÊ«·ﬂ „ﬁ›Ê·." ) ;
	if ( p_t_info [ playerid ] [ phone_id ] != INVALID_PLAYER_ID || is_ether_calling { playerid } != 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}√‰Âˆ «·„Õ«œÀ… «·Õ«·Ì…." ) ;
	show_dialog ( playerid, d_service, DIALOG_STYLE_LIST, "{"#cBL"}«·Œœ„« ", "«·‘—ÿ…\n«·≈”⁄«›\n «ﬂ”Ì\n„Ìﬂ«‰Ìﬂ\n Ê’Ì· «·»÷«∆⁄", "«Œ —", "—ÃÊ⁄" ) ;
	return 1 ;
}


