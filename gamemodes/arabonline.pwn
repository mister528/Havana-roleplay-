CMD:phone_copy ( playerid, params [ ] )
{
	PhonePush ( playerid, "STATUS| „ ‰”Œ ID." ) ;
	return 1 ;
}

CMD:phone_add ( playerid, params [ ] )
{
	new target_arg [ MAX_PLAYER_NAME ] ;
	if ( sscanf ( params, "s[24]", target_arg ) ) return PhonePush ( playerid, "STATUS|«ﬂ » ID √Ê «”„ «·Õ”«»." ) ;
	new uid, target_name [ MAX_PLAYER_NAME ], targetid = INVALID_PLAYER_ID ;
	if ( ! isNumeric ( target_arg ) )
	{
		uid = strval ( target_arg ) ;
		targetid = PhoneFindOnlineByUid ( uid ) ;
		if ( targetid != INVALID_PLAYER_ID ) format ( target_name, sizeof ( target_name ), "%s", p_info [ targetid ] [ name ] ) ;
	}
	else
	{
		targetid = GetPlayerID ( target_arg ) ;
		if ( targetid != INVALID_PLAYER_ID ) uid = p_info [ targetid ] [ id ], format ( target_name, sizeof ( target_name ), "%s", p_info [ targetid ] [ name ] ) ;
	}
	if ( uid <= 0 || uid == p_info [ playerid ] [ id ] ) return PhonePush ( playerid, "STATUS|ID €Ì— ’ÕÌÕ." ) ;
	PhoneEnsureTables ( ) ;
	new query [ 260 ] ;
	if ( targetid == INVALID_PLAYER_ID )
	{
		if ( ! isNumeric ( target_arg ) )
			mysql_format ( sql_connection, query, sizeof ( query ), "SELECT `u_id`,`u_name` FROM `users` WHERE `u_id`='%d' LIMIT 1", uid ) ;
		else
			mysql_format ( sql_connection, query, sizeof ( query ), "SELECT `u_id`,`u_name` FROM `users` WHERE `u_name`='%e' LIMIT 1", target_arg ) ;
		new Cache:account = mysql_query ( sql_connection, query ) ;
		if ( ! cache_num_rows ( ) )
		{
			cache_delete ( account ) ;
			return PhonePush ( playerid, "STATUS|«·Õ”«» €Ì— „ÊÃÊœ." ) ;
		}
		uid = cache_get_field_content_int ( 0, "u_id", sql_connection ) ;
		cache_get_field_content ( 0, "u_name", target_name, sql_connection, MAX_PLAYER_NAME ) ;
		cache_delete ( account ) ;
		if ( uid <= 0 || uid == p_info [ playerid ] [ id ] ) return PhonePush ( playerid, "STATUS|ID €Ì— ’ÕÌÕ." ) ;
	}
