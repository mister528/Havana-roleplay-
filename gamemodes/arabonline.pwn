	if ( is_text_invalid ( params [ 1 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"{«·”»» ÌÕ ÊÌ ⁄·Ï √Õ—› €Ì— ’«·Õ…." ) ;

	p_info [ params [ 0 ] ] [ f_warning ] ++ ;
	if ( p_info [ params [ 0 ] ] [ f_warning ] >= 3 )
	{
		new scm_string [ 266 ] ;
		
		format ( scm_string, 144, "[F] %s %s „›’Ê· „‰ «·„‰Ÿ„… %s (%d/3). «·”»»: %s.", f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], p_info [ params [ 0 ] ] [ f_warning ], params [ 1 ] ) ;
		foreach(new i: logged_players) if ( ( p_info [ i ] [ member ] == p_info [ playerid ] [ member ] || is_control_chat { i } == p_info [ playerid ] [ member ] ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, 0x8D8DFFFF, scm_string ) ;

        format ( scm_string, 128, "DELETE FROM `f_warns` WHERE `f_name`='%s' LIMIT 3", p_info [ params [ 0 ] ] [ name ] ) ;
		mysql_query ( sql_connection, scm_string ) ;

		format ( scm_string,sizeof(scm_string),
		"INSERT INTO `users_jobinfo` (`ji_uid`,`ji_date_invite`,`ji_date_uninvite`,`ji_reason`,`ji_fraction`,`ji_fwarnings` ) SELECT `u_id`, `u_fraction_date`, NOW(), '%s','%d','%d' FROM `users` WHERE `u_id` = '%d'",
		params [ 1 ], p_info [ params [ 0 ] ] [ member ], p_info [ params [ 0 ] ] [ f_warning ], p_info [ params [ 0 ] ] [ id ] ) ;
		mysql_tquery ( sql_connection, scm_string, "", "" ) ;

		p_info [ params [ 0 ] ] [ member ] = 0 ;
		p_info [ params [ 0 ] ] [ rank ] = 0 ;
		p_info [ params [ 0 ] ] [ org_skin ] = 0 ;
		p_info [ params [ 0 ] ] [ warblock ] = 0 ;
		p_info [ params [ 0 ] ] [ spawnchange ] = 0 ;
		update_int_sql ( params [ 0 ], "u_spawnchange", p_info [ params [ 0 ] ] [ spawnchange ] ) ;
		update_int_sql ( params [ 0 ], "u_warblock", p_info [ params [ 0 ] ] [ warblock ] ) ;
		update_int_sql ( params [ 0 ], "u_member", p_info [ params [ 0 ] ] [ member ] ) ;
		update_int_sql ( params [ 0 ], "u_rank", p_info [ params [ 0 ] ] [ rank ] ) ;

		SetPlayerSkin ( params [ 0 ], p_info [ params [ 0 ] ] [ skin ] ) ;
		SetPlayerColor ( params [ 0 ], 0xFFFFFF80 ) ; // col_white
	}
	update_int_sql ( params [ 0 ], "u_f_warning", p_info [ params [ 0 ] ] [ f_warning ] ) ;
	
	if ( p_info [ params [ 0 ] ] [ f_warning ] < 3 )
	{
		new scm_string [ 144 ] ;

		format ( scm_string, sizeof scm_string, "[F] %s %s √⁄ÿÏ ≈‰–«— %s (%d/3). «·”»»: %s.",f_rank [ p_info [ playerid ] [ member ] - 1 ] [ p_info [ playerid ] [ rank ] - 1 ], p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], p_info [ params [ 0 ] ] [ f_warning ], params [ 1 ] ) ;
		foreach(new i: logged_players) if ( ( p_info [ i ] [ member ] == p_info [ playerid ] [ member ] || is_control_chat { i } == p_info [ playerid ] [ member ] ) && p_info [ i ] [ settings ] [ 0 ] != 0 ) SendClientMessage ( i, 0x8D8DFFFF, scm_string ) ;

	    format ( scm_string, 128, "INSERT INTO `f_warns` (`f_date`,`f_reason`,`f_name`,`to_f_name`) VALUES (NOW(),'%s','%s','%s')",
		params [ 1 ], p_info [ params [ 0 ] ] [ name ], p_info [ playerid ] [ name ] ) ;
