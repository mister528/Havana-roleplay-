stock RemoveRadar(radar_id)
{
	DestroyDynamic3DTextLabel(GetRadarData(radar_id, R_LABEL));

	DestroyDynamicArea(GetRadarData(radar_id, R_ZONE));

	DestroyDynamicObject(GetRadarData(radar_id, R_OBJECT));

	g_radar[radar_id] = g_radar_default_values;

	if(radar_id == g_radars_created - 1 && radar_id != 0)
		g_radars_created --;

	return 1;
}

stock CheckRadars(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(vehicleid == 0) return 1;

	if(veh_info[vehicleid - 1][v_type] == JC_TYPE_FRAC) // fixcode
	{
		switch(veh_info[vehicleid - 1][v_owner])
		{
		    case 4,5,6,8,9,11,7,15,16,17,27: return 1;
		}
	}
	new Float: speed = GetVehicleSpeed(vehicleid);

	for(new idx; idx < g_radars_created; idx ++)
	{
		if(!IsValidDynamicObject(GetRadarData(idx, R_OBJECT))) continue;
		if(GetPVarInt(playerid, "radar_detected") > gettime()) continue;

		if(IsPlayerInRangeOfPoint(playerid, 40.0, GetRadarData(idx, R_POS_X), GetRadarData(idx, R_POS_Y), GetRadarData(idx, R_POS_Z)))
		{
			if(speed > (GetRadarData(idx, R_LIMIT) + 20))
			{
			    if(p_info[playerid][p_ticket_count] < 30)
			    {
					p_info[playerid][p_ticket_count]++;

					new fmt_text[35],
						excess;

					excess = floatround(speed) - GetRadarData(idx, R_LIMIT);
					
					new message[256];
					format(message, sizeof(message), " „  „ ≈’œ«—  speeding  –ﬂ—…. %d km. „ﬁ—Ê¡ «·„“Ìœ / –«ﬂ—", excess);
					SendClientMessage(playerid, 0x14A3FFFF, message);
					
					format(message, sizeof(message), "«·—ﬁ„ „‰ «·„Œ«·›«  %d „‰ 30 ﬁ»·  confiscation «·‹ —Œ’… «·ﬁÌ«œ…. Radar #%d", p_info[playerid][p_ticket_count], idx + 1);
					SendClientMessage(playerid, 0x14A3FFFF, message);

					//send_me_f(playerid, 0x14A3FFFF, "You have been issued a speeding ticket. %d km. Read more /tickets", excess);
					//send_me_f(playerid, 0x14A3FFFF, "Number of fines %d from 30 before the confiscation of the driver's license. Radar #%d", p_info[playerid][p_ticket_count], idx + 1);

					if(p_info[playerid][p_ticket_count] >= 30)
					{
					    send_me(playerid, 0xFF6600FF, " „ ”Õ» —Œ’… «·ﬁÌ«œ… „‰ﬂ »”»» ﬂÀ—… «·„Œ«·›« .");
					    p_info[playerid][p_ticket_count] = 30;
					    p_info[playerid][drive_lic] = 0 ;
						update_int_sql(playerid, "u_drive_lic", p_info[playerid][drive_lic]);
						RemovePlayerFromVehicle(playerid);
					}

					format(fmt_text, sizeof fmt_text, "Speeding „›⁄¯· %d km/h", excess);

					CreateTicket(playerid, floatround(excess * server_tax_km), "The Great Wall", fmt_text);
				}

				SetPVarInt(playerid, "radar_detected", gettime() + 15);

				break;
			}
		}
	}
	return 1;
}

stock CreateTicket(playerid, amount, issuer[], description[])
{
	new query[190];

	mysql_format(sql_connection, query, sizeof query, "INSERT INTO tickets (uid, amount, issuer, description) VALUES (%d, %d, '%s', '%s')",
	p_info[playerid][id], amount, issuer, description);
	mysql_tquery(sql_connection, query, "", "");
	return 1;
}

