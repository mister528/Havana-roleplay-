callback: shop_sim_callback ( playerid, pl_number )
{
	new fields,
		rows ;

	cache_get_data ( rows, fields ) ;
	if ( rows )return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}Â–« «·—ﬁ„ „ÕÃÊ“ „‰ ·«⁄» À«‰Ì." ), ShowShopDialog ( playerid ) ;
	p_info [ playerid ] [ number ] = pl_number ;
	update_int_sql ( playerid, "u_number", p_info [ playerid ] [ number ] ) ;
	new _t_string [ 102 ] ;
	format ( _t_string, sizeof ( _t_string ), "{"#cGN"}* {"#cWH"}‰ÃÕ  ›Ì  „  €ÌÌ—Â Õﬁﬂ —ﬁ„ «·ÃÊ«·.  ÃœÌœ «·—ﬁ„ ÂÊ: {"#cGN"}%d{"#cWH"}." , p_info [ playerid ] [ number ] ) ;
	SendClientMessage ( playerid, col_white, _t_string ) ;

	new b = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;

	b_info [ b ] [ b_product ] -= b_shop_product [ 1 ] ;
	b_info [ b ] [ b_money ] += b_shop_price [ 1 ] + floatround ( b_shop_price [ 1 ] * ( float ( b_info [ b ] [ b_cost ] ) / 100 ) ) ;
	b_info [ b ] [ b_cash_today ] += b_shop_price [ 1 ] + floatround ( b_shop_price [ 1 ] * ( float ( b_info [ b ] [ b_cost ] ) / 100 ) ) ;

	ShowShopDialog ( playerid ) ;
	give_money ( playerid, - b_shop_price [ 1 ] - floatround ( b_shop_price [ 1 ] * ( float ( b_info [ b ] [ b_cost ] ) / 100 ) ) ) ;
	insert_money_log ( playerid, INVALID_PLAYER_ID, - b_shop_price [ 1 ] - floatround ( b_shop_price [ 1 ] * ( float ( b_info [ b ] [ b_cost ] ) / 100 ) ), "Purchase 24/7" ) ;

	return 1 ;
}

