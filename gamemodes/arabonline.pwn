}
stock show_family ( playerid )
{
    new family_id = p_info [ playerid ] [ family ] - 1;
    global_string [ 0 ] = EOS ;

    if(family_info[family_id][fam_house] != -1)
    {
        if(family_info [ family_id ] [ fam_safe ] == -1)
        {
            format ( global_string, sizeof ( global_string ), "{"#cBL"}1. {"#cWH"}»Ì  «·⁄«∆·…\t{2cdb00}(«·»Ì : #%d)\n{"#cBL"}2. {"#cWH"}Œ“‰… «·⁄«∆·…\t{2cdb00}$500.000\n{"#cBL"}3. {"#cWH"}»‰ﬂ «·⁄«∆·…: {2cdb00}$%d\n{"#cBL"}4. {"#cWH"}„⁄·Ê„«  «·⁄«∆·…\n{"#cBL"}5. {"#cWH"}≈⁄œ«œ«  «·⁄«∆·…\n{"#cBL"}6. {"#cWH"}”Ì«—«  «·⁄«∆·…\n{"#cRD"}7. «·Œ—ÊÃ „‰ «·⁄«∆·…",family_info[p_info [ playerid ] [ family ] - 1][fam_house], family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_bank ] ) ;
            show_dialog ( playerid, d_family, DIALOG_STYLE_LIST, "{"#cBL"}«·⁄«∆·… «·ﬁ«∆„…", global_string, "«Œ —", "≈€·«ﬁ" ) ;
        }
        else if(family_info [ family_id ] [ fam_safe ] == 0)
        {
            format ( global_string, sizeof ( global_string ), "{"#cBL"}1. {"#cWH"}»Ì  «·⁄«∆·…\t{2cdb00}(«·»Ì : #%d)\n{"#cBL"}2. {"#cWH"}Œ“‰… «·⁄«∆·…\t{ff0000}(≈€·«ﬁ)\n{"#cBL"}3. {"#cWH"}»‰ﬂ «·⁄«∆·…: {2cdb00}$%d\n{"#cBL"}4. {"#cWH"}„⁄·Ê„«  «·⁄«∆·…\n{"#cBL"}5. {"#cWH"}≈⁄œ«œ«  «·⁄«∆·…\n{"#cBL"}6. {"#cWH"}”Ì«—«  «·⁄«∆·…\n{"#cRD"}7. «·Œ—ÊÃ „‰ «·⁄«∆·…",family_info[p_info [ playerid ] [ family ] - 1][fam_house], family_info [ p_info [ playerid ] [ family ] - 1 ] [ fam_bank ] ) ;
            show_dialog ( playerid, d_family, DIALOG_STYLE_LIST, "{"#cBL"}«·⁄«∆·… «·ﬁ«∆„…", global_string, "«Œ —", "≈€·«ﬁ" ) ;
        }
