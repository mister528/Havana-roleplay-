stock ArmorDamage(playerid,attackerid,weaponid,Float:ammount)
{
	#pragma unused attackerid
	#pragma unused weaponid

	if ( p_t_info [ playerid ] [ p_armour ] <= 0)
	           return false;

	if ( p_t_info [ playerid ] [ p_armour ] - ammount <= 0)
	set_armour(playerid,0.0 ) ;
	else
	set_armour(playerid,p_t_info [ playerid ] [ p_armour ] - ammount ) ;

	return true;
}

stock HealthDamage(playerid,attackerid,weaponid,Float:ammount)
{
	#if defined debug_mode
		printf ( "HealthDamage" ) ;
	#endif
	if ( (p_t_info [ playerid ] [ p_health ] - ammount) <= 0.0)
	{
		#if defined debug_mode
			printf ( "p_t_info [ playerid ] [ p_health ] - ammount) <= 0.0" ) ;
		#endif
		GetPlayerPos(playerid, player_death_pos [ playerid ] [ 0 ], player_death_pos [ playerid ] [ 1 ], player_death_pos [ playerid ] [ 2] ) ;
		set_health(playerid, 0.0 ) ;
		OnPlayerSyncDeath(playerid, attackerid, weaponid ) ;
		player_killed[ playerid ] = 1;
	}
	else
	{
		#if defined debug_mode
			printf ( "set_health" ) ;
		#endif
		set_health(playerid,p_t_info [ playerid ] [ p_health ] - ammount ) ;
	}

    return true;
}

stock fix_seconde ( seconds )
{
	new time_string [ 12 ],
		minutes = floatround ( seconds / 60 ) ;

	seconds -= minutes * 60 ;

	format ( time_string, sizeof( time_string ), "%02d:%02d", minutes, seconds ) ;
	return time_string;
}

forward UnFreezee(playerid);
public UnFreezee(playerid) return TogglePlayerControllable(playerid, true);

stock pSpawn(playerid)
{
    new yacht_id = 0 ;
	foreach ( new veh_id:player_vehicles[playerid])
	{
		if ( ! v_boat_int ( veh_id ) ) continue ;
		yacht_id = veh_id ;
		break ;
	}
	if(p_info[playerid][jailed] > 1 && p_info[playerid][jail] == 10)
	{
	    reset_player_weapon(playerid);
	    set_pos ( playerid, 5048.978515, -765.416931, 12.459382+3.0, 0.0, 0, 15 ) ;
	}
	else if(p_info[playerid][jailed] > 1 && p_info[playerid][jail_type] == 1)
	{
	    reset_player_weapon(playerid);
	    new random_jail_pos = random ( 2 ) ;
		set_pos ( playerid, jail_spawn1 [ random_jail_pos ] [ 0 ],
							jail_spawn1 [ random_jail_pos ] [ 1 ],
							jail_spawn1 [ random_jail_pos ] [ 2 ],
							jail_spawn1 [ random_jail_pos ] [ 3 ],
							6,6 ) ;
	}
	else if(p_info[playerid][jailed] > 1 && p_info[playerid][jail_type] == 2)
	{
	    reset_player_weapon(playerid);
	    new random_jail_pos = random ( 2 ) ;
		set_pos ( playerid, jail_spawn2 [ random_jail_pos ] [ 0 ],
							jail_spawn2 [ random_jail_pos ] [ 1 ],
							jail_spawn2 [ random_jail_pos ] [ 2 ],
							jail_spawn2 [ random_jail_pos ] [ 3 ],
							10,10 ) ;
	}
	else if(p_info[playerid][jailed] > 1 && p_info[playerid][jail_type] == 3)
	{
	    reset_player_weapon(playerid);
	    new random_jail_pos = random ( 2 ) ;
		set_pos ( playerid, jail_spawn3 [ random_jail_pos ] [ 0 ],
							jail_spawn3 [ random_jail_pos ] [ 1 ],
							jail_spawn3 [ random_jail_pos ] [ 2 ],
							jail_spawn3 [ random_jail_pos ] [ 3 ],
							3,3 ) ;
	}
    else if(p_info[playerid][spawnchange] == 0 && p_info[playerid][jailed] < 1)
	{
	    new i = random ( 2 );
		set_pos ( playerid, newbie_spawn_pos [ i ] [ 0 ], newbie_spawn_pos [ i ][ 1 ], newbie_spawn_pos [ i ][ 2 ] , newbie_spawn_pos [ i ][ 3 ], 0, 0 ) ;
	}
	else if ( p_info [ playerid ] [ house ] != -1 && p_info [ playerid ] [ spawnchange ] == 1  && p_info[playerid][jailed] < 1)
	{
		new h = p_info [ playerid ] [ house ] - 1 ;
		new hint = h_info [ h ] [ h_int ] - 1 ;

		set_pos ( playerid, house_int [ hint ] [ hspawn_position ] [ 0 ], house_int [ hint ] [ hspawn_position ] [ 1 ], house_int [ hint ] [ hspawn_position ] [ 2 ], house_int [ hint ] [ hspawn_position ] [ 3 ], house_int [ hint ] [ hint_int ], h_info [ h ] [ h_id ] ) ;
		SetPVarInt ( playerid, "house_id", p_info [ playerid ] [ house ] ) ;

	}
    else if ( p_info[playerid][family] != 0 && family_info[ p_info[playerid][family]-1 ][fam_house] != -1 && p_info [ playerid ] [ spawnchange ] == 6  && p_info[playerid][jailed] < 1)
    {
        new family_id = p_info [ playerid ] [ family ] - 1;
        new h = family_info [ family_id ] [ fam_house ];
        new hint = h_info [ h ] [ h_int ] -1 ;

        set_pos ( playerid, house_int [ hint ] [ hspawn_position ] [ 0 ], house_int [ hint ] [ hspawn_position ] [ 1 ], house_int [ hint ] [ hspawn_position ] [ 2 ], house_int [ hint ] [ hspawn_position ] [ 3 ], house_int [ hint ] [ hint_int ], family_info[family_id][fam_house]+1 ) ;
        SetPVarInt ( playerid, "house_id", family_info[family_id][fam_house]+1) ;
    }
    else if ( yacht_id && p_info [ playerid ] [ spawnchange ] == 3 && p_info[playerid][jailed] < 1)
	{
		is_player_in_boat [ playerid ] = yacht_id ;

		set_pos ( playerid, 1390.1287, -24.9963, 1001.0063, 182.7941, 5, yacht_id ) ;
	}
    else if ( p_info [ playerid ] [ cellar ] != -1 && p_info [ playerid ] [ spawnchange ] == 4  && p_info[playerid][jailed] < 1)
	{
		new h = p_info [ playerid ] [ cellar ] - 1 ;

		set_pos ( playerid, 1400.0562, -9.9276, 1000.9152, 176.1147, 4, cellar_info [ h ] [ cl_id ] + house_count ) ;

		SetPVarInt ( playerid, "tp_area_used", 1 ) ;
		teleport_tick [ playerid ] = GetTickCount ( ) ;
		SetPVarInt ( playerid, "cellar_id", p_info [ playerid ] [ cellar ] ) ;
	}
	else if ( p_info [ playerid ] [ rent_house ] != -1 && p_info [ playerid ] [ spawnchange ] == 5  && p_info[playerid][jailed] < 1)
	{
		new h = p_info [ playerid ] [ rent_house ] - 1 ;
		new hint = h_info [ h ] [ h_int ] - 1 ;

		set_pos ( playerid, house_int [ hint ] [ hspawn_position ] [ 0 ], house_int [ hint ] [ hspawn_position ] [ 1 ], house_int [ hint ] [ hspawn_position ] [ 2 ], house_int [ hint ] [ hspawn_position ] [ 3 ], house_int [ hint ] [ hint_int ], h_info [ h ] [ h_id ] ) ;
		SetPVarInt ( playerid, "house_id", p_info [ playerid ] [ rent_house ] ) ;

	}
	else if ( ( p_info [ playerid ] [ member ] || p_info [ playerid ] [ leader ] ) && p_info [ playerid ] [ spawnchange ] == 2  && p_info[playerid][jailed] < 1)
	{
		set_pos ( playerid, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn ] [ 0 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn ] [ 1 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn ] [ 2 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn ] [ 3 ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn_int ], f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_spawn_virt ] ) ;
	}
 	else
	{
	    new i = random ( 2 );
		set_pos ( playerid, newbie_spawn_pos [ i ] [ 0 ], newbie_spawn_pos [ i ][ 1 ], newbie_spawn_pos [ i ][ 2 ] , newbie_spawn_pos [ i ][ 3 ], 0, 0 ) ;
		SendClientMessage(playerid,col_gray,"* ‰ﬁÿ… «·≈‰ÿ·«ﬁ Õﬁ ﬂ «‰Õ–› ° › „  ÊÃÌÂﬂ  ·ﬁ«∆Ì« ·„Õÿ… «·ﬁÿ«—");
	}
	is_player_fake_spawn { playerid } = 1 ;
	if ( is_fraction_duty { playerid } == 1 ) SetPlayerSkin ( playerid, p_info [ playerid ] [ org_skin ] ), SetPlayerColor ( playerid, f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_radar_color ] ) ;
	else SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;
	//StopAudioStreamForPlayer(playerid);
	return 1;
}

stock GiveDamageForPlayer(playerid,attackerid,weaponid,Float:ammount)
{
	#if defined debug_mode
		printf ( "GiveDamageForPlayer" ) ;
	#endif
	if ( p_t_info [ playerid ] [ p_armour ] >= 1)
	{
		if ( p_t_info [ playerid ] [ p_armour ] - ammount <= 0)
		{
  			set_armour(playerid, 0.0 ) ;
			HealthDamage(playerid,attackerid,weaponid,ammount - p_t_info [ playerid ] [ p_armour ] ) ;
		}
		else
			ArmorDamage(playerid,attackerid,weaponid,ammount ) ;
	}
	else
		HealthDamage(playerid,attackerid,weaponid,ammount ) ;
	return true;
}
// new stocks
stock GetPlayerSpeedExx(playerid)
{
    new Float:Coord[4];
    GetPlayerVelocity(playerid, Coord[0], Coord[1], Coord[2]);
    Coord[3] = floatsqroot(floatpower(floatabs(Coord[0]), 2.0) + floatpower(floatabs(Coord[1]), 2.0) + floatpower(floatabs(Coord[2]), 2.0)) * 213.3;
    return floatround(Coord[3]);

}
stock GetPlayerID(const pname[])
{
    if(isnull(pname)) return -1;

    foreach(new i : logged_players)
    {
        if(!strcmp(p_info[i][name], pname, false)) return i;
    }
    return -1;
}
stock _AddStaticVehicle(modelid, Float:spawn_x, Float:spawn_y, Float:spawn_z, Float:z_angle, color1, color2)
{
	new vehicleid = AddStaticVehicle(modelid, spawn_x, spawn_y, spawn_z, z_angle, color1, color2 ) ;
	veh_info [ vehicleid - 1 ] [ v_model ] = modelid ;
	veh_info [ vehicleid - 1 ] [ v_color ] [ 0 ] = color1 ;
	veh_info [ vehicleid - 1 ] [ v_color ] [ 1 ] = color2 ;
	veh_info [ vehicleid - 1 ] [ v_health ] = 1000.0 ;
	veh_info [ vehicleid - 1 ] [ v_paint ] = 3 ;
	veh_info [ vehicleid - 1 ] [ v_fuel ] = 40.0 ;
	return vehicleid;
}
#define AC_AddStaticVehicle		_AddStaticVehicle

stock _SpawnPlayer ( playerid )
{
	if(!GetPlayerVehicleID(playerid))
	{
		new Float:pos_x, Float:pos_y, Float:pos_z;
		GetPlayerPos(playerid, pos_x, pos_y, pos_z);
		SetPlayerPos(playerid, pos_x, pos_y, (pos_z + 6.0));
		//pSpawn(playerid);
	}
	return SpawnPlayer ( playerid ) ;
}
