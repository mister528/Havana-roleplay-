alias:general("g" )
CMD:general(playerid, params[])
{

    if(p_info[playerid][mute] > 0) return SendClientMessage(playerid,0xafafafff,"√‰  „„‰Ê⁄ „‰ «·‘« ");
    new text[150];
    if(sscanf(params,"s",text)) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"{«·«” Œœ«„: /vipchat [«·‰’]." ) ;


    new playerName[MAX_PLAYER_NAME];
    GetPlayerName(playerid, playerName, sizeof(playerName));

    // Format the message
    new chatMessage[144]; // Maximum chat length
    format(chatMessage, sizeof(chatMessage), "[«·‘«  «·⁄«„] %s: %s", playerName, params);

    // Send the message to all players
    SendClientMessageToAll(0x00FF00FF, chatMessage);

    return 1;
}


