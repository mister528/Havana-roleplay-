					SetPVarInt(playerid, "ClickBar", 0);
				}
				else GivePVarInt(playerid, "ClickBar", 1);
				if(!IsPlayerAttachedObjectSlotUsed(playerid, 4)) SetPlayerAttachedObject(playerid, 4, 2913, 6, 0.033000, 0.028000, -0.104999, 5.699995, -1.999999, 0.500062, 1.000000, 1.000000, 1.000000);
			}
			if(GetPVarInt(playerid, "GYM_Dumbbells") == 1 && GetPVarInt(playerid, "GYM_Simulator_Time") <= gettime()+2)
			{
				ApplyAnimation(playerid, "Freeweights", "gym_free_down", 4, 0, 0, 0, 1, 0);
				SetPVarInt(playerid, "GYM_Simulator_Time", gettime()+2);
				if(GetPVarInt(playerid, "ClickDumbbells") >= 100)
				{
					if(GetPVarInt(playerid, "ClickWeight") >= 50)
					{
						SetPVarInt(playerid, "ClickWeight", 0);
					}
					else GivePVarInt(playerid, "ClickWeight", 1);
					if(p_info[playerid][stats][2] < 100)
					{
						GivePlayerStats(playerid, 2, 1);
						GameTextForPlayer ( playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~ ﬁÊ… ~g~+1", 3000, 3 ) ;
					}
					SetPVarInt(playerid, "ClickDumbbells", 0);
				}
				else GivePVarInt(playerid, "ClickDumbbells", 1);
				if(!IsPlayerAttachedObjectSlotUsed(playerid, 4)) SetPlayerAttachedObject(playerid, 4, 2915, 6, 0.083999, 0.000000, -0.039999, -7.199998, -87.000038, -3.199999, 1.000000, 1.000000, 1.000000);
			}
		}
	}
	if(newkeys & KEY_CTRL_BACK)
	{
	    if(IsPlayerInRangeOfPoint(playerid, 1.5, 772.1121, 9.4133, 1001.7000))
		{
		    if(is_gym_training { playerid } == 0) return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}«»œ√ «· œ—Ì» √Ê·«");
			if(!GetPVarInt(playerid, "GYM_Bike"))
			{
				if(SimulatorUse[0] == true) return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"} «·„œ—¯» „‘€Ê·");
				SetPlayerPos(playerid, 772.6120, 8.8898, 999.7000);
				SetPlayerFacingAngle(playerid, 89.9620);
				ApplyAnimation(playerid, "GYMNASIUM", "gym_bike_geton", 4, 0, 0, 0, 1, 0);
				SetPVarInt(playerid, "GYM_Bike", 1);
				SetPVarInt(playerid, "GYM_Simulator_Time", gettime()+4);
				SimulatorUse[0] = true;
			}
			else
			{
				ApplyAnimation(playerid, "GYMNASIUM", "gym_bike_getoff", 4, 0, 0, 0, 0, 0);
				SetPVarInt(playerid, "GYM_Bike", 0);
				SimulatorUse[0] = false;
			}
		}
		if(IsPlayerInRangeOfPoint(playerid, 1.5, 773.4795, -1.2654, 1000.7258))
		{
		    if(is_gym_training { playerid } == 0) return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}«»œ√ «· œ—Ì» √Ê·«");
			if(!GetPVarInt(playerid, "GYM_Thread"))
			{
				if(SimulatorUse[1] == true) return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"} «·„œ—¯» „‘€Ê·");
				SetPlayerPos(playerid, 773.4795, -1.2654, 1000.7258);
				SetPlayerFacingAngle(playerid, 181.4563);
				ApplyAnimation(playerid, "GYMNASIUM", "gym_tread_geton", 4, 0, 0, 0, 1, 0, 1);
				SetPVarInt(playerid, "GYM_Thread", 1);
				SetPVarInt(playerid, "GYM_Simulator_Time", gettime()+4);
				SimulatorUse[1] = true;
			}
			else
			{
				ApplyAnimation(playerid, "GYMNASIUM", "gym_tread_getoff", 4, 0, 0, 0, 0, 0);
				SetPVarInt(playerid, "GYM_Thread", 0);
				SimulatorUse[1] = false;
			}
		}
		if(IsPlayerInRangeOfPoint(playerid, 1.5, 772.9084, 1.4091, 1000.7210))
		{
		    if(is_gym_training { playerid } == 0) return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}«»œ√ «· œ—Ì» √Ê·«");
			if(!GetPVarInt(playerid, "GYM_Bar"))
			{
				if(SimulatorUse[2] == true) return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"} «·„Õ«ﬂÌ „‘€Ê·.");
				SetPlayerPos(playerid, 772.9084, 1.4091, 1000.7210);
				SetPlayerFacingAngle(playerid, 271.5546);
				ApplyAnimation(playerid, "benchpress", "gym_bp_geton", 4, 0, 0, 0, 1, 0);
				SetPVarInt(playerid, "GYM_Bar", 1);
				SetPVarInt(playerid, "GYM_Simulator_Time", gettime()+6);
				SimulatorUse[2] = true;
				if(!IsPlayerAttachedObjectSlotUsed(playerid, 4)) SetPlayerAttachedObject(playerid, 4, 2913, 6, 0.033000, 0.028000, -0.104999, 5.699995, -1.999999, 0.500062, 1.000000, 1.000000, 1.000000);
			}
			else
			{
				ApplyAnimation(playerid, "benchpress", "gym_bp_getoff", 4, 0, 0, 0, 0, 0);
				SetPVarInt(playerid, "GYM_Bar", 0);
				RemovePlayerAttachedObject(playerid, 4);
				SimulatorUse[2] = false;
			}
		}
		if(IsPlayerInRangeOfPoint(playerid, 1.5, 773.4990, 5.3875, 1000.7802))
		{
		    if(is_gym_training { playerid } == 0) return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"}«»œ√ «· œ—Ì» √Ê·«");
			if(!GetPVarInt(playerid, "GYM_Dumbbells"))
			{
				if(SimulatorUse[3] == true) return SendClientMessage(playerid, col_gray, "{"#cRD"}* {"#cGR"} «·„œ—¯» „‘€Ê·");
				SetPlayerPos(playerid, 773.4990, 5.3875, 1000.7802);
				SetPlayerFacingAngle(playerid, 91.7721);
				ApplyAnimation(playerid, "Freeweights", "gym_free_pickup", 4, 0, 0, 0, 1, 0);
				SetPVarInt(playerid, "GYM_Dumbbells", 1);
				SetPVarInt(playerid, "GYM_Simulator_Time", gettime()+4);
				SimulatorUse[3] = true;
				if(!IsPlayerAttachedObjectSlotUsed(playerid, 4)) SetPlayerAttachedObject(playerid, 4, 2915, 6, 0.083999, 0.000000, -0.039999, -7.199998, -87.000038, -3.199999, 1.000000, 1.000000, 1.000000);
