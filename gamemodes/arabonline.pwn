callback: ac_check ( playerid, Float:x, Float:y, Float:z )
{
	if ( p_t_info [ playerid ] [ p_tp_immune_time ] != 0 ) return 1 ;
	if ( GetTickCount ( ) - p_t_info [ playerid ] [ p_update ] > 1000 )return 1 ;
	p_t_info [ playerid ] [ p_tp_ac_timer ] = -1 ;
//	if ( ! IsPlayerInRangeOfPoint ( playerid, 150, x, y, z ) ) return anti_cheat ( playerid, "teleport", 0 ) ;
	return 1 ;
}

callback: toggle_controlable ( playerid, bool:toggle, bool:draw_status )
{
	if ( ! toggle ) SetPVarInt ( playerid, "freeze_status", 1 ) ;
	else DeletePVar ( playerid, "freeze_status" ) ;
	if ( draw_status )
	{
/*		if ( used_area [ playerid ] != -1 )
		{
			for ( new i = 0; i < 2 ; i ++ )	TextDrawShowForPlayer ( playerid, td_alt_area [ i ] ) ;
		}*/
	}
	if ( is_tazered { playerid } != 0 )is_tazered { playerid } = 0 ;
	return TogglePlayerControllable ( playerid, toggle ) ;
}
