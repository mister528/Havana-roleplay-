	if(p_info[params[0]][id] == 1) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— ﬂ „  «·”Ã‰." ) ;

	
	new scm_string [ 144 ] ;
	format( scm_string,sizeof ( scm_string ), "≈œ«—Ì %s ﬂ „ «··«⁄» %s „‰ «·‘«  ·‹ %d œﬁÌﬁ…. «·”»»: %s", p_info [ playerid ] [ name ], p_info [ params [ 0 ] ] [ name ], params [ 1 ], params [ 2 ] ) ;
	foreach(new i: logged_players) if ( p_info [ i ] [ settings ] [ 2 ] ) SendClientMessage ( i, col_light_red, scm_string ) ;

