stock GetNumberOfPlayersOnThisIP(test_ip[])
{
	new against_ip[32+1];
	new x = 0;
	new ip_count = 0;
	for(x=0; x<MAX_PLAYERS; x++)
	{
		if(IsPlayerConnected(x))
		{
		    GetPlayerIp(x,against_ip,32);
		    if(!strcmp(against_ip,test_ip)) ip_count++;
		}
	}
	return ip_count;
}

public SV_VOID:OnPlayerActivationKeyPress(SV_UINT:playerid, SV_UINT:keyid)
{
    // Attach player to local stream as speaker if 'B' key is pressed
    if(p_info[playerid][voice_mute] == 0)
    {
    	if (keyid == 0x42 && lstream[playerid]) SvAttachSpeakerToStream(lstream[playerid], playerid);
    }
    else if(p_info[playerid][voice_mute] != 0)
    {
        new scm_string [ 66 ] ;
		format ( scm_string, sizeof ( scm_string ),"⁄‰œﬂ ÕŸ— „‰ ’Ê  | %d À«‰Ì…", p_info [ playerid ] [ voice_mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
    }
    // Attach the player to the global stream as a speaker if the 'Z' key is pressed
  //  if (keyid == 0x5A && gstream) SvAttachSpeakerToStream(gstream, playerid);
}

public SV_VOID:OnPlayerActivationKeyRelease(SV_UINT:playerid, SV_UINT:keyid)
{
    // Detach the player from the local stream if the 'B' key is released
    if(p_info[playerid][voice_mute] == 0)
	{
    	if (keyid == 0x42 && lstream[playerid]) SvDetachSpeakerFromStream(lstream[playerid], playerid);
    }
    else if(p_info[playerid][voice_mute] != 0)
    {
        new scm_string [ 66 ] ;
		format ( scm_string, sizeof ( scm_string ),"⁄‰œﬂ ÕŸ— „‰ ’Ê  | %d À«‰Ì…", p_info [ playerid ] [ voice_mute ] ) ;
		SendClientMessage ( playerid, col_light_red, scm_string ) ;
    }
    // Detach the player from the global stream if the 'Z' key is released
  //  if (keyid == 0x5A && gstream) SvDetachSpeakerFromStream(gstream, playerid);
}

public OnPlayerConnect ( playerid )
{
    Havana_ResetWantedMeta ( playerid ) ;

	if ( IsPlayerNPC(playerid) )
	{
		SetPlayerSkin(playerid, NPCTEST_SKIN_ID);
		return 1;
	}
    Fisherman_OnPlayerConnect(playerid);

        // === Havana Ballas Tap state reset ===
        g_ballasTap_active[playerid] = 0;

	GetPlayerName ( playerid, p_info [ playerid ] [ name ] , MAX_PLAYER_NAME ) ;
	new kickname [ MAX_PLAYER_NAME ] ;
	new kickname1;
	kickname1 = GetPlayerName ( playerid, kickname, sizeof(kickname));
	if( kickname1 > 19 )
	{
	    SendClientMessage( playerid, col_white, "Õﬁﬂ «·«”„ ÂÊ √ﬂÀ— „‰ 19 Õ—Ê›!");
	    kick_player(playerid);
	    return 1;
	}
	weapon_hack_status [ playerid ] = 0;
	gz_violations [ playerid ] = 0 ;
	gz_warn_cooldown [ playerid ] = 0 ;
	
	GangZoneShowForPlayer(playerid, areazone, 0xD1A573AA);
	if ( army_base_zone != -1 ) GangZoneShowForPlayer(playerid, army_base_zone, 0x4B3621AA);
    HavanaIsland_ShowZone ( playerid ) ;
	
	GetPlayerIp ( playerid, p_t_info [ playerid ] [ p_ip ] ,  16 ) ;
	if(player_Breakcar [playerid] != INVALID_VEHICLE_ID)
	{
		player_Breakcar [playerid] = INVALID_VEHICLE_ID;
	}
	if(player_Stealcar [playerid] != INVALID_VEHICLE_ID)
	{
		player_Stealcar [playerid] = INVALID_VEHICLE_ID;
	}
	InGZ[playerid] = 0;
	ondmz[playerid] = 0;
	Chase[playerid] = -1;
	PlayingRadio[playerid] = 0;
	tazertimer[playerid] = 0;
	OnlyChase[playerid] = 0;
	CopChaseTimer[playerid] = -1;
	InJAIL[playerid] = 0;
	tazered [playerid] = 0;
	OnMoneyPickup[playerid] = 0;

	// pizza
	p_info[playerid][pizzatimer] = 0;
	
	//vipskin
    p_info [ playerid ] [ vipskin ] = 0;
    
	
	new buffer[80+1];
	GetPlayerClientID(playerid, buffer);
	/*
	new _veh_count = 0,
		query_string [ 78 ] ;
	format ( query_string, sizeof ( query_string ),"SELECT * FROM users_vehicles WHERE v_owner = '%d'", p_info [ playerid ] [ id ] ) ;
	new Cache:result = mysql_query ( sql_connection, query_string ) ;
	_veh_count = cache_num_rows ( ) ;
	cache_delete ( result ) ;
	return _veh_count ;
	*/

	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerConnect] playerid:%d", playerid ) ;
	#endif
	ac_test_OnPlayerConnect ( playerid ) ;
	
	SendClientMessage(playerid, 0xFF0000FF, "Õ„«Ì… ≈ÿ·«ﬁ «·‰«— «·”—Ì⁄ „›⁄¯·…. «·≈ÿ·«ﬁ «·”—Ì⁄ —«Õ Ì”»» ⁄ﬁÊ»« .");
		
	/*
	new namejoin[MAX_PLAYER_NAME], messagejoin[128];
    GetPlayerName(playerid, namejoin, sizeof(namejoin));
    format(messagejoin, sizeof(messagejoin), "{80FF00}[INFO]: Player %s has joined the server!", namejoin);
    SendClientMessageToAll(-1, messagejoin);
	*/
	
    // [HavanaRp v13] disabled bottom-left HAVANA/ROLEPLAY emblem; replaced by launcher brand overlay
    //for(new i;i<14;i++) TextDrawShowForPlayer(playerid, PublicTD[i]);
    //for(new i;i<9;i++) TextDrawShowForPlayer(playerid, newlogotd[i]);
    for(new i;i<9;i++) TextDrawShowForPlayer(playerid, Welcome_TD[i]);
    for(new i;i<2;i++) TextDrawShowForPlayer(playerid, TD_DataTime[i]);
    
    RemoveBuildingForPlayer(playerid, 1440, 948.7656, -1381.1641, 13.0469, 0.25);
    
    // spawn glitch
	RemoveBuildingForPlayer(playerid, 4961, 1745.2031, -1882.8516, 26.1406, 0.25);
	RemoveBuildingForPlayer(playerid, 5033, 1745.2031, -1882.8516, 26.1406, 0.25);
	RemoveBuildingForPlayer(playerid, 5055, 1745.2031, -1882.8516, 26.1406, 0.25);
	RemoveBuildingForPlayer(playerid, 4821, 1745.2031, -1882.8516, 26.1406, 0.25);

	// LSPD exterior rebuild
	RemoveBuildingForPlayer(playerid, 3976, 1571.599, -1675.750, 35.679, 0.250);
	RemoveBuildingForPlayer(playerid, 4064, 1571.599, -1675.750, 35.679, 0.250);

	//==============================================================================

	clear_player_data ( playerid ) ;
	SetPlayerColor ( playerid, 0xFFFFFF80 ) ; // col_middle_white

	AC_TogglePlayerSpectating ( playerid, true ) ;
 
	
	p_t_info [ playerid ] [ p_tp_immune_time ] = 6 ;

 	#if defined __anti_godmode
	antigm_OnPlayerConnect(playerid);
	#endif






	/*-------------------------------[ Player TextDraw's ]--------------------------------*/
	
    new PlayerText:textid;
   	LoadScreenPText[playerid] = textid = CreatePlayerTextDraw(playerid, 303.0000, 253.0517, "100%"); // Empty
	PlayerTextDrawLetterSize(playerid, textid, 0.1460, 0.9611);
	PlayerTextDrawAlignment(playerid, textid, 1);
	PlayerTextDrawColor(playerid, textid, -1);
	PlayerTextDrawBackgroundColor(playerid, textid, 255);
	PlayerTextDrawFont(playerid, textid, 2);
	PlayerTextDrawSetProportional(playerid, textid, 1);
	PlayerTextDrawSetShadow(playerid, textid, 0);
	
	/*-------------------------------------------------------------------------------------*/
	
	
	RemoveBuildingForPlayer(playerid, 14795, 1388.880005, -20.882000, 1005.200012, 0.250000); // accs
	

	#include "modules/objects/m_rem_objects.pwn"
	
	

	//==============================================================================

    new query_string [ 60 + MAX_PLAYER_NAME ];
	format ( query_string, sizeof query_string, "SELECT `u_id` FROM `users` WHERE `u_name` = '%s' LIMIT 1", p_info [ playerid ] [ name ] ) ;
	mysql_tquery ( sql_connection, query_string, "check_player_registered", "i", playerid ) ;
	
	// samp ’Ê 
	// Checking for plugin availability
	if(GetPVarInt(playerid, "show_pass") == 1)
	{
		for(new i = 0; i < 39; i++)
		{
		    PlayerTextDrawDestroy(playerid, Passport_PTD[playerid][i]);
		    Passport_PTD [ playerid ] [ i ] = PlayerText:-1 ;

			if(i < 6) TextDrawHideForPlayer(playerid, Passport_TD[i]);
		}
		DeletePVar(playerid, "show_pass");
	}
    if (SvGetVersion(playerid) == SV_NULL)
    {
        SendClientMessage(playerid, -1, "„« ·ﬁÌ  plugin sampvoice.");
    }
    // Checking for a microphone
    else if (SvHasMicro(playerid) == SV_FALSE)
    {
        SendClientMessage(playerid, -1, " „« ﬁœ— Ì „ «·⁄ÀÊ— ⁄·Ï «·„Ìﬂ—Ê›Ê‰.");
    }
    // Create a local stream with an audibility distance of 40.0, an unlimited number of listeners
    // and the name 'Local' (the name 'Local' will be displayed in red in the players' speakerlist)
    else if ((lstream[playerid] = SvCreateDLStreamAtPlayer(40.0, SV_INFINITY, playerid, 0x1CCCEBFF, "TALK")))
    {
        SendClientMessage(playerid, -1, "«÷€ÿ B ⁄‘«‰  ﬂ·„ ›Ì «·‘«  «·„Õ·Ì.");

        // Attach the player to the global stream as a listener
     //   if (gstream) SvAttachListenerToStream(gstream, playerid);

        // Assign microphone activation keys to the player
        SvAddKey(playerid, 0x42);
  //      SvAddKey(playerid, 0x5A);
    }
	shop_on_player_connect(playerid);
	return 1;
}

stock ClearTrailerEnum(numberrow)
{
	TrailerInfo[numberrow][d_id] = -1;
	TrailerInfo[numberrow][userID] = -1;
	TrailerInfo[numberrow][d_deagle] = -1;
	TrailerInfo[numberrow][d_m4] = -1;
	TrailerInfo[numberrow][d_posx] = 0.0;
	TrailerInfo[numberrow][d_posy] = 0.0;
	TrailerInfo[numberrow][d_posz] = 0.0;
	TrailerInfo[numberrow][d_posa] = 0.0;
	TrailerInfo[numberrow][d_door] = -1;
	TrailerInfo[numberrow][d_materials] = -1;
	TrailerInfo[numberrow][d_owner] = EOS;
	TrailerInfo[numberrow][d_trailer] = INVALID_VEHICLE_ID;
	TrailerInfo[numberrow][d_label] = Text3D:INVALID_3DTEXT_ID;
}

public OnPlayerDisconnect ( playerid, reason )
{
    Havana_ResetWantedMeta ( playerid ) ;

    Fisherman_OnPlayerDisconnect(playerid, reason);
    HavanaIsland_StopExtract ( playerid, false ) ;
    // HavanaRP weapon-craft: snapshot the current RPG ammo into rpg_save so
    // it survives reconnects/restarts even if the player fired some shots
    // since the last craft event.
    if ( p_info [ playerid ] [ id ] > 0 )
    {
        new _hrp_rpg_gun = 0, _hrp_rpg_ammo = 0 ;
        GetPlayerWeaponData ( playerid, 7, _hrp_rpg_gun, _hrp_rpg_ammo ) ;
        if ( _hrp_rpg_gun == 35 && _hrp_rpg_ammo > 0 )
        {
            p_info [ playerid ] [ rpg_save ] = _hrp_rpg_ammo ;
            update_int_sql ( playerid, "rpg_save", _hrp_rpg_ammo ) ;
        }
        else
        {
            p_info [ playerid ] [ rpg_save ] = 0 ;
            update_int_sql ( playerid, "rpg_save", 0 ) ;
        }
    }
	objedit_reset_player ( playerid ) ;
	if ( ! IsPlayerNPC(playerid) ) NpcTest_Destroy(playerid);
	else if ( g_npctest_owner[playerid] != INVALID_PLAYER_ID ) g_npctest_bot[g_npctest_owner[playerid]] = INVALID_PLAYER_ID;
	if (g_shop247_open[playerid]) HideShopTD(playerid);
	#if defined debug_mode
		printf ( "[DEBUG] [OnPlayerDisconnect] playerid:%d | reason:%d", playerid, reason ) ;
	#endif
	ac_test_OnPlayerDisconnect ( playerid, reason ) ;
        shop_on_player_disconnect ( playerid ) ;
	
	if( GetPVarInt ( playerid, "antistealer" ) )
	{
	    new scm_string [ 128 ];
	    //new playerip[160];
        //GetPlayerIp(playerid,playerip,sizeof(playerip));
	    format ( scm_string, sizeof ( scm_string ),"›ﬂ ÕŸ— IP %s", p_t_info [ playerid ] [ p_ip ]) ;
	    SendRconCommand ( scm_string ) ;
	    SendRconCommand("reloadbans");
	}
	
	if(p_info[playerid][buyedtr])
	{
		for(new i = 0; i < MAX_TRAILERS; i++)
		{
			if(!strcmp(p_info[playerid][name],TrailerInfo[i][d_owner]))
			{
				DestroyDynamic3DTextLabel(TrailerInfo[i][d_label]);
				DestroyVehicle(TrailerInfo[i][d_trailer]);
				ClearTrailerEnum(i);
				totaltrailers--;
				break;
			}
		}
	}
	
	new nameexit[MAX_PLAYER_NAME], messageexit[128];
    GetPlayerName(playerid, nameexit, sizeof(nameexit));
    format(messageexit, sizeof(messageexit), "{FF0000}[„⁄·Ê„« ]: «··«⁄» %s ⁄‰œ Ì”«—  «·”Ì—›—!", nameexit);
    SendClientMessageToAll(-1, messageexit);
	
	if ( Iter_Count(player_vehicles[ playerid ]) != 0)
	{
		foreach(new veh_id:player_vehicles[ playerid ])
		{
			new query_string [ 146 ] ;

			format ( query_string, sizeof ( query_string ),"UPDATE `users_vehicles` SET `v_fuel` = '%f',`v_millage` = '%f' WHERE `v_id` = '%d' LIMIT 1",
			veh_info [ veh_id - 1 ] [ v_fuel ],
			veh_info [ veh_id - 1 ] [ v_millage ],
			veh_info [ veh_id - 1 ] [ v_id ] ) ;
			mysql_tquery ( sql_connection, query_string, "", "" ) ;


			veh_info [ veh_id - 1 ] [ v_owner ] = 0 ;
			veh_info [ veh_id - 1 ] [ v_rank ] = 0 ;
			veh_info [ veh_id - 1 ] [ v_type ] = 0 ;
			AC_DestroyVehicle ( veh_id ) ;
		}
		Iter_Clear(player_vehicles[ playerid ]) ;
	}
	// ’Ê 
    if (lstream[playerid])
    {
        SvDeleteStream(lstream[playerid]);
        lstream[playerid] = SV_NULL;
    }
    
    if (p_info [ playerid ] [ temp_orgsz ] == 1)
    {
    	p_info [ playerid ] [ member ] = 0 ;
		p_info [ playerid ] [ leader ] = 0 ;
		p_info [ playerid ] [ rank ] = 0 ;
		p_info [ playerid ] [ spawnchange ] = 0 ;
		p_info [ playerid ] [ temp_orgsz ] = 0 ;

		update_int_sql ( playerid, "u_spawnchange", p_info [ playerid ] [ spawnchange ] ) ;
	}
	
	if(GetPVarInt(playerid, "pts_show") == 1)
	{
	    for(new i = 0; i < 62; i++)
		{
		    TextDrawHideForPlayer(playerid, Carpass_TD[i]);

			if(i < 7)
			{
				PlayerTextDrawDestroy(playerid, Carpass_PTD[playerid][i]);
				Carpass_PTD [ playerid ] [ i ] = PlayerText:-1 ;
			}
		}
		DeletePVar(playerid, "pts_show");
	}
    
    //////////////////////System save health//////////////////////
    
	//new Float:healthoff;
    //GetPlayerHealth(playerid, healthoff );
    new healthtext[155];
    mysql_format ( sql_connection, healthtext, sizeof healthtext,"UPDATE users SET `u_health` = '%f' WHERE `u_id` ='%d'",p_t_info [ playerid ] [ p_health ] ,p_info [ playerid ] [ id ] );
    mysql_tquery ( sql_connection, healthtext ) ;
    ////////////////////////////////////////////////////////////////////////
	for(new i;i<14;i++) TextDrawHideForPlayer(playerid, PublicTD[i]);
	//for(new i;i<9;i++) TextDrawHideForPlayer(playerid, newlogotd[i]);
	for(new i;i<2;i++) TextDrawHideForPlayer(playerid, TD_DataTime[i]);
    if ( p_info [ playerid ] [ pizzatimer ] > 0 )
	{
	    p_info [ playerid ] [ pizzatimer ] = 0;
 	}
 	//vipskin
    for ( new i = 0; i < 11 ; i ++ )
	{
		RemovePlayerAttachedObject ( playerid, i ) ;
	}
    if(GetPVarInt(playerid, "on_dmarena"))
	{
	    dmzone1_players --;
        new dmzstring[128];
		format(dmzstring, sizeof(dmzstring), "{ffffff}„Ê»«Ì· ÷œ „Ê»«Ì·\n{ffffff}ﬂ„»ÌÊ — ÷œ ﬂ„»ÌÊ —\n{f5d922}%d ·«⁄»",dmzone1_players);
		Dmzone1_Text = CreateDynamic3DTextLabel(dmzstring,0xf5d92299,2038.3451,-1768.9265,1323.5272+0.5,10.0); // Mobile vs Mobile - Pc vs Pc
		UpdateDynamic3DTextLabelText ( Dmzone1_Text, -1, dmzstring ) ;
	}
	if(GetPVarInt(playerid, "on_dmarena1"))
	{
	    dmzone2_players --;
        new dmzstring2[128];
		format(dmzstring2, sizeof(dmzstring2), "{ffffff}„Ê»«Ì· ÷œ ﬂ„»ÌÊ —\n{f5d922}%d ·«⁄»",dmzone2_players);
		Dmzone2_Text = CreateDynamic3DTextLabel(dmzstring2,0xf5d92299,2038.3451,-1768.9265,1323.5272+0.5,10.0); // Mobile vs Pc
		UpdateDynamic3DTextLabelText ( Dmzone2_Text, -1, dmzstring2 ) ;
	}
	if(InPizza[playerid] == 1)
	{
	    AC_DestroyVehicle(vehiclerc[playerid]);
	    p_info[playerid][pizzatimer] = 0;
	}
    // for ( new i = 0; i < 5 ; i ++ )	PlayerTextDrawHide ( playerid, Hunger [playerid][ i ] ) ;
	// DMZONE
    DeletePVar(playerid, "Health");
	DeletePVar(playerid, "on_dmarena");
	DeletePVar(playerid, "AntiCBUG");
	DeletePVar(playerid, "on_dmarena1");
	DeletePVar(playerid, "arena_weapon_set");
	// builder
	DeletePVar(playerid, "TakedBuild");
	DeletePVar(playerid, "PutBuild");
	
	//dreba job
	DeletePVar(playerid, "Dreba_Taked");
	DeletePVar(playerid, "Put_Dreba");
	DeletePVar(playerid, "Put_Dreba1");
	p_info [ playerid ] [ u_trailer ] = 0 ;
	
	if(Insamiq[playerid] == 1)
	{
       GivePlayerMoney(playerid, totalsami[playerid]*MUSORSAMI);
	   musorsami[playerid] = 0;
	   totalsami[playerid] = 0;
       Insamiq[playerid] = 0;
	   onCheckskinsamilos[playerid] = false;
	   AC_DestroyVehicle(player_samiq[playerid]);
	}
	
	//tyara job
	DeletePVar(playerid, "Tyara_Taked");
	DeletePVar(playerid, "Put_Tyara");
	DeletePVar(playerid, "tyara_vehicle");
	
	//if(RadarTimer[playerid] != 0) KillTimer(RadarTimer[playerid]);

	if(InTyarajob[playerid] == 1)
	{
	    AC_DestroyVehicle(tyara_veh[playerid]);
	}

	if(InTyarajob[playerid] == 0)
	{
	    AC_DestroyVehicle(tyara_veh[playerid]);
	}
	
	//bank job
    if(InBankjob[playerid] == 1)
	{
       GivePlayerMoney(playerid, total[playerid]*MUSOR);
	   musor[playerid] = 0;
	   total[playerid] = 0;
		    //p_info[playerid][banktimer] = 0;
       InBankjob[playerid] = 0;
	   onCheckskinbanklos[playerid] = false;
	   AC_DestroyVehicle(player_banker[playerid]);
	}

	DeletePVar(playerid, "bankpos001");
	DeletePVar(playerid, "bank91");
	DeletePVar(playerid, "bankpos11");
	DeletePVar(playerid, "test");
	DeletePVar(playerid, "bankpos2");

	// spback
	if(p_t_info [ playerid ] [ mp_tp ] != 1)
	{
		new spawn_sql_string [ 1000 ];
		GetPlayerPos(playerid, p_info[playerid][pSpawnPos][0], p_info[playerid][pSpawnPos][1], p_info[playerid][pSpawnPos][2]);
		GetPlayerFacingAngle(playerid, p_info[playerid][pSpawnPos][3]);
		p_info[playerid][pSpawnInterior] = GetPlayerInterior(playerid);
		p_info[playerid][pSpawnWorld] = GetPlayerVirtualWorld(playerid);
		mysql_format ( sql_connection, spawn_sql_string, sizeof spawn_sql_string, "UPDATE `users` SET `spawnData`='%.2f,%.2f,%.2f,%.2f' WHERE `u_name`='%s'",p_info[playerid][pSpawnPos][0], p_info[playerid][pSpawnPos][1], p_info[playerid][pSpawnPos][2],p_info[playerid][pSpawnPos][3],p_info[playerid][name]);
		mysql_tquery ( sql_connection, spawn_sql_string ) ;
		update_int_sql(playerid, "pSpawnInterior", p_info[playerid][pSpawnWorld]);
		update_int_sql(playerid, "pSpawnInterior", p_info[playerid][pSpawnInterior]);
	}

	//save weapons
	if(ondmz[playerid] != 1 && p_t_info [ playerid ] [ mp_tp ] != 1 && weapon_hack_status [playerid] != 1 )
	{
		for ( new i = 0; i < 11; i ++ )
		{
			new gun;
			new ammo;
		    GetPlayerWeaponData(playerid, i, gun, ammo);
			if(gun == 23 && ammo > 0)
			{
			    new sdpistol1_save[128];
				p_info[playerid][sdpistol_save] = ammo;
				mysql_format ( sql_connection, sdpistol1_save, sizeof sdpistol1_save,"UPDATE `users` SET `sdpistol_save` = '%d' WHERE `u_id`='%d'",p_info[playerid][sdpistol_save],p_info[playerid][id]);
				mysql_tquery ( sql_connection, sdpistol1_save ) ;
			}
			if(gun == 24 && ammo > 0)
			{
			    new deagle1_save[128];
				p_info[playerid][deagle_save] = ammo;
				mysql_format ( sql_connection, deagle1_save, sizeof deagle1_save,"UPDATE `users` SET `deagle_save` = '%d' WHERE `u_id`='%d'",p_info[playerid][deagle_save],p_info[playerid][id]);
				mysql_tquery ( sql_connection, deagle1_save ) ;
			}
			if(gun == 25 && ammo > 0)
			{
			    new shotgun1_save[128];
				p_info[playerid][shotgun_save] = ammo;
				mysql_format ( sql_connection, shotgun1_save, sizeof shotgun1_save,"UPDATE `users` SET `shotgun_save` = '%d' WHERE `u_id`='%d'",p_info[playerid][shotgun_save],p_info[playerid][id]);
				mysql_tquery ( sql_connection, shotgun1_save ) ;
			}
			if(gun == 29 && ammo > 0)
			{
			    new mp51_save[128];
				p_info[playerid][mp5_save] = ammo;
				mysql_format ( sql_connection, mp51_save, sizeof mp51_save,"UPDATE `users` SET `mp5_save` = '%d' WHERE `u_id`='%d'",p_info[playerid][mp5_save],p_info[playerid][id]);
				mysql_tquery ( sql_connection, mp51_save ) ;
			}
			if(gun == 30 && ammo > 0)
			{
			    new ak1_save[128];
				p_info[playerid][ak_save] = ammo;
				mysql_format ( sql_connection, ak1_save, sizeof ak1_save,"UPDATE `users` SET `ak_save` = '%d' WHERE `u_id`='%d'",p_info[playerid][ak_save],p_info[playerid][id]);
				mysql_tquery ( sql_connection, ak1_save ) ;
			}
			if(gun == 31 && ammo > 0)
			{
			    new m41_save[128];
				p_info[playerid][m4_save] = ammo;
				mysql_format ( sql_connection, m41_save, sizeof m41_save,"UPDATE `users` SET `m4_save` = '%d' WHERE `u_id`='%d'",p_info[playerid][m4_save],p_info[playerid][id]);
				mysql_tquery ( sql_connection, m41_save ) ;
			}
		}
	}
    
	//TextDrawHideForPlayer(playerid, HungerTD[0]);
	
	//jc
	if ( player_Breakcar [playerid] != INVALID_PLAYER_ID )
	{
	    AC_DestroyVehicle ( player_Breakcar [playerid] );
		player_Breakcar [playerid] = INVALID_VEHICLE_ID;
	}
	if(player_Stealcar [playerid] != INVALID_VEHICLE_ID)
	{
		player_Stealcar [playerid] = INVALID_VEHICLE_ID;
	}
	if ( breakcar_timer { playerid }>0 )
	{
	    breakcar_timer { playerid } = 0;
 	}
    if ( p_info [ playerid ] [ stealtimer ]>0 )
	{
	    p_info [ playerid ] [ stealtimer ] = 0;
 	}
 	
 	
	
	if ( p_info [ playerid ] [ admin ] )
	{
		Iter_Remove ( admin_players, playerid ) ;
		p_info [ playerid ] [ admin ] = 0 ;
	}
    

	if ( p_t_info [ playerid ] [ p_logged ] == false )
	{
	    KillTimer(login_timer [ playerid ]);
 	}

    if(playerLSTimerID[playerid]) KillTimer(playerLSTimerID[playerid]);
    playerLSTimerID[playerid] = 0;

  

	if ( p_t_info [ playerid ] [ pveh ] != -1 )
	{
		AC_DestroyVehicle ( p_t_info [ playerid ] [ pveh ] ) ;
		p_t_info [ playerid ] [ pveh ] = -1 ;
	}

	/*  */
	if(RepOn[playerid]) RepOt--;
	RepId[playerid] = -1;
	
	if ( GetPVarInt ( playerid, "fork_object") )
	{
		DestroyDynamicObject ( GetPVarInt ( playerid, "fork_object" ) ) ;
		DeletePVar ( playerid, "fork_object" ) ;
	}
	if ( player_practice { playerid } != 0 )
	{
		player_practice { playerid } = 0 ;
		KillTimer ( player_practice_step_timer [ playerid ] ) ;
