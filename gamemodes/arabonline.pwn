callback: callback_offamily ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  „ «·⁄ÀÊ— ⁄·Ï ·«⁄»Ì‰ »Â–Ì «·»Ì«‰« ." );

	new rows_list = GetPVarInt ( playerid, "ofm_list_page" ) - 1 ;
	SetPVarInt ( playerid, "ofm_list_rows", rows ) ;
	new line_string [ MAX_PLAYER_NAME + 60 ], pl_ofm_name [ 20 ], pl_ofm_online [ 16 ], fam_c_rank ;
	new dialog_string [ 10 * sizeof(line_string) + 50 ] ;
	strcat ( dialog_string, "{"#cBL"}«·”«»ﬁ «·’›Õ…{"#cBL"}\n«· «·Ì «·’›Õ…\n{"#cWH"}" ) ;
	for ( new i = rows_list * 10 ; i <  rows_list * 10 + 10 ; i ++ )
	{
		if ( i >= rows ) break ;

		cache_get_field_content ( i, "u_name", pl_ofm_name, sql_connection, 20 ) ;
		cache_get_field_content ( i, "u_last_date", pl_ofm_online, sql_connection, 16 ) ;
		fam_c_rank = cache_get_field_content_int ( i, "u_family_rank", sql_connection ) ;

		new pvar_string [ 8 ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", i - rows_list * 10 ) ;
		SetPVarString ( playerid, pvar_string, pl_ofm_name ) ;

		format ( line_string, sizeof ( line_string ), "%s - {"#cBL"}%s (%d){"#cWH"} - %s\n", pl_ofm_name, family_rank [ p_info [ playerid ] [ family ] - 1 ] [ fam_c_rank ], fam_c_rank, pl_ofm_online ) ;
		strcat ( dialog_string, line_string ) ;
	}

	show_dialog ( playerid, d_offmembers_list1, DIALOG_STYLE_LIST, "{"#cBL"}√⁄÷«¡ «·⁄«∆·… €Ì— ‰‘ÿ", dialog_string, "«Œ —", "—ÃÊ⁄" ) ;
	return 1 ;
}

callback: callback_offamily_info ( playerid )
{
	new rows, fields;
	cache_get_data ( rows, fields ) ;
	if ( rows )
	{
		new last_date [ 16 ], fraction_date [ 16 ], fam_c_rank ;

		fam_c_rank = cache_get_field_content_int ( 0, "u_family_rank", sql_connection ) ;
		cache_get_field_content(0, "u_last_date", last_date, sql_connection, 16 ) ;
		cache_get_field_content(0, "u_family_date", fraction_date, sql_connection, 16 ) ;

		new pvar_string [ 20 ], pl_name [ 20 ] ;
		format ( pvar_string, sizeof ( pvar_string ), "ofm_%d", GetPVarInt ( playerid, "ofm_listitem" ) ) ;
		GetPVarString ( playerid, pvar_string, pl_name, 20 ) ;

		new dialog_string [ 256 ] ;
		format ( dialog_string, sizeof ( dialog_string ), "{"#cWH"}«·«”„: {"#cBL"}%s{"#cWH"}\n«·ÊŸÌ›… «·⁄‰Ê«‰: {"#cBL"}%s (%d){"#cWH"}\n›Ì  «·⁄«∆·… „⁄ {"#cBL"}%s{"#cWH"}\n«·√ŒÌ— entrance: {"#cBL"}%s{"#cWH"}", pl_name, family_rank [ p_info [ playerid ] [ family ] - 1 ] [ fam_c_rank ], fam_c_rank, fraction_date, last_date ) ;
		show_dialog ( playerid, d_offmembers_pl_menu_info1, DIALOG_STYLE_MSGBOX, "{"#cBL"}«··«⁄» „⁄·Ê„« ", dialog_string, "—ÃÊ⁄", "" ) ;
	}
	if ( ! rows )
	{
		new query_string [ 128 ];
		DeletePVar( playerid, "ofm_listitem" ) ;
		if( ! GetPVarInt ( playerid, "ofm_type" ) )
		{
			mysql_format ( sql_connection, query_string, 98, "SELECT `u_name`,`u_last_date`,`u_family_rank` FROM `users` WHERE `u_family` = '%d' AND `u_online` = '0'", p_info [ playerid ] [ family ] ) ;
			mysql_tquery ( sql_connection, query_string, "callback_offamily", "i", playerid ) ;
			return 1;
		}
	}
	return 1 ;
}

cmd:u(playerid, params[])
{
	if(p_info[playerid][mute] >= 1)
	return SendClientMessage(playerid, col_light_red, "«·Ê’Ê· ≈·Ï «·‘«  „ÕÃÊ». «·Êﬁ  «··Ì Ì› Õ: {FFE100}/«·Êﬁ ");

	if(p_info[playerid][f_mute] >= 1)
	return SendClientMessage(playerid, col_light_red, "«·Ê’Ê· ≈·Ï ‘«  «·—«œÌÊ „ÕÃÊ». «·Êﬁ  «··Ì Ì› Õ: {FFE100}/«·Êﬁ ");

	if(gang_player(playerid) || mafia_player(playerid))
	{
		if(GetPVarInt(playerid, "antifloodu") > gettime())
		return SendClientMessage(playerid, col_light_red, "·«  ›·œ...");

		extract params -> new string:text[120]; else
		return SendClientMessage(playerid, col_gray, !"«·«” Œœ«„: {FFFFFF}/u [«·‰’]");

		new string[144];
		format(string, sizeof(string), "[U] (%s) %s %s[%d]: %s", f_info[p_info[playerid][member]-1][f_name], f_rank[p_info[playerid][member]-1][p_info[playerid][rank]-1], p_info [ playerid ] [ name ], playerid, text);
		foreach(new i: logged_players) if((f_diplomacy[p_info[playerid][member]-11][p_info[i][member]-11] == dip_status_alliance || p_info[i][member] == p_info[playerid][member] || is_control_chat{i} == p_info[playerid][member]) && p_info[i][settings][0] != 0) SendClientMessage(i, 0xb5e8f0FF, string);

		SetPVarInt(playerid, "antifloodu", gettime()+3);
	}
	return 1;
}

callback: WeaponAnim(playerid)
{
	if(IsPlayerAttachedObjectSlotUsed(playerid, 0)) RemovePlayerAttachedObject(playerid, 0);
	ClearAnimations(playerid);
	ApplyAnimation( playerid, "BUDDY", "buddy_reload", 4.1, 0, 1, 1, 1, 0 );
  	SetPlayerAttachedObject( playerid, 0, 355, 14, 0.301943, 0.011442, 0.010348, 106.050292, 330.509094, 3.293162, 1.000000, 1.000000, 1.000000 );
	return 1;
}

callback: FriendPay ( playerid, money_pay )
{
	new Referal [ MAX_PLAYER_NAME ] ;
	cache_get_field_content ( 0, "u_referal", Referal, sql_connection, MAX_PLAYER_NAME ) ;
	if(strcmp(Referal, "n", false) != 0)
	{
		new query_string [ 118 ] ;
		format ( query_string, sizeof ( query_string ),"UPDATE `users` SET `u_donate` = `u_donate`+'%d' WHERE `u_name` = '%d' LIMIT 1", money_pay, Referal ) ;
		mysql_query ( sql_connection, query_string ) ;
	}
	return 1;
}

