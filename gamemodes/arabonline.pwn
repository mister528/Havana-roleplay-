	mysql_tquery ( sql_connection, scm_string ) ;

	SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"}  „  À»Ì  ÃÂ«“   »⁄ GPS ›Ì «·”Ì«—… »‰Ã«Õ." ) ;
	return 1 ;
}

