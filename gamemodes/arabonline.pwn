	SendClientMessage ( playerid, 0x8D8DFFAA, scm_string ) ;
	
	format(scm_string, sizeof scm_string, "ﬁ«· () ≈·Ï œ«Œ·  —«œÌÊ: {FFFFFF}%s", params [ 0 ]);
