    new string[228];
    format(string,sizeof(string), "Õﬁﬂ taskill «·„” ÊÏ ÂÊ %d Ê ⁄‰œﬂ stealed %d «·”Ì«—…(s)", p_info[playerid][pTaskillLevel],p_info[playerid][pTaskill]);
