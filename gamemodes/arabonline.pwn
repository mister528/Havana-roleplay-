#define ACC_SHOP_COUNT  sizeof ( g_acc_models )

// Floating object position: ~1.2 m in front of the player, waist-high.
#define ACC_OBJ_X       ACC_LOOK_X
#define ACC_OBJ_Y       ACC_LOOK_Y
#define ACC_OBJ_Z       ACC_LOOK_Z

new g_acc_object      [ MAX_PLAYERS ] ;
new Float:g_acc_rot_z [ MAX_PLAYERS ] ;
new      g_acc_spin_on[ MAX_PLAYERS ] ;
new      g_acc_timer  [ MAX_PLAYERS ] ;

forward accshop_spin_tick ( playerid ) ;
public  accshop_spin_tick ( playerid )
{
    if ( ! GetPVarInt ( playerid, "acc_active" ) ) return 1 ;

    // object idle rotation (Z-axis slow spin)
    if ( g_acc_spin_on [ playerid ] && g_acc_object [ playerid ] )
    {
        g_acc_rot_z [ playerid ] += 4.0 ;
        if ( g_acc_rot_z [ playerid ] >= 360.0 ) g_acc_rot_z [ playerid ] -= 360.0 ;
        SetDynamicObjectRot ( g_acc_object [ playerid ],
                              0.0, 0.0, g_acc_rot_z [ playerid ] ) ;
    }

    // camera orbit animation (right -> back -> left -> top -> front)
    if ( GetPVarInt ( playerid, "acc_orbit_on" ) )
    {
        new Float:t = GetPVarFloat ( playerid, "acc_orbit_t" ) ;
        t += 0.025 ;
        if ( t >= 1.0 )
        {
            DeletePVar ( playerid, "acc_orbit_on" ) ;
            DeletePVar ( playerid, "acc_orbit_t"  ) ;
            // restore default view
            SetPlayerCameraPos    ( playerid, ACC_CAM_X, ACC_CAM_Y, ACC_CAM_Z ) ;
            SetPlayerCameraLookAt ( playerid, ACC_LOOK_X, ACC_LOOK_Y, ACC_LOOK_Z ) ;
        }
        else
        {
            SetPVarFloat ( playerid, "acc_orbit_t", t ) ;
            // orbit around the preview point at ~2.7m radius
            new Float:pi2     = 6.28318530718 ;
            new Float:a0      = -0.1952 ;            // starting angle of default cam
            new Float:ang     = a0 + t * pi2 ;
            new Float:rad     = 2.80 ;
            new Float:ox      = ACC_LOOK_X + rad * floatcos ( ang, radian ) ;
            new Float:oy      = ACC_LOOK_Y + rad * floatsin ( ang, radian ) ;
            // vertical bob: +0.9m at quarter, -0.1m trough elsewhere (above+back view)
            new Float:oz      = ACC_CAM_Z + 0.90 * floatsin ( t * pi2, radian ) ;
            SetPlayerCameraPos    ( playerid, ox, oy, oz ) ;
            SetPlayerCameraLookAt ( playerid, ACC_LOOK_X, ACC_LOOK_Y, ACC_LOOK_Z ) ;
        }
    }
    return 1 ;
}

stock accshop_send_overlay ( playerid )
{
    new idx   = GetPVarInt ( playerid, "acc_idx" ) ;
    if ( idx < 0 || idx >= ACC_SHOP_COUNT ) idx = 0 ;
    new model = g_acc_models [ idx ] ;
    new price = g_acc_prices [ idx ] ;
    new body [ 32 ] ;
    format ( body, sizeof ( body ), "%d|%d", model, price ) ;
    ShowPlayerDialog ( playerid, 31338, DIALOG_STYLE_MSGBOX,
        "[!ACC_SHOP_OPEN]", body, " ", " " ) ;
}

stock accshop_spawn_object ( playerid )
{
    new idx = GetPVarInt ( playerid, "acc_idx" ) ;
    if ( idx < 0 || idx >= ACC_SHOP_COUNT ) idx = 0 ;
    if ( g_acc_object [ playerid ] )
    {
        DestroyDynamicObject ( g_acc_object [ playerid ] ) ;
        g_acc_object [ playerid ] = 0 ;
    }
    new biz = GetPVarInt ( playerid, "cl_biz" ) - 1 ;
    if ( biz < 0 ) biz = 0 ;
    new vw = b_info [ biz ] [ b_id ] + 1000 ;
    g_acc_object [ playerid ] = CreateDynamicObject (
        g_acc_models [ idx ],
        ACC_OBJ_X, ACC_OBJ_Y, ACC_OBJ_Z,
        0.0, 0.0, g_acc_rot_z [ playerid ],
        vw, 0, -1, 300.0, 300.0 ) ;
    // Force the streamer to re-evaluate this player so the new object
    // appears instantly after cycling.
    Streamer_Update ( playerid, STREAMER_TYPE_OBJECT ) ;
}

stock accshop_close_overlay ( playerid )
{
    ShowPlayerDialog ( playerid, 31338, DIALOG_STYLE_MSGBOX,
        "[!ACC_SHOP_CLOSE]", " ", " ", " " ) ;
}

stock accshop_clear_pvars ( playerid )
{
    DeletePVar ( playerid, "acc_active"    ) ;
    DeletePVar ( playerid, "acc_idx"       ) ;
    DeletePVar ( playerid, "acc_cat"       ) ;
    DeletePVar ( playerid, "acc_cat_start" ) ;
    DeletePVar ( playerid, "acc_cat_count" ) ;
    DeletePVar ( playerid, "acc_back_x"    ) ;
    DeletePVar ( playerid, "acc_back_y"    ) ;
    DeletePVar ( playerid, "acc_back_z"    ) ;
    DeletePVar ( playerid, "acc_back_a"    ) ;
    DeletePVar ( playerid, "acc_back_iw"   ) ;
    DeletePVar ( playerid, "acc_back_vw"   ) ;
    DeletePVar ( playerid, "acc_orbit_on"  ) ;
    DeletePVar ( playerid, "acc_orbit_t"   ) ;
}

stock accshop_restore_player ( playerid )
{
    new Float:bx = GetPVarFloat ( playerid, "acc_back_x" ) ;
    new Float:by = GetPVarFloat ( playerid, "acc_back_y" ) ;
    new Float:bz = GetPVarFloat ( playerid, "acc_back_z" ) ;
    new Float:ba = GetPVarFloat ( playerid, "acc_back_a" ) ;
    new       iw = GetPVarInt   ( playerid, "acc_back_iw" ) ;
    new       vw = GetPVarInt   ( playerid, "acc_back_vw" ) ;

    // Fallback: if no saved pos, drop the player at the clothes-shop
    // entry point (inside the new interior) using the biz we came from.
    if ( bx == 0.0 && by == 0.0 && bz == 0.0 )
    {
        new biz = GetPVarInt ( playerid, "cl_biz" ) - 1 ;
        if ( biz < 0 ) biz = 0 ;
        bx = b_interior [ 6 ] [ i_position ] [ 0 ] ;
        by = b_interior [ 6 ] [ i_position ] [ 1 ] ;
        bz = b_interior [ 6 ] [ i_position ] [ 2 ] ;
        ba = b_interior [ 6 ] [ i_position ] [ 3 ] ;
        iw = b_interior [ 6 ] [ i_interior ] ;
        vw = b_info     [ biz ] [ b_id     ] + 1000 ;
    }

    SetPlayerInterior     ( playerid, iw ) ;
    SetPlayerVirtualWorld ( playerid, vw ) ;
    SetPlayerPos          ( playerid, bx, by, bz ) ;
    SetPlayerFacingAngle  ( playerid, ba ) ;
    SetCameraBehindPlayer ( playerid ) ;
    TogglePlayerControllable ( playerid, 1 ) ;
    SetPVarInt ( playerid, "tp_area_used", 1 ) ;
}

stock accshop_enter ( playerid )
{
    if ( GetPVarInt ( playerid, "acc_active" ) ) return 1 ;
    if ( GetPVarInt ( playerid, "cl_active"  ) ) return 1 ;
    new biz = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
    if ( biz < 0 ) return 1 ;
    if ( b_info [ biz ] [ b_type ] != bizz_type_clothes ) return 1 ;

    SetPVarInt   ( playerid, "acc_active", 1 ) ;
    SetPVarInt   ( playerid, "acc_idx",    0 ) ;
    SetPVarInt   ( playerid, "cl_biz",     biz + 1 ) ;

    new Float:px, Float:py, Float:pz, Float:pa ;
    GetPlayerPos      ( playerid, px, py, pz ) ;
    GetPlayerFacingAngle ( playerid, pa ) ;
    SetPVarFloat ( playerid, "acc_back_x",  px ) ;
    SetPVarFloat ( playerid, "acc_back_y",  py ) ;
    SetPVarFloat ( playerid, "acc_back_z",  pz ) ;
    SetPVarFloat ( playerid, "acc_back_a",  pa ) ;
    SetPVarInt   ( playerid, "acc_back_iw", GetPlayerInterior     ( playerid ) ) ;
    SetPVarInt   ( playerid, "acc_back_vw", GetPlayerVirtualWorld ( playerid ) ) ;

    // Move the player into the preview pose.
    SetPlayerInterior     ( playerid, 0 ) ;
    SetPlayerVirtualWorld ( playerid, b_info [ biz ] [ b_id ] + 1000 ) ;
    // Park the player out of sight behind the camera.
    SetPlayerPos          ( playerid, ACC_HIDE_X, ACC_HIDE_Y, ACC_HIDE_Z ) ;
    SetPlayerFacingAngle  ( playerid, 78.77 ) ;
    TogglePlayerControllable ( playerid, 0 ) ;
    SetPlayerCameraPos    ( playerid, ACC_CAM_X, ACC_CAM_Y, ACC_CAM_Z ) ;
    SetPlayerCameraLookAt ( playerid, ACC_LOOK_X, ACC_LOOK_Y, ACC_LOOK_Z ) ;
    SetPlayerCameraPos    ( playerid, ACC_CAM_X, ACC_CAM_Y, ACC_CAM_Z ) ;
    SetPlayerCameraLookAt ( playerid, ACC_LOOK_X, ACC_LOOK_Y, ACC_LOOK_Z ) ;

    g_acc_rot_z   [ playerid ] = 0.0 ;
    g_acc_spin_on [ playerid ] = 1 ;
    accshop_spawn_object ( playerid ) ;
    accshop_send_overlay ( playerid ) ;

    if ( g_acc_timer [ playerid ] ) KillTimer ( g_acc_timer [ playerid ] ) ;
    g_acc_timer [ playerid ] = SetTimerEx ( "accshop_spin_tick", 80, true,
                                            "i", playerid ) ;
    return 1 ;
}

stock accshop_cycle ( playerid, direction )
{
    if ( ! GetPVarInt ( playerid, "acc_active" ) ) return 1 ;
    new start = GetPVarInt ( playerid, "acc_cat_start" ) ;
    new count = GetPVarInt ( playerid, "acc_cat_count" ) ;
    if ( count <= 0 )
    {
        start = 0 ;
        count = ACC_SHOP_COUNT ;
    }
    new idx = GetPVarInt ( playerid, "acc_idx" ) ;
    new rel = idx - start ;
    rel = ( rel + direction + count ) % count ;
    idx = start + rel ;
    SetPVarInt ( playerid, "acc_idx", idx ) ;
    accshop_spawn_object ( playerid ) ;
    accshop_send_overlay ( playerid ) ;
    return 1 ;
}

// Toggle rotate: launch one full orbit (right/back/left/top/front) then
// return to the default camera.  Safe to re-press while active (restarts).
stock accshop_toggle_spin ( playerid )
{
    if ( ! GetPVarInt ( playerid, "acc_active" ) ) return 1 ;
    SetPVarInt   ( playerid, "acc_orbit_on",   1   ) ;
    SetPVarFloat ( playerid, "acc_orbit_t",    0.0 ) ;
    return 1 ;
}

stock accshop_close ( playerid )
{
    if ( g_acc_timer [ playerid ] )
    {
        KillTimer ( g_acc_timer [ playerid ] ) ;
        g_acc_timer [ playerid ] = 0 ;
    }
    if ( g_acc_object [ playerid ] )
    {
        DestroyDynamicObject ( g_acc_object [ playerid ] ) ;
        g_acc_object [ playerid ] = 0 ;
    }
    g_acc_spin_on [ playerid ] = 0 ;
}

stock accshop_exit ( playerid )
{
    // Run cleanup unconditionally: the overlay may have been closed
    // but PVars could still be stale after a prior crash/disconnect.
    accshop_close          ( playerid ) ;
    accshop_restore_player ( playerid ) ;
    accshop_close_overlay  ( playerid ) ;
    accshop_clear_pvars    ( playerid ) ;
    SendClientMessage ( playerid, col_white,
        "{"#cGR"}* {"#cWH"} „ ≈·€«¡ ‘—«¡ «·≈ﬂ””Ê«—." ) ;
    return 1 ;
}

stock accshop_find_free_slot ( playerid )
{
    for ( new j = 0 ; j < 8 ; j ++ )
    {
        if ( p_info [ playerid ] [ accessories ] [ j ] == 0 ) return j ;
    }
    return -1 ;
}

stock accshop_buy ( playerid )
{
    if ( ! GetPVarInt ( playerid, "acc_active" ) ) return 1 ;
    new idx = GetPVarInt ( playerid, "acc_idx" ) ;
    if ( idx < 0 || idx >= ACC_SHOP_COUNT ) idx = 0 ;
    new model = g_acc_models [ idx ] ;
    new price = g_acc_prices [ idx ] ;

    if ( p_info [ playerid ] [ money ] < price )
    {
        SendClientMessage ( playerid, col_gray,
            "{"#cRD"}* {"#cWH"}„« „⁄ﬂ ›·Ê” ﬂ«›Ì… ·‘—«¡ «·≈ﬂ””Ê«—." ) ;
        return 1 ;
    }

    new slot = accshop_find_free_slot ( playerid ) ;
    if ( slot < 0 )
    {
        SendClientMessage ( playerid, col_gray,
            "{"#cRD"}* {"#cWH"}Œ«‰«  «·≈ﬂ””Ê«—«  „„ ·∆… (8/8)." ) ;
        return 1 ;
    }

    give_money       ( playerid, -price ) ;
    insert_money_log ( playerid, -1, -price, "acc_buy" ) ;

    new biz = GetPVarInt ( playerid, "cl_biz" ) - 1 ;
    if ( biz >= 0 )
    {
        b_info [ biz ] [ b_money       ] += floatround ( price * 0.03 ) ;
        b_info [ biz ] [ b_cash_today  ] += floatround ( price * 0.03 ) ;
    }

    p_info [ playerid ] [ accessories      ] [ slot ] = model ;
    p_info [ playerid ] [ accessories_used ] [ slot ] = 0 ;

    new _query [ 160 ] ;
    format ( _query, sizeof ( _query ),
        "UPDATE `users` SET `u_accessories`='%d|%d|%d|%d|%d|%d|%d|%d' WHERE `u_id`='%d'",
        p_info [ playerid ] [ accessories ] [ 0 ], p_info [ playerid ] [ accessories ] [ 1 ],
        p_info [ playerid ] [ accessories ] [ 2 ], p_info [ playerid ] [ accessories ] [ 3 ],
        p_info [ playerid ] [ accessories ] [ 4 ], p_info [ playerid ] [ accessories ] [ 5 ],
        p_info [ playerid ] [ accessories ] [ 6 ], p_info [ playerid ] [ accessories ] [ 7 ],
        p_info [ playerid ] [ id ] ) ;
    mysql_tquery ( sql_connection, _query ) ;

    GiveItem ( playerid, model ) ;
    havana_push_inv_update ( playerid ) ;

    accshop_close          ( playerid ) ;
    accshop_restore_player ( playerid ) ;
    accshop_close_overlay  ( playerid ) ;
    accshop_clear_pvars    ( playerid ) ;

    new msg [ 160 ] ;
    format ( msg, sizeof ( msg ),
        "{"#cGN"}* {"#cWH"} „ ‘—«¡ «·≈ﬂ””Ê«— »‹ {"#cGN"}%d${"#cWH"}.", price ) ;
    SendClientMessage ( playerid, col_white, msg ) ;
    return 1 ;
}

CMD:accshop_left   ( playerid ) { return accshop_cycle       ( playerid, -1 ) ; }
CMD:accshop_right  ( playerid ) { return accshop_cycle       ( playerid,  1 ) ; }
CMD:accshop_rotate ( playerid ) { return accshop_toggle_spin ( playerid     ) ; }
CMD:accshop_buy    ( playerid ) { return accshop_buy         ( playerid     ) ; }
CMD:accshop_exit   ( playerid ) { return accshop_exit        ( playerid     ) ; }

stock havana_persist_acc_used ( playerid )
{
    new _q [ 200 ] ;
    format ( _q, sizeof ( _q ), "UPDATE `users` SET `u_accessories_used`='%d|%d|%d|%d|%d|%d|%d|%d' WHERE `u_id`='%d'",
        p_info [ playerid ] [ accessories_used ] [ 0 ], p_info [ playerid ] [ accessories_used ] [ 1 ],
        p_info [ playerid ] [ accessories_used ] [ 2 ], p_info [ playerid ] [ accessories_used ] [ 3 ],
        p_info [ playerid ] [ accessories_used ] [ 4 ], p_info [ playerid ] [ accessories_used ] [ 5 ],
        p_info [ playerid ] [ accessories_used ] [ 6 ], p_info [ playerid ] [ accessories_used ] [ 7 ],
        p_info [ playerid ] [ id ] ) ;
    mysql_tquery ( sql_connection, _q ) ;
}
stock havana_persist_acc_models ( playerid )
{
    new _q [ 200 ] ;
    format ( _q, sizeof ( _q ), "UPDATE `users` SET `u_accessories`='%d|%d|%d|%d|%d|%d|%d|%d' WHERE `u_id`='%d'",
        p_info [ playerid ] [ accessories ] [ 0 ], p_info [ playerid ] [ accessories ] [ 1 ],
        p_info [ playerid ] [ accessories ] [ 2 ], p_info [ playerid ] [ accessories ] [ 3 ],
        p_info [ playerid ] [ accessories ] [ 4 ], p_info [ playerid ] [ accessories ] [ 5 ],
        p_info [ playerid ] [ accessories ] [ 6 ], p_info [ playerid ] [ accessories ] [ 7 ],
        p_info [ playerid ] [ id ] ) ;
    mysql_tquery ( sql_connection, _q ) ;
}
// Scan all 10 attach slots, return bitmask of used ones.
stock havana_attach_mask ( playerid )
{
    new hac_mask = 0 ;
    for ( new hac_i = 0 ; hac_i < 10 ; hac_i ++ )
    {
        if ( IsPlayerAttachedObjectSlotUsed ( playerid, hac_i ) )
        {
            hac_mask = hac_mask | ( 1 << hac_i ) ;
        }
    }
    return hac_mask ;
}
// Store (real_idx + 1) in a pvar; 0 means "unknown".
stock havana_set_acidx ( playerid, slot, idx )
{
    new buf [ 24 ] ;
    format ( buf, sizeof ( buf ), "HAV_ACIDX_%d", slot ) ;
    SetPVarInt ( playerid, buf, idx + 1 ) ;
}
stock havana_get_acidx ( playerid, slot )
{
    new buf [ 24 ] ;
    format ( buf, sizeof ( buf ), "HAV_ACIDX_%d", slot ) ;
    return GetPVarInt ( playerid, buf ) - 1 ;
}
// Wipe every accessory attach slot (5..9) and re-attach every accessory
// the player currently has equipped, recording the real slot that each
// one landed in so /ac_up /ac_fw etc can later target the right one.
stock havana_rebuild_acc ( playerid )
{
    for ( new sl = 0 ; sl < 8 ; sl ++ )
    {
        new b [ 24 ] ;
        format ( b, sizeof ( b ), "HAV_ACIDX_%d", sl ) ;
        DeletePVar ( playerid, b ) ;
    }
    for ( new i = 5 ; i < 10 ; i ++ )
    {
        if ( IsPlayerAttachedObjectSlotUsed ( playerid, i ) )
            RemovePlayerAttachedObject ( playerid, i ) ;
    }
    for ( new sl = 0 ; sl < 8 ; sl ++ )
    {
        if ( p_info [ playerid ] [ accessories ] [ sl ] == 0 ) continue ;
        if ( p_info [ playerid ] [ accessories_used ] [ sl ] != 1 ) continue ;
        new before = havana_attach_mask ( playerid ) ;
        GiveItem ( playerid, p_info [ playerid ] [ accessories ] [ sl ] ) ;
        new after  = havana_attach_mask ( playerid ) ;
        new added  = after & ~before ;
        new new_idx = -1 ;
        for ( new k = 0 ; k < 10 ; k ++ )
        {
            if ( added & ( 1 << k ) ) { new_idx = k ; break ; }
        }
        if ( new_idx >= 0 )
        {
            havana_set_acidx ( playerid, sl, new_idx ) ;
            if ( havana_has_saved_acc_offsets ( playerid, sl ) ) havana_ac_reapply ( playerid, sl ) ;
        }
    }
}
CMD:ac_use ( playerid, params [ ] )
{
    new slot ;
    if ( sscanf ( params, "d", slot ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«” ⁄„·: /ac_use [0-7]" ) ;
    if ( slot < 0 || slot > 7 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}—ﬁ„ «·Œ«‰… €Ì— ’«·Õ." ) ;
    if ( p_info [ playerid ] [ accessories ] [ slot ] == 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}Œ«‰… «·≈ﬂ””Ê«— ›«—€…." ) ;
    // If already equipped just refresh so ACIDX is correct; avoids duplicates.
    new was_used = ( p_info [ playerid ] [ accessories_used ] [ slot ] == 1 ) ;
    p_info [ playerid ] [ accessories_used ] [ slot ] = 1 ;
    // Wipe and reapply every equipped accessory so attach slot indices
    // are known exactly (no duplicates from partial attachments).
    havana_rebuild_acc ( playerid ) ;
    if ( ! was_used ) havana_persist_acc_used ( playerid ) ;
    SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „  ›⁄Ì· «·≈ﬂ””Ê«—." ) ;
    return 1 ;
}
CMD:ac_off ( playerid, params [ ] )
{
    new slot ;
    if ( sscanf ( params, "d", slot ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«” ⁄„·: /ac_off [0-7]" ) ;
    if ( slot < 0 || slot > 7 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}—ﬁ„ «·Œ«‰… €Ì— ’«·Õ." ) ;
    if ( p_info [ playerid ] [ accessories ] [ slot ] == 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}Œ«‰… «·≈ﬂ””Ê«— ›«—€…." ) ;
    p_info [ playerid ] [ accessories_used ] [ slot ] = 0 ;
    havana_rebuild_acc ( playerid ) ;
    havana_persist_acc_used ( playerid ) ;
    SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „  ⁄ÿÌ· «·≈ﬂ””Ê«—." ) ;
    return 1 ;
}
CMD:ac_drop ( playerid, params [ ] )
{
    new slot ;
    if ( sscanf ( params, "d", slot ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«” ⁄„·: /ac_drop [0-7]" ) ;
    if ( slot < 0 || slot > 7 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}—ﬁ„ «·Œ«‰… €Ì— ’«·Õ." ) ;
    if ( p_info [ playerid ] [ accessories ] [ slot ] == 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}Œ«‰… «·≈ﬂ””Ê«— ›«—€…." ) ;
    p_info [ playerid ] [ accessories ] [ slot ] = 0 ;
    p_info [ playerid ] [ accessories_used ] [ slot ] = 0 ;
    havana_clear_saved_acc_offsets ( playerid, slot ) ;
    havana_rebuild_acc ( playerid ) ;
    havana_persist_acc_models ( playerid ) ;
    havana_persist_acc_used   ( playerid ) ;
    havana_persist_acc_offsets ( playerid ) ;
    SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „ —„Ì «·≈ﬂ””Ê«—." ) ;
    return 1 ;
}


stock havana_ac_command_slot ( playerid, params [ ], &slot )
{
    if ( sscanf ( params, "d", slot ) ) return 0 ;
    if ( slot < 0 || slot > 7 ) return 0 ;
    if ( p_info [ playerid ] [ accessories ] [ slot ] == 0 ) return 0 ;
    return 1 ;
}

stock havana_cmd_ac_adjust ( playerid, params [ ], Float:dox, Float:doy, Float:doz, Float:dscale, Float:drot )
{
    new s ;
    if ( ! havana_ac_command_slot ( playerid, params, s ) ) return 1 ;
    havana_ac_adjust ( playerid, s, dox, doy, doz, dscale, drot ) ;
    return 1 ;
}

// /ac_up /ac_dn /ac_fw /ac_bk /ac_big /ac_sml √¢‚Ç¨‚Äù adjust attach offset/scale.
// SA-MP 0.3.7-R2 lacks GetPlayerAttachedObject so we track per-slot deltas
// in pvars and re-apply the attach ourselves at index 5 (head-ish slot).
// A small accuracy tradeoff: bone/base-offsets are hardcoded to sensible
// defaults for head-worn accessories (which is the common case) rather
// than per-model-per-skin like the original SetAttachToSkin table.
stock Float:havana_get_pvarf ( playerid, tag [ ] , slot, Float:defv )
{
    new buf [ 24 ] ;
    format ( buf, sizeof ( buf ), "HAV_%s_%d", tag, slot ) ;
    new Float:v = GetPVarFloat ( playerid, buf ) ;
    if ( v == 0.0 ) return defv ;
    return v ;
}
stock havana_set_pvarf ( playerid, tag [ ] , slot, Float:v )
{
    new buf [ 24 ] ;
    format ( buf, sizeof ( buf ), "HAV_%s_%d", tag, slot ) ;
    SetPVarFloat ( playerid, buf, v ) ;
}
stock havana_ac_reapply ( playerid, slot )
{
    if ( slot < 0 || slot > 7 ) return 0 ;
    new model = p_info [ playerid ] [ accessories ] [ slot ] ;
    if ( model == 0 ) return 0 ;
    if ( p_info [ playerid ] [ accessories_used ] [ slot ] != 1 ) return 0 ;

    new idx = havana_get_acidx ( playerid, slot ) ;
    if ( idx < 0 || idx > 9 ) return 0 ;

    new b [ 28 ] ;
    format ( b, sizeof ( b ), "HAV_ACBONE_%d", slot ) ;
    new bone = GetPVarInt ( playerid, b ) ;
    if ( bone == 0 ) return 0 ;

    format ( b, sizeof ( b ), "HAV_ACBX_%d", slot ) ; new Float:bx = GetPVarFloat ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBY_%d", slot ) ; new Float:by = GetPVarFloat ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBZ_%d", slot ) ; new Float:bz = GetPVarFloat ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBRX_%d", slot ) ; new Float:brx = GetPVarFloat ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBRY_%d", slot ) ; new Float:bry = GetPVarFloat ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBRZ_%d", slot ) ; new Float:brz = GetPVarFloat ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBSX_%d", slot ) ; new Float:bsx = GetPVarFloat ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBSY_%d", slot ) ; new Float:bsy = GetPVarFloat ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBSZ_%d", slot ) ; new Float:bsz = GetPVarFloat ( playerid, b ) ;

    if ( IsPlayerAttachedObjectSlotUsed ( playerid, idx ) )
        RemovePlayerAttachedObject ( playerid, idx ) ;
    havana_attach_accessory ( playerid, idx, model, bone,
        bx, by, bz,
        brx, bry, brz,
        bsx, bsy, bsz ) ;
    return 1 ;
}

// =========================================================================
// [HAVANA] Persist & load accessory control offsets
// =========================================================================
stock havana_has_saved_acc_offsets ( playerid, slot )
{
    new b [ 28 ] ;
    format ( b, sizeof ( b ), "HAV_ACSAVED_%d", slot ) ;
    return GetPVarInt ( playerid, b ) ;
}

stock havana_mark_saved_acc_offsets ( playerid, slot, status )
{
    new b [ 28 ] ;
    format ( b, sizeof ( b ), "HAV_ACSAVED_%d", slot ) ;
    if ( status ) SetPVarInt ( playerid, b, 1 ) ;
    else DeletePVar ( playerid, b ) ;
}

stock havana_clear_saved_acc_offsets ( playerid, slot )
{
    new b [ 28 ] ;
    format ( b, sizeof ( b ), "HAV_ACBONE_%d", slot ) ; DeletePVar ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBX_%d", slot ) ; DeletePVar ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBY_%d", slot ) ; DeletePVar ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBZ_%d", slot ) ; DeletePVar ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBRX_%d", slot ) ; DeletePVar ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBRY_%d", slot ) ; DeletePVar ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBRZ_%d", slot ) ; DeletePVar ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBSX_%d", slot ) ; DeletePVar ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBSY_%d", slot ) ; DeletePVar ( playerid, b ) ;
    format ( b, sizeof ( b ), "HAV_ACBSZ_%d", slot ) ; DeletePVar ( playerid, b ) ;
    havana_mark_saved_acc_offsets ( playerid, slot, 0 ) ;
}

stock havana_get_saved_acc_float ( playerid, slot, const suffix [ ], &Float:value )
{
    new b [ 28 ] ;
    format ( b, sizeof ( b ), "HAV_%s_%d", suffix, slot ) ;
    value = GetPVarFloat ( playerid, b ) ;
}

stock havana_set_saved_acc_float ( playerid, slot, const suffix [ ], Float:value )
{
    new b [ 28 ] ;
    format ( b, sizeof ( b ), "HAV_%s_%d", suffix, slot ) ;
    SetPVarFloat ( playerid, b, value ) ;
}

stock havana_persist_acc_offsets ( playerid )
{
    new buf [ 600 ] , tmp [ 24 ], b [ 28 ] ;
    buf [ 0 ] = 0 ;
    for ( new s = 0 ; s < 8 ; s ++ )
    {
        if ( s > 0 ) strcat ( buf, ";", sizeof ( buf ) ) ;
        if ( ! havana_has_saved_acc_offsets ( playerid, s ) ) continue ;

        format ( b, sizeof ( b ), "HAV_ACBONE_%d", s ) ;
        format ( tmp, sizeof ( tmp ), "%d", GetPVarInt ( playerid, b ) ) ; strcat ( buf, tmp, sizeof ( buf ) ) ;

        format ( b, sizeof ( b ), "HAV_ACBX_%d", s ) ; format ( tmp, sizeof ( tmp ), ",%.3f", GetPVarFloat ( playerid, b ) ) ; strcat ( buf, tmp, sizeof ( buf ) ) ;
        format ( b, sizeof ( b ), "HAV_ACBY_%d", s ) ; format ( tmp, sizeof ( tmp ), ",%.3f", GetPVarFloat ( playerid, b ) ) ; strcat ( buf, tmp, sizeof ( buf ) ) ;
        format ( b, sizeof ( b ), "HAV_ACBZ_%d", s ) ; format ( tmp, sizeof ( tmp ), ",%.3f", GetPVarFloat ( playerid, b ) ) ; strcat ( buf, tmp, sizeof ( buf ) ) ;
        format ( b, sizeof ( b ), "HAV_ACBRX_%d", s ) ; format ( tmp, sizeof ( tmp ), ",%.1f", GetPVarFloat ( playerid, b ) ) ; strcat ( buf, tmp, sizeof ( buf ) ) ;
        format ( b, sizeof ( b ), "HAV_ACBRY_%d", s ) ; format ( tmp, sizeof ( tmp ), ",%.1f", GetPVarFloat ( playerid, b ) ) ; strcat ( buf, tmp, sizeof ( buf ) ) ;
        format ( b, sizeof ( b ), "HAV_ACBRZ_%d", s ) ; format ( tmp, sizeof ( tmp ), ",%.1f", GetPVarFloat ( playerid, b ) ) ; strcat ( buf, tmp, sizeof ( buf ) ) ;
        format ( b, sizeof ( b ), "HAV_ACBSX_%d", s ) ; format ( tmp, sizeof ( tmp ), ",%.3f", GetPVarFloat ( playerid, b ) ) ; strcat ( buf, tmp, sizeof ( buf ) ) ;
        format ( b, sizeof ( b ), "HAV_ACBSY_%d", s ) ; format ( tmp, sizeof ( tmp ), ",%.3f", GetPVarFloat ( playerid, b ) ) ; strcat ( buf, tmp, sizeof ( buf ) ) ;
        format ( b, sizeof ( b ), "HAV_ACBSZ_%d", s ) ; format ( tmp, sizeof ( tmp ), ",%.3f", GetPVarFloat ( playerid, b ) ) ; strcat ( buf, tmp, sizeof ( buf ) ) ;
    }
    new _q [ 760 ] ;
    format ( _q, sizeof ( _q ), "UPDATE `users` SET `u_acc_offsets`='%s' WHERE `u_id`='%d'", buf, p_info [ playerid ] [ id ] ) ;
    mysql_tquery ( sql_connection, _q ) ;
}

stock havana_load_acc_offsets_str ( playerid, const str [ ] )
{
    for ( new s = 0 ; s < 8 ; s ++ ) havana_clear_saved_acc_offsets ( playerid, s ) ;
    if ( strlen ( str ) < 3 ) return 0 ;

    new pos = 0, slen = strlen ( str ), slot = 0, item_end, item [ 96 ], tok [ 16 ], field_start, field_end, Float:value ;
    while ( slot < 8 && pos <= slen )
    {
        item_end = strfind ( str, ";", false, pos ) ;
        if ( item_end == -1 ) item_end = slen ;
        strmid ( item, str, pos, item_end, sizeof ( item ) ) ;
        if ( strlen ( item ) > 2 )
        {
            field_start = 0 ;
            for ( new f = 0 ; f < 10 ; f ++ )
            {
                field_end = strfind ( item, ",", false, field_start ) ;
                if ( field_end == -1 ) field_end = strlen ( item ) ;
                strmid ( tok, item, field_start, field_end, sizeof ( tok ) ) ;
                switch ( f )
                {
                    case 0:
                    {
                        new b [ 28 ] ;
                        format ( b, sizeof ( b ), "HAV_ACBONE_%d", slot ) ;
                        SetPVarInt ( playerid, b, strval ( tok ) ) ;
                    }
                    case 1..9:
                    {
                        value = floatstr ( tok ) ;
                        switch ( f )
                        {
                            case 1: havana_set_saved_acc_float ( playerid, slot, "ACBX", value ) ;
                            case 2: havana_set_saved_acc_float ( playerid, slot, "ACBY", value ) ;
                            case 3: havana_set_saved_acc_float ( playerid, slot, "ACBZ", value ) ;
                            case 4: havana_set_saved_acc_float ( playerid, slot, "ACBRX", value ) ;
                            case 5: havana_set_saved_acc_float ( playerid, slot, "ACBRY", value ) ;
                            case 6: havana_set_saved_acc_float ( playerid, slot, "ACBRZ", value ) ;
                            case 7: havana_set_saved_acc_float ( playerid, slot, "ACBSX", value ) ;
                            case 8: havana_set_saved_acc_float ( playerid, slot, "ACBSY", value ) ;
                            case 9: havana_set_saved_acc_float ( playerid, slot, "ACBSZ", value ) ;
                        }
                    }
                }
                field_start = field_end + 1 ;
                if ( field_end >= strlen ( item ) ) break ;
            }
            havana_mark_saved_acc_offsets ( playerid, slot, 1 ) ;
        }
        slot ++ ;
        pos = item_end + 1 ;
        if ( item_end >= slen ) break ;
    }
    return 1 ;
}

stock havana_apply_saved_offsets ( playerid )
{
    for ( new s = 0 ; s < 8 ; s ++ )
    {
        if ( ! havana_has_saved_acc_offsets ( playerid, s ) ) continue ;
        havana_ac_reapply ( playerid, s ) ;
    }
    return 1 ;
}

stock havana_ac_adjust ( playerid, slot, Float:dox, Float:doy, Float:doz, Float:dscale, Float:drot )
{
    if ( slot < 0 || slot > 7 ) return 0 ;
    if ( p_info [ playerid ] [ accessories ] [ slot ] == 0 ) return 0 ;
    if ( p_info [ playerid ] [ accessories_used ] [ slot ] != 1 )
    {
        p_info [ playerid ] [ accessories_used ] [ slot ] = 1 ;
        havana_persist_acc_used ( playerid ) ;
        havana_rebuild_acc ( playerid ) ;
    }

    new idx = havana_get_acidx ( playerid, slot ) ;
    if ( idx < 0 || idx > 9 )
    {
        havana_rebuild_acc ( playerid ) ;
        idx = havana_get_acidx ( playerid, slot ) ;
    }
    if ( idx < 0 || idx > 9 ) return 0 ;

    new b [ 28 ] ;
    format ( b, sizeof ( b ), "HAV_ACBONE_%d", slot ) ;
    if ( GetPVarInt ( playerid, b ) == 0 )
    {
        havana_rebuild_acc ( playerid ) ;
        format ( b, sizeof ( b ), "HAV_ACBONE_%d", slot ) ;
    }
    if ( GetPVarInt ( playerid, b ) == 0 ) return 0 ;

    new Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, Float:sx, Float:sy, Float:sz ;
    havana_get_saved_acc_float ( playerid, slot, "ACBX", x ) ;
    havana_get_saved_acc_float ( playerid, slot, "ACBY", y ) ;
    havana_get_saved_acc_float ( playerid, slot, "ACBZ", z ) ;
    havana_get_saved_acc_float ( playerid, slot, "ACBRX", rx ) ;
    havana_get_saved_acc_float ( playerid, slot, "ACBRY", ry ) ;
    havana_get_saved_acc_float ( playerid, slot, "ACBRZ", rz ) ;
    havana_get_saved_acc_float ( playerid, slot, "ACBSX", sx ) ;
    havana_get_saved_acc_float ( playerid, slot, "ACBSY", sy ) ;
    havana_get_saved_acc_float ( playerid, slot, "ACBSZ", sz ) ;

    x += dox ;
    y += doy ;
    z += doz ;
    rz += drot ;
    sx += dscale ;
    sy += dscale ;
    sz += dscale ;

    if ( sx < 0.3 ) sx = 0.3 ; if ( sx > 3.0 ) sx = 3.0 ;
    if ( sy < 0.3 ) sy = 0.3 ; if ( sy > 3.0 ) sy = 3.0 ;
    if ( sz < 0.3 ) sz = 0.3 ; if ( sz > 3.0 ) sz = 3.0 ;
    while ( rz >= 360.0 ) rz -= 360.0 ;
    while ( rz <    0.0 ) rz += 360.0 ;

    havana_set_saved_acc_float ( playerid, slot, "ACBX", x ) ;
    havana_set_saved_acc_float ( playerid, slot, "ACBY", y ) ;
    havana_set_saved_acc_float ( playerid, slot, "ACBZ", z ) ;
    havana_set_saved_acc_float ( playerid, slot, "ACBRX", rx ) ;
    havana_set_saved_acc_float ( playerid, slot, "ACBRY", ry ) ;
    havana_set_saved_acc_float ( playerid, slot, "ACBRZ", rz ) ;
    havana_set_saved_acc_float ( playerid, slot, "ACBSX", sx ) ;
    havana_set_saved_acc_float ( playerid, slot, "ACBSY", sy ) ;
    havana_set_saved_acc_float ( playerid, slot, "ACBSZ", sz ) ;
    havana_mark_saved_acc_offsets ( playerid, slot, 1 ) ;

    havana_ac_reapply ( playerid, slot ) ;
    havana_persist_acc_offsets ( playerid ) ;
    return 1 ;
}

// dox = forward/back (X relative to bone), doy = up/down, doz = in/out, dscale = grow/shrink, drot = rotation delta around Z (deg)
// Up/Down moves along Z (bone-local vertical), Forward/Back along X.
CMD:ac_up  ( playerid, params [ ] ) { return havana_cmd_ac_adjust ( playerid, params,  0.0 ,  0.0 ,  0.08,  0.0  ,  0.0  ) ; }
CMD:ac_dn  ( playerid, params [ ] ) { return havana_cmd_ac_adjust ( playerid, params,  0.0 ,  0.0 , -0.08,  0.0  ,  0.0  ) ; }
CMD:ac_fw  ( playerid, params [ ] ) { return havana_cmd_ac_adjust ( playerid, params,  0.08,  0.0 ,  0.0 ,  0.0  ,  0.0  ) ; }
CMD:ac_bk  ( playerid, params [ ] ) { return havana_cmd_ac_adjust ( playerid, params, -0.08,  0.0 ,  0.0 ,  0.0  ,  0.0  ) ; }
CMD:ac_big ( playerid, params [ ] ) { return havana_cmd_ac_adjust ( playerid, params,  0.0 ,  0.0 ,  0.0 ,  0.10 ,  0.0  ) ; }
CMD:ac_sml ( playerid, params [ ] ) { return havana_cmd_ac_adjust ( playerid, params,  0.0 ,  0.0 ,  0.0 , -0.10 ,  0.0  ) ; }
CMD:ac_rot ( playerid, params [ ] ) { return havana_cmd_ac_adjust ( playerid, params,  0.0 ,  0.0 ,  0.0 ,  0.0  , 30.0  ) ; }
// Big-step "push back" / "push forward" along X axis for quick placement.
CMD:ac_bbk ( playerid, params [ ] ) { return havana_cmd_ac_adjust ( playerid, params, -0.25,  0.0 ,  0.0 ,  0.0  ,  0.0  ) ; }
CMD:ac_bfw ( playerid, params [ ] ) { return havana_cmd_ac_adjust ( playerid, params,  0.25,  0.0 ,  0.0 ,  0.0  ,  0.0  ) ; }
// /ac_ctrl √¢‚Ç¨‚Äù sent when the player opens the control pad. Forces the
// accessory to the body-stable attach (bone=1, spine) so it no longer
// follows the head's rotation.
CMD:ac_ctrl ( playerid, params [ ] )
{
    new s ;
    if ( sscanf ( params, "d", s ) ) return 1 ;
    if ( s < 0 || s > 7 ) return 1 ;
    if ( p_info [ playerid ] [ accessories ] [ s ] == 0 ) return 1 ;
    if ( p_info [ playerid ] [ accessories_used ] [ s ] != 1 ) return 1 ;
    return 1 ;
}
// /ac_rst √¢‚Ç¨‚Äù reset all offsets/scale/rotation for a slot to defaults and refresh the attachment.
CMD:ac_rst ( playerid, params [ ] )
{
    new slot ;
    if ( sscanf ( params, "d", slot ) ) return 1 ;
    if ( slot < 0 || slot > 7 ) return 1 ;
    havana_clear_saved_acc_offsets ( playerid, slot ) ;
    havana_rebuild_acc ( playerid ) ;
    havana_persist_acc_offsets ( playerid ) ;
    return 1 ;
}


// === Admin object editor ===
stock objedit_is_admin ( playerid )
{
    if ( p_info [ playerid ] [ admin ] < 8 ) return 0 ;
    return 1 ;
}

stock objedit_clean_project_name ( src [ ], dest [ ], size = sizeof dest )
{
    format ( dest, size, "%s", src ) ;
    for ( new i = 0 ; i < strlen ( dest ) ; i ++ )
    {
        if ( dest [ i ] == '|' || dest [ i ] == '\\' || dest [ i ] == '/' || dest [ i ] == ':' || dest [ i ] == '*' || dest [ i ] == '?' || dest [ i ] == '"' || dest [ i ] == '<' || dest [ i ] == '>' ) dest [ i ] = '_' ;
    }
    return 1 ;
}

stock objedit_reset_player ( playerid )
{
    for ( new i = 0 ; i < OBJEDIT_MAX_OBJECTS ; i ++ )
    {
        if ( g_objedit_data [ playerid ] [ i ] [ oe_object ] != 0 && IsValidDynamicObject ( g_objedit_data [ playerid ] [ i ] [ oe_object ] ) )
        {
            DestroyDynamicObject ( g_objedit_data [ playerid ] [ i ] [ oe_object ] ) ;
        }
        g_objedit_data [ playerid ] [ i ] [ oe_model ] = 0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_object ] = 0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_attached ] = 0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_world ] = 0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_interior ] = 0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_x ] = 0.0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_y ] = 0.0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_z ] = 0.0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_rx ] = 0.0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_ry ] = 0.0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_rz ] = 0.0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_scale ] = 1.0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_offx ] = 0.0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_offy ] = 0.0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_offz ] = 0.0 ;
        g_objedit_data [ playerid ] [ i ] [ oe_has_undo ] = 0 ;
    }
    g_objedit_count [ playerid ] = 0 ;
    g_objedit_current [ playerid ] = -1 ;
    g_objedit_active [ playerid ] = false ;
    g_objedit_project [ playerid ] [ 0 ] = EOS ;
    SendClientMessage ( playerid, col_gray, "~OBJEDIT~HIDE" ) ;
    return 1 ;
}

stock objedit_get_current ( playerid )
{
    new s = g_objedit_current [ playerid ] ;
    if ( s < 0 || s >= g_objedit_count [ playerid ] ) return -1 ;
    if ( g_objedit_data [ playerid ] [ s ] [ oe_object ] == 0 ) return -1 ;
    if ( ! IsValidDynamicObject ( g_objedit_data [ playerid ] [ s ] [ oe_object ] ) ) return -1 ;
    return s ;
}

stock objedit_push_overlay ( playerid )
{
    new s = objedit_get_current ( playerid ) ;
    if ( s == -1 ) return SendClientMessage ( playerid, col_gray, "~OBJEDIT~HIDE" ) ;

    toggle_controlable ( playerid, true, false ) ;
    Streamer_Update ( playerid ) ;

    new payload [ 256 ] ;
    format ( payload, sizeof payload, "~OBJEDIT~SHOW|%d|%d|%d|%d|%.4f|%.4f|%.4f|%.2f|%.2f|%.2f|%.2f|%s",
        s,
        g_objedit_data [ playerid ] [ s ] [ oe_model ],
        g_objedit_count [ playerid ],
        g_objedit_data [ playerid ] [ s ] [ oe_attached ],
        g_objedit_data [ playerid ] [ s ] [ oe_x ],
        g_objedit_data [ playerid ] [ s ] [ oe_y ],
        g_objedit_data [ playerid ] [ s ] [ oe_z ],
        g_objedit_data [ playerid ] [ s ] [ oe_rx ],
        g_objedit_data [ playerid ] [ s ] [ oe_ry ],
        g_objedit_data [ playerid ] [ s ] [ oe_rz ],
        g_objedit_data [ playerid ] [ s ] [ oe_scale ],
        g_objedit_project [ playerid ] ) ;
    SendClientMessage ( playerid, col_gray, payload ) ;
    return 1 ;
}

stock objedit_reapply ( playerid, s )
{
    if ( s < 0 || s >= OBJEDIT_MAX_OBJECTS ) return 0 ;
    if ( g_objedit_data [ playerid ] [ s ] [ oe_model ] <= 0 ) return 0 ;
    if ( g_objedit_data [ playerid ] [ s ] [ oe_object ] == 0 || ! IsValidDynamicObject ( g_objedit_data [ playerid ] [ s ] [ oe_object ] ) )
    {
        new STREAMER_TAG_OBJECT:nobj = CreateDynamicObject (
            g_objedit_data [ playerid ] [ s ] [ oe_model ],
            g_objedit_data [ playerid ] [ s ] [ oe_x ],
            g_objedit_data [ playerid ] [ s ] [ oe_y ],
            g_objedit_data [ playerid ] [ s ] [ oe_z ],
            g_objedit_data [ playerid ] [ s ] [ oe_rx ],
            g_objedit_data [ playerid ] [ s ] [ oe_ry ],
            g_objedit_data [ playerid ] [ s ] [ oe_rz ],
            g_objedit_data [ playerid ] [ s ] [ oe_world ],
            g_objedit_data [ playerid ] [ s ] [ oe_interior ], -1, 300.0, 300.0 ) ;
        if ( nobj == STREAMER_TAG_OBJECT:0 ) return 0 ;
        g_objedit_data [ playerid ] [ s ] [ oe_object ] = _:nobj ;
    }

    new parent = g_objedit_data [ playerid ] [ s ] [ oe_attached ] - 1 ;
    if ( parent >= 0 && parent < g_objedit_count [ playerid ] && g_objedit_data [ playerid ] [ parent ] [ oe_object ] != 0 && IsValidDynamicObject ( g_objedit_data [ playerid ] [ parent ] [ oe_object ] ) )
    {
        AttachDynamicObjectToObject ( g_objedit_data [ playerid ] [ s ] [ oe_object ], g_objedit_data [ playerid ] [ parent ] [ oe_object ],
            g_objedit_data [ playerid ] [ s ] [ oe_offx ],
            g_objedit_data [ playerid ] [ s ] [ oe_offy ],
            g_objedit_data [ playerid ] [ s ] [ oe_offz ],
            g_objedit_data [ playerid ] [ s ] [ oe_rx ],
            g_objedit_data [ playerid ] [ s ] [ oe_ry ],
            g_objedit_data [ playerid ] [ s ] [ oe_rz ], 1 ) ;
    }
    else
    {
        SetDynamicObjectPos ( g_objedit_data [ playerid ] [ s ] [ oe_object ],
            g_objedit_data [ playerid ] [ s ] [ oe_x ],
            g_objedit_data [ playerid ] [ s ] [ oe_y ],
            g_objedit_data [ playerid ] [ s ] [ oe_z ] ) ;
        SetDynamicObjectRot ( g_objedit_data [ playerid ] [ s ] [ oe_object ],
            g_objedit_data [ playerid ] [ s ] [ oe_rx ],
            g_objedit_data [ playerid ] [ s ] [ oe_ry ],
            g_objedit_data [ playerid ] [ s ] [ oe_rz ] ) ;
    }
    return 1 ;
}


stock objedit_project_index_path ( idx, dest [ ], size = sizeof dest )
{
    format ( dest, size, "obj_list_%d.dat", idx ) ;
    return 1 ;
}

stock objedit_chomp ( text [ ] )
{
    new len = strlen ( text ) ;
    while ( len > 0 && ( text [ len - 1 ] == '\n' || text [ len - 1 ] == '\r' ) )
    {
        text [ len - 1 ] = EOS ;
        len -- ;
    }
    return 1 ;
}

stock objedit_register_project ( project [ ] )
{
    new path [ 96 ], pname [ 64 ] ;
    for ( new i = 0 ; i < 50 ; i ++ )
    {
        objedit_project_index_path ( i, path, sizeof path ) ;
        if ( fexist ( path ) )
        {
            new File:r = fopen ( path, io_read ) ;
            if ( r )
            {
                fread ( r, pname, sizeof pname ) ;
                fclose ( r ) ;
                objedit_chomp ( pname ) ;
                if ( ! strcmp ( pname, project, true ) ) return 1 ;
            }
        }
        else
        {
            new File:w = fopen ( path, io_write ) ;
            if ( w ) { fwrite ( w, project ) ; fclose ( w ) ; }
            return 1 ;
        }
    }
    return 1 ;
}

stock objedit_project_dat_path ( project [ ], dest [ ], size = sizeof dest )
{
    format ( dest, size, "%s.dat", project ) ;
    return 1 ;
}

stock objedit_project_txt_path ( project [ ], dest [ ], size = sizeof dest )
{
    format ( dest, size, "%s.txt", project ) ;
    return 1 ;
}

stock objedit_save_project_dat ( playerid )
{
    if ( ! g_objedit_active [ playerid ] || g_objedit_count [ playerid ] <= 0 ) return 0 ;
    new path [ 128 ], line [ 256 ] ;
    objedit_project_dat_path ( g_objedit_project [ playerid ], path, sizeof path ) ;
    new File:w = fopen ( path, io_write ) ;
    if ( ! w ) return 0 ;
    for ( new i = 0 ; i < g_objedit_count [ playerid ] ; i ++ )
    {
        format ( line, sizeof line, "%d %.4f %.4f %.4f %.2f %.2f %.2f %.2f %d %.4f %.4f %.4f %d %d\r\n",
            g_objedit_data [ playerid ] [ i ] [ oe_model ],
            g_objedit_data [ playerid ] [ i ] [ oe_x ],
            g_objedit_data [ playerid ] [ i ] [ oe_y ],
            g_objedit_data [ playerid ] [ i ] [ oe_z ],
            g_objedit_data [ playerid ] [ i ] [ oe_rx ],
            g_objedit_data [ playerid ] [ i ] [ oe_ry ],
            g_objedit_data [ playerid ] [ i ] [ oe_rz ],
            g_objedit_data [ playerid ] [ i ] [ oe_scale ],
            g_objedit_data [ playerid ] [ i ] [ oe_attached ],
            g_objedit_data [ playerid ] [ i ] [ oe_offx ],
            g_objedit_data [ playerid ] [ i ] [ oe_offy ],
            g_objedit_data [ playerid ] [ i ] [ oe_offz ],
            g_objedit_data [ playerid ] [ i ] [ oe_world ],
            g_objedit_data [ playerid ] [ i ] [ oe_interior ] ) ;
        fwrite ( w, line ) ;
    }
    fclose ( w ) ;
    objedit_register_project ( g_objedit_project [ playerid ] ) ;
    return 1 ;
}

stock objedit_reload_static ( )
{
    objedit_destroy_static_all ( ) ;
    objedit_load_all_perm_projects ( ) ;
    return 1 ;
}

stock objedit_open_project ( playerid, project [ ] )
{
    new tmp [ 64 ] ;
    format ( tmp, sizeof tmp, "%s", project ) ;
    objedit_reset_player ( playerid ) ;
    objedit_clean_project_name ( tmp, g_objedit_project [ playerid ], sizeof ( g_objedit_project [ ] ) ) ;
    objedit_destroy_static_project ( g_objedit_project [ playerid ] ) ;
    g_objedit_active [ playerid ] = true ;

    new path [ 128 ] ;
    objedit_project_dat_path ( g_objedit_project [ playerid ], path, sizeof path ) ;
    if ( ! fexist ( path ) ) return 1 ;
    new File:r = fopen ( path, io_read ) ;
    if ( ! r ) return 1 ;

    new line [ 256 ], model, attached, world, interior, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, Float:scale, Float:offx, Float:offy, Float:offz ;
    while ( fread ( r, line, sizeof line ) && g_objedit_count [ playerid ] < OBJEDIT_MAX_OBJECTS )
    {
        if ( sscanf ( line, "dfffffffdfffdd", model, x, y, z, rx, ry, rz, scale, attached, offx, offy, offz, world, interior ) ) continue ;
        new s = g_objedit_count [ playerid ] ;
        new STREAMER_TAG_OBJECT:obj = CreateDynamicObject ( model, x, y, z, rx, ry, rz, world, interior, -1, 300.0, 300.0 ) ;
        if ( obj == STREAMER_TAG_OBJECT:0 ) continue ;
        g_objedit_data [ playerid ] [ s ] [ oe_model ] = model ;
        g_objedit_data [ playerid ] [ s ] [ oe_object ] = _:obj ;
        g_objedit_data [ playerid ] [ s ] [ oe_attached ] = attached ;
        g_objedit_data [ playerid ] [ s ] [ oe_world ] = world ;
        g_objedit_data [ playerid ] [ s ] [ oe_interior ] = interior ;
        g_objedit_data [ playerid ] [ s ] [ oe_x ] = x ;
        g_objedit_data [ playerid ] [ s ] [ oe_y ] = y ;
        g_objedit_data [ playerid ] [ s ] [ oe_z ] = z ;
        g_objedit_data [ playerid ] [ s ] [ oe_rx ] = rx ;
        g_objedit_data [ playerid ] [ s ] [ oe_ry ] = ry ;
        g_objedit_data [ playerid ] [ s ] [ oe_rz ] = rz ;
        g_objedit_data [ playerid ] [ s ] [ oe_scale ] = scale ;
        g_objedit_data [ playerid ] [ s ] [ oe_offx ] = offx ;
        g_objedit_data [ playerid ] [ s ] [ oe_offy ] = offy ;
        g_objedit_data [ playerid ] [ s ] [ oe_offz ] = offz ;
        g_objedit_count [ playerid ] ++ ;
    }
    fclose ( r ) ;
    for ( new i = 0 ; i < g_objedit_count [ playerid ] ; i ++ ) objedit_reapply ( playerid, i ) ;
    if ( g_objedit_count [ playerid ] > 0 ) g_objedit_current [ playerid ] = 0 ;
    return 1 ;
}

stock objedit_unregister_project ( project [ ] )
{
    new path [ 96 ], pname [ 64 ] ;
    for ( new i = 0 ; i < 50 ; i ++ )
    {
        objedit_project_index_path ( i, path, sizeof path ) ;
        if ( ! fexist ( path ) ) continue ;
        new File:r = fopen ( path, io_read ) ;
        if ( ! r ) continue ;
        fread ( r, pname, sizeof pname ) ;
        fclose ( r ) ;
        objedit_chomp ( pname ) ;
        if ( ! strcmp ( pname, project, true ) )
        {
            fremove ( path ) ;
            return 1 ;
        }
    }
    return 0 ;
}

stock objedit_delete_project ( playerid, idx )
{
    new path [ 96 ], pname [ 64 ] ;
    objedit_project_index_path ( idx, path, sizeof path ) ;
    if ( ! fexist ( path ) ) return 0 ;
    new File:r = fopen ( path, io_read ) ;
    if ( ! r ) return 0 ;
    fread ( r, pname, sizeof pname ) ;
    fclose ( r ) ;
    objedit_chomp ( pname ) ;
    if ( strlen ( pname ) < 1 ) return 0 ;
    new dpath [ 128 ], tpath [ 128 ] ;
    objedit_project_dat_path ( pname, dpath, sizeof dpath ) ;
    objedit_project_txt_path ( pname, tpath, sizeof tpath ) ;
    if ( fexist ( dpath ) ) fremove ( dpath ) ;
    if ( fexist ( tpath ) ) fremove ( tpath ) ;
    fremove ( path ) ;
    objedit_reset_player ( playerid ) ;
    objedit_reload_static ( ) ;
    return 1 ;
}

stock objedit_show_project_menu ( playerid )
{
    new list [ 2048 ], path [ 96 ], pname [ 64 ], line [ 96 ], shown ;
    list [ 0 ] = EOS ;
    for ( new m = 0 ; m < 50 ; m ++ ) g_objedit_menu_index [ playerid ] [ m ] = -1 ;
    strcat ( list, "Create new project\n", sizeof list ) ;
    for ( new i = 0 ; i < 50 ; i ++ )
    {
        objedit_project_index_path ( i, path, sizeof path ) ;
        if ( ! fexist ( path ) ) continue ;
        new File:r = fopen ( path, io_read ) ;
        if ( ! r ) continue ;
        fread ( r, pname, sizeof pname ) ;
        fclose ( r ) ;
        objedit_chomp ( pname ) ;
        if ( strlen ( pname ) < 1 ) continue ;
        new dpath [ 128 ] ;
        objedit_project_dat_path ( pname, dpath, sizeof dpath ) ;
        if ( ! fexist ( dpath ) ) continue ;
        g_objedit_menu_index [ playerid ] [ shown ] = i ;
        shown ++ ;
        format ( line, sizeof line, "%s\n", pname ) ;
        strcat ( list, line, sizeof list ) ;
    }
    show_dialog ( playerid, d_object_project_list, DIALOG_STYLE_LIST, "Object Projects", list, "Select", "Delete" ) ;
    return 1 ;
}

stock objedit_save_undo ( playerid )
{
    new s = objedit_get_current ( playerid ) ;
    if ( s == -1 ) return 0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_undo_x ] = g_objedit_data [ playerid ] [ s ] [ oe_x ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_undo_y ] = g_objedit_data [ playerid ] [ s ] [ oe_y ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_undo_z ] = g_objedit_data [ playerid ] [ s ] [ oe_z ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_undo_rx ] = g_objedit_data [ playerid ] [ s ] [ oe_rx ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_undo_ry ] = g_objedit_data [ playerid ] [ s ] [ oe_ry ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_undo_rz ] = g_objedit_data [ playerid ] [ s ] [ oe_rz ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_undo_scale ] = g_objedit_data [ playerid ] [ s ] [ oe_scale ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_has_undo ] = 1 ;
    return 1 ;
}

stock objedit_apply_undo ( playerid )
{
    new s = objedit_get_current ( playerid ) ;
    if ( s == -1 ) return 1 ;
    if ( ! g_objedit_data [ playerid ] [ s ] [ oe_has_undo ] ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}No previous object movement." ) ;
    g_objedit_data [ playerid ] [ s ] [ oe_x ] = g_objedit_data [ playerid ] [ s ] [ oe_undo_x ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_y ] = g_objedit_data [ playerid ] [ s ] [ oe_undo_y ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_z ] = g_objedit_data [ playerid ] [ s ] [ oe_undo_z ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_rx ] = g_objedit_data [ playerid ] [ s ] [ oe_undo_rx ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_ry ] = g_objedit_data [ playerid ] [ s ] [ oe_undo_ry ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_rz ] = g_objedit_data [ playerid ] [ s ] [ oe_undo_rz ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_scale ] = g_objedit_data [ playerid ] [ s ] [ oe_undo_scale ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_has_undo ] = 0 ;
    objedit_reapply ( playerid, s ) ;
    Streamer_Update ( playerid ) ;
    objedit_push_overlay ( playerid ) ;
    SendClientMessage ( playerid, col_gray, "~OBJEDIT~STATUS|Undo applied" ) ;
    return 1 ;
}

stock objedit_destroy_static_project ( project [ ] )
{
    for ( new i = 0 ; i < g_objedit_static_count ; i ++ )
    {
        if ( g_objedit_static_ids [ i ] != 0 && ! strcmp ( g_objedit_static_proj [ i ], project, true ) )
        {
            if ( IsValidDynamicObject ( g_objedit_static_ids [ i ] ) ) DestroyDynamicObject ( g_objedit_static_ids [ i ] ) ;
            g_objedit_static_ids [ i ] = 0 ;
            g_objedit_static_proj [ i ] [ 0 ] = EOS ;
        }
    }
    new w = 0 ;
    for ( new i = 0 ; i < g_objedit_static_count ; i ++ )
    {
        if ( g_objedit_static_ids [ i ] == 0 ) continue ;
        if ( w != i )
        {
            g_objedit_static_ids [ w ] = g_objedit_static_ids [ i ] ;
            format ( g_objedit_static_proj [ w ], 64, "%s", g_objedit_static_proj [ i ] ) ;
            g_objedit_static_ids [ i ] = 0 ;
            g_objedit_static_proj [ i ] [ 0 ] = EOS ;
        }
        w ++ ;
    }
    g_objedit_static_count = w ;
    return 1 ;
}

stock objedit_destroy_static_all ( )
{
    for ( new i = 0 ; i < g_objedit_static_count ; i ++ )
    {
        if ( g_objedit_static_ids [ i ] != 0 && IsValidDynamicObject ( g_objedit_static_ids [ i ] ) )
        {
            DestroyDynamicObject ( g_objedit_static_ids [ i ] ) ;
        }
        g_objedit_static_ids [ i ] = 0 ;
        g_objedit_static_proj [ i ] [ 0 ] = EOS ;
    }
    g_objedit_static_count = 0 ;
    return 1 ;
}

stock objedit_load_dat_static ( project [ ] )
{
    new path [ 128 ] ;
    objedit_project_dat_path ( project, path, sizeof path ) ;
    if ( ! fexist ( path ) ) return 0 ;
    new File:r = fopen ( path, io_read ) ;
    if ( ! r ) return 0 ;
    new line [ 256 ], model, attached, world, interior, loaded, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, Float:scale, Float:offx, Float:offy, Float:offz ;
    #pragma unused attached
    #pragma unused scale
    #pragma unused offx
    #pragma unused offy
    #pragma unused offz
    while ( fread ( r, line, sizeof line ) )
    {
        if ( sscanf ( line, "dfffffffdfffdd", model, x, y, z, rx, ry, rz, scale, attached, offx, offy, offz, world, interior ) ) continue ;
        new STREAMER_TAG_OBJECT:sobj = CreateDynamicObject ( model, x, y, z, rx, ry, rz, world, interior, -1, 300.0, 300.0 ) ;
        if ( sobj != STREAMER_TAG_OBJECT:0 && g_objedit_static_count < OBJEDIT_MAX_STATIC )
        {
            g_objedit_static_ids [ g_objedit_static_count ] = _:sobj ;
            format ( g_objedit_static_proj [ g_objedit_static_count ], 64, "%s", project ) ;
            g_objedit_static_count ++ ;
        }
        loaded ++ ;
    }
    fclose ( r ) ;
    return loaded ;
}

stock objedit_load_all_perm_projects ( )
{
    new path [ 96 ], pname [ 64 ], loaded_total ;
    for ( new i = 0 ; i < 50 ; i ++ )
    {
        objedit_project_index_path ( i, path, sizeof path ) ;
        if ( ! fexist ( path ) ) continue ;
        new File:r = fopen ( path, io_read ) ;
        if ( ! r ) continue ;
        fread ( r, pname, sizeof pname ) ;
        fclose ( r ) ;
        objedit_chomp ( pname ) ;
        if ( strlen ( pname ) > 0 ) loaded_total += objedit_load_dat_static ( pname ) ;
    }
    printf ( "[ObjEditor] Loaded %d permanent objects from txt projects.", loaded_total ) ;
    return 1 ;
}

stock objedit_move ( playerid, Float:dx, Float:dy, Float:dz, use_facing = 0 )
{
    new s = objedit_get_current ( playerid ) ;
    if ( s == -1 ) return 1 ;
    objedit_save_undo ( playerid ) ;

    if ( use_facing )
    {
        new Float:a ;
        GetPlayerFacingAngle ( playerid, a ) ;
        new Float:fx = floatsin ( -a, degrees ) ;
        new Float:fy = floatcos ( -a, degrees ) ;
        new Float:rx = floatcos ( a, degrees ) ;
        new Float:ry = floatsin ( a, degrees ) ;
        g_objedit_data [ playerid ] [ s ] [ oe_x ] += ( fx * dy ) + ( rx * dx ) ;
        g_objedit_data [ playerid ] [ s ] [ oe_y ] += ( fy * dy ) + ( ry * dx ) ;
    }
    else
    {
        g_objedit_data [ playerid ] [ s ] [ oe_x ] += dx ;
        g_objedit_data [ playerid ] [ s ] [ oe_y ] += dy ;
    }
    g_objedit_data [ playerid ] [ s ] [ oe_z ] += dz ;

    if ( g_objedit_data [ playerid ] [ s ] [ oe_attached ] > 0 )
    {
        g_objedit_data [ playerid ] [ s ] [ oe_offx ] += dx ;
        g_objedit_data [ playerid ] [ s ] [ oe_offy ] += dy ;
        g_objedit_data [ playerid ] [ s ] [ oe_offz ] += dz ;
    }

    objedit_reapply ( playerid, s ) ;
    Streamer_Update ( playerid ) ;
    objedit_push_overlay ( playerid ) ;
    return 1 ;
}

stock objedit_rotate ( playerid, Float:drx, Float:dry, Float:drz )
{
    new s = objedit_get_current ( playerid ) ;
    if ( s == -1 ) return 1 ;
    objedit_save_undo ( playerid ) ;
    g_objedit_data [ playerid ] [ s ] [ oe_rx ] += drx ;
    g_objedit_data [ playerid ] [ s ] [ oe_ry ] += dry ;
    g_objedit_data [ playerid ] [ s ] [ oe_rz ] += drz ;
    while ( g_objedit_data [ playerid ] [ s ] [ oe_rx ] >= 360.0 ) g_objedit_data [ playerid ] [ s ] [ oe_rx ] -= 360.0 ;
    while ( g_objedit_data [ playerid ] [ s ] [ oe_ry ] >= 360.0 ) g_objedit_data [ playerid ] [ s ] [ oe_ry ] -= 360.0 ;
    while ( g_objedit_data [ playerid ] [ s ] [ oe_rz ] >= 360.0 ) g_objedit_data [ playerid ] [ s ] [ oe_rz ] -= 360.0 ;
    objedit_reapply ( playerid, s ) ;
    Streamer_Update ( playerid ) ;
    objedit_push_overlay ( playerid ) ;
    return 1 ;
}

stock objedit_scale ( playerid, Float:ds )
{
    new s = objedit_get_current ( playerid ) ;
    if ( s == -1 ) return 1 ;
    objedit_save_undo ( playerid ) ;
    g_objedit_data [ playerid ] [ s ] [ oe_scale ] += ds ;
    if ( g_objedit_data [ playerid ] [ s ] [ oe_scale ] < 0.20 ) g_objedit_data [ playerid ] [ s ] [ oe_scale ] = 0.20 ;
    if ( g_objedit_data [ playerid ] [ s ] [ oe_scale ] > 5.00 ) g_objedit_data [ playerid ] [ s ] [ oe_scale ] = 5.00 ;
    objedit_push_overlay ( playerid ) ;
    SendClientMessage ( playerid, col_gray, "~OBJEDIT~STATUS| „  ⁄œÌ· ﬁÌ„… «·ÕÃ„ ··Õ›Ÿ ›Ì «·„·›" ) ;
    return 1 ;
}

stock objedit_create_object ( playerid, modelid )
{
    if ( ! g_objedit_active [ playerid ] ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«ﬂ » /object √Ê·« Ê÷⁄ «”„ «·„‘—Ê⁄." ) ;
    if ( modelid < 1 || modelid > 20000 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}ID «·√Ê»Ãﬂ  €Ì— ’«·Õ." ) ;
    if ( g_objedit_count [ playerid ] >= OBJEDIT_MAX_OBJECTS ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}Ê’·  ··Õœ «·√ﬁ’Ï ·Â–« «·„‘—Ê⁄. «Õ›Ÿ «·„‘—Ê⁄ À„ «»œ√ „‘—Ê⁄ ÃœÌœ." ) ;

    new Float:x, Float:y, Float:z, Float:a ;
    GetPlayerPos ( playerid, x, y, z ) ;
    GetPlayerFacingAngle ( playerid, a ) ;
    x += floatsin ( -a, degrees ) * 3.0 ;
    y += floatcos ( -a, degrees ) * 3.0 ;

    new s = g_objedit_count [ playerid ] ;
    new world = GetPlayerVirtualWorld ( playerid ) ;
    new interior = GetPlayerInterior ( playerid ) ;
    new STREAMER_TAG_OBJECT:obj = CreateDynamicObject ( modelid, x, y, z, 0.0, 0.0, a, world, interior, -1, 300.0, 300.0 ) ;
    if ( obj == STREAMER_TAG_OBJECT:0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"} ⁄–— ≈‰‘«¡ «·√Ê»Ãﬂ ." ) ;

    g_objedit_data [ playerid ] [ s ] [ oe_model ] = modelid ;
    g_objedit_data [ playerid ] [ s ] [ oe_object ] = _:obj ;
    g_objedit_data [ playerid ] [ s ] [ oe_attached ] = 0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_world ] = world ;
    g_objedit_data [ playerid ] [ s ] [ oe_interior ] = interior ;
    g_objedit_data [ playerid ] [ s ] [ oe_x ] = x ;
    g_objedit_data [ playerid ] [ s ] [ oe_y ] = y ;
    g_objedit_data [ playerid ] [ s ] [ oe_z ] = z ;
    g_objedit_data [ playerid ] [ s ] [ oe_rx ] = 0.0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_ry ] = 0.0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_rz ] = a ;
    g_objedit_data [ playerid ] [ s ] [ oe_scale ] = 1.0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_offx ] = 0.0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_offy ] = 0.0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_offz ] = 0.0 ;

    g_objedit_count [ playerid ] ++ ;
    g_objedit_current [ playerid ] = s ;
    objedit_push_overlay ( playerid ) ;
    SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „ ≈÷«›… «·√Ê»Ãﬂ . «” Œœ„ «·ﬁ«∆„… ·· Õﬂ„ Ê«·Õ›Ÿ." ) ;
    return 1 ;
}

stock objedit_attach_current ( playerid )
{
    new s = objedit_get_current ( playerid ) ;
    if ( s == -1 ) return 1 ;
    if ( g_objedit_count [ playerid ] < 2 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}√÷› √Ê»Ãﬂ  À«‰Ì √Ê·« Õ Ï  ﬁœ—  À» Â." ) ;

    new Float:best = 99999.0, bestslot = -1 ;
    for ( new i = 0 ; i < g_objedit_count [ playerid ] ; i ++ )
    {
        if ( i == s ) continue ;
        if ( g_objedit_data [ playerid ] [ i ] [ oe_object ] == 0 ) continue ;
        new Float:d = floatsqroot ( floatpower ( g_objedit_data [ playerid ] [ s ] [ oe_x ] - g_objedit_data [ playerid ] [ i ] [ oe_x ], 2.0 ) + floatpower ( g_objedit_data [ playerid ] [ s ] [ oe_y ] - g_objedit_data [ playerid ] [ i ] [ oe_y ], 2.0 ) + floatpower ( g_objedit_data [ playerid ] [ s ] [ oe_z ] - g_objedit_data [ playerid ] [ i ] [ oe_z ], 2.0 ) ) ;
        if ( d < best ) { best = d ; bestslot = i ; }
    }
    if ( bestslot == -1 || best > 8.0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}·« ÌÊÃœ √Ê»Ãﬂ  ﬁ—Ì» ·· À»Ì  ⁄·ÌÂ." ) ;

    g_objedit_data [ playerid ] [ s ] [ oe_attached ] = bestslot + 1 ;
    g_objedit_data [ playerid ] [ s ] [ oe_offx ] = g_objedit_data [ playerid ] [ s ] [ oe_x ] - g_objedit_data [ playerid ] [ bestslot ] [ oe_x ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_offy ] = g_objedit_data [ playerid ] [ s ] [ oe_y ] - g_objedit_data [ playerid ] [ bestslot ] [ oe_y ] ;
    g_objedit_data [ playerid ] [ s ] [ oe_offz ] = g_objedit_data [ playerid ] [ s ] [ oe_z ] - g_objedit_data [ playerid ] [ bestslot ] [ oe_z ] ;
    objedit_reapply ( playerid, s ) ;
    Streamer_Update ( playerid ) ;
    objedit_push_overlay ( playerid ) ;
    SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „  À»Ì  «·√Ê»Ãﬂ  ›Êﬁ √ﬁ—» √Ê»Ãﬂ ." ) ;
    return 1 ;
}

stock objedit_detach_current ( playerid )
{
    new s = objedit_get_current ( playerid ) ;
    if ( s == -1 ) return 1 ;
    if ( g_objedit_data [ playerid ] [ s ] [ oe_attached ] == 0 ) return 1 ;

    new model = g_objedit_data [ playerid ] [ s ] [ oe_model ] ;
    new oldobj = g_objedit_data [ playerid ] [ s ] [ oe_object ] ;
    if ( oldobj != 0 && IsValidDynamicObject ( oldobj ) ) DestroyDynamicObject ( oldobj ) ;
    g_objedit_data [ playerid ] [ s ] [ oe_object ] = CreateDynamicObject ( model,
        g_objedit_data [ playerid ] [ s ] [ oe_x ],
        g_objedit_data [ playerid ] [ s ] [ oe_y ],
        g_objedit_data [ playerid ] [ s ] [ oe_z ],
        g_objedit_data [ playerid ] [ s ] [ oe_rx ],
        g_objedit_data [ playerid ] [ s ] [ oe_ry ],
        g_objedit_data [ playerid ] [ s ] [ oe_rz ],
        g_objedit_data [ playerid ] [ s ] [ oe_world ],
        g_objedit_data [ playerid ] [ s ] [ oe_interior ], -1, 300.0, 300.0 ) ;
    g_objedit_data [ playerid ] [ s ] [ oe_attached ] = 0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_offx ] = 0.0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_offy ] = 0.0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_offz ] = 0.0 ;
    objedit_push_overlay ( playerid ) ;
    SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „ ›ﬂ  À»Ì  «·√Ê»Ãﬂ ." ) ;
    return 1 ;
}

stock objedit_delete_current ( playerid )
{
    new s = objedit_get_current ( playerid ) ;
    if ( s == -1 ) return 1 ;
    if ( g_objedit_data [ playerid ] [ s ] [ oe_object ] != 0 && IsValidDynamicObject ( g_objedit_data [ playerid ] [ s ] [ oe_object ] ) ) DestroyDynamicObject ( g_objedit_data [ playerid ] [ s ] [ oe_object ] ) ;
    for ( new i = s ; i < g_objedit_count [ playerid ] - 1 ; i ++ )
    {
        for ( new E_OBJEDIT_DATA:e ; e < E_OBJEDIT_DATA ; e ++ ) g_objedit_data [ playerid ] [ i ] [ e ] = g_objedit_data [ playerid ] [ i + 1 ] [ e ] ;
    }
    g_objedit_count [ playerid ] -- ;
    if ( g_objedit_count [ playerid ] < 0 ) g_objedit_count [ playerid ] = 0 ;
    for ( new i = 0 ; i < g_objedit_count [ playerid ] ; i ++ )
    {
        if ( g_objedit_data [ playerid ] [ i ] [ oe_attached ] == s + 1 ) g_objedit_data [ playerid ] [ i ] [ oe_attached ] = 0 ;
        else if ( g_objedit_data [ playerid ] [ i ] [ oe_attached ] > s + 1 ) g_objedit_data [ playerid ] [ i ] [ oe_attached ] -- ;
    }
    if ( g_objedit_count [ playerid ] == 0 )
    {
        g_objedit_current [ playerid ] = -1 ;
        SendClientMessage ( playerid, col_gray, "~OBJEDIT~HIDE" ) ;
    }
    else
    {
        if ( s >= g_objedit_count [ playerid ] ) s = g_objedit_count [ playerid ] - 1 ;
        g_objedit_current [ playerid ] = s ;
        objedit_push_overlay ( playerid ) ;
    }
    SendClientMessage ( playerid, col_white, "{"#cGN"}* {"#cWH"} „ Õ–› «·√Ê»Ãﬂ  „‰ «·„‘—Ê⁄." ) ;
    return 1 ;
}

stock objedit_save_project ( playerid )
{
    if ( ! g_objedit_active [ playerid ] || g_objedit_count [ playerid ] <= 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}·« ÌÊÃœ „‘—Ê⁄ √Ê √Ê»Ãﬂ «  ··Õ›Ÿ." ) ;

    new filename [ 128 ] ;
    objedit_project_txt_path ( g_objedit_project [ playerid ], filename, sizeof filename ) ;
    new File:f = fopen ( filename, io_write ) ;
    if ( ! f ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"} ⁄–— ≈‰‘«¡ „·› TXT œ«Œ· scriptfiles." ) ;

    new line [ 256 ] ;
    format ( line, sizeof line, "„‘—Ê⁄ „Õ—— «·√Ê»Ãﬂ « : %s\r\n", g_objedit_project [ playerid ] ) ; fwrite ( f, line ) ;
    format ( line, sizeof line, "’«Õ» «·„‘—Ê⁄: %s | Õ”«» ID: %d\r\n", p_info [ playerid ] [ name ], p_info [ playerid ] [ id ] ) ; fwrite ( f, line ) ;
    format ( line, sizeof line, "⁄œœ «·√Ê»Ãﬂ « : %d\r\n\r\n", g_objedit_count [ playerid ] ) ; fwrite ( f, line ) ;
    fwrite ( f, "«· — Ì» | Object ID | «”„ «·√Ê»Ãﬂ  | X | Y | Z | RX | RY | RZ | Scale | „À»  ›Êﬁ | OffsetX | OffsetY | OffsetZ | Interior | World\r\n" ) ;

    for ( new i = 0 ; i < g_objedit_count [ playerid ] ; i ++ )
    {
        new parent = g_objedit_data [ playerid ] [ i ] [ oe_attached ] ;
        new parent_model = 0 ;
        if ( parent > 0 && parent - 1 < g_objedit_count [ playerid ] ) parent_model = g_objedit_data [ playerid ] [ parent - 1 ] [ oe_model ] ;
        format ( line, sizeof line, "%d | %d | Object_%d | %.4f | %.4f | %.4f | %.2f | %.2f | %.2f | %.2f | %s%d Object_%d | %.4f | %.4f | %.4f | %d | %d\r\n",
            i + 1,
            g_objedit_data [ playerid ] [ i ] [ oe_model ],
            g_objedit_data [ playerid ] [ i ] [ oe_model ],
            g_objedit_data [ playerid ] [ i ] [ oe_x ],
            g_objedit_data [ playerid ] [ i ] [ oe_y ],
            g_objedit_data [ playerid ] [ i ] [ oe_z ],
            g_objedit_data [ playerid ] [ i ] [ oe_rx ],
            g_objedit_data [ playerid ] [ i ] [ oe_ry ],
            g_objedit_data [ playerid ] [ i ] [ oe_rz ],
            g_objedit_data [ playerid ] [ i ] [ oe_scale ],
            parent > 0 ? "‰⁄„: #" : "·«: #",
            parent,
            parent_model,
            g_objedit_data [ playerid ] [ i ] [ oe_offx ],
            g_objedit_data [ playerid ] [ i ] [ oe_offy ],
            g_objedit_data [ playerid ] [ i ] [ oe_offz ],
            g_objedit_data [ playerid ] [ i ] [ oe_interior ],
            g_objedit_data [ playerid ] [ i ] [ oe_world ] ) ;
        fwrite ( f, line ) ;
    }

    fwrite ( f, "\r\nﬂÊœ SA-MP Ã«Â“:\r\n" ) ;
    for ( new i = 0 ; i < g_objedit_count [ playerid ] ; i ++ )
    {
        format ( line, sizeof line, "CreateDynamicObject(%d, %.4f, %.4f, %.4f, %.2f, %.2f, %.2f, %d, %d, -1, 300.0, 300.0);\r\n",
            g_objedit_data [ playerid ] [ i ] [ oe_model ],
            g_objedit_data [ playerid ] [ i ] [ oe_x ],
            g_objedit_data [ playerid ] [ i ] [ oe_y ],
            g_objedit_data [ playerid ] [ i ] [ oe_z ],
            g_objedit_data [ playerid ] [ i ] [ oe_rx ],
            g_objedit_data [ playerid ] [ i ] [ oe_ry ],
            g_objedit_data [ playerid ] [ i ] [ oe_rz ],
            g_objedit_data [ playerid ] [ i ] [ oe_world ],
            g_objedit_data [ playerid ] [ i ] [ oe_interior ] ) ;
        fwrite ( f, line ) ;
    }
    fclose ( f ) ;

    objedit_save_project_dat ( playerid ) ;
    format ( line, sizeof line, "{"#cGN"}* {"#cWH"} „ Õ›Ÿ „‘—Ê⁄ «·√Ê»Ãﬂ «  ›Ì scriptfiles/%s", filename ) ;
    SendClientMessage ( playerid, col_white, line ) ;
    SendClientMessage ( playerid, col_gray, "~OBJEDIT~STATUS| „ Õ›Ÿ „·› TXT »‰Ã«Õ" ) ;
    return 1 ;
}


stock objedit_send_static_scales ( playerid )
{
    if ( ! g_objedit_active [ playerid ] ) return 0 ;
    for ( new i = 0 ; i < g_objedit_count [ playerid ] ; i ++ )
    {
        new Float:sc = g_objedit_data [ playerid ] [ i ] [ oe_scale ] ;
        if ( sc < 0.99 || sc > 1.01 )
        {
            new msg [ 256 ] ;
            format ( msg, sizeof msg, "~OBJEDIT~SCALE|%d|%.4f|%.4f|%.4f|%.2f",
                g_objedit_data [ playerid ] [ i ] [ oe_model ],
                g_objedit_data [ playerid ] [ i ] [ oe_x ],
                g_objedit_data [ playerid ] [ i ] [ oe_y ],
                g_objedit_data [ playerid ] [ i ] [ oe_z ],
                sc ) ;
            SendClientMessage ( playerid, col_gray, msg ) ;
        }
    }
    return 1 ;
}

stock objedit_send_perm_scales ( playerid )
{
    new path [ 96 ], pname [ 64 ] ;
    for ( new pi = 0 ; pi < 50 ; pi ++ )
    {
        objedit_project_index_path ( pi, path, sizeof path ) ;
        if ( ! fexist ( path ) ) continue ;
        new File:r = fopen ( path, io_read ) ;
        if ( ! r ) continue ;
        fread ( r, pname, sizeof pname ) ;
        fclose ( r ) ;
        objedit_chomp ( pname ) ;
        if ( strlen ( pname ) < 1 ) continue ;
        new dpath [ 128 ] ;
        objedit_project_dat_path ( pname, dpath, sizeof dpath ) ;
        if ( ! fexist ( dpath ) ) continue ;
        new File:dr = fopen ( dpath, io_read ) ;
        if ( ! dr ) continue ;
        new line [ 256 ], model, attached, world, interior, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, Float:scale, Float:offx, Float:offy, Float:offz ;
        while ( fread ( dr, line, sizeof line ) )
        {
            if ( sscanf ( line, "dfffffffdfffdd", model, x, y, z, rx, ry, rz, scale, attached, offx, offy, offz, world, interior ) ) continue ;
            if ( scale < 0.99 || scale > 1.01 )
            {
                new msg [ 256 ] ;
                format ( msg, sizeof msg, "~OBJEDIT~SCALE|%d|%.4f|%.4f|%.4f|%.2f", model, x, y, z, scale ) ;
                SendClientMessage ( playerid, col_gray, msg ) ;
            }
        }
        fclose ( dr ) ;
    }
    return 1 ;
}

stock objedit_show_list ( playerid )
{
    if ( ! g_objedit_active [ playerid ] || g_objedit_count [ playerid ] <= 0 ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}·« ÌÊÃœ √Ê»Ãﬂ «  „÷«›… Õ«·Ì«. «” Œœ„ /object À„ /Add." ) ;
    new list [ 2048 ], line [ 128 ] ;
    list [ 0 ] = EOS ;
    for ( new i = 0 ; i < g_objedit_count [ playerid ] ; i ++ )
    {
        format ( line, sizeof line, "#%d - ID:%d | X:%.2f Y:%.2f Z:%.2f%s\n",
            i + 1,
            g_objedit_data [ playerid ] [ i ] [ oe_model ],
            g_objedit_data [ playerid ] [ i ] [ oe_x ],
            g_objedit_data [ playerid ] [ i ] [ oe_y ],
            g_objedit_data [ playerid ] [ i ] [ oe_z ],
            g_objedit_data [ playerid ] [ i ] [ oe_attached ] > 0 ? " | „À» " : "" ) ;
        strcat ( list, line, sizeof list ) ;
    }
    show_dialog ( playerid, d_object_list, DIALOG_STYLE_LIST, "{"#cBL"}ﬁ«∆„… √Ê»Ãﬂ «  «·„‘—Ê⁄", list, " ⁄œÌ·", "≈€·«ﬁ" ) ;
    return 1 ;
}

CMD:eddtadd ( playerid, params [ ] )
{
    #pragma unused params
    if ( ! objedit_is_admin ( playerid ) ) return 1 ;
    if ( ! g_objedit_active [ playerid ] ) return objedit_show_project_menu ( playerid ) ;
    return objedit_show_list ( playerid ) ;
}

CMD:object ( playerid, params [ ] )
{
    #pragma unused params
    if ( ! objedit_is_admin ( playerid ) ) return 1 ;
    show_dialog ( playerid, d_object_project, DIALOG_STYLE_INPUT, "{"#cBL"}„Õ—— «·√Ê»Ãﬂ « ", "{"#cWH"}÷⁄ «”„ «·„‘—Ê⁄ «·–Ì  —Ìœ ≈‰‘«¡Â:\n\n{"#cYW"}„À«·: œÌﬂÊ— „ÿ⁄„", "≈‰‘«¡", "≈·€«¡" ) ;
    return 1 ;
}

CMD:add ( playerid, params [ ] )
{
    if ( ! objedit_is_admin ( playerid ) ) return 1 ;
    new modelid ;
    if ( sscanf ( params, "d", modelid ) ) return SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}«·«” Œœ«„: /Add [ID «·√Ê»Ãﬂ ]" ) ;
    return objedit_create_object ( playerid, modelid ) ;
}

CMD:obj_up     ( playerid, params [ ] ) { if(params[0]){}return objedit_move ( playerid, 0.0, 0.0, 0.10 ) ; }
CMD:obj_dn     ( playerid, params [ ] ) { if(params[0]){}return objedit_move ( playerid, 0.0, 0.0, -0.10 ) ; }
CMD:obj_fw     ( playerid, params [ ] ) { if(params[0]){}return objedit_move ( playerid, 0.0, -0.12, 0.0, 1 ) ; }
CMD:obj_bk     ( playerid, params [ ] ) { if(params[0]){}return objedit_move ( playerid, 0.0, 0.12, 0.0, 1 ) ; }
CMD:obj_left   ( playerid, params [ ] ) { if(params[0]){}return objedit_move ( playerid, 0.12, 0.0, 0.0, 1 ) ; }
CMD:obj_right  ( playerid, params [ ] ) { if(params[0]){}return objedit_move ( playerid, -0.12, 0.0, 0.0, 1 ) ; }
CMD:obj_rx     ( playerid, params [ ] ) { if(params[0]){}return objedit_rotate ( playerid, 10.0, 0.0, 0.0 ) ; }
CMD:obj_ry     ( playerid, params [ ] ) { if(params[0]){}return objedit_rotate ( playerid, 0.0, 10.0, 0.0 ) ; }
CMD:obj_rz     ( playerid, params [ ] ) { if(params[0]){}return objedit_rotate ( playerid, 0.0, 0.0, 10.0 ) ; }
CMD:obj_big    ( playerid, params [ ] ) { if(params[0]){}return objedit_scale ( playerid, 0.10 ) ; }
CMD:obj_sml    ( playerid, params [ ] ) { if(params[0]){}return objedit_scale ( playerid, -0.10 ) ; }
CMD:obj_attach ( playerid, params [ ] ) { if(params[0]){}return objedit_attach_current ( playerid ) ; }
CMD:obj_detach ( playerid, params [ ] ) { if(params[0]){}return objedit_detach_current ( playerid ) ; }
CMD:obj_del    ( playerid, params [ ] ) { if(params[0]){}return objedit_delete_current ( playerid ) ; }
CMD:obj_save   ( playerid, params [ ] ) { if(params[0]){}return objedit_save_project ( playerid ) ; }
CMD:obj_undo   ( playerid, params [ ] ) { if(params[0]){}return objedit_apply_undo ( playerid ) ; }
CMD:obj_perm   ( playerid, params [ ] )
{
    if(params[0]){}
    if ( ! g_objedit_active [ playerid ] || g_objedit_count [ playerid ] <= 0 ) return SendClientMessage ( playerid, col_gray, "{FF3333}* {AAAAAA}¡« ÌÊÃœ „‘—Ê⁄ „› ÊÕ ··Õ›Ÿ «·œ«∆„." ) ;
    new res1 = objedit_save_project_dat ( playerid ) ;
    if ( ! res1 ) return SendClientMessage ( playerid, col_gray, "{FF3333}* {AAAAAA} ⁄–— Õ›Ÿ „·› DAT." ) ;
    objedit_save_project ( playerid ) ;
    objedit_send_static_scales ( playerid ) ;
    new s = g_objedit_current [ playerid ] ;
    if ( s >= 0 && s < g_objedit_count [ playerid ] )
    {
        objedit_reapply ( playerid, s ) ;
        Streamer_Update ( playerid ) ;
        objedit_push_overlay ( playerid ) ;
    }
    SendClientMessage ( playerid, col_white, "{33FF33}* {FFFFFF} „ «·Õ›Ÿ «·œ«∆„ »‰Ã«Õ. «·„‘—Ê⁄ ”Ì Õ„· »⁄œ «·—Ì” «— ." ) ;
    return 1 ;
}
CMD:obj_close  ( playerid, params [ ] ) { if(params[0]){}objedit_reset_player ( playerid ) ; objedit_reload_static ( ) ; return 1 ; }
CMD:obj_rst    ( playerid, params [ ] )
{
    #pragma unused params
    new s = objedit_get_current ( playerid ) ;
    if ( s == -1 ) return 1 ;
    g_objedit_data [ playerid ] [ s ] [ oe_rx ] = 0.0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_ry ] = 0.0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_rz ] = 0.0 ;
    g_objedit_data [ playerid ] [ s ] [ oe_scale ] = 1.0 ;
    objedit_reapply ( playerid, s ) ;
    Streamer_Update ( playerid ) ;
    objedit_push_overlay ( playerid ) ;
    return 1 ;
}
CMD:obj_prev   ( playerid, params [ ] )
{
    #pragma unused params
    if ( g_objedit_count [ playerid ] <= 0 ) return 1 ;
    g_objedit_current [ playerid ] -- ;
    if ( g_objedit_current [ playerid ] < 0 ) g_objedit_current [ playerid ] = g_objedit_count [ playerid ] - 1 ;
    return objedit_push_overlay ( playerid ) ;
}
CMD:obj_next   ( playerid, params [ ] )
{
    #pragma unused params
    if ( g_objedit_count [ playerid ] <= 0 ) return 1 ;
    g_objedit_current [ playerid ] ++ ;
    if ( g_objedit_current [ playerid ] >= g_objedit_count [ playerid ] ) g_objedit_current [ playerid ] = 0 ;
    return objedit_push_overlay ( playerid ) ;
}

// Per-category boundaries.  (start, count) indices into g_acc_models[].
stock accshop_cat_range ( cat, &start, &count )
{
    switch ( cat )
    {
        case  0 : { start =   0 ; count =  4 ; } // ”„«⁄« 
        case  1 : { start =   4 ; count =  6 ; } // ﬁ»⁄« 
        case  2 : { start =  10 ; count =  3 ; } // »‰«„«
        case  3 : { start =  13 ; count = 12 ; } // ﬂ«»« 
        case  4 : { start =  25 ; count =  6 ; } // ŒÊ–« 
        case  5 : { start =  31 ; count =  5 ; } // »Ì—ÌÂ
        case  6 : { start =  36 ; count =  2 ; } // ‘⁄Ê—
        case  7 : { start =  38 ; count = 18 ; } // ‰Ÿ«—« 
        case  8 : { start =  56 ; count = 10 ; } // ⁄’«»«  —√”
        case  9 : { start =  66 ; count =  7 ; } // ﬁ»⁄«  B
        case 10 : { start =  73 ; count = 13 ; } // ”«⁄« 
        case 11 : { start =  86 ; count = 11 ; } // Õﬁ«∆»
        case 12 : { start =  97 ; count =  5 ; } // »«‰œ«‰«”
        case 13 : { start = 102 ; count = 13 ; } // ⁄·Ï «·ŸÂ—
        case 14 : { start = 115 ; count =  4 ; } // ⁄·Ï «·ﬂ ›
        default : { start =   0 ; count = ACC_SHOP_COUNT ; }
    }
}

stock accshop_enter_cat ( playerid, cat )
{
    if ( GetPVarInt ( playerid, "acc_active" ) ) return 1 ;
    if ( GetPVarInt ( playerid, "cl_active"  ) ) return 1 ;
    new biz = GetPVarInt ( playerid, "p_biz_id" ) - 1 ;
    if ( biz < 0 ) return 1 ;
    if ( b_info [ biz ] [ b_type ] != bizz_type_clothes ) return 1 ;

    new start, count ;
    accshop_cat_range ( cat, start, count ) ;
    if ( count <= 0 ) return 1 ;

    SetPVarInt   ( playerid, "acc_active",    1 ) ;
    SetPVarInt   ( playerid, "acc_idx",       start ) ;
    SetPVarInt   ( playerid, "acc_cat",       cat + 1 ) ;
    SetPVarInt   ( playerid, "acc_cat_start", start ) ;
    SetPVarInt   ( playerid, "acc_cat_count", count ) ;
    SetPVarInt   ( playerid, "cl_biz",        biz + 1 ) ;

    new Float:px, Float:py, Float:pz, Float:pa ;
    GetPlayerPos      ( playerid, px, py, pz ) ;
    GetPlayerFacingAngle ( playerid, pa ) ;
    SetPVarFloat ( playerid, "acc_back_x",  px ) ;
    SetPVarFloat ( playerid, "acc_back_y",  py ) ;
    SetPVarFloat ( playerid, "acc_back_z",  pz ) ;
    SetPVarFloat ( playerid, "acc_back_a",  pa ) ;
    SetPVarInt   ( playerid, "acc_back_iw", GetPlayerInterior     ( playerid ) ) ;
    SetPVarInt   ( playerid, "acc_back_vw", GetPlayerVirtualWorld ( playerid ) ) ;

    SetPlayerInterior     ( playerid, 0 ) ;
    SetPlayerVirtualWorld ( playerid, b_info [ biz ] [ b_id ] + 1000 ) ;
    // Park the player out of sight behind the camera.
    SetPlayerPos          ( playerid, ACC_HIDE_X, ACC_HIDE_Y, ACC_HIDE_Z ) ;
    SetPlayerFacingAngle  ( playerid, 78.77 ) ;
    TogglePlayerControllable ( playerid, 0 ) ;
    SetPlayerCameraPos    ( playerid, ACC_CAM_X, ACC_CAM_Y, ACC_CAM_Z ) ;
    SetPlayerCameraLookAt ( playerid, ACC_LOOK_X, ACC_LOOK_Y, ACC_LOOK_Z ) ;
    SetPlayerCameraPos    ( playerid, ACC_CAM_X, ACC_CAM_Y, ACC_CAM_Z ) ;
    SetPlayerCameraLookAt ( playerid, ACC_LOOK_X, ACC_LOOK_Y, ACC_LOOK_Z ) ;

    g_acc_rot_z   [ playerid ] = 0.0 ;
    g_acc_spin_on [ playerid ] = 1 ;
    accshop_spawn_object ( playerid ) ;
    accshop_send_overlay ( playerid ) ;

    if ( g_acc_timer [ playerid ] ) KillTimer ( g_acc_timer [ playerid ] ) ;
    g_acc_timer [ playerid ] = SetTimerEx ( "accshop_spin_tick", 80, true,
                                            "i", playerid ) ;
    return 1 ;
}

// =========================================================================
//  Car-shop preview overlay (NEW - 2026-05)
//
//  Sentinel dialog title:  "[!CARSHOP_OPEN]"  body "<model>|<price>|<rot>|<cat>"
//                          "[!CARSHOP_CLOSE]"  closes the overlay
//
//  Commands the overlay sends:
//      /carshop_left   /carshop_right    - cycle model within category
//      /carshop_rotate                   - step camera view (front->R->back->L)
//      /carshop_color N                  - apply paint colour (0..15)
//      /carshop_buy                      - purchase
//      /carshop_exit                     - leave without buying
//
//  Re-uses the existing per-category model + price tables
//  (t_shop_models, t_shop_category, GetModelPrice, t_shop_respawn).
// =========================================================================

// Dealer showroom pedestal (new interior, Interior=0, VW=playerid+9000).
#define CAR_PREV_X          1097.458618
#define CAR_PREV_Y          -820.894409
#define CAR_PREV_Z          1084.047485
#define CAR_PREV_A          186.170000

// Camera ring around the pedestal (4-step orbit).
#define CAR_CAM_RADIUS      7.250000
#define CAR_CAM_Z           1087.100000
#define CAR_LOOK_Z          1084.500000

// Player parked off-pedestal, invisible.
#define CAR_HIDE_X          1097.458618
#define CAR_HIDE_Y          -840.000000
#define CAR_HIDE_Z          1090.500000

// 16-colour palette shown in the overlay.  Values are SA:MP vehicle colour
// IDs chosen so the painted car visually matches the swatch.
new const g_car_palette [ 16 ] = {
    0,      //  0  Black
    1,      //  1  White
    12,     //  2  Silver
    3,      //  3  Red
    7,      //  4  Orange
    6,      //  5  Yellow
    9,      //  6  Light Green
    16,     //  7  Green
    79,     //  8  Cyan
    14,     //  9  Blue
    146,    // 10  Navy
    126,    // 11  Purple
    107,    // 12  Pink
    128,    // 13  Brown
    36,     // 14  Dark Red
    131     // 15  Beige
} ;

// Max list index usable per category (number of non-zero entries in
// t_shop_models column for that category).
stock carshop_cat_count ( cat )
{
    if ( cat < 0 || cat >= 8 ) return 0 ;  // boats/aircraft disabled
    new n = 0 ;
    for ( new i = 0 ; i < 42 ; i ++ )
    {
        if ( t_shop_models [ i ] [ cat ] == 0 ) break ;
        n ++ ;
    }
    return n ;
}

stock carshop_current_model ( playerid )
{
    new cat  = GetPVarInt ( playerid, "carshop_type" ) ;
    new list = GetPVarInt ( playerid, "carshop_list" ) ;
    if ( cat < 0 || cat >= 8 ) return 0 ;
    if ( list < 0 || list >= 42 ) return 0 ;
    return t_shop_models [ list ] [ cat ] ;
}

stock carshop_current_price ( playerid )
{
    new model = carshop_current_model ( playerid ) ;
    if ( model <= 0 ) return 0 ;
    return GetModelPrice ( model ) * for_tax [ 2 ] ;
}

// Short display label for cars in the Luxury category ó shown in the
// overlay next to the price so the player can tell the cars apart.
// Non-luxury IDs return an empty string and the UI keeps its old look.
stock carshop_model_name ( model, out_name [ ], len )
{
    switch ( model )
    {
        case 439: format ( out_name, len, "Daewoo Gentra Azelow" ) ;
        case 602: format ( out_name, len, "Mercedes E63 AMG" ) ;
        case 415: format ( out_name, len, "Mercedes" ) ;
        case 445: format ( out_name, len, "BYD Destroyer 05" ) ;
        case 516: format ( out_name, len, "Toyota Camry XSE V6" ) ;
        case 560: format ( out_name, len, "Gentra 511 Tuning" ) ;
        default:  out_name [ 0 ] = EOS ;
    }
    return 1 ;
}

stock carshop_send_overlay ( playerid )
{
    new g_ar_cat [ 8 ] [ 32 ] = {
        "”Ì«—«  ›«Œ—…",
        "ÃÌ»",
        "ﬂÊ»ÌÂ",
        "»Ìﬂ √»",
        "”Ìœ«‰",
        "⁄—»…",
        "›«‰",
        "œ—«Ã… ‰«—Ì…"
    } ;
    new model = carshop_current_model ( playerid ) ;
    new price = carshop_current_price ( playerid ) ;
    new rot   = GetPVarInt ( playerid, "carshop_rot" ) ;
    new cat   = GetPVarInt ( playerid, "carshop_type" ) ;
    if ( cat < 0 || cat >= 8 ) cat = 0 ;

    // For luxury cars we replace the category label with the car name +
    // its model ID so the overlay shows "Mercedes E63 AMG (602)" etc.
    new label [ 32 ] ;
    new mname [ 32 ] ;
    carshop_model_name ( model, mname, sizeof ( mname ) ) ;
    if ( cat == 0 && mname [ 0 ] != '\0' )
        format ( label, sizeof ( label ), "%s (%d)", mname, model ) ;
    else
        format ( label, sizeof ( label ), "%s", g_ar_cat [ cat ] ) ;

    new body [ 128 ] ;
    format ( body, sizeof ( body ), "%d|%d|%d|%s",
             model, price, rot, label ) ;
    ShowPlayerDialog ( playerid, 31338, DIALOG_STYLE_MSGBOX,
        "[!CARSHOP_OPEN]", body, " ", " " ) ;
}

stock carshop_close_overlay ( playerid )
{
    ShowPlayerDialog ( playerid, 31338, DIALOG_STYLE_MSGBOX,
        "[!CARSHOP_CLOSE]", " ", " ", " " ) ;
}

stock carshop_place_camera ( playerid )
{
    // 4-step orbit around the pedestal.  Step 0 = behind the car.
    new rot = GetPVarInt ( playerid, "carshop_rot" ) % 4 ;
    new Float: ang ;
    switch ( rot )
    {
        case 0 : ang = 180.0 ;  // camera north  (car faces ~south -> sees rear)
        case 1 : ang =  90.0 ;  // camera east   (right side)
        case 2 : ang =   0.0 ;  // camera south  (front of car)
        default: ang = 270.0 ;  // camera west   (left side)
    }
    new Float: rad = ang * 3.141592 / 180.0 ;
    new Float: cx  = CAR_PREV_X + floatsin ( rad, radian ) * CAR_CAM_RADIUS ;
    new Float: cy  = CAR_PREV_Y + floatcos ( rad, radian ) * CAR_CAM_RADIUS ;
    SetPlayerCameraPos    ( playerid, cx, cy, CAR_CAM_Z ) ;
    SetPlayerCameraLookAt ( playerid, CAR_PREV_X, CAR_PREV_Y, CAR_LOOK_Z ) ;
}

stock carshop_spawn_preview ( playerid )
{
    new model = carshop_current_model ( playerid ) ;
    if ( model <= 0 ) return 0 ;

    // Destroy existing preview veh.
    new old = GetPVarInt ( playerid, "carshop_car" ) ;
    if ( old > 0 ) AC_DestroyVehicle ( old ) ;

    new c1 = GetPVarInt ( playerid, "carshop_c1" ) ;
    new c2 = GetPVarInt ( playerid, "carshop_c2" ) ;
    new vw = playerid + 9000 ;
    new veh = AC_CreateVehicle ( model, CAR_PREV_X, CAR_PREV_Y,
                                 CAR_PREV_Z, CAR_PREV_A, c1, c2, -1 ) ;
    SetVehicleVirtualWorld ( veh, vw ) ;
    LinkVehicleToInterior  ( veh, 0 ) ;
    SetPVarInt ( playerid, "carshop_car", veh ) ;
    Streamer_Update ( playerid ) ;
    return 1 ;
}

stock carshop_enter ( playerid, cat )
{
    if ( GetPVarInt ( playerid, "carshop_active" ) ) return 1 ;
    if ( cat < 0 || cat >= 10 ) return 0 ;
    if ( carshop_cat_count ( cat ) <= 0 ) return 0 ;

    // Remember where the player came from so exit restores correctly.
    new Float: px, Float: py, Float: pz, Float: pa ;
    GetPlayerPos      ( playerid, px, py, pz ) ;
    GetPlayerFacingAngle ( playerid, pa ) ;
    SetPVarFloat ( playerid, "carshop_back_x",  px ) ;
    SetPVarFloat ( playerid, "carshop_back_y",  py ) ;
    SetPVarFloat ( playerid, "carshop_back_z",  pz ) ;
    SetPVarFloat ( playerid, "carshop_back_a",  pa ) ;
    SetPVarInt   ( playerid, "carshop_back_iw", GetPlayerInterior     ( playerid ) ) ;
    SetPVarInt   ( playerid, "carshop_back_vw", GetPlayerVirtualWorld ( playerid ) ) ;

    SetPVarInt ( playerid, "carshop_active", 1 ) ;
    SetPVarInt ( playerid, "carshop_type",   cat ) ;
    SetPVarInt ( playerid, "carshop_list",   0 ) ;
    SetPVarInt ( playerid, "carshop_rot",    0 ) ;
    // Pick a non-white default colour from the palette so each
    // category ‘«› distinct at first glance (avoid the "same
    // white car everywhere" perception).
    new def_c1 = g_car_palette [ 3 + ( cat % 13 ) ] ;
    SetPVarInt ( playerid, "carshop_c1",     def_c1 ) ;
    SetPVarInt ( playerid, "carshop_c2",     def_c1 ) ;

    // Enter preview world.
    SetPlayerInterior     ( playerid, 0 ) ;
    SetPlayerVirtualWorld ( playerid, playerid + 9000 ) ;
    SetPlayerPos          ( playerid, CAR_HIDE_X, CAR_HIDE_Y, CAR_HIDE_Z ) ;
    TogglePlayerControllable ( playerid, 0 ) ;

    carshop_spawn_preview ( playerid ) ;
    carshop_place_camera  ( playerid ) ;
    carshop_send_overlay  ( playerid ) ;
    return 1 ;
}

stock carshop_cycle ( playerid, dir )
{
    if ( ! GetPVarInt ( playerid, "carshop_active" ) ) return 1 ;
    new cat   = GetPVarInt ( playerid, "carshop_type" ) ;
    new cnt   = carshop_cat_count ( cat ) ;
    if ( cnt <= 0 ) return 1 ;
    new list  = GetPVarInt ( playerid, "carshop_list" ) ;
    list = ( list + dir + cnt ) % cnt ;
    SetPVarInt ( playerid, "carshop_list", list ) ;
    carshop_spawn_preview ( playerid ) ;
    carshop_send_overlay  ( playerid ) ;
    return 1 ;
}

stock carshop_step_rotate ( playerid )
{
    if ( ! GetPVarInt ( playerid, "carshop_active" ) ) return 1 ;
    new rot = ( GetPVarInt ( playerid, "carshop_rot" ) + 1 ) % 4 ;
    SetPVarInt ( playerid, "carshop_rot", rot ) ;
    carshop_place_camera  ( playerid ) ;
    carshop_send_overlay  ( playerid ) ;
    return 1 ;
}

stock carshop_apply_color ( playerid, pal )
{
    if ( ! GetPVarInt ( playerid, "carshop_active" ) ) return 1 ;
    if ( pal < 0 || pal >= 16 ) return 1 ;
    new c = g_car_palette [ pal ] ;
    SetPVarInt ( playerid, "carshop_c1", c ) ;
    SetPVarInt ( playerid, "carshop_c2", c ) ;
    new veh = GetPVarInt ( playerid, "carshop_car" ) ;
    if ( veh > 0 ) n_ChangeVehicleColor ( veh, c, c ) ;
    return 1 ;
}

stock carshop_restore_player ( playerid )
{
    new veh = GetPVarInt ( playerid, "carshop_car" ) ;
    if ( veh > 0 ) AC_DestroyVehicle ( veh ) ;

    new Float: bx = GetPVarFloat ( playerid, "carshop_back_x" ) ;
    new Float: by = GetPVarFloat ( playerid, "carshop_back_y" ) ;
    new Float: bz = GetPVarFloat ( playerid, "carshop_back_z" ) ;
    new Float: ba = GetPVarFloat ( playerid, "carshop_back_a" ) ;
    new       iw = GetPVarInt   ( playerid, "carshop_back_iw" ) ;
    new       vw = GetPVarInt   ( playerid, "carshop_back_vw" ) ;
    if ( bx == 0.0 && by == 0.0 )
    {
        // Fallback: LS dealership entrance.
        bx = 2201.0 ; by = 1393.0 ; bz = 10.8 ; ba = 0.0 ; iw = 0 ; vw = 0 ;
    }

    SetPlayerInterior     ( playerid, iw ) ;
    SetPlayerVirtualWorld ( playerid, vw ) ;
    SetPlayerPos          ( playerid, bx, by, bz ) ;
    SetPlayerFacingAngle  ( playerid, ba ) ;
    SetCameraBehindPlayer ( playerid ) ;
    TogglePlayerControllable ( playerid, 1 ) ;
    SetPVarInt ( playerid, "tp_area_used", 1 ) ;
}

stock carshop_clear_pvars ( playerid )
{
    DeletePVar ( playerid, "carshop_active" ) ;
    DeletePVar ( playerid, "carshop_type"   ) ;
    DeletePVar ( playerid, "carshop_list"   ) ;
    DeletePVar ( playerid, "carshop_rot"    ) ;
    DeletePVar ( playerid, "carshop_c1"     ) ;
    DeletePVar ( playerid, "carshop_c2"     ) ;
    DeletePVar ( playerid, "carshop_car"    ) ;
    DeletePVar ( playerid, "carshop_back_x" ) ;
    DeletePVar ( playerid, "carshop_back_y" ) ;
    DeletePVar ( playerid, "carshop_back_z" ) ;
    DeletePVar ( playerid, "carshop_back_a" ) ;
    DeletePVar ( playerid, "carshop_back_iw") ;
    DeletePVar ( playerid, "carshop_back_vw") ;
}

stock carshop_exit ( playerid )
{
    if ( ! GetPVarInt ( playerid, "carshop_active" ) ) return 1 ;
    carshop_close_overlay ( playerid ) ;
    carshop_restore_player ( playerid ) ;
    carshop_clear_pvars ( playerid ) ;
    return 1 ;
}

stock carshop_buy ( playerid )
{
    if ( ! GetPVarInt ( playerid, "carshop_active" ) ) return 1 ;
    new model = carshop_current_model ( playerid ) ;
    new price = carshop_current_price ( playerid ) ;
    if ( model <= 0 ) return 1 ;

    if ( p_info [ playerid ] [ money ] < price )
    {
        SendClientMessage ( playerid, col_gray,
            "{"#cRD"}* {"#cGR"}„« ⁄‰œﬂ ›·Ê” ﬂ«›Ì… ·‘—«¡ Â–Ì «·”Ì«—…." ) ;
        return 1 ;
    }
    if ( get_player_veh_count ( playerid ) >= p_info [ playerid ] [ max_veh ] )
    {
        SendClientMessage ( playerid, col_gray,
            "{"#cRD"}* {"#cGR"}«·√Ê· ·«“„  »Ì⁄ ÊÕœ… „‰ ”Ì«—« ﬂ." ) ;
        return 1 ;
    }
    if ( p_info [ playerid ] [ family ] != 0 &&
         p_info [ playerid ] [ family_rang ] == 7 )
    {
        // Family leader must choose who owns the vehicle; keep simple by
        // treating as personal purchase here - advanced choice dialog is
        // out of scope for this overlay iteration.
    }

    new ts_id = 0 ; // LS dealership (luxury + 4x4 share LS spawn)
    if ( GetPVarInt ( playerid, "carshop_type" ) == 7 ) ts_id = 1 ; // bike -> SF
    if ( GetPVarInt ( playerid, "carshop_type" ) == 8 ) ts_id = 3 ; // boat
    if ( GetPVarInt ( playerid, "carshop_type" ) == 9 ) ts_id = 4 ; // aircraft
    new slot = random ( 5 ) ;
    new c1 = GetPVarInt ( playerid, "carshop_c1" ) ;
    new c2 = GetPVarInt ( playerid, "carshop_c2" ) ;
    new Float: sx = t_shop_respawn [ ts_id ] [ slot ] [ 0 ] ;
    new Float: sy = t_shop_respawn [ ts_id ] [ slot ] [ 1 ] ;
    new Float: sz = t_shop_respawn [ ts_id ] [ slot ] [ 2 ] ;
    new Float: sa = t_shop_respawn [ ts_id ] [ slot ] [ 3 ] ;

    new veh_id = AC_CreateVehicle ( model, sx, sy, sz, sa, c1, c2, -1 ) ;

    veh_info [ veh_id - 1 ] [ v_model ] = GetVehicleModel ( veh_id ) ;

    new query_string [ 256 ] ;
    mysql_format ( sql_connection, query_string, sizeof query_string,
        "INSERT INTO `users_vehicles`(`v_model`,`v_owner`,`v_color_1`,`v_color_2`,`v_pos_x`,`v_pos_y`,`v_pos_z`,`v_pos_a`,`v_buydate`) VALUES ('%i','%i','%i','%i','%f','%f','%f','%f',NOW())",
        model, p_info [ playerid ] [ id ],
        c1, c2, sx, sy, sz, sa ) ;
    mysql_tquery ( sql_connection, query_string,
        "create_vehicle_callback", "dd", veh_id, playerid ) ;

    give_money ( playerid, - price ) ;
    insert_money_log ( playerid, INVALID_PLAYER_ID, - price,
                       "purchase of transport" ) ;

    veh_info [ veh_id - 1 ] [ v_type ]     = vehicle_type_player ;
    veh_info [ veh_id - 1 ] [ v_vehicle ]  = veh_id ;
    format ( veh_info [ veh_id - 1 ] [ v_plate ], 12, "‰ﬁ·" ) ;
    veh_info [ veh_id - 1 ] [ v_pos ] [ 0 ] = sx ;
    veh_info [ veh_id - 1 ] [ v_pos ] [ 1 ] = sy ;
    veh_info [ veh_id - 1 ] [ v_pos ] [ 2 ] = sz ;
    veh_info [ veh_id - 1 ] [ v_pos ] [ 3 ] = sa ;
    veh_info [ veh_id - 1 ] [ v_fuel ]     = 100.0 ;
    veh_info [ veh_id - 1 ] [ v_millage ]  = 0.0 ;
    veh_info [ veh_id - 1 ] [ v_fine ]     = 3 ;
    veh_info [ veh_id - 1 ] [ v_color ] [ 0 ] = c1 ;
    veh_info [ veh_id - 1 ] [ v_color ] [ 1 ] = c2 ;

    new engine, lights, alarm, doors, bonnet, boot, objective ;
    veh_info [ veh_id - 1 ] [ v_locked ] = true ;
    GetVehicleParamsEx ( veh_id, engine, lights, alarm, doors, bonnet, boot, objective ) ;
    SetVehicleParamsEx ( veh_id, engine, lights, alarm, true, bonnet, boot, objective ) ;

    veh_info [ veh_id - 1 ] [ v_owner ] = p_info [ playerid ] [ id ] ;
    SetVehicleNumberPlate ( veh_info [ veh_id - 1 ] [ v_vehicle ],
                            veh_info [ veh_id - 1 ] [ v_plate ] ) ;
    Iter_Add(player_vehicles[ playerid ], veh_info [ veh_id - 1 ] [ v_vehicle ]) ;

    // Family 11 (car dealership) gets a cut.
    new _text_string [ 160 ] ;
    f_info [ 10 ] [ f_money ] += price ;
    format ( _text_string, sizeof ( _text_string ),
        "UPDATE `fractions` SET `f_money` = '%d' WHERE `f_id` = '11' LIMIT 1",
        f_info [ 10 ] [ f_money ] ) ;
    mysql_tquery ( sql_connection, _text_string, "", "" ) ;

    SendClientMessage ( playerid, col_white,
        "{"#cGN"}* {"#cWH"} „ ‘—«¡ «·”Ì«—… »‰Ã«Õ." ) ;
    SendClientMessage ( playerid, col_white,
        "{"#cGN"}* {"#cWH"} „  Ê’Ì·Â« ≈·Ï «·”«Õ… «·Œ«—ÃÌ…. «” Œœ„ {"#cGN"}/vpark{"#cWH"} ··Õ›«Ÿ ⁄·ÌÂ«." ) ;

    carshop_exit ( playerid ) ;
    return 1 ;
}

CMD:carshop_left   ( playerid )             { return carshop_cycle       ( playerid, -1 ) ; }
CMD:carshop_right  ( playerid )             { return carshop_cycle       ( playerid,  1 ) ; }
CMD:carshop_rotate ( playerid )             { return carshop_step_rotate ( playerid     ) ; }
CMD:carshop_buy    ( playerid )             { return carshop_buy         ( playerid     ) ; }
CMD:carshop_exit   ( playerid )             { return carshop_exit        ( playerid     ) ; }
CMD:carshop_color  ( playerid, params [ ] )
{
    new idx = strval ( params ) ;
    return carshop_apply_color ( playerid, idx ) ;
}


