        p_info[playerid][m4_save] = 0;
        update_int_sql ( playerid, "m4_save", p_info [ playerid ] [ m4_save ] ) ;
    }
    if (p_info[playerid][rpg_save] > 0)
    {
        // HavanaRP weapon-craft: restore the persisted RocketLauncher (id 35)
        // with whatever ammo the player had at last save. We re-anchor the
        // anti-cheat tracking state, disable Nex-AC ammo checks for 12s,
        // and bump the immune window so neither the gamemode sweep nor
        // Nex-AC code 16 strips/flags the freshly restored launcher.
        new _rpg_ammo = p_info[playerid][rpg_save];
        p_t_info [ playerid ] [ p_gun_immune_time ] = 24 ;
        p_t_info [ playerid ] [ p_gun_slot ] [ 7 ] = 35 ;
        if ( p_t_info [ playerid ] [ p_gun_ammo ] [ 7 ] < _rpg_ammo )
            p_t_info [ playerid ] [ p_gun_ammo ] [ 7 ] = _rpg_ammo ;
        Craft_DisableACAmmo ( playerid ) ;
        give_weapon(playerid, 35, _rpg_ammo);
        SetTimerEx ( "CraftTable_VerifyGrant", 1500, 0, "iii", playerid, 35, _rpg_ammo ) ;
    }
 	if ( anim_loaded { playerid } == 0 )
	{
   		PreloadAnimLibs(playerid);
		anim_loaded { playerid } = 1 ;
	}
	ResetPlayerMoney ( playerid ) ;
	GivePlayerMoney ( playerid, p_info [ playerid ] [ money ] ) ;

	SetPlayerSkin ( playerid, p_info [ playerid ] [ skin ] ) ;

	if ( GetPVarInt ( playerid, "have_box" ) ) DeletePVar ( playerid, "have_box" ) ;
	if ( GetPVarInt ( playerid, "have_factory_box" ) ) DeletePVar ( playerid, "have_factory_box" ) ;
	if ( GetPVarInt ( playerid, "exam_vehicle" ) != 0 ) AC_DestroyVehicle ( GetPVarInt ( playerid, "exam_vehicle" ) ), DeletePVar ( playerid, "exam_vehicle" ) ;
	if ( action_type { playerid } != 0 )
	{
		action_td_status ( playerid, false ) ;
	}

	if ( p_info [ playerid ] [ salary ] != 0 )
	{
		new _t_string [ 62 ] ;
		format ( _t_string, sizeof ( _t_string ), "√‰  ﬂ«‰Ê« compensated %d$ ·‹ «·‘€·.", p_info [ playerid ] [ salary ] ) ;
		SendClientMessage ( playerid, 0xCCCCCCFF, _t_string ) ;
		give_money ( playerid, p_info [ playerid ] [ salary ] ) ;
		insert_money_log ( playerid, INVALID_PLAYER_ID, p_info [ playerid ] [ salary ], "salary compensation" ) ;
