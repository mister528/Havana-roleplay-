stock Shop247_MakeClickSprite(playerid, idx, Float:x, Float:y, Float:w, Float:h, color)
{
	g_shop247_td[playerid][idx] = CreatePlayerTextDraw(playerid, x, y, "LD_SPAC:WHITE");
	PlayerTextDrawBackgroundColor(playerid, g_shop247_td[playerid][idx], 0);
	PlayerTextDrawFont(playerid, g_shop247_td[playerid][idx], 4);
	PlayerTextDrawLetterSize(playerid, g_shop247_td[playerid][idx], 0.5, 1.0);
	PlayerTextDrawColor(playerid, g_shop247_td[playerid][idx], color);
	PlayerTextDrawSetOutline(playerid, g_shop247_td[playerid][idx], 0);
	PlayerTextDrawSetProportional(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawSetShadow(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawUseBox(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawBoxColor(playerid, g_shop247_td[playerid][idx], color);
	PlayerTextDrawTextSize(playerid, g_shop247_td[playerid][idx], w, h);
	PlayerTextDrawSetSelectable(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawShow(playerid, g_shop247_td[playerid][idx]);
	return 1;
}
stock Shop247_MakeLabelTop(playerid, idx, Float:x, Float:y, text[], color)
{
	g_shop247_td[playerid][idx] = CreatePlayerTextDraw(playerid, x, y, text);
	PlayerTextDrawAlignment(playerid, g_shop247_td[playerid][idx], 2);
	PlayerTextDrawFont(playerid, g_shop247_td[playerid][idx], 2);
	PlayerTextDrawLetterSize(playerid, g_shop247_td[playerid][idx], 0.33, 1.5);
	PlayerTextDrawColor(playerid, g_shop247_td[playerid][idx], color);
	PlayerTextDrawSetOutline(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawSetProportional(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawSetShadow(playerid, g_shop247_td[playerid][idx], 1);
	PlayerTextDrawSetSelectable(playerid, g_shop247_td[playerid][idx], 0);
	PlayerTextDrawShow(playerid, g_shop247_td[playerid][idx]);
	return 1;
}
stock ShowShopTD(playerid)
{
	printf("[SHOP_DBG] ShowShopTD start pid=%d", playerid);
	if (g_shop247_open[playerid]) HideShopTD(playerid);
	ShowPlayerDialog(playerid, -1, 0, " ", " ", " ", " ");
	new b = GetPVarInt(playerid, "p_biz_id") - 1;
	if (b < 0) b = 0;
	// [0] panel backdrop
	g_shop247_td[playerid][0] = CreatePlayerTextDraw(playerid, 175.0, 95.0, "_");
	PlayerTextDrawFont(playerid, g_shop247_td[playerid][0], 1);
	PlayerTextDrawLetterSize(playerid, g_shop247_td[playerid][0], 0.0, 34.0);
	PlayerTextDrawTextSize(playerid, g_shop247_td[playerid][0], 465.0, 0.0);
	PlayerTextDrawUseBox(playerid, g_shop247_td[playerid][0], 1);
	PlayerTextDrawBoxColor(playerid, g_shop247_td[playerid][0], 0x0A0A0AEE);
	PlayerTextDrawColor(playerid, g_shop247_td[playerid][0], 0x00000000);
	PlayerTextDrawSetSelectable(playerid, g_shop247_td[playerid][0], 0);
	PlayerTextDrawShow(playerid, g_shop247_td[playerid][0]);
	// [1] green title bar
	g_shop247_td[playerid][1] = CreatePlayerTextDraw(playerid, 175.0, 95.0, "_");
	PlayerTextDrawFont(playerid, g_shop247_td[playerid][1], 1);
	PlayerTextDrawLetterSize(playerid, g_shop247_td[playerid][1], 0.0, 2.2);
	PlayerTextDrawTextSize(playerid, g_shop247_td[playerid][1], 465.0, 0.0);
	PlayerTextDrawUseBox(playerid, g_shop247_td[playerid][1], 1);
	PlayerTextDrawBoxColor(playerid, g_shop247_td[playerid][1], 0x00C46AFF);
	PlayerTextDrawColor(playerid, g_shop247_td[playerid][1], 0x00000000);
	PlayerTextDrawSetSelectable(playerid, g_shop247_td[playerid][1], 0);
	PlayerTextDrawShow(playerid, g_shop247_td[playerid][1]);
	// [2] title text
	g_shop247_td[playerid][2] = CreatePlayerTextDraw(playerid, 320.0, 98.0, "Â«›«‰« «·„Õ· 24/7");
	PlayerTextDrawAlignment(playerid, g_shop247_td[playerid][2], 2);
	PlayerTextDrawFont(playerid, g_shop247_td[playerid][2], 2);
	PlayerTextDrawLetterSize(playerid, g_shop247_td[playerid][2], 0.34, 1.55);
	PlayerTextDrawColor(playerid, g_shop247_td[playerid][2], 0xFFFFFFFF);
	PlayerTextDrawSetOutline(playerid, g_shop247_td[playerid][2], 1);
	PlayerTextDrawSetShadow(playerid, g_shop247_td[playerid][2], 1);
	PlayerTextDrawSetSelectable(playerid, g_shop247_td[playerid][2], 0);
	PlayerTextDrawShow(playerid, g_shop247_td[playerid][2]);
	// [3..17] 15 item rows (same pattern that worked in v18)
	new buf[96];
	for (new i = 0; i < 15; i++) {
		new price = b_shop_price[i] + floatround(b_shop_price[i] * (float(b_info[b][b_cost]) / 100));
		format(buf, sizeof(buf), " %d. %s     ~g~$%d", i+1, shop247_td_names[i], price);
		new Float:ty = 131.0 + float(i) * 17.0;
		new boxc = (i % 2) ? 0x1A1A1AEE : 0x252525EE;
		Shop247_MakeRow(playerid, 3+i, ty, buf, boxc, 1);
	}
	// [18] BUY sprite (Font 4 LD_SPAC:WHITE) - CLICKABLE like dice buttons
	Shop247_MakeClickSprite(playerid, 18, 188.0, 372.0, 130.0, 22.0, 0x00C46AFF);
	// [19] CLOSE sprite - CLICKABLE
	Shop247_MakeClickSprite(playerid, 19, 328.0, 372.0, 130.0, 22.0, 0xC42222FF);
	// [20] BUY label on top (non-clickable)
	Shop247_MakeLabelTop(playerid, 20, 253.0, 376.0, "BUY", 0xFFFFFFFF);
	// [21] CLOSE label on top (non-clickable)
	Shop247_MakeLabelTop(playerid, 21, 393.0, 376.0, "CLOSE", 0xFFFFFFFF);
	// [22] hint
	g_shop247_td[playerid][22] = CreatePlayerTextDraw(playerid, 320.0, 402.0, "«‰ﬁ— «·€—÷, then «‰ﬁ— ‘—«¡ √Ê ≈€·«ﬁ");
	PlayerTextDrawAlignment(playerid, g_shop247_td[playerid][22], 2);
	PlayerTextDrawFont(playerid, g_shop247_td[playerid][22], 1);
	PlayerTextDrawLetterSize(playerid, g_shop247_td[playerid][22], 0.22, 0.9);
	PlayerTextDrawColor(playerid, g_shop247_td[playerid][22], 0xAAAAAAFF);
	PlayerTextDrawSetOutline(playerid, g_shop247_td[playerid][22], 0);
	PlayerTextDrawSetShadow(playerid, g_shop247_td[playerid][22], 1);
	PlayerTextDrawSetSelectable(playerid, g_shop247_td[playerid][22], 0);
	PlayerTextDrawShow(playerid, g_shop247_td[playerid][22]);
	g_shop247_open[playerid] = true;
	g_shop247_sel[playerid] = -1;
	for (new gi = 0; gi < 17; gi++) TextDrawShowForPlayer(playerid, g_shop247_hit[gi]);
	CancelSelectTextDraw(playerid);
	SetTimerEx("ShopTD_EnableCursor", 250, false, "d", playerid);
	return 1;
}
public ShopTD_DoBuy(playerid, sel)
{
	if (sel < 0 || sel > 14) return 0;
	OnDialogResponse(playerid, d_shop, 1, sel, "");
	return 1;
}
