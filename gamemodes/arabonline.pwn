CMD:pts(playerid, params[])
{
	if ( ! IsPlayerInAnyVehicle ( playerid ) ) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}·«“„ ÌﬂÊ‰ ›Ì ‰ﬁ·!");

    new _v_id = GetPlayerVehicleID ( playerid ) ;

	if ( veh_info [ _v_id - 1 ] [ v_owner ] != p_info [ playerid ] [ id ] || veh_info [ _v_id - 1 ] [ v_type ] != vehicle_type_player )return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"} ·«“„  ﬂÊ‰ ⁄‰œﬂ ”Ì«—… Œ«’…!");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /‰ﬁ«ÿ [ID/«·«”„]");
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
    if(GetPVarInt(params [ 0 ], "pts_show") == 1) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» Ì‘«Âœ «·ÃÊ«“ «· ﬁ‰Ì.");

    if ( ! IsPlayerInRangeOfPoint ( playerid, 5, p_t_info [ params [ 0 ] ][ p_pos ] [ 0 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 1 ], p_t_info [ params [ 0 ] ][ p_pos ] [ 2 ] ) || GetPlayerVirtualWorld ( params [ 0 ] ) != GetPlayerVirtualWorld ( playerid ) )return SendClientMessage ( playerid, col_gray,""c_orange_red"* "c_grey"«··«⁄» »⁄Ìœ Ãœ«." ) ;

	show_pts(playerid, params[0]);

	new scm_string [ 100 ] ;
	if ( params[0] != playerid )format(scm_string, sizeof(scm_string), "⁄—÷ «·”Ì«—…'s «·ÃÊ«“ %s", p_info [ params [ 0 ] ] [ name ] ) ;
	else format(scm_string, sizeof(scm_string), "‘«› ⁄‰œ «·”Ì«—… «·ÃÊ«“" ) ;
	me_action ( playerid, scm_string ) ;
	return 1;
}

stock show_pts(playerid, show_id)
{
	if(GetPVarInt(show_id, "pts_show") == 1) return SendClientMessage(show_id, col_white, !""scm_error"√‰   ‘«Âœ –«ﬂ «·ÃÊ«“ ﬁ»·.");

	Carpass_PTD[show_id][0] = CreatePlayerTextDraw(show_id, 382.8379, 175.6517, "JORDAN_STEWART~n~~n~TESLA_„ÊœÌ·_X~n~~n~XYESLA"); // empty
	PlayerTextDrawLetterSize(show_id, Carpass_PTD[show_id][0], 0.1782, 0.8033);
	PlayerTextDrawAlignment(show_id, Carpass_PTD[show_id][0], 3);
