CMD:debtors ( playerid )
{
	if ( p_info [ playerid ] [ member ] != 11 && ! mayor_player ( playerid ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–Ì «·ÊŸÌ›… „« ÂÌ „ «Õ… ·ﬂ." ) ;
	if ( p_info [ playerid ] [ member ] == 11 && p_info [ playerid ] [ rank ] < 9 || mayor_player ( playerid ) && p_info [ playerid ] [ rank ] < 5 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}Â–Ì «·ÊŸÌ›… „« ÂÌ „ «Õ… ·ﬂ." ) ;

	SetPVarInt ( playerid, "ofm_list_page", 1 ) ;
	mysql_tquery ( sql_connection, "SELECT `u_name`,`u_tax` FROM `users` WHERE `u_tax` > 100000 ORDER BY `users`.`u_tax` DESC", "callback_debtors", "i", playerid ) ;
	return 1 ;
}

