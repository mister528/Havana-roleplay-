CMD:spoff ( playerid )
{
	if ( GetPVarInt ( playerid, "spectate_status" ) != 0 )
	{
		for ( new j = 0 ; j < 27 ; j ++ )
		{
			TextDrawHideForPlayer ( playerid, admin_panel [ j ] ) ;
			if ( j < 3 )
			{
				PlayerTextDrawDestroy ( playerid, admin_panel_ptd [ playerid ] [ j ] ) ;
				admin_panel_ptd [ playerid ] [ j ] = PlayerText:-1;
			}
		}
		CancelSelectTextDraw ( playerid ) ;
		TogglePlayerSpectating ( playerid, false ) ;
		p_t_info [ playerid ] [ sp_admin ] = 0 ;
	}
	return 1 ;
}

CMD:sp(playerid, params[])
{
	if ( ! p_info [ playerid ] [ admin ] )return 1 ;
	if ( sscanf ( params, "u", params [ 0 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«·«” Œœ«„: /sp [ID]" ) ;
	if ( ! IsPlayerConnected ( params [ 0 ] ) ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» €Ì— „ÊÃÊœ." ) ;
	if ( GetPVarInt ( params [ 0 ], "spectate_status" ) != 0 ) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«··«⁄» ÂÊ ›Ì „—«ﬁ»… «·Ê÷⁄." ) ;
	if(p_info[params[0]][admin] > p_info[playerid][admin]) return SendClientMessage(playerid, col_gray,"„«  ﬁœ—  —«ﬁ» ≈œ«—Ì „” Ê«Â √⁄·Ï „‰ﬂ");
	
	if(p_info[params[0]][id] == 1) return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}„«  ﬁœ— «·”«⁄… Â–« «·”Ã‰." ) ;

	new scm_string [ MAX_PLAYER_NAME * 2 + 6 * 2 + 18 ] ;
