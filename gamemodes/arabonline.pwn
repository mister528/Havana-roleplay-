	return 1;
}

CMD:fwarn(playerid, params[])
{
 	if ( p_info [ playerid ] [ member ] == 0 ) return 1 ;
	if ( p_info [ playerid ] [ rank ] <  f_info [ p_info [ playerid ] [ member ] - 1 ] [ f_rank_settings ] [ 4 ] )return 1 ;
	if ( sscanf ( params, "us[32]", params [ 0 ], params [ 1 ] ) )return SendClientMessage ( playerid, col_gray,"{"#cRD"}* {"#cGR"}«” Œœ«„: /fwarn [id/«·«”„] [«·”»»]" ) ;
