}

callback: family_loading ( )
{
    new fields ;
    cache_get_data ( family_count, fields ) ;
    if ( family_count )
    {
        for ( new f = 0; f < family_count ; f++ )
        {

            family_info [ f ][ fam_id ] = cache_get_field_content_int ( f, "fam_id", sql_connection ) ;
			cache_get_field_content ( f, "fam_name", family_info [ f ] [ fam_name ], sql_connection, 68 ) ;
			cache_get_field_content ( f, "fam_creator", family_info [ f ] [ fam_creator ], sql_connection, MAX_PLAYER_NAME ) ;

            family_info [ f ][ fam_nationality ] = cache_get_field_content_int (f, "fam_nationality", sql_connection ) ;

			cache_get_field_content ( f, "fam_chat_color", family_info [ f ][ fam_chat_color ], sql_connection, 8 ) ;
			

			global_string [ 0 ] = EOS ;
			cache_get_field_content ( f, "fam_settings", global_string, sql_connection, 12 ), sscanf ( global_string, "p<|>dddddd",
			family_info [ f ] [ fam_settings ] [ 0 ], family_info [ f ] [ fam_settings ] [ 1 ], family_info [ f ] [ fam_settings ] [ 2 ],
			family_info [ f ] [ fam_settings ] [ 3 ], family_info [ f ] [ fam_settings ] [ 4 ], family_info [ f ] [ fam_settings ] [ 5 ] ) ;

			global_string [ 0 ] = EOS ;
			cache_get_field_content ( f, "fam_ranks", global_string, sql_connection, 372 ), sscanf ( global_string, "p<|>s[30]s[30]s[30]s[30]s[30]s[30]s[30]",
			family_rank [ f ] [ 0 ], family_rank [ f ] [ 1 ], family_rank [ f ] [ 2 ], family_rank [ f ] [ 3 ],
			family_rank [ f ] [ 4 ], family_rank [ f ] [ 5 ], family_rank [ f ] [ 6 ] ) ;
			
			family_info [ f ][ fam_bank ] = cache_get_field_content_int (f, "fam_bank", sql_connection ) ;
			
			// family spawn
			family_info [ f ][ fam_house ] = cache_get_field_content_int (f, "fam_house", sql_connection ) ;
			family_info [ f ][ fam_house_xgpos ] = cache_get_field_content_int (f, "fam_house_xgpos", sql_connection ) ;
			family_info [ f ][ fam_house_ygpos ] = cache_get_field_content_int (f, "fam_house_ygpos", sql_connection ) ;
			family_info [ f ][ fam_house_zgpos ] = cache_get_field_content_int (f, "fam_house_zgpos", sql_connection ) ;
			family_info [ f ][ fam_house_cgpos ] = cache_get_field_content_int (f, "fam_house_cgpos", sql_connection ) ;
			
			// family safe
			family_info [ f ][ fam_safe ] = cache_get_field_content_int (f, "fam_safe", sql_connection ) ;
			family_info [ f ][ fam_deagle ] = cache_get_field_content_int (f, "fam_deagle", sql_connection ) ;
			family_info [ f ][ fam_sdpistol ] = cache_get_field_content_int (f, "fam_sdpistol", sql_connection ) ;
			family_info [ f ][ fam_mp5 ] = cache_get_field_content_int (f, "fam_mp5", sql_connection ) ;
			family_info [ f ][ fam_ak ] = cache_get_field_content_int (f, "fam_ak", sql_connection ) ;
			family_info [ f ][ fam_shotgun ] = cache_get_field_content_int (f, "fam_shotgun", sql_connection ) ;
			family_info [ f ][ fam_m4 ] = cache_get_field_content_int (f, "fam_m4", sql_connection ) ;
			
			// family cars
			family_info [ f ][ fam_car1 ] = cache_get_field_content_int (f, "fam_car1", sql_connection ) ;
			family_info [ f ][ fam_car2 ] = cache_get_field_content_int (f, "fam_car2", sql_connection ) ;
			family_info [ f ][ fam_car3 ] = cache_get_field_content_int (f, "fam_car3", sql_connection ) ;
			family_info [ f ][ fam_car4 ] = cache_get_field_content_int (f, "fam_car4", sql_connection ) ;
			family_info [ f ][ fam_car5 ] = cache_get_field_content_int (f, "fam_car5", sql_connection ) ;
			
			family_info[f][fam_car1_spawned] = 0;
            family_info[f][fam_car2_spawned] = 0;
            family_info[f][fam_car3_spawned] = 0;
            family_info[f][fam_car4_spawned] = 0;
            family_info[f][fam_car5_spawned] = 0;
			
			family_info [ f ][ fam_car1_spawned ] = cache_get_field_content_int (f, "fam_car1_spawned", sql_connection ) ;
			family_info [ f ][ fam_car2_spawned ] = cache_get_field_content_int (f, "fam_car2_spawned", sql_connection ) ;
			family_info [ f ][ fam_car3_spawned ] = cache_get_field_content_int (f, "fam_car3_spawned", sql_connection ) ;
			family_info [ f ][ fam_car4_spawned ] = cache_get_field_content_int (f, "fam_car4_spawned", sql_connection ) ;
			family_info [ f ][ fam_car5_spawned ] = cache_get_field_content_int (f, "fam_car5_spawned", sql_connection ) ;
			
			family_info[f][fam_car1_spawned] = 0;
            family_info[f][fam_car2_spawned] = 0;
            family_info[f][fam_car3_spawned] = 0;
            family_info[f][fam_car4_spawned] = 0;
            family_info[f][fam_car5_spawned] = 0;
            
            family_info [ f ][ fam_car_color ] = cache_get_field_content_int (f, "fam_car_color", sql_connection ) ;
            
            family_info [ f ][ fam_members ] = cache_get_field_content_int (f, "fam_members", sql_connection ) ;
		}
    }
    else printf ( "LOADING: loaded%d families.", family_count ) ;
    return 1;
}

callback:callback_familylist ( playerid )
{
	new rows, fields ;
	cache_get_data ( rows, fields ) ;
	if ( ! rows )
	{
		SendClientMessage ( playerid, col_gray, "{"#cRD"}* {"#cGR"}„«  „ «·⁄ÀÊ— ⁄·Ï ⁄«∆·… ›Ì √—‘Ì› «·œÊ·…." ) ;
		show_dialog ( playerid, d_family_hall, DIALOG_STYLE_LIST, "{"#cBL"}√—‘Ì› «·œÊ·…", "{"#cGR"}- {"#cWH"}≈‰‘«¡ «·⁄«∆·…\n{"#cGR"}- {"#cWH"} €ÌÌ— «”„ «·⁄«∆·…\n{"#cGR"}- {"#cWH"}ﬁ«∆„… «·⁄«∆·« ", "«Œ —", "≈€·«ﬁ" ) ;
		DeletePVar ( playerid, "ofm_list_page" ) ;
		return 1 ;
	}
	new rows_list = GetPVarInt ( playerid, "ofm_list_page" ) - 1 ;
	SetPVarInt ( playerid, "ofm_list_rows", rows ) ;
	new line_string [ 68 + 16 ],
		pl_f_name [ 68 ] ;

	global_string [ 0 ] = EOS ;
	for ( new i = rows_list * 20 ; i <  rows_list * 20 + 20 ; i ++ )
	{
		if ( i >= rows ) break ;

		cache_get_field_content ( i, "fam_name", pl_f_name, sql_connection, 68 ) ;

		format ( line_string, sizeof ( line_string ), "{"#cWH"}%d. {"#cWH"}%s\n", i + 1, pl_f_name ) ;
		strcat ( global_string, line_string ) ;

	}

